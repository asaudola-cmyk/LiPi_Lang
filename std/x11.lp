// 📜 লিপি X11 নেটিভ উইন্ডো ইঞ্জিন (Pure Lipi X11 Windowing Protocol)
// 🏛️ GTK, Qt বা Xlib ছাড়াই সরাসরি UNIX ডোমেইন সকেটের মাধ্যমে গ্রাফিক্যাল উইন্ডো!
// ইনোভেশন: /tmp/.X11-unix/X0 সকেটে সরাসরি বাইনারি প্যাকেট পাঠিয়ে হার্ডওয়্যার এক্সিলারেশন।

include "std/mem.lp"

// ১. X11 সার্ভারের সাথে UNIX Socket এ কানেক্ট করা
// WHY: Xlib এর পরাধীনতা দূর করে আমরা সরাসরি X Server-এর সাথে কথা বলছি।
fn এক্স11_কানেক্ট
    // SYS_socket (41): AF_UNIX (1), SOCK_STREAM (1), 0
    সকেট_এফডি = সিসকল(41, 1, 1, 0)
    if সকেট_এফডি < 0
        say "❌ UNIX সকেট তৈরি ব্যর্থ!"
        return -1

    // sockaddr_un (sun_family = 1, sun_path = "/tmp/.X11-unix/X0")
    // মেমরিতে 110 বাইট বরাদ্দ
    সকঅ্যাড্রেস = সিসকল(9, 0, 110, 3, 34, -1, 0)
    মেমরি_পূরণ(সকঅ্যাড্রেস, 0, 110)

    // sun_family = AF_UNIX (1) -> 16-bit (2 bytes)
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 0, 1)
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 1, 0)

    // sun_path = "/tmp/.X11-unix/X0"
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 2, 47) // '/'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 3, 116) // 't'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 4, 109) // 'm'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 5, 112) // 'p'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 6, 47) // '/'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 7, 46) // '.'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 8, 88) // 'X'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 9, 49) // '1'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 10, 49) // '1'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 11, 45) // '-'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 12, ۱17) // 'u'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 12, 117) // 'u'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 13, 110) // 'n'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 14, 105) // 'i'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 15, ۱20) // 'x'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 15, 120) // 'x'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 16, 47) // '/'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 17, 88) // 'X'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, 18, 48) // '0'

    // SYS_connect (42): fd, sockaddr, addrlen (110)
    স্ট্যাটাস = সিসকল(42, সকেট_এফডি, সকঅ্যাড্রেস, 110)

    সিসকল(11, সকঅ্যাড্রেস, 110) // মেমরি রিলিজ

    if স্ট্যাটাস < 0
        say "❌ X11 সার্ভারে কানেক্ট করতে ব্যর্থ (X0 নেই)!"
        return -1

    return সকেট_এফডি

// ২. কানেকশন সেটআপ (X11 Connection Setup Packet)
// WHY: X11 সার্ভারকে বলতে হবে যে আমরা লিটল-এন্ডিয়ান (l) এবং ভার্সন 11.0 ব্যবহার করছি।
fn এক্স11_সেটআপ সকেট_এফডি
    প্যাকেট = সিসকল(9, 0, 12, 3, 34, -1, 0)

    // Byte-order: 'l' = 108 (0x6c) - Little Endian
    মেমরি_বাইট_লেখো(প্যাকেট, 0, 108)

    // Protocol major version = 11 (0x0b)
    মেমরি_বাইট_লেখো(প্যাকেট, 2, 11)
    মেমরি_বাইট_লেখো(প্যাকেট, 3, 0)

    // Protocol minor version = 0
    মেমরি_বাইট_লেখো(প্যাকেট, 4, 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 5, 0)

    // Auth name & data len = 0 (16-bit 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 6, 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 7, 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 8, 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 9, 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 10, 0)
    মেমরি_বাইট_লেখো(প্যাকেট, 11, 0)

    // SYS_sendto (44): fd, buf, len, flags, dest_addr, addrlen
    সিসকল(44, সকেট_এফডি, প্যাকেট, 12, 0, 0, 0)
    সিসকল(11, প্যাকেট, 12)

    // সার্ভার থেকে রেসপন্স পড়া (SYS_recvfrom = 45)
    // রেসপন্সে Root Window ID এবং Resource Base থাকে যা উইন্ডো তৈরির জন্য লাগবে।
    রেসপন্স = সিসকল(9, 0, 4096, 3, 34, -1, 0)
    পঠিত_বাইট = সিসকল(45, সকেট_এফডি, রেসপন্স, 4096, 0, 0, 0)

    if পঠিত_বাইট < 8
        say "❌ X11 সার্ভার থেকে সঠিক রেসপন্স পাওয়া যায়নি!"
        return -1

    // রেসপন্সের প্রথম বাইট: 1 = Success, 0 = Failed, 2 = Authenticate
    স্ট্যাটাস = মেমরি_বাইট_পড়ো(রেসপন্স, 0)
    if স্ট্যাটাস != 1
        say "❌ X11 কানেকশন সেটআপ ব্যর্থ! স্ট্যাটাস কোড: " + স্ট্যাটাস
        return -1

    // Resource ID Base (Offset 12 in X11 Setup Reply)
    // 32-bit ID base
    বেস0 = মেমরি_বাইট_পড়ো(রেসপন্স, 12)
    বেস1 = মেমরি_বাইট_পড়ো(রেসপন্স, 13)
    বেস2 = মেমরি_বাইট_পড়ো(রেসপন্স, 14)
    বেস3 = মেমরি_বাইট_পড়ো(রেসপন্স, 15)
    রিসোর্স_বেস = বেস0 + (বেস1 * 256) + (বেস2 * 65536) + (বেস3 * 16777216)

    say "✅ X11 কানেকশন সফল! Resource Base ID: " + রিসোর্স_বেস

    return রেসপন্স // পয়েন্টার return দিচ্ছি
