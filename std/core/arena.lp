// ==============================================================================
// 👑 LIPI STANDARD LIBRARY: ARENA MEMORY ALLOCATOR & ARC (std/arena.lp)
// ⚡ 100% Sovereign Silicon Memory Architecture | Zero Fragmentation | O(1) Allocation
// ==============================================================================

// WHY: Traditional malloc/free causes heap fragmentation and kernel transition overhead.
// An arena allocator acquires a large memory block once from Linux (via SYS_mmap)
// and dispenses 8-byte aligned memory chunks using an ultra-fast bump pointer (O(1)).
// All allocated memory is released in a single CPU cycle via arena reset.

অন্তর্ভুক্ত "std/mem.lp"

গঠন অ্যারিনা {
    বেস,
    ক্যাপাসিটি,
    ব্যবহৃত
}

// ১. কার্নেল পেজ ম্যাপ দিয়ে নতুন অ্যারিনা মেমরি পুল তৈরি
ফাংশন অ্যারিনা_তৈরি(ক্যাপাসিটি) {
    // SYS_mmap(0, length, PROT_READ|PROT_WRITE=3, MAP_ANONYMOUS|MAP_PRIVATE=34, -1, 0)
    ধরি র_মেম = সিসকল(৯, ০, ক্যাপাসিটি, ৩, ৩৪, -১, ০)
    যদি র_মেম <= ০ {
        ফেরত ০
    }

    ধরি পুল = মেমরি_বরাদ্দ(২৪)
    মেমরি_লেখো(পুল, ০, র_মেম)
    মেমরি_লেখো(পুল, ৮, ক্যাপাসিটি)
    মেমরি_লেখো(পুল, ১৬, ০)
    ফেরত পুল
}

// ২. অ্যারিনা থেকে ৮-বাইট অ্যালাইন্ড মেমরি চাঙ্ক বরাদ্দ (O(1) Bump Allocation)
ফাংশন অ্যারিনা_বরাদ্দ(পুল, বাইট_সাইজ) {
    ধরি বেস = মেমরি_পড়ো(পুল, ০)
    ধরি ক্যাপাসিটি = মেমরি_পড়ো(পুল, ৮)
    ধরি ব্যবহৃত = মেমরি_পড়ো(পুল, ১৬)

    // ৮-বাইট কিউ-ওয়ার্ড (QWORD) বাউন্ডারিতে অ্যালাইনমেন্ট: (size + 7) & ~7
    ধরি অ্যালাইন্ড_সাইজ = (বাইট_সাইজ + ৭) & (০ - ৮)

    যদি ব্যবহৃত + অ্যালাইন্ড_সাইজ > ক্যাপাসিটি {
        ফেরত ০ // মেমরি শেষ (Out of Memory)
    }

    ধরি বরাদ্দী_ঠিকানা = বেস + ব্যবহৃত
    ধরি নতুন_ব্যবহৃত = ব্যবহৃত + অ্যালাইন্ড_সাইজ
    মেমরি_লেখো(পুল, ১৬, নতুন_ব্যবহৃত)

    ফেরত বরাদ্দী_ঠিকানা
}

// ৩. বর্তমানে ব্যবহৃত মোট মেমরি বাইট সংখ্যা
ফাংশন অ্যারিনা_ব্যবহৃত_মেমরি(পুল) {
    ফেরত মেমরি_পড়ো(পুল, ১৬)
}

// ৪. অ্যারিনায় অবশিষ্ট খালি মেমরি বাইট সংখ্যা
ফাংশন অ্যারিনা_অবশিষ্ট_মেমরি(পুল) {
    ধরি ক্যাপাসিটি = মেমরি_পড়ো(পুল, ৮)
    ধরি ব্যবহৃত = মেমরি_পড়ো(পুল, ১৬)
    ফেরত ক্যাপাসিটি - ব্যবহৃত
}

// ৫. এক পলকে সমস্ত বরাদ্দ মেমরি রিসেট (O(1) Instant Mass Reclamation)
// WHY: Zero fragmentation and zero memory leak guarantee.
ফাংশন অ্যারিনা_রিসেট(পুল) {
    মেমরি_লেখো(পুল, ১৬, ০)
    ফেরত ০
}

// ৬. ওএস কার্নেলকে মেমরি পৃষ্ঠা ফেরত দিয়ে অ্যারিনা ধ্বংসকরণ
ফাংশন অ্যারিনা_ধ্বংস(পুল) {
    ধরি বেস = মেমরি_পড়ো(পুল, ০)
    ধরি ক্যাপাসিটি = মেমরি_পড়ো(পুল, ৮)
    যদি বেস > ০ {
        // SYS_munmap(addr, length) -> Syscall 11
        সিসকল(১১, বেস, ক্যাপাসিটি, ০, ০, ০, ০)
    }
    মেমরি_লেখো(পুল, ০, ০)
    মেমরি_লেখো(পুল, ৮, ০)
    মেমরি_লেখো(পুল, ১৬, ০)
    ফেরত ০
}

// ------------------------------------------------------------------------------
// স্মার্ট রেফারেন্স কাউন্টিং (Atomic Reference Counting - ARC Primitives)
// ------------------------------------------------------------------------------

// ৭. রেফারেন্স সেল তৈরি (রেফারেন্স কাউন্ট = ১)
ফাংশন রেফারেন্স_তৈরি(ডাটা_মান) {
    ধরি সেল = মেমরি_বরাদ্দ(১৬)
    মেমরি_লেখো(সেল, ০, ১)        // অফসেট ০: রেফারেন্স কাউন্ট = ১
    মেমরি_লেখো(সেল, ৮, ডাটা_মান) // অফসেট ৮: ডেটা পয়েন্টার / মান
    ফেরত সেল
}

// ৮. রেফারেন্স কাউন্ট বৃদ্ধি
ফাংশন রেফারেন্স_ধরে_রাখো(সেল) {
    ধরি কাউন্ট = মেমরি_পড়ো(সেল, ০)
    কাউন্ট = কাউন্ট + ১
    মেমরি_লেখো(সেল, ০, কাউন্ট)
    ফেরত কাউন্ট
}

// ৯. রেফারেন্স কাউন্ট হ্রাসকরণ (কাউন্ট ০ হলে স্বয়ংক্রিয়ভাবে মুক্তযোগ্য)
ফাংশন রেফারেন্স_ছেড়ে_দাও(সেল) {
    ধরি কাউন্ট = মেমরি_পড়ো(সেল, ০)
    যদি কাউন্ট > ০ {
        কাউন্ট = কাউন্ট - ১
        মেমরি_লেখো(সেল, ০, কাউন্ট)
    }
    ফেরত কাউন্ট
}

// ১০. রেফারেন্স সেলের বর্তমান মান পাঠ
ফাংশন রেফারেন্স_মান(সেল) {
    ফেরত মেমরি_পড়ো(সেল, ৮)
}
