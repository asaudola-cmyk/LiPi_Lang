// 📜 লিপি স্ট্যান্ডার্ড স্ট্রিং ও কনসোল ডেকোরেশন লাইব্রেরি (Pure Lipi String & Terminal UI Library)
// 🎨 এএনএসআই ট্রু-কালার (ANSI TrueColor) ও ইউটিএফ-৮ ফরম্যাটিং রুটিন

// ১. রঙিন শিরোনাম মুদ্রণ
কাজ রঙিন_শিরোনাম(শিরোনাম) {
    দেখাও "\033[1;36m=== " + শিরোনাম + " ===\033[0m"
}

// ২. সবুজ রঙের সাফল্য বার্তা মুদ্রণ
কাজ সফলতা_বার্তা(বার্তা) {
    দেখাও "\033[1;32m[সাফল্য ✔] \033[0m" + বার্তা
}

// ৩. সায়ান রঙের তথ্য বার্তা মুদ্রণ
কাজ তথ্য_বার্তা(বার্তা) {
    দেখাও "\033[1;36m[তথ্য ℹ] \033[0m" + বার্তা
}

// ৪. হলুদ রঙের সতর্কতা বার্তা মুদ্রণ
কাজ সতর্ক_বার্তা(বার্তা) {
    দেখাও "\033[1;33m[সতর্কতা ⚠] \033[0m" + বার্তা
}

// ৫. লাল রঙের ত্রুটি বার্তা মুদ্রণ
কাজ ভুল_বার্তা(বার্তা) {
    দেখাও "\033[1;31m[ত্রুটি ✖] \033[0m" + বার্তা
}

// ৬. স্ট্রিং দৈর্ঘ্য নির্ণয় (String Byte Length via builtin দৈর্ঘ্য)
// WHY: স্ট্রিং ভেরিয়েবল বা লিটারেলের ইউটিএফ-৮ বাইট সাইজ রিটার্ন করে।
কাজ স্ট্রিং_দৈর্ঘ্য(লেখা) {
    ধরি d = দৈর্ঘ্য(লেখা)
    ফেরত d
}

// ৭. স্ট্রিং খালি কিনা যাচাই (Check if string is empty)
কাজ স্ট্রিং_খালি_কিনা(লেখা) {
    ধরি d = দৈর্ঘ্য(লেখা)
    যদি d == ০ {
        ফেরত ১
    }
    ফেরত ০
}
