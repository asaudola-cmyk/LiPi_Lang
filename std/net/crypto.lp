// ==============================================================================
// 👑 LIPI STANDARD LIBRARY: HARDWARE CRYPTOGRAPHY & SHA-256 (std/crypto.lp)
// ⚡ 100% Sovereign NIST FIPS 180-4 Engine | Hardware CPU Entropy | Zero Libc
// ==============================================================================

// WHY: Cryptographic hashing and entropy generation must be entirely sovereign.
// This library implements the full NIST SHA-256 algorithm with single-cycle
// ror32 CPU instructions, bitwise logic, and RDRAND hardware entropy.

অন্তর্ভুক্ত "std/mem.lp"

// ১. ক্রিপ্টোগ্রাফিক হার্ডওয়্যার সিলিকন র‍্যান্ডম ইন্টিজার জেনারেটর
ফাংশন সিলিকন_র্যান্ডম_সংখ্যা() {
    ধরি r = সিলিকন_র্যান্ডম()
    ফেরত r
}

// ২. হেক্সাডেসিমেল ক্যারেক্টার ম্যাপার (০-১৫ নিবল থেকে ASCII কোড)
ফাংশন নিবল_থেকে_হেক্স(নিবল) {
    ধরি n = নিবল & 15
    যদি n < 10 {
        ফেরত 48 + n // ASCII "0" - "9"
    }
    ফেরত 97 + (n - 10) // ASCII "a" - "f"
}

// ৩. SHA-256 রাউন্ড কনস্ট্যান্ট ইনিশিয়ালাইজার (K[0..63])
ফাংশন sha256_কনস্ট্যান্ট_ইনিট(কে_মেমরি) {
    মেমরি_লেখো(কে_মেমরি, 0, 0x428a2f98)
    মেমরি_লেখো(কে_মেমরি, 8, 0x71374491)
    মেমরি_লেখো(কে_মেমরি, 16, 0xb5c0fbcf)
    মেমরি_লেখো(কে_মেমরি, 24, 0xe9b5dba5)
    মেমরি_লেখো(কে_মেমরি, 32, 0x3956c25b)
    মেমরি_লেখো(কে_মেমরি, 40, 0x59f111f1)
    মেমরি_লেখো(কে_মেমরি, 48, 0x923f82a4)
    মেমরি_লেখো(কে_মেমরি, 56, 0xab1c5ed5)
    মেমরি_লেখো(কে_মেমরি, 64, 0xd807aa98)
    মেমরি_লেখো(কে_মেমরি, 72, 0x12835b01)
    মেমরি_লেখো(কে_মেমরি, 80, 0x243185be)
    মেমরি_লেখো(কে_মেমরি, 88, 0x550c7dc3)
    মেমরি_লেখো(কে_মেমরি, 96, 0x72be5d74)
    মেমরি_লেখো(কে_মেমরি, 104, 0x80deb1fe)
    মেমরি_লেখো(কে_মেমরি, 112, 0x9bdc06a7)
    মেমরি_লেখো(কে_মেমরি, 120, 0xc19bf174)
    মেমরি_লেখো(কে_মেমরি, 128, 0xe49b69c1)
    মেমরি_লেখো(কে_মেমরি, 136, 0xefbe4786)
    মেমরি_লেখো(কে_মেমরি, 144, 0xfc19dc6)
    মেমরি_লেখো(কে_মেমরি, 152, 0x240ca1cc)
    মেমরি_লেখো(কে_মেমরি, 160, 0x2de92c6f)
    মেমরি_লেখো(কে_মেমরি, 168, 0x4a7484aa)
    মেমরি_লেখো(কে_মেমরি, 176, 0x5cb0a9dc)
    মেমরি_লেখো(কে_মেমরি, 184, 0x76f988da)
    মেমরি_লেখো(কে_মেমরি, 192, 0x983e5152)
    মেমরি_লেখো(কে_মেমরি, 200, 0xa831c66d)
    মেমরি_লেখো(কে_মেমরি, 208, 0xb00327c8)
    মেমরি_লেখো(কে_মেমরি, 216, 0xbf597fc7)
    মেমরি_লেখো(কে_মেমরি, 224, 0xc6e00bf3)
    মেমরি_লেখো(কে_মেমরি, 232, 0xd5a79147)
    মেমরি_লেখো(কে_মেমরি, 240, 0x6ca6351)
    মেমরি_লেখো(কে_মেমরি, 248, 0x14292967)
    মেমরি_লেখো(কে_মেমরি, 256, 0x27b70a85)
    মেমরি_লেখো(কে_মেমরি, 264, 0x2e1b2138)
    মেমরি_লেখো(কে_মেমরি, 272, 0x4d2c6dfc)
    মেমরি_লেখো(কে_মেমরি, 280, 0x53380d13)
    মেমরি_লেখো(কে_মেমরি, 288, 0x650a7354)
    মেমরি_লেখো(কে_মেমরি, 296, 0x766a0abb)
    মেমরি_লেখো(কে_মেমরি, 304, 0x81c2c92e)
    মেমরি_লেখো(কে_মেমরি, 312, 0x92722c85)
    মেমরি_লেখো(কে_মেমরি, 320, 0xa2bfe8a1)
    মেমরি_লেখো(কে_মেমরি, 328, 0xa81a664b)
    মেমরি_লেখো(কে_মেমরি, 336, 0xc24b8b70)
    মেমরি_লেখো(কে_মেমরি, 344, 0xc76c51a3)
    মেমরি_লেখো(কে_মেমরি, 352, 0xd192e819)
    মেমরি_লেখো(কে_মেমরি, 360, 0xd6990624)
    মেমরি_লেখো(কে_মেমরি, 368, 0xf40e3585)
    মেমরি_লেখো(কে_মেমরি, 376, 0x106aa070)
    মেমরি_লেখো(কে_মেমরি, 384, 0x19a4c116)
    মেমরি_লেখো(কে_মেমরি, 392, 0x1e376c08)
    মেমরি_লেখো(কে_মেমরি, 400, 0x2748774c)
    মেমরি_লেখো(কে_মেমরি, 408, 0x34b0bcb5)
    মেমরি_লেখো(কে_মেমরি, 416, 0x391c0cb3)
    মেমরি_লেখো(কে_মেমরি, 424, 0x4ed8aa4a)
    মেমরি_লেখো(কে_মেমরি, 432, 0x5b9cca4f)
    মেমরি_লেখো(কে_মেমরি, 440, 0x682e6ff3)
    মেমরি_লেখো(কে_মেমরি, 448, 0x748f82ee)
    মেমরি_লেখো(কে_মেমরি, 456, 0x78a5636f)
    মেমরি_লেখো(কে_মেমরি, 464, 0x84c87814)
    মেমরি_লেখো(কে_মেমরি, 472, 0x8cc70208)
    মেমরি_লেখো(কে_মেমরি, 480, 0x90befffa)
    মেমরি_লেখো(কে_মেমরি, 488, 0xa4506ceb)
    মেমরি_লেখো(কে_মেমরি, 496, 0xbef9a3f7)
    মেমরি_লেখো(কে_মেমরি, 504, 0xc67178f2)
    ফেরত কে_মেমরি
}

// ৪. SHA-256 কম্প্রেশন ফাংশন উপাদানসমূহ
ফাংশন sha256_ch(x, y, z) {
    ফেরত z ^ (x & (y ^ z))
}

ফাংশন sha256_maj(x, y, z) {
    ফেরত (x & y) ^ ((x ^ y) & z)
}

ফাংশন sha256_sigma0(x) {
    ফেরত ror32(x, 2) ^ ror32(x, 13) ^ ror32(x, 22)
}

ফাংশন sha256_sigma1(x) {
    ফেরত ror32(x, 6) ^ ror32(x, 11) ^ ror32(x, 25)
}

ফাংশন sha256_gamma0(x) {
    ফেরত ror32(x, 7) ^ ror32(x, 18) ^ (x >> 3)
}

ফাংশন sha256_gamma1(x) {
    ফেরত ror32(x, 17) ^ ror32(x, 19) ^ (x >> 10)
}

// ৫. পূর্ণাঙ্গ SHA-256 হ্যাশিং ইঞ্জিন
// মেসেজ পয়েন্টার এবং দৈর্ঘ্য নিয়ে ৬৪-ক্যারেক্টার হেক্স ডাইজেস্ট আউটপুট বাফারে লেখে
ফাংশন sha256_হ্যাশ(মেসেজ_পয়েন্টার, দৈর্ঘ্য, আউটপুট_বাফার) {
    // কে কনস্ট্যান্ট মেমরি পুল বরাদ্দ (৬৪ x ৮ = ৫১২ বাইট)
    ধরি কে_পুল = মেমরি_বরাদ্দ(৫১২)
    sha256_কনস্ট্যান্ট_ইনিট(কে_পুল)

    // প্যাডিং সাইজ নির্ধারণ: দৈর্ঘ্য + ১ (0x80) + ৮ (দৈর্ঘ্য বিট)
    // ৬৪ বাইটের ব্লকে রাউন্ড-আপ
    ধরি প্যাডেড_দৈর্ঘ্য = ((দৈর্ঘ্য + 9 + 63) / 64) * 64
    ধরি প্যাডেড_বাফার = মেমরি_বরাদ্দ(প্যাডেড_দৈর্ঘ্য + 64)
    মেমরি_পূরণ(প্যাডেড_বাফার, 0, প্যাডেড_দৈর্ঘ্য + 64)

    // মেসেজ বাইট অনুলিপি
    ধরি i = 0
    যতক্ষণ i < দৈর্ঘ্য {
        ধরি b = মেমরি_বাইট_পড়ো(মেসেজ_পয়েন্টার, i)
        মেমরি_বাইট_লেখো(প্যাডেড_বাফার, i, b)
        i = i + 1
    }

    // 0x80 বাইট অ্যাপেন্ড
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, দৈর্ঘ্য, 128)

    // মোট দৈর্ঘ্য বিটে হিসাব (Big-Endian 64-bit integer at the end of block)
    ধরি মোট_বিট = দৈর্ঘ্য * 8
    ধরি লেন_অফসেট = প্যাডেড_দৈর্ঘ্য - 8
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 7, মোট_বিট & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 6, (মোট_বিট >> 8) & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 5, (মোট_বিট >> 16) & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 4, (মোট_বিট >> 24) & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 3, (মোট_বিট >> 32) & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 2, (মোট_বিট >> 40) & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 1, (মোট_বিট >> 48) & 255)
    মেমরি_বাইট_লেখো(প্যাডেড_বাফার, লেন_অফসেট + 0, (মোট_বিট >> 56) & 255)

    // প্রাথমিক হ্যাশ স্টেট (H0 .. H7)
    ধরি h0 = 0x6a09e667
    ধরি h1 = 0xbb67ae85
    ধরি h2 = 0x3c6ef372
    ধরি h3 = 0xa54ff53a
    ধরি h4 = 0x510e527f
    ধরি h5 = 0x9b05688c
    ধরি h6 = 0x1f83d9ab
    ধরি h7 = 0x5be0cd19

    // মেসেজ শিডিউল বাফার W (৬৪টি ৩২-বিট শব্দ = ৫১২ বাইট)
    ধরি w_বাফার = মেমরি_বরাদ্দ(512)

    // প্রতিটি ৫১২-বিট (৬৪ বাইট) ব্লকে প্রসেসিং
    ধরি ব্লক_অফসেট = 0
    যতক্ষণ ব্লক_অফসেট < প্যাডেড_দৈর্ঘ্য {
        // ১. প্রথম ১৬টি শব্দ W[0..15] গঠন (Big-endian unpacking)
        ধরি t = 0
        যতক্ষণ t < 16 {
            ধরি বো = ব্লক_অফসেট + (t * 4)
            ধরি b0 = মেমরি_বাইট_পড়ো(প্যাডেড_বাফার, বো)
            ধরি b1 = মেমরি_বাইট_পড়ো(প্যাডেড_বাফার, বো + 1)
            ধরি b2 = মেমরি_বাইট_পড়ো(প্যাডেড_বাফার, বো + 2)
            ধরি b3 = মেমরি_বাইট_পড়ো(প্যাডেড_বাফার, বো + 3)
            ধরি শব্দ = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
            মেমরি_লেখো(w_বাফার, t * 8, শব্দ)
            t = t + 1
        }

        // ২. W[16..63] শিডিউল এক্সপ্যানশন
        যতক্ষণ t < 64 {
            ধরি w_t2 = মেমরি_পড়ো(w_বাফার, (t - 2) * 8)
            ধরি w_t7 = মেমরি_পড়ো(w_বাফার, (t - 7) * 8)
            ধরি w_t15 = মেমরি_পড়ো(w_বাফার, (t - 15) * 8)
            ধরি w_t16 = মেমরি_পড়ো(w_বাফার, (t - 16) * 8)

            ধরি s1 = sha256_gamma1(w_t2)
            ধরি s0 = sha256_gamma0(w_t15)
            ধরি w_নতুন = (s1 + w_t7 + s0 + w_t16) & 0xffffffff
            মেমরি_লেখো(w_বাফার, t * 8, w_নতুন)
            t = t + 1
        }

        // ৩. ওয়ার্কিং ভ্যারিয়েবল ইনিশিয়ালাইজেশন
        ধরি a = h0
        ধরি b = h1
        ধরি c = h2
        ধরি d = h3
        ধরি e = h4
        ধরি f = h5
        ধরি g = h6
        ধরি h = h7

        // ৪. ৬৪ রাউন্ড মিক্সিং ও কম্প্রেশন
        t = 0
        যতক্ষণ t < 64 {
            ধরি s1 = sha256_sigma1(e)
            ধরি ch = sha256_ch(e, f, g)
            ধরি kt = মেমরি_পড়ো(কে_পুল, t * 8)
            ধরি wt = মেমরি_পড়ো(w_বাফার, t * 8)
            ধরি temp1 = (h + s1 + ch + kt + wt) & 0xffffffff

            ধরি s0 = sha256_sigma0(a)
            ধরি maj = sha256_maj(a, b, c)
            ধরি temp2 = (s0 + maj) & 0xffffffff

            h = g
            g = f
            f = e
            e = (d + temp1) & 0xffffffff
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 0xffffffff

            t = t + 1
        }

        // ৫. ইন্টারমিডিয়েট হ্যাশ মান আপডেট
        h0 = (h0 + a) & 0xffffffff
        h1 = (h1 + b) & 0xffffffff
        h2 = (h2 + c) & 0xffffffff
        h3 = (h3 + d) & 0xffffffff
        h4 = (h4 + e) & 0xffffffff
        h5 = (h5 + f) & 0xffffffff
        h6 = (h6 + g) & 0xffffffff
        h7 = (h7 + h) & 0xffffffff

        ব্লক_অফসেট = ব্লক_অফসেট + 64
    }

    // ৬. ৬৪-ক্যারেক্টার হেক্স ফরম্যাটিং (H0 .. H7)
    ধরি h_অ্যারে = মেমরি_বরাদ্দ(64)
    মেমরি_লেখো(h_অ্যারে, 0, h0)
    মেমরি_লেখো(h_অ্যারে, 8, h1)
    মেমরি_লেখো(h_অ্যারে, 16, h2)
    মেমরি_লেখো(h_অ্যারে, 24, h3)
    মেমরি_লেখো(h_অ্যারে, 32, h4)
    মেমরি_লেখো(h_অ্যারে, 40, h5)
    মেমরি_লেখো(h_অ্যারে, 48, h6)
    মেমরি_লেখো(h_অ্যারে, 56, h7)

    ধরি আউট_পজ = 0
    ধরি k = 0
    যতক্ষণ k < 8 {
        ধরি val = মেমরি_পড়ো(h_অ্যারে, k * 8)
        ধরি nib = 7
        যতক্ষণ nib >= 0 {
            ধরি shift = nib * 4
            ধরি ch = নিবল_থেকে_হেক্স(val >> shift)
            মেমরি_বাইট_লেখো(আউটপুট_বাফার, আউট_পজ, ch)
            আউট_পজ = আউট_পজ + 1
            nib = nib - 1
        }
        k = k + 1
    }
    মেমরি_বাইট_লেখো(আউটপুট_বাফার, 64, 0) // Null terminator

    ফেরত আউটপুট_বাফার
}
