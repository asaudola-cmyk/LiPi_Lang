// 📜 লিপি টার্মিনাল ইউআই ইঞ্জিন (Pure Lipi ANSI TUI Engine)
// 🏛️ সরাসরি লিনাক্স স্টিকি টার্মিনাল, ডাবল-বাফারিং এবং ANSI এস্কেপ সিকোয়েন্স
// ০% ncurses, ০% HTML, ০% JS নির্ভরতা

// ১. ক্যানভাস বাফার বরাদ্দ (Allocate Framebuffer for TUI)
// WHY: স্ক্রিন ফ্লিকারিং (flickering) এড়ানোর জন্য মেমরিতে ফ্রেম তৈরি করে একসাথে রেন্ডার করা।
fn ক্যানভাস_তৈরি প্রস্থ উচ্চতা
    আকার = প্রস্থ * উচ্চতা
    পয়েন্টার = সিসকল(9, 0, আকার, 3, 34, -1, 0)
    // 32 = Space ' ' (খালি ক্যানভাস)
    কার্সর = 0
    while কার্সর < আকার
        মেমরি_বাইট_লেখো(পয়েন্টার, কার্সর, 32)
        কার্সর = কার্সর + 1
    return পয়েন্টার

// ২. ক্যানভাসে ক্যারেক্টার আঁকা (Draw Character on Buffer)
// WHY: X এবং Y কো-অর্ডিনেট অনুযায়ী ক্যানভাসের নির্দিষ্ট স্থানে ডেটা বসানো।
fn ক্যানভাস_পিক্সেল ক্যানভাস প্রস্থ এক্স ওয়াই ক্যারেক্টার
    সূচক = (ওয়াই * প্রস্থ) + এক্স
    মেমরি_বাইট_লেখো(ক্যানভাস, সূচক, ক্যারেক্টার)
    return সূচক

// ৩. টার্মিনাল পরিষ্কার করা (Clear ANSI Terminal)
// WHY: ফ্রেম রেন্ডার করার আগে পুরো টার্মিনাল স্ক্রিন মুছে ফেলা।
fn টার্মিনাল_পরিষ্কার
    say "\033[2J\033[H"
    return 1

// ৪. কার্সর লুকানো (Hide Terminal Cursor)
fn কার্সর_লুকাও
    say "\033[?25l"
    return 1

// ৫. কার্সর দেখানো (Show Terminal Cursor)
fn কার্সর_দেখাও
    say "\033[?25h"
    return 1

// ৬. ক্যানভাস সরাসরি টার্মিনালে রেন্ডার করা (Render Buffer via SYS_write)
// WHY: একসাথে সম্পূর্ণ ফ্রেম টার্মিনালে পুশ করে 60FPS অর্জন করা।
fn ক্যানভাস_রেন্ডার ক্যানভাস আকার
    টার্মিনাল_পরিষ্কার()
    // SYS_write (1) -> fd (1 = stdout)
    সিসকল(1, 1, ক্যানভাস, আকার)
    say "" // Flush line
    return আকার

// ৭. মাউস ট্র্যাকিং চালু করা (Enable ANSI Mouse Tracking SGR 1006)
fn মাউস_ট্র্যাকিং_চালু()
    say "\033[?1000h\033[?1006h"
    return 1

// ৮. মাউস ট্র্যাকিং বন্ধ করা (Disable ANSI Mouse Tracking)
fn মাউস_ট্র্যাকিং_বন্ধ()
    say "\033[?1006l\033[?1000l"
    return 1
