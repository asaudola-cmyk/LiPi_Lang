// ==============================================================================
// 🌍 লিপি মাল্টিলিঙ্গুয়াল কীওয়ার্ড প্যাক
// লিপি প্রথম ১.০ | সংকেতনাম: সোভেরিন
// File: std/multilang.lp
//
// WHY এই মডিউল:
//   Plan Phase 5.3 — "মাল্টিলিঙ্গুয়াল ওয়ার্ল্ড ডমিনেশন"
//   8 billion people should code in their mother tongue.
//   This module defines keyword aliases for future multilingual support.
//
// সমর্থিত ভাষাসমূহ (ভবিষ্যৎ):
//   বাংলা (Bengali)     ✅ Native — প্রথম ১.০
//   हिंदी (Hindi)       🔜 v2.0
//   العربية (Arabic)    🔜 v2.1
//   中文 (Chinese)      🔜 v2.2
//   Español (Spanish)   🔜 v2.3
//   Français (French)   🔜 v2.4
//   Русский (Russian)   🔜 v2.6
//   日本語 (Japanese)   🔜 v2.7
//   한국어 (Korean)     🔜 v2.8
// ==============================================================================

অন্তর্ভুক্ত "std/version.lp"

// ─── Keyword Translation Table ────────────────────────────────────────────────
// লিপির মূল বাংলা কীওয়ার্ড → অন্যান্য ভাষা

// WHY: Even English programmers can use লিপি via English keywords
// English aliases (already supported in compiler)
// if          → যদি
// else        → নাহলে
// while       → যতক্ষণ
// for         → প্রতিটি/ভেতরে
// return      → ফেরত
// function    → কাজ
// let/var     → ধরি
// struct      → গঠন
// include     → অন্তর্ভুক্ত
// show/print  → দেখাও

// ─── Hindi (হিন্দি) — v2.0 ──────────────────────────────────────────────────
// যদি    → यदि
// নাহলে  → अन्यथा
// যতক্ষণ → जबतक
// ফেরত   → वापस
// কাজ    → काम
// ধরি    → धारण
// গঠন    → संरचना
// দেখাও  → दिखाओ

// ─── Arabic (আরবি) — v2.1 ───────────────────────────────────────────────────
// যদি    → إذا
// নাহলে  → وإلا
// যতক্ষণ → طالما
// ফেরত   → أعد
// কাজ    → دالة
// ধরি    → دع
// দেখাও  → أظهر

// ─── Spanish (স্প্যানিশ) — v2.3 ─────────────────────────────────────────────
// যদি    → si
// নাহলে  → sino
// যতক্ষণ → mientras
// ফেরত   → retornar
// কাজ    → función
// ধরি    → sea
// দেখাও  → mostrar

// ─── Keyword info functions ───────────────────────────────────────────────────
কাজ LANG_সংখ্যা(ভাষা_কোড) {
    // WHY: Return count of languages supported in this build
    যদি ভাষা_কোড == ১ { ফেরত ১ }  // Bengali only in v1.0
    ফেরত ১
}

কাজ LANG_তালিকা_দেখাও() {
    দেখাও "লিপি সমর্থিত ভাষাসমূহ:"
    দেখাও ""
    দেখাও "  প্রকাশিত:"
    দেখাও "  ✅  বাংলা (Bengali)   — লিপি প্রথম ১.০"
    দেখাও ""
    দেখাও "  পরিকল্পিত:"
    দেখাও "  🔜  हिंदी (Hindi)      — লিপি ২.০"
    দেখাও "  🔜  العربية (Arabic)   — লিপি ২.১"
    দেখাও "  🔜  中文 (Chinese)     — লিপি ২.২"
    দেখাও "  🔜  Español (Spanish)  — লিপি ২.৩"
    দেখাও "  🔜  Français (French)  — লিপি ২.৪"
    দেখাও "  🔜  Português          — লিপি ২.৫"
    দেখাও "  🔜  Русский (Russian)  — লিপি ২.৬"
    দেখাও "  🔜  日本語 (Japanese)  — লিপি ২.৭"
    দেখাও "  🔜  한국어 (Korean)    — লিপি ২.৮"
    দেখাও "  🔜  Kiswahili (Africa) — লিপি ৩.০"
    দেখাও ""
    দেখাও "লক্ষ্য: ৮ বিলিয়ন মানুষ নিজের ভাষায় কোড লিখতে পারবে।"
    দেখাও "সংস্করণ:", LIPI_সংস্করণ
    ফেরত ০
}

// ─── Bengali Locale ───────────────────────────────────────────────────────────
কাজ বাংলা_তারিখ(বছর, মাস, দিন) {
    // WHY: Native Bengali date formatting (বাংলাদেশ/ভারত standard)
    ধরি মাসের_নাম = "???"
    যদি মাস == ১ { মাসের_নাম = "জানুয়ারি" }
    যদি মাস == ২ { মাসের_নাম = "ফেব্রুয়ারি" }
    যদি মাস == ৩ { মাসের_নাম = "মার্চ" }
    যদি মাস == ৪ { মাসের_নাম = "এপ্রিল" }
    যদি মাস == ৫ { মাসের_নাম = "মে" }
    যদি মাস == ৬ { মাসের_নাম = "জুন" }
    যদি মাস == ৭ { মাসের_নাম = "জুলাই" }
    যদি মাস == ৮ { মাসের_নাম = "আগস্ট" }
    যদি মাস == ৯ { মাসের_নাম = "সেপ্টেম্বর" }
    যদি মাস == ১০ { মাসের_নাম = "অক্টোবর" }
    যদি মাস == ১১ { মাসের_নাম = "নভেম্বর" }
    যদি মাস == ১২ { মাসের_নাম = "ডিসেম্বর" }

    দেখাও বাংলা_সংখ্যা(দিন), মাসের_নাম, বাংলা_সংখ্যা(বছর)
    ফেরত ০
}

কাজ বাংলা_সময়(ঘন্টা, মিনিট) {
    ধরি সময়_নাম = "রাত"
    যদি ঘন্টা >= ৬ { সময়_নাম = "সকাল" }
    যদি ঘন্টা >= ১২ { সময়_নাম = "দুপুর" }
    যদি ঘন্টা >= ১৬ { সময়_নাম = "বিকেল" }
    যদি ঘন্টা >= ১৯ { সময়_নাম = "সন্ধ্যা" }
    যদি ঘন্টা >= ২১ { সময়_নাম = "রাত" }

    দেখাও সময়_নাম, বাংলা_সংখ্যা(ঘন্টা), "টা", বাংলা_সংখ্যা(মিনিট), "মিনিট"
    ফেরত ০
}

কাজ বাংলা_বার(day_of_week) {
    যদি day_of_week == ০ { দেখাও "রবিবার" }
    যদি day_of_week == ১ { দেখাও "সোমবার" }
    যদি day_of_week == ২ { দেখাও "মঙ্গলবার" }
    যদি day_of_week == ৩ { দেখাও "বুধবার" }
    যদি day_of_week == ৪ { দেখাও "বৃহস্পতিবার" }
    যদি day_of_week == ৫ { দেখাও "শুক্রবার" }
    যদি day_of_week == ৬ { দেখাও "শনিবার" }
    ফেরত ০
}
