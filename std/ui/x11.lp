// 📜 লিপি X11 নেটিভ উইন্ডো ইঞ্জিন (Pure Lipi X11 Windowing Protocol)
// 🏛️ GTK, Qt বা Xlib ছাড়াই সরাসরি UNIX ডোমেইন সকেটের মাধ্যমে গ্রাফিক্যাল উইন্ডো!
// ইনোভেশন: /tmp/.X11-unix/X0 সকেটে সরাসরি বাইনারি প্যাকেট পাঠিয়ে হার্ডওয়্যার এক্সিলারেশন।

অন্তর্ভুক্ত "std/mem.lp"

// ১. X11 সার্ভারের সাথে UNIX Socket এ কানেক্ট করা
// WHY: Xlib এর পরাধীনতা দূর করে আমরা সরাসরি X Server-এর সাথে কথা বলছি।
কাজ এক্স১১_কানেক্ট() {
    // SYS_socket (41): AF_UNIX (1), SOCK_STREAM (1), 0
    ধরি সকেট_এফডি = সিসকল(৪১, ১, ১, ০)
    যদি সকেট_এফডি < ০ {
        দেখাও "❌ UNIX সকেট তৈরি ব্যর্থ!"
        ফেরত -১
    }
    
    // sockaddr_un (sun_family = 1, sun_path = "/tmp/.X11-unix/X0")
    // মেমরিতে 110 বাইট বরাদ্দ
    ধরি সকঅ্যাড্রেস = সিসকল(৯, ০, ১১০, ৩, ৩৪, -১, ০)
    মেমরি_পূরণ(সকঅ্যাড্রেস, ০, ১১০)
    
    // sun_family = AF_UNIX (1) -> 16-bit (2 bytes)
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ০, ১)
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১, ০)
    
    // sun_path = "/tmp/.X11-unix/X0"
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ২, ৪৭) // '/'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৩, ১১৬) // 't'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৪, ১০৯) // 'm'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৫, ১১২) // 'p'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৬, ৪৭) // '/'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৭, ৪৬) // '.'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৮, ৮৮) // 'X'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ৯, ৪৯) // '1'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১০, ৪৯) // '1'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১১, ৪৫) // '-'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১২, ۱১৭) // 'u'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১২, ১১৭) // 'u'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৩, ১১০) // 'n'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৪, ১০৫) // 'i'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৫, ۱২০) // 'x'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৫, ১২০) // 'x'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৬, ৪৭) // '/'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৭, ৮৮) // 'X'
    মেমরি_বাইট_লেখো(সকঅ্যাড্রেস, ১৮, ৪৮) // '0'
    
    // SYS_connect (42): fd, sockaddr, addrlen (110)
    ধরি স্ট্যাটাস = সিসকল(৪২, সকেট_এফডি, সকঅ্যাড্রেস, ১১০)
    
    সিসকল(১১, সকঅ্যাড্রেস, ১১০) // মেমরি রিলিজ
    
    যদি স্ট্যাটাস < ০ {
        দেখাও "❌ X11 সার্ভারে কানেক্ট করতে ব্যর্থ (X0 নেই)!"
        ফেরত -১
    }
    
    ফেরত সকেট_এফডি
}

// ২. কানেকশন সেটআপ (X11 Connection Setup Packet)
// WHY: X11 সার্ভারকে বলতে হবে যে আমরা লিটল-এন্ডিয়ান (l) এবং ভার্সন 11.0 ব্যবহার করছি।
কাজ এক্স১১_সেটআপ(সকেট_এফডি) {
    ধরি প্যাকেট = সিসকল(৯, ০, ১২, ৩, ৩৪, -১, ০)
    
    // Byte-order: 'l' = 108 (0x6c) - Little Endian
    মেমরি_বাইট_লেখো(প্যাকেট, ০, ১০৮)
    
    // Protocol major version = 11 (0x0b)
    মেমরি_বাইট_লেখো(প্যাকেট, ২, ১১)
    মেমরি_বাইট_লেখো(প্যাকেট, ৩, ০)
    
    // Protocol minor version = 0
    মেমরি_বাইট_লেখো(প্যাকেট, ৪, ০)
    মেমরি_বাইট_লেখো(প্যাকেট, ৫, ০)
    
    // Auth name & data len = 0 (16-bit 0)
    মেমরি_বাইট_লেখো(প্যাকেট, ৬, ০)
    মেমরি_বাইট_লেখো(প্যাকেট, ৭, ০)
    মেমরি_বাইট_লেখো(প্যাকেট, ৮, ০)
    মেমরি_বাইট_লেখো(প্যাকেট, ৯, ০)
    মেমরি_বাইট_লেখো(প্যাকেট, ১০, ০)
    মেমরি_বাইট_লেখো(প্যাকেট, ১১, ০)
    
    // SYS_sendto (44): fd, buf, len, flags, dest_addr, addrlen
    সিসকল(৪৪, সকেট_এফডি, প্যাকেট, ১২, ০, ০, ০)
    সিসকল(১১, প্যাকেট, ১২)
    
    // সার্ভার থেকে রেসপন্স পড়া (SYS_recvfrom = 45)
    // রেসপন্সে Root Window ID এবং Resource Base থাকে যা উইন্ডো তৈরির জন্য লাগবে।
    ধরি রেসপন্স = সিসকল(৯, ০, ৪০৯৬, ৩, ৩৪, -১, ০)
    ধরি পঠিত_বাইট = সিসকল(৪৫, সকেট_এফডি, রেসপন্স, ৪০৯৬, ০, ০, ০)
    
    যদি পঠিত_বাইট < ৮ {
        দেখাও "❌ X11 সার্ভার থেকে সঠিক রেসপন্স পাওয়া যায়নি!"
        ফেরত -১
    }
    
    // রেসপন্সের প্রথম বাইট: 1 = Success, 0 = Failed, 2 = Authenticate
    ধরি স্ট্যাটাস = মেমরি_বাইট_পড়ো(রেসপন্স, ০)
    যদি স্ট্যাটাস != ১ {
        দেখাও "❌ X11 কানেকশন সেটআপ ব্যর্থ! স্ট্যাটাস কোড: " + স্ট্যাটাস
        ফেরত -১
    }
    
    // Resource ID Base (Offset 12 in X11 Setup Reply)
    // 32-bit ID base
    ধরি বেস০ = মেমরি_বাইট_পড়ো(রেসপন্স, ১২)
    ধরি বেস১ = মেমরি_বাইট_পড়ো(রেসপন্স, ১৩)
    ধরি বেস২ = মেমরি_বাইট_পড়ো(রেসপন্স, ১৪)
    ধরি বেস৩ = মেমরি_বাইট_পড়ো(রেসপন্স, ১৫)
    ধরি রিসোর্স_বেস = বেস০ + (বেস১ * ২৫৬) + (বেস২ * ৬৫৫৩৬) + (বেস৩ * ১৬৭৭৭২১৬)
    
    দেখাও "✅ X11 কানেকশন সফল! Resource Base ID: " + রিসোর্স_বেস
    
    ফেরত রেসপন্স // পয়েন্টার ফেরত দিচ্ছি
}
