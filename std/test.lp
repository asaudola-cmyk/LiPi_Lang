// ==============================================================================
// 🧪 লিপি টেস্টিং ফ্রেমওয়ার্ক (pytest + Jest Killer)
// লিপি প্রথম ১.০ | সংকেতনাম: সোভেরিন
// File: std/test.lp
//
// WHY এই মডিউল:
//   Testing is not optional for production code.
//   pytest (Python), Jest (JS), Google Test (C++) — এদের replace করবে।
//   
// ব্যবহার:
//   অন্তর্ভুক্ত "std/test.lp"
//   TEST_শুরু("আমার টেস্ট স্যুট")
//   ASSERT_সমান(ফু(৪২), ৮৪, "দ্বিগুণ কাজ করছে")
//   ASSERT_সত্য(x > ০, "x ধনাত্মক হতে হবে")
//   TEST_শেষ()
// ==============================================================================

অন্তর্ভুক্ত "std/core/mem.lp"
অন্তর্ভুক্ত "std/core/io.lp"
অন্তর্ভুক্ত "std/version.lp"

// ─── Test stats ───────────────────────────────────────────────────────────────
ধরি TEST_পাস_গণনা  = ০
ধরি TEST_ফেল_গণনা  = ০
ধরি TEST_SKIP_গণনা = ০
ধরি TEST_suite_নাম = ""
ধরি TEST_শুরু_সময়  = ০

// ─── Test Suite ───────────────────────────────────────────────────────────────
কাজ TEST_শুরু(suite_নাম) {
    TEST_suite_নাম = suite_নাম
    TEST_পাস_গণনা = ০
    TEST_ফেল_গণনা = ০
    TEST_SKIP_গণনা = ০
    TEST_শুরু_সময় = সিপিউ_ক্লক()
    দেখাও ""
    দেখাও "\033[1;36m🧪 টেস্ট স্যুট:", suite_নাম, "\033[0m"
    দেখাও "─────────────────────────────────────────────"
}

কাজ TEST_শেষ() {
    ধরি মোট = TEST_পাস_গণনা + TEST_ফেল_গণনা
    ধরি শেষ_সময় = সিপিউ_ক্লক()
    ধরি elapsed = শেষ_সময় - TEST_শুরু_সময়
    দেখাও ""
    দেখাও "─────────────────────────────────────────────"
    দেখাও "\033[1;33mফলাফল:\033[0m"
    দেখাও "  ✅ পাস :", TEST_পাস_গণনা
    দেখাও "  ❌ ফেল :", TEST_ফেল_গণনা
    দেখাও "  ⏭️  skip:", TEST_SKIP_গণনা
    দেখাও "  মোট   :", মোট
    দেখাও "  সময়  :", elapsed, "cycles"
    দেখাও ""
    যদি TEST_ফেল_গণনা == ০ {
        দেখাও "\033[1;32m✅ সব টেস্ট পাস!\033[0m"
        ফেরত ০
    }
    দেখাও "\033[1;31m❌", TEST_ফেল_গণনা, "টি টেস্ট ব্যর্থ!\033[0m"
    ফেরত ১
}

// ─── Assertions ───────────────────────────────────────────────────────────────
কাজ ASSERT_সমান(প্রকৃত, প্রত্যাশিত, বার্তা) {
    যদি প্রকৃত == প্রত্যাশিত {
        TEST_পাস_গণনা = TEST_পাস_গণনা + ১
        দেখাও "  \033[1;32m✔\033[0m", বার্তা
        ফেরত সত্য
    }
    TEST_ফেল_গণনা = TEST_ফেল_গণনা + ১
    দেখাও "  \033[1;31m✗\033[0m", বার্তা
    দেখাও "    প্রত্যাশিত:", প্রত্যাশিত
    দেখাও "    পাওয়া গেছে:", প্রকৃত
    ফেরত মিথ্যা
}

কাজ ASSERT_অসমান(ক, খ, বার্তা) {
    যদি ক != খ {
        TEST_পাস_গণনা = TEST_পাস_গণনা + ১
        দেখাও "  \033[1;32m✔\033[0m", বার্তা
        ফেরত সত্য
    }
    TEST_ফেল_গণনা = TEST_ফেল_গণনা + ১
    দেখাও "  \033[1;31m✗\033[0m", বার্তা, "(মান সমান নয় হওয়া উচিত ছিল)"
    ফেরত মিথ্যা
}

কাজ ASSERT_সত্য(শর্ত, বার্তা) {
    ফেরত ASSERT_সমান(শর্ত, ১, বার্তা)
}

কাজ ASSERT_মিথ্যা(শর্ত, বার্তা) {
    ফেরত ASSERT_সমান(শর্ত, ০, বার্তা)
}

কাজ ASSERT_বড়(ক, খ, বার্তা) {
    যদি ক > খ {
        TEST_পাস_গণনা = TEST_পাস_গণনা + ১
        দেখাও "  \033[1;32m✔\033[0m", বার্তা
        ফেরত সত্য
    }
    TEST_ফেল_গণনা = TEST_ফেল_গণনা + ১
    দেখাও "  \033[1;31m✗\033[0m", বার্তা, "| প্রত্যাশিত:", ক, ">", খ
    ফেরত মিথ্যা
}

কাজ ASSERT_ছোট(ক, খ, বার্তা) {
    যদি ক < খ {
        TEST_পাস_গণনা = TEST_পাস_গণনা + ১
        দেখাও "  \033[1;32m✔\033[0m", বার্তা
        ফেরত সত্য
    }
    TEST_ফেল_গণনা = TEST_ফেল_গণনা + ১
    দেখাও "  \033[1;31m✗\033[0m", বার্তা, "| প্রত্যাশিত:", ক, "<", খ
    ফেরত মিথ্যা
}

কাজ ASSERT_NULL(পয়েন্টার, বার্তা) {
    ফেরত ASSERT_সমান(পয়েন্টার, ০, বার্তা)
}

কাজ ASSERT_NOT_NULL(পয়েন্টার, বার্তা) {
    যদি পয়েন্টার != ০ {
        TEST_পাস_গণনা = TEST_পাস_গণনা + ১
        দেখাও "  \033[1;32m✔\033[0m", বার্তা
        ফেরত সত্য
    }
    TEST_ফেল_গণনা = TEST_ফেল_গণনা + ১
    দেখাও "  \033[1;31m✗\033[0m", বার্তা, "(NULL হওয়া উচিত ছিল না)"
    ফেরত মিথ্যা
}

কাজ ASSERT_range(মান, min, max, বার্তা) {
    // WHY: Check value is within expected range
    যদি মান >= min {
        যদি মান <= max {
            TEST_পাস_গণনা = TEST_পাস_গণনা + ১
            দেখাও "  \033[1;32m✔\033[0m", বার্তা, "| মান:", মান, "∈ [", min, ",", max, "]"
            ফেরত সত্য
        }
    }
    TEST_ফেল_গণনা = TEST_ফেল_গণনা + ১
    দেখাও "  \033[1;31m✗\033[0m", বার্তা, "| মান:", মান, "∉ [", min, ",", max, "]"
    ফেরত মিথ্যা
}

// ─── Test Skip ────────────────────────────────────────────────────────────────
কাজ TEST_skip(কারণ) {
    TEST_SKIP_গণনা = TEST_SKIP_গণনা + ১
    দেখাও "  \033[38;2;128;128;128m⏭  SKIP:", কারণ, "\033[0m"
}

// ─── Benchmark ────────────────────────────────────────────────────────────────
কাজ BENCH_রান(নাম, iterations) {
    // WHY: Measure performance in CPU cycles
    ধরি শুরু = সিপিউ_ক্লক()
    ধরি i = ০
    যতক্ষণ i < iterations {
        i = i + ১
    }
    ধরি শেষ = সিপিউ_ক্লক()
    ধরি মোট = শেষ - শুরু
    ধরি per_iter = মোট / iterations
    দেখাও "  📊 BENCH:", নাম
    দেখাও "    iterations:", iterations
    দেখাও "    মোট cycles:", মোট
    দেখাও "    প্রতি iter :", per_iter, "cycles"
    ফেরত per_iter
}

// ─── Test Reporter ────────────────────────────────────────────────────────────
কাজ TEST_রিপোর্ট_junit(output_পাথ) {
    // WHY: JUnit XML format allows CI systems to parse test results
    দেখাও "  → JUnit XML রিপোর্ট:", output_পাথ
    ধরি fd = ফাইল_তৈরি(output_পাথ)
    ধরি xml = "<?xml version='1.0'?><testsuites></testsuites>"
    ফাইল_লেখো(fd, xml, দৈর্ঘ্য(xml))
    ফাইল_বন্ধ(fd)
    ফেরত ০
}
