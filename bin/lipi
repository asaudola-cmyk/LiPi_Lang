#!/usr/bin/env bash
# ==============================================================================
# 👑 LIPI SOVEREIGN RUNNER (bin/lipi)
# ⚡ 100% Pure Machine Code Execution | 0% C | 0% GCC | 0% Libc | 0% Python
# ==============================================================================

set -euo pipefail

LIPI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LIPI_HOME

VERSION="First 1.0 (প্রথম ১.০) — Sovereign [Pure Native Machine Code]"

# No arguments -> Launch interactive sovereign REPL
if [ $# -eq 0 ]; then
    if [ -x "$LIPI_HOME/bin/lipirepl" ]; then
        exec "$LIPI_HOME/bin/lipirepl"
    else
        echo "Error: Sovereign REPL binary ($LIPI_HOME/bin/lipirepl) not found." >&2
        exit 1
    fi
fi

case "$1" in
    --version|-v)
        echo "Lipi $VERSION"
        exit 0
        ;;
    --help|-h)
        echo "Lipi Programming Language — Sovereign Runner"
        echo "Version: $VERSION"
        echo ""
        echo "Usage:"
        echo "  lipi                     → Launch interactive sovereign REPL"
        echo "  lipi <file.lp> [args...] → Run Lipi source file directly"
        echo "  lipi -e '<code>'         → Evaluate one-liner expression"
        echo "  lipi --version           → Print version"
        echo "  lipi --help              → Show this help message"
        echo ""
        echo "Native Compiler:"
        echo "  lipc <file.lp> -o <bin>  → Compile to standalone ELF64 executable"
        exit 0
        ;;
    -e)
        if [ -z "${2:-}" ]; then
            echo "Error: -e requires code string" >&2
            exit 1
        fi
        TMP_SRC="$(mktemp /tmp/lipi_eval_XXXXXXXX.lp)"
        TMP_BIN="$(mktemp /tmp/lipi_eval_XXXXXXXX)"
        trap "rm -f '$TMP_SRC' '$TMP_BIN'" EXIT
        echo "$2" > "$TMP_SRC"
        "$LIPI_HOME/bin/lipc" "$TMP_SRC" -o "$TMP_BIN" >/dev/null 2>&1
        chmod +x "$TMP_BIN"
        exec "$TMP_BIN" "${@:3}"
        ;;
    *)
        INPUT="$1"
        if [ ! -f "$INPUT" ]; then
            echo "Error: file '$INPUT' not found" >&2
            exit 1
        fi
        TMP_BIN="$(mktemp /tmp/lipi_run_XXXXXXXX)"
        trap "rm -f '$TMP_BIN'" EXIT
        "$LIPI_HOME/bin/lipc" "$INPUT" -o "$TMP_BIN" >/dev/null 2>&1
        chmod +x "$TMP_BIN"
        exec "$TMP_BIN" "${@:2}"
        ;;
esac
