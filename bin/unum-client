#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * 👑 UNUM SOVEREIGN STANDALONE CLIENT CLI
 *
 * ZERO HTML, ZERO CSS, ZERO JAVASCRIPT, ZERO REACT, ZERO BROWSER.
 *
 * Pure silicon remote client:
 * - Mode 1: Connect to 60 FPS Remote Terminal Console (TCP :7070)
 * - Mode 2: Connect to Remote Binary Framebuffer (TCP :7071) and render in local X11 window
 * - Mode 3: Automated protocol test run
 *
 * Usage:
 *   php bin/unum-client [--host=127.0.0.1] [--port=7070]
 *   php bin/unum-client --host=127.0.0.1 --port=7071 --window
 *   php bin/unum-client --test-run
 *
 * @author Shafiullah (Gyani Supreme Core)
 */

require_once __DIR__ . '/../src/Unum/Server/SovereignBinaryDisplayServer.php';
require_once __DIR__ . '/../src/Unum/Ui/PixelCanvas.php';
require_once __DIR__ . '/../src/Unum/Ui/X11SocketWindow.php';

use Unum\Server\SovereignBinaryDisplayServer;
use Unum\Ui\PixelCanvas;
use Unum\Ui\X11SocketWindow;

$options = getopt('', ['host::', 'port::', 'window', 'test-run', 'help']);

if (isset($options['help'])) {
    echo <<<HELP
👑 UNUM Sovereign Standalone Client
Usage: php bin/unum-client [options]

Options:
  --host=<ip>      Remote UNUM server address (default: 127.0.0.1)
  --port=<int>     Remote port (default: 7070 for console, 7071 for window)
  --window         Connect via Binary Framebuffer Protocol to native X11 window
  --test-run       Automated verification test of client protocol stack
  --help           Show this help message

HELP;
    exit(0);
}

$host = isset($options['host']) ? (string)$options['host'] : '127.0.0.1';
$isWindowMode = isset($options['window']);
$port = isset($options['port']) ? (int)$options['port'] : ($isWindowMode ? 7071 : 7070);

// 1. Test Run Mode
if (isset($options['test-run'])) {
    echo "\n========================================================================\n";
    echo "  👑 UNUM SOVEREIGN CLIENT PROTOCOL VERIFICATION TEST\n";
    echo "========================================================================\n\n";

    // Test 1: RLE Compression Round-Trip
    echo "● [1/2] Testing 32-Bit Word RLE Compression & Decompression...\n";
    $testPixels = str_repeat(pack('V', 0xFF0D1117), 500)
                . str_repeat(pack('V', 0xFF58A6FF), 200)
                . str_repeat(pack('V', 0xFF3FB950), 300);
    $rawLen = strlen($testPixels); // 4000 bytes

    $compressed = SovereignBinaryDisplayServer::compressRle32($testPixels);
    $decompressed = SovereignBinaryDisplayServer::decompressRle32($compressed);

    if ($decompressed !== $testPixels) {
        echo "      RLE Compression Mismatch! [FAIL]\n";
        exit(1);
    }
    printf("      Compressed 4000 bytes to %d bytes (%.1fx ratio) [PASS]\n", strlen($compressed), $rawLen / strlen($compressed));

    // Test 2: Binary Frame Packet Header
    echo "● [2/2] Testing SBFP Packet Protocol Formatting...\n";
    $pktHeader = SovereignBinaryDisplayServer::MAGIC . pack('CV', SovereignBinaryDisplayServer::PKT_FRAME_TILE, 100);
    if (substr($pktHeader, 0, 4) !== "UNUM" || ord($pktHeader[4]) !== SovereignBinaryDisplayServer::PKT_FRAME_TILE) {
        echo "      Packet Header Invalid! [FAIL]\n";
        exit(1);
    }
    echo "      Packet Header Formatted Correctly [PASS]\n";

    echo "\n========================================================================\n";
    echo "  ✅ ALL CLIENT PROTOCOL TESTS PASSED 100%\n";
    echo "========================================================================\n\n";
    exit(0);
}

// 2. Binary Remote Window Mode (TCP :7071 -> Local X11)
if ($isWindowMode) {
    echo "🖥️ Connecting to UNUM Binary Display Server at {$host}:{$port}...\n";
    $sock = @stream_socket_client("tcp://{$host}:{$port}", $errno, $errstr, 3.0);
    if (!$sock) {
        fwrite(STDERR, "❌ Connection failed: {$errstr} ({$errno})\n");
        exit(1);
    }
    stream_set_blocking($sock, false);

    // Read Handshake Response
    $handshakeRaw = '';
    $t0 = microtime(true);
    while (strlen($handshakeRaw) < 14) {
        $chunk = @fread($sock, 14 - strlen($handshakeRaw));
        if ($chunk !== false && $chunk !== '') {
            $handshakeRaw .= $chunk;
        }
        if ((microtime(true) - $t0) > 3.0) {
            fwrite(STDERR, "❌ Handshake timeout from {$host}:{$port}\n");
            exit(1);
        }
        usleep(5000);
    }

    $magic = substr($handshakeRaw, 0, 4);
    if ($magic !== SovereignBinaryDisplayServer::MAGIC) {
        fwrite(STDERR, "❌ Invalid magic header: {$magic}\n");
        exit(1);
    }

    $hs = unpack('Ctype/Vlen/vwidth/vheight/Cbpp', substr($handshakeRaw, 4));
    $winW = $hs['width'];
    $winH = $hs['height'];
    echo "✅ Handshake OK: Remote Canvas {$winW}x{$winH} @ {$hs['bpp']}-bit ARGB\n";

    // Open local native X11 window
    $x11 = new X11SocketWindow($winW, $winH, "UNUM Remote Silicon Window ({$host}:{$port})");
    if (!$x11->connect() || !$x11->createWindow()) {
        fwrite(STDERR, "❌ Could not open local X11 window. Falling back.\n");
        exit(1);
    }
    echo "✅ Local Native X11 Window Active. Streaming frames...\n";

    $localCanvas = new PixelCanvas($winW, $winH, 0xFF0D1117);

    while (true) {
        // Read packets from server
        $header = @fread($sock, 9);
        if ($header !== false && strlen($header) === 9) {
            $un = unpack('Ctype/Vlen', substr($header, 4, 5));
            $type = $un['type'];
            $len = $un['len'];

            $payload = '';
            while (strlen($payload) < $len) {
                $chunk = @fread($sock, $len - strlen($payload));
                if ($chunk !== false && $chunk !== '') {
                    $payload .= $chunk;
                }
            }

            if ($type === SovereignBinaryDisplayServer::PKT_FRAME_TILE && strlen($payload) >= 9) {
                $th = unpack('vx/vy/vw/vh/Ccomp', substr($payload, 0, 9));
                $tileCompressed = substr($payload, 9);
                $tileRaw = ($th['comp'] === 1) ? SovereignBinaryDisplayServer::decompressRle32($tileCompressed) : $tileCompressed;

                // Blit into local canvas
                $offset = 0;
                for ($cy = $th['y']; $cy < $th['y'] + $th['h']; ++$cy) {
                    for ($cx = $th['x']; $cx < $th['x'] + $th['w']; ++$cx) {
                        if ($offset + 4 <= strlen($tileRaw)) {
                            $color = unpack('V', substr($tileRaw, $offset, 4))[1];
                            $localCanvas->setPixel($cx, $cy, $color);
                            $offset += 4;
                        }
                    }
                }
                $x11->blitCanvas($localCanvas);
            }
        }

        // Poll local X11 events and forward to remote server
        $events = $x11->pollEvents();
        foreach ($events as $ev) {
            if ($ev['type'] === 2) { // KeyPress (Esc/q to quit)
                echo "\nExited cleanly.\n";
                $x11->close();
                fclose($sock);
                exit(0);
            }
            if ($ev['type'] === 4) { // ButtonPress (mouse click)
                // Forward input packet to server
                $inPayload = pack('Cvvv', 1, 0, 100, 100);
                $inPkt = SovereignBinaryDisplayServer::MAGIC . pack('CV', SovereignBinaryDisplayServer::PKT_INPUT_EVENT, strlen($inPayload)) . $inPayload;
                @fwrite($sock, $inPkt);
            }
        }

        usleep(10000); // 100 Hz polling loop
    }
}

// 3. Remote Terminal Console Mode (TCP :7070 -> Terminal Raw Mode)
echo "⚡ Connecting to UNUM Sovereign Terminal Console at {$host}:{$port}...\n";
$sock = @stream_socket_client("tcp://{$host}:{$port}", $errno, $errstr, 3.0);
if (!$sock) {
    fwrite(STDERR, "❌ Connection failed: {$errstr} ({$errno})\n");
    exit(1);
}

stream_set_blocking($sock, false);
$stdin = STDIN;
stream_set_blocking($stdin, false);

// Save initial stty and enter raw terminal mode
$initialStty = @shell_exec('stty -g 2>/dev/null') ?: '';
@system('stty -icanon -echo min 0 time 0 2>/dev/null');

// Restore terminal on exit
register_shutdown_function(function () use ($initialStty, $sock) {
    @fwrite(STDOUT, "\033[?1000l\033[?1006l\033[?25h\033[?1049l\033[0m");
    if (!empty($initialStty)) {
        @system('stty ' . escapeshellarg($initialStty) . ' 2>/dev/null');
    } else {
        @system('stty sane 2>/dev/null');
    }
    if ($sock) {
        @fclose($sock);
    }
});

while (true) {
    $read = [$sock, $stdin];
    $write = null;
    $except = null;

    if (@stream_select($read, $write, $except, 0, 10000) > 0) {
        // Data from server -> write to local terminal stdout
        if (in_array($sock, $read, true)) {
            $data = @fread($sock, 65536);
            if ($data === false || $data === '') {
                // Server disconnected
                break;
            }
            fwrite(STDOUT, $data);
        }

        // Data from local terminal stdin -> send to server socket
        if (in_array($stdin, $read, true)) {
            $input = @fread($stdin, 4096);
            if ($input !== false && $input !== '') {
                @fwrite($sock, $input);
            }
        }
    }
}
