#!/bin/bash
# lipc — Lipi Native Compiler
# Compiles .lp files to native binaries (no Python at runtime!)
# WHY: This is the path to Lipi's full independence from Python.
#
# Usage:
#   lipc hello.lp            → compiles to ./hello
#   lipc hello.lp -o myapp   → compiles to ./myapp
#   lipc --emit-c hello.lp   → just show C code, don't compile

set -e

LIPI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."
LIPI_RUNTIME_H="$LIPI_HOME/src/compiler/lipi_runtime.h"
LIPI_CODEGEN="$LIPI_HOME/src/compiler/c_codegen.py"

# Color output
GREEN="\033[32m"; CYAN="\033[36m"; RED="\033[31m"; RESET="\033[0m"

usage() {
    echo "Usage: lipc <file.lp> [options]"
    echo ""
    echo "Options:"
    echo "  -o <output>          Output binary name (default: basename of file)"
    echo "  --direct-elf         Direct x86_64 ELF machine code (Zero GCC, Zero Libc) 👑"
    echo "  --baremetal          Alias for --direct-elf"
    echo "  --emit-c             Print generated C code to stdout"
    echo "  --emit-asm           Print assembly (requires -S after gcc)"
    echo "  -O0/-O2/-O3          GCC optimization level (default: -O2)"
    echo "  -v                   Verbose output"
    echo ""
    echo "Examples:"
    echo "  lipc hello.lp                    Compile to ./hello"
    echo "  lipc --direct-elf hello.lp       Zero-GCC Direct Machine Code"
    echo "  lipc hello.lp -o myapp           Compile to ./myapp"
    echo "  lipc --emit-c hello.lp           Show generated C code"
    echo "  echo 'say 42' | lipc -           Read from stdin"
}

# Parse args
INPUT=""
OUTPUT=""
EMIT_C=0
DIRECT_ELF=0
OPT_LEVEL="-O2"
VERBOSE=0
EXTRA_GCC=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)                  OUTPUT="$2"; shift 2 ;;
        --direct-elf|--baremetal) DIRECT_ELF=1; shift ;;
        --emit-c)            EMIT_C=1; shift ;;
        --emit-asm)          EXTRA_GCC="-S"; shift ;;
        -O0|-O1|-O2|-O3|-Os) OPT_LEVEL="$1"; shift ;;
        -v)                  VERBOSE=1; shift ;;
        --help|-h)           usage; exit 0 ;;
        -*)                  echo "Unknown option: $1"; usage; exit 1 ;;
        *)                   INPUT="$1"; shift ;;
    esac
done

if [[ -z "$INPUT" ]]; then
    echo -e "${RED}Error: no input file${RESET}"
    usage
    exit 1
fi

# Derive output name
if [[ -z "$OUTPUT" ]]; then
    OUTPUT="${INPUT%.lp}"
    OUTPUT="$(basename "$OUTPUT")"
fi

# 👑 Pillar 1 & 2: Direct x86_64 ELF Machine Code Emitter (Zero GCC, Zero Libc)
if [[ $DIRECT_ELF -eq 1 ]] || ! command -v gcc &>/dev/null; then
    [[ $VERBOSE -eq 1 ]] && echo -e "${CYAN}→ Direct ELF Generation: $INPUT → ./$OUTPUT${RESET}"
    cd "$LIPI_HOME"
    # WHY: Native standalone compiler binary — 0% Python invocation
    if [[ -x "$LIPI_HOME/bin/lipc_native_elf" ]]; then
        if "$LIPI_HOME/bin/lipc_native_elf" "$INPUT" "$OUTPUT" >/dev/null 2>&1; then
            echo -e "${GREEN}✔ Compiled (Direct Machine Code 👑): $INPUT → ./$OUTPUT${RESET}"
            echo -e "  Zero GCC | Zero Libc | 100% Statically Linked Linux ELF64"
            echo -e "  Run: ${CYAN}./$OUTPUT${RESET}"
            exit 0
        fi
    fi
    if python3 -m src.compiler.elf_emitter "$INPUT" "$OUTPUT"; then
        echo -e "${GREEN}✔ Compiled (Direct Machine Code 👑): $INPUT → ./$OUTPUT${RESET}"
        echo -e "  Zero GCC | Zero Libc | 100% Statically Linked Linux ELF64"
        echo -e "  Run: ${CYAN}./$OUTPUT${RESET}"
        exit 0
    else
        echo -e "${RED}❌ Direct ELF compilation failed${RESET}"
        exit 1
    fi
fi

# Temp files
TMP_C="$(mktemp /tmp/lipi_XXXXXXXX.c)"
trap "rm -f '$TMP_C'" EXIT

# Step 1: Lipi → C
[[ $VERBOSE -eq 1 ]] && echo -e "${CYAN}→ Compiling: $INPUT → C${RESET}"
cd "$LIPI_HOME"

if [[ -x "$LIPI_HOME/bin/lipc_bin" ]]; then
    # WHY: Native self-hosted compiler — zero Python dependency at compile time
    if _LIPI_ARGV="lipc|$INPUT|$TMP_C" "$LIPI_HOME/bin/lipc_bin" >/dev/null 2>&1; then
        :
    else
        echo -e "${RED}❌ Native Lipi→C compilation failed${RESET}"
        exit 1
    fi
elif python3 "$LIPI_CODEGEN" "$INPUT" -o "$TMP_C" 2>&1; then
    :
else
    echo -e "${RED}❌ Lipi→C transpilation failed${RESET}"
    exit 1
fi

# If --emit-c, print and exit
if [[ $EMIT_C -eq 1 ]]; then
    cat "$TMP_C"
    exit 0
fi

# Step 2: C → native binary via gcc
[[ $VERBOSE -eq 1 ]] && echo -e "${CYAN}→ Compiling: C → native binary${RESET}"

if gcc $OPT_LEVEL "$TMP_C" \
    -I"$(dirname "$LIPI_RUNTIME_H")" \
    -lm \
    -o "$OUTPUT" \
    $EXTRA_GCC 2>&1; then
    echo -e "${GREEN}✔ Compiled: $INPUT → ./$OUTPUT${RESET}"
    echo -e "  Run: ${CYAN}./$OUTPUT${RESET}"
else
    echo -e "${RED}❌ GCC compilation failed${RESET}"
    exit 1
fi
