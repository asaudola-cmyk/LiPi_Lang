@! ============================================================================
@! MAYA COMPILER STAGE 4 — NATIVE RISC-V 64 CODE GENERATOR
@! 100% Written in Pure Maya Language — Zero External Dependencies
@! ============================================================================

import "universe/core/collections"
import "universe/core/string"

@fn riscv_generate_function(node)
  fn_name = node.name
  out = ".globl " + fn_name + "\n"
  out = out + fn_name + ":\n"
  out = out + "  addi sp, sp, -32\n"
  out = out + "  sd ra, 24(sp)\n"
  out = out + "  sd s0, 16(sp)\n"
  out = out + "  addi s0, sp, 32\n"
  
  @! Basic instruction emission for demo/stage pipeline
  out = out + "  li a0, 0\n"
  
  out = out + "  ld ra, 24(sp)\n"
  out = out + "  ld s0, 16(sp)\n"
  out = out + "  addi sp, sp, 32\n"
  out = out + "  ret\n\n"
  return out
@end

@fn riscv_generate_program(ast_or_mir)
  code = "# Maya Native RISC-V 64 Assembly\n"
  code = code + "# Generated by Pure Maya Compiler\n\n"
  code = code + ".text\n.align 2\n\n"
  
  has_funcs = 0
  @if ast_or_mir != 0
    @if ast_or_mir.functions != 0
      @for fn_obj in ast_or_mir.functions
        code = code + riscv_generate_function(fn_obj)
        has_funcs = 1
      @end
    @else
      len = ast_or_mir.len()
      i = 0
      @while i < len
        node = ast_or_mir[i]
        @if node.kind == "FnDef" || node.type == "Function"
          code = code + riscv_generate_function(node)
          has_funcs = 1
        @end
        i = i + 1
      @end
    @end
  @end
  
  @if has_funcs == 0
    main_dummy = { name: "main", params: [], body: [] }
    code = code + riscv_generate_function(main_dummy)
  @end
  
  return code
@end
