@! ============================================================================
@! MAYA STAGE 4: NATIVE ARM64 (AArch64) BACKEND IN PURE MAYA
@! Emits native ARM64 machine code directly (Apple Silicon / Raspberry Pi).
@! ============================================================================

import "universe/core/collections"
import "universe/core/string"
import "compiler/middleend/maya_ir"

@fn get_arm_reg(mir_reg_idx)
  @if mir_reg_idx < 30
    return "x" + mir_reg_idx.to_str()
  @end
  return "x19"
@end

@fn generate_arm_instruction(inst)
  @if inst.type == "LoadInt"
    reg = get_arm_reg(inst.dest)
    return "  mov " + reg + ", #" + inst.val.to_str()
  @elif inst.type == "Add"
    dest = get_arm_reg(inst.dest)
    left = get_arm_reg(inst.left)
    right = get_arm_reg(inst.right)
    return "  add " + dest + ", " + left + ", " + right
  @elif inst.type == "Mul"
    dest = get_arm_reg(inst.dest)
    left = get_arm_reg(inst.left)
    right = get_arm_reg(inst.right)
    return "  mul " + dest + ", " + left + ", " + right
  @elif inst.type == "Return"
    src = get_arm_reg(inst.src)
    out = ""
    @if src != "x0"
      out = "  mov x0, " + src + "\n"
    @end
    return out + "  ret"
  @end
  return "  // Unhandled instruction: " + inst.type
@end

@fn arm_generate_function(func_mir)
  code = ".global _" + func_mir.name + "\n"
  code = code + "_" + func_mir.name + ":\n"
  
  @! Prologue
  code = code + "  stp x29, x30, [sp, #-16]!\n"
  code = code + "  mov x29, sp\n"
  
  idx = 0
  @while idx < func_mir.instructions.len()
    inst = func_mir.instructions[idx]
    code = code + generate_arm_instruction(inst) + "\n"
    idx = idx + 1
  @end
  
  @! Epilogue
  code = code + "  ldp x29, x30, [sp], #16\n"
  code = code + "  ret\n"
  return code
@end

@fn arm_generate_program(mir_program)
  result = "// Maya Native ARM64 (AArch64) Assembly\n"
  result = result + "// Generated by Pure Maya Compiler\n\n"
  result = result + ".text\n.align 4\n\n"
  
  idx = 0
  @while idx < mir_program.functions.len()
    result = result + arm_generate_function(mir_program.functions[idx]) + "\n"
    idx = idx + 1
  @end
  
  return result
@end
