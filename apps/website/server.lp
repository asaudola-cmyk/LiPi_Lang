// প্রধান ফুল-স্ট্যাক সার্ভার এক্সিকিউশন (Main Server Execution)
// ==============================================================================

দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI FULL-STACK SOVEREIGN WEB & DATABASE ENGINE (v2.1 Ultra)\033[0m       \033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ Frontend + Backend + Database | 100% Pure Native Machine Code        \033[0m\033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
দেখাও ""

// ১. ডাটাবেজ ফাইল ইনিশিয়ালাইজেশন
ধরি ডিবি_পাথ = "apps/website/data/sovereign_store.db"
ধরি ডিবি_এফডি = ডিবি_খোলো(ডিবি_পাথ)
যদি ডিবি_এফডি < ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: ডাটাবেজ ফাইল খোলা সম্ভব হয়নি!\033[0m"
    ফেরত ১
}

// যদি ডাটাবেজ সম্পূর্ণ নতুন হয়, তবে প্রাথমিক বীজ রেকর্ড যোগ করা
ধরি প্রাথমিক_রেকর্ড = ডিবি_মোট_রেকর্ড(ডিবি_এফডি)
যদি প্রাথমিক_রেকর্ড == ০ {
    ডিবি_রেকর্ড_যোগ(ডিবি_এফডি, ১০২৪)
    ডিবি_রেকর্ড_যোগ(ডিবি_এফডি, ২০৪৮)
    ডিবি_রেকর্ড_যোগ(ডিবি_এফডি, ৪০৯৬)
    দেখাও "\033[1;32m  ✔ ডাটাবেজে ৩টি প্রাথমিক বীজ রেকর্ড সফলভাবে ইনসার্ট করা হয়েছে।\033[0m"
}

// ২. টিসিপি নেটওয়ার্ক সকেট কনফিগারেশন
ধরি সার্ভার_এফডি = সকেট_তৈরি()
যদি সার্ভার_এফডি < ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: নেটওয়ার্ক সকেট তৈরি ব্যর্থ!\033[0m"
    ফেরত ১
}

সকেট_অপশন_সেট(সার্ভার_এফডি, বাফার())
ধরি পোর্ট = ৮০৮০
ধরি বাইন্ড_কোড = পোর্ট_বাইন্ড(সার্ভার_এফডি, বাফার(), পোর্ট)
যদি বাইন্ড_কোড != ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: পোর্ট ৮০৮০ এ বাইন্ড ব্যর্থ (Port In Use)!\033[0m"
    সকেট_বন্ধ(সার্ভার_এফডি)
    ফেরত ১
}

ধরি ব্যাকলগ = ৬৪
ধরি লিসেন_কোড = সকেট_লিসেন(সার্ভার_এফডি, ব্যাকলগ)
যদি লিসেন_কোড != ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: লিসেন মোড চালু করা যায়নি!\033[0m"
    সকেট_বন্ধ(সার্ভার_এফডি)
    ফেরত ১
}

দেখাও "\033[1;32m✔ লিপি ফুল-স্ট্যাক সার্বভৌম ওয়েব ও ডাটাবেজ সার্ভার সক্রিয়!\033[0m"
দেখাও "\033[1;36m  • ফ্রন্টএন্ড ইউআই  : http://localhost:8080/\033[0m"
দেখাও "\033[1;36m  • ডাটাবেজ এন্ডপয়েন্ট: http://localhost:8080/api/db/items\033[0m"
দেখাও "\033[1;33m  • স্টোরেজ পাথ     : " + ডিবি_পাথ + "\033[0m"
দেখাও "\033[1;33m  • নির্ভরতা        : ০% Libc | ০% PHP | ০% Node | ১০০% খাঁটি লিপি\033[0m"
দেখাও ""

ধরি শুরু_ক্লক = সিপিউ_ক্লক()
ধরি অনুরোধ_গণনা = ০
ধরি রিকোয়েস্ট_বাফার = মেমরি_বরাদ্দ(৪০৯৬)

// ৩. ফুল-স্ট্যাক রিকোয়েস্ট লুপ (Full-Stack Request Event Loop)
ধরি সার্ভার_চলমান = ১
যতক্ষণ সার্ভার_চলমান {
    ধরি ক্লায়েন্ট_এফডি = সকেট_গ্রহণ(সার্ভার_এফডি)
    যদি ক্লায়েন্ট_এফডি >= ০ {
        অনুরোধ_গণনা = অনুরোধ_গণনা + ১
        ধরি পঠিত = ফাইল_পড়ো(ক্লায়েন্ট_এফডি, রিকোয়েস্ট_বাফার, ২০৪৮)

        // মেথড পরবর্তী পাথ শুরুর পজিশন নির্ণয় (Dynamic Path Start Offset)
        ধরি p = প্রথম_স্পেস_খুঁজো(রিকোয়েস্ট_বাফার, পঠিত)

        ধরি p0 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ০) // '/'
        ধরি p1 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ১)
        ধরি p2 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ২)
        ধরি p3 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ৩)
        ধরি p4 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ৪)
        ধরি p5 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ৫)
        ধরি p6 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ৬)
        ধরি p7 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ৭)
        ধরি p8 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, p + ৮)

        ধরি হ্যান্ডেলড = ০

        // [এপিআই ১] /api/db/... (p1='a', p2='p', p3='i', p4='/', p5='d', p6='b', p7='/')
        যদি p1 == ৯৭ {
            যদি p2 == ১১২ {
                যদি p3 == ১০৫ {
                    যদি p4 == ৪৭ {
                        যদি p5 == ১০০ {
                            যদি p6 == ৯৮ {
                                যদি p7 == ৪৭ {
                                    // p8 == 'i' (/api/db/items)
                                    যদি p8 == ১০৫ {
                                        ডিবি_রেকর্ডস_প্রেরণ(ক্লায়েন্ট_এফডি, ডিবি_এফডি)
                                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                                        হ্যান্ডেলড = ১
                                        দেখাও "  [DB 📦] /api/db/items সার্ভ সম্পন্ন #" + অনুরোধ_গণনা
                                    }

                                    // p8 == 'a' (/api/db/add)
                                    যদি p8 == ৯৭ {
                                        ধরি ইনপুট_মান = পার্স_মান(রিকোয়েস্ট_বাফার, পঠিত)
                                        ডিবি_রেকর্ড_ইনসার্ট_এপিআই(ক্লায়েন্ট_এফডি, ডিবি_এফডি, ইনপুট_মান)
                                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                                        হ্যান্ডেলড = ১
                                        দেখাও "  [DB ➕] /api/db/add সম্পন্ন: মান=" + ইনপুট_মান
                                    }

                                    // p8 == 'd' (/api/db/delete)
                                    যদি p8 == ১০০ {
                                        ধরি ডেল_আইডি = পার্স_আইডি(রিকোয়েস্ট_বাফার, পঠিত)
                                        ডিবি_রেকর্ড_ডিলিট_এপিআই(ক্লায়েন্ট_এফডি, ডিবি_এফডি, ডেল_আইডি)
                                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                                        হ্যান্ডেলড = ১
                                        দেখাও "  [DB 🗑️] /api/db/delete সম্পন্ন: id=" + ডেল_আইডি
                                    }

                                    // p8 == 's' (/api/db/stats)
                                    যদি p8 == ১১৫ {
                                        ডিবি_স্ট্যাটস_প্রেরণ(ক্লায়েন্ট_এফডি, ডিবি_এফডি)
                                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                                        হ্যান্ডেলড = ১
                                        দেখাও "  [DB 📊] /api/db/stats সম্পন্ন #" + অনুরোধ_গণনা
                                    }
                                }
                            }
                        }

                        // [এপিআই ২] /api/status (p5='s', p6='t', p7='a', p8='t')
                        যদি p5 == ১১৫ {
                            ডাইনামিক_স্ট্যাটাস_প্রেরণ(ক্লায়েন্ট_এফডি, অনুরোধ_গণনা, শুরু_ক্লক)
                            সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                            হ্যান্ডেলড = ১
                            দেখাও "  [API ⚡] /api/status সম্পন্ন #" + অনুরোধ_গণনা
                        }
                    }
                }
            }
        }

        // [অ্যাসেট ১] /style.css
        যদি হ্যান্ডেলড == ০ {
            যদি p1 == ১১৫ {
                যদি p2 == ১১৬ {
                    যদি p3 == ১২১ {
                        ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/website/public/style.css", "text/css; charset=utf-8")
                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                        হ্যান্ডেলড = ১
                    }
                }
            }
        }

        // [অ্যাসেট ২] /app.js
        যদি হ্যান্ডেলড == ০ {
            যদি p1 == ৯৭ {
                যদি p2 == ১১২ {
                    যদি p3 == ১১২ {
                        যদি p4 == ৪৬ {
                            ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/website/public/app.js", "application/javascript; charset=utf-8")
                            সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                            হ্যান্ডেলড = ১
                        }
                    }
                }
            }
        }

        // [অ্যাসেট ৩] /favicon.svg
        যদি হ্যান্ডেলড == ০ {
            যদি p1 == ১০২ {
                যদি p2 == ৯৭ {
                    যদি p3 == ১১৮ {
                        ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/website/public/favicon.svg", "image/svg+xml")
                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                        হ্যান্ডেলড = ১
                    }
                }
            }
        }

        // [হোমপেজ] / অথবা /index.html
        যদি হ্যান্ডেলড == ০ {
            ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/website/public/index.html", "text/html; charset=utf-8")
            সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
            হ্যান্ডেলড = ১
        }
    }
}

মেমরি_মুক্তি(রিকোয়েস্ট_বাফার, ৪০৯৬)
ফাইল_বন্ধ(ডিবি_এফডি)
সকেট_বন্ধ(সার্ভার_এফডি)
দেখাও "সার্ভার সমাপ্ত।"
