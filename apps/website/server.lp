// ==============================================================================
// 👑 LIPI FULL-STACK SOVEREIGN HTTP WEB SERVER & DATABASE BACKEND
// File: apps/website/server.lp
// ⚡ 100% Pure Lipi | Zero Libc | Zero PHP | Linux Kernel AMD64 Syscalls
//
// WHY: Full-stack engine handling HTTP 1.1 routing, REST API endpoints,
// binary database CRUD operations, and persistent NVMe/SSD storage.
// ==============================================================================

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/net.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/str.lp"
অন্তর্ভুক্ত "apps/website/db_engine.lp"

// ১. পূর্ণসংখ্যাকে আস্কি অক্ষরে রূপান্তর করে মেমরিতে লেখা
// WHY: ডাইনামিক মেট্রিক্স ও আইডিকে আস্কি স্ট্রিংয়ে রূপান্তর করা
কাজ সংখ্যা_থেকে_আস্কি(মান, গন্তব্য, শুরু_অফসেট) {
    যদি মান == ০ {
        মেমরি_বাইট_লেখো(গন্তব্য, শুরু_অফসেট, ৪৮)
        ফেরত শুরু_অফসেট + ১
    }

    ধরি টেম্প_মান = মান
    ধরি ডিজিট_সংখ্যা = ০
    ধরি স্ট্যাক_বাফার = বাফার()

    যতক্ষণ টেম্প_মান > ০ {
        ধরি ভাগশেষ = টেম্প_মান % ১০
        মেমরি_বাইট_লেখো(স্ট্যাক_বাফার, ডিজিট_সংখ্যা, ভাগশেষ + ৪৮)
        ডিজিট_সংখ্যা = ডিজিট_সংখ্যা + ১
        টেম্প_মান = টেম্প_মান / ১০
    }

    ধরি কার্সার = শুরু_অফসেট
    ধরি k = ডিজিট_সংখ্যা - ১
    যতক্ষণ k >= ০ {
        ধরি চ = মেমরি_বাইট_পড়ো(স্ট্যাক_বাফার, k)
        মেমরি_বাইট_লেখো(গন্তব্য, কার্সার, চ)
        কার্সার = কার্সার + ১
        k = k - ১
    }

    ফেরত কার্সার
}

// ২. স্ট্রিং অনুলিপি করে মেমরিতে অ্যাপেন্ড করা
// WHY: মেমরি বাফারে এইচটিটিপি হেডার ও জেএসন ফিল্ড সাজানো
কাজ স্ট্রিং_যোগ_করো(উৎস, গন্তব্য, শুরু_অফসেট) {
    ধরি কার্সার = শুরু_অফসেট
    ধরি i = ০
    ধরি চলমান = ১
    যতক্ষণ চলমান {
        ধরি বাইট = মেমরি_বাইট_পড়ো(উৎস, i)
        যদি বাইট == ০ {
            ফেরত কার্সার
        }
        মেমরি_বাইট_লেখো(গন্তব্য, কার্সার, বাইট)
        কার্সার = কার্সার + ১
        i = i + ১
    }
    ফেরত কার্সার
}

// ৩. HTTP রিকোয়েস্টে পাথ শুরুর অফসেট নির্ধারণ (Find Path Offset after Method)
// WHY: GET, POST, DELETE এর দৈর্ঘ্য ৩-৬ অক্ষর হতে পারে। প্রথম স্পেস খুঁজে পাথ স্টার্ট বের করা।
কাজ প্রথম_স্পেস_খুঁজো(বাফার_ঠিকানা, সাইজ) {
    ধরি i = ০
    যতক্ষণ i < সাইজ {
        ধরি b = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i)
        যদি b == ৩২ { // ' ' space
            ফেরত i + ১
        }
        i = i + ১
    }
    ফেরত ০
}

// ৪. রিকোয়েস্ট থেকে 'val=' সংখ্যা পার্স করা (Parse val=XXXX)
// WHY: POST বা GET রিকোয়েস্টে আসা নিউমেরিক প্যারামিটার এক্সট্রাক্ট করা
কাজ পার্স_মান(বাফার_ঠিকানা, সাইজ) {
    ধরি i = ০
    ধরি মান = ০
    ধরি সীমা = সাইজ - ৩
    যতক্ষণ i < সীমা {
        ধরি c1 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i)
        ধরি c2 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i + ১)
        ধরি c3 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i + ২)
        ধরি c4 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i + ৩)
        // 'v' = 118, 'a' = 97, 'l' = 108, '=' = 61
        যদি c1 == ১১৮ {
            যদি c2 == ৯৭ {
                যদি c3 == ১০৮ {
                    যদি c4 == ৬১ {
                        ধরি j = i + ৪
                        ধরি চলা = ১
                        যতক্ষণ চলা {
                            যদি j >= সাইজ {
                                চলা = ০
                            }
                            যদি j < সাইজ {
                                ধরি ch = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, j)
                                যদি ch >= ৪৮ {
                                    যদি ch <= ৫৭ {
                                        মান = (মান * ১০) + (ch - ৪৮)
                                        j = j + ১
                                    }
                                }
                                যদি ch < ৪৮ {
                                    চলা = ০
                                }
                                যদি ch > ৫৭ {
                                    চলা = ০
                                }
                            }
                        }
                        ফেরত মান
                    }
                }
            }
        }
        i = i + ১
    }
    ফেরত মান
}

// ৫. রিকোয়েস্ট থেকে 'id=' সংখ্যা পার্স করা (Parse id=X)
// WHY: রেকর্ড মোছার জন্য টার্গেট রেকর্ড আইডি সংগ্রহ করা
কাজ পার্স_আইডি(বাফার_ঠিকানা, সাইজ) {
    ধরি i = ০
    ধরি মান = ০
    ধরি সীমা = সাইজ - ২
    যতক্ষণ i < সীমা {
        ধরি c1 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i)
        ধরি c2 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i + ১)
        ধরি c3 = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, i + ২)
        // 'i' = 105, 'd' = 100, '=' = 61
        যদি c1 == ১০৫ {
            যদি c2 == ১০০ {
                যদি c3 == ৬১ {
                    ধরি j = i + ৩
                    ধরি চলা = ১
                    যতক্ষণ চলা {
                        যদি j >= সাইজ {
                            চলা = ০
                        }
                        যদি j < সাইজ {
                            ধরি ch = মেমরি_বাইট_পড়ো(বাফার_ঠিকানা, j)
                            যদি ch >= ৪৮ {
                                যদি ch <= ৫৭ {
                                    মান = (মান * ১০) + (ch - ৪৮)
                                    j = j + ১
                                }
                            }
                            যদি ch < ৪৮ {
                                চলা = ০
                            }
                            যদি ch > ৫৭ {
                                চলা = ০
                            }
                        }
                    }
                    ফেরত মান
                }
            }
        }
        i = i + ১
    }
    ফেরত মান
}

// ৬. ডিস্ক থেকে স্ট্যাটিক ফাইল পাঠাও
কাজ ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, ফাইলপাথ, মাইম_টাইপ) {
    ধরি ফাইল_এফডি = ফাইল_খোলো(ফাইলপাথ)
    যদি ফাইল_এফডি < ০ {
        ধরি নট_ফাউন্ড = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n404: File Not Found\n"
        ফাইল_লেখো(ক্লায়েন্ট_এফডি, নট_ফাউন্ড, দৈর্ঘ্য(নট_ফাউন্ড))
        ফেরত -১
    }

    ধরি আকার = সিসকল(৮, ফাইল_এফডি, ০, ২) // lseek SEEK_END
    সিসকল(৮, ফাইল_এফডি, ০, ০)            // lseek SEEK_SET

    ধরি ফাইল_বাফার = মেমরি_বরাদ্দ(আকার + ৮)
    ধরি পঠিত = ফাইল_পড়ো(ফাইল_এফডি, ফাইল_বাফার, আকার)
    ফাইল_বন্ধ(ফাইল_এফডি)

    ধরি হেডার_বাফার = বাফার()
    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-FullStack-Silicon/2.1\r\nContent-Type: ", হেডার_বাফার, কার্সার)
    কার্সার = স্ট্রিং_যোগ_করো(মাইম_টাইপ, হেডার_বাফার, কার্সার)
    কার্সার = স্ট্রিং_যোগ_করো("\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", হেডার_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, হেডার_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, ফাইল_বাফার, আকার)

    মেমরি_মুক্তি(ফাইল_বাফার, আকার + ৮)
    ফেরত ০
}

// ৭. ডাইনামিক টেলিমেট্রি স্ট্যাটাস এপিআই (/api/status)
কাজ ডাইনামিক_স্ট্যাটাস_প্রেরণ(ক্লায়েন্ট_এফডি, অনুরোধ_গণনা, শুরু_ক্লক) {
    ধরি বর্তমান_ক্লক = সিপিউ_ক্লক()
    ধরি ডেল্টা_সাইকেল = বর্তমান_ক্লক - শুরু_ক্লক

    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(২০৪৮)
    ধরি বডি_শুরু = ১০২৪
    ধরি বি_কার্সার = বডি_শুরু

    বি_কার্সার = স্ট্রিং_যোগ_করো("{\"status\":\"sovereign_online\",\"engine\":\"Lipi Full-Stack Silicon ELF64\",\"version\":\"2.1-ultra\",\"cpu_cycles\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(বর্তমান_ক্লক, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"uptime_cycles\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(ডেল্টা_সাইকেল, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"requests_served\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(অনুরোধ_গণনা, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"memory_allocated_kb\":128,\"active_horizons\":21,\"php_dependency\":0,\"libc_dependency\":0}\n", রেসপন্স_বাফার, বি_কার্সার)

    ধরি বডি_আকার = বি_কার্সার - বডি_শুরু

    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-FullStack-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার + বডি_শুরু, বডি_আকার)

    মেমরি_মুক্তি(রেসপন্স_বাফার, ২০৪৮)
    ফেরত ০
}

// ৮. ডাটাবেজ সমস্ত রেকর্ড JSON এ রিটার্ন (/api/db/items)
// WHY: বাইনারি ফাইল থেকে সরাসরি প্রতিটি রেকর্ড স্ক্যান করে JSON অ্যারে প্রস্তুত করা
কাজ ডিবি_রেকর্ডস_প্রেরণ(ক্লায়েন্ট_এফডি, ডিবি_এফডি) {
    ধরি মোট = ডিবি_মোট_রেকর্ড(ডিবি_এফডি)
    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(১৬৩৮৪)
    ধরি বডি_শুরু = ১০২৪
    ধরি বি_কার্সার = বডি_শুরু

    বি_কার্সার = স্ট্রিং_যোগ_করো("[", রেসপন্স_বাফার, বি_কার্সার)

    সিসকল(৮, ডিবি_এফডি, ০, ০) // SEEK_SET
    ধরি বাফ = বাফার()
    ধরি প্রথম = ১
    ধরি i = ০

    যতক্ষণ i < মোট {
        সিসকল(০, ডিবি_এফডি, বাফ, ৩২)
        ধরি rec_id = মেমরি_পড়ো(বাফ, ০)
        ধরি rec_time = মেমরি_পড়ো(বাফ, ৮)
        ধরি rec_status = মেমরি_পড়ো(বাফ, ১৬)
        ধরি rec_val = মেমরি_পড়ো(বাফ, ২৪)

        যদি rec_status == ১ {
            যদি প্রথম == ০ {
                বি_কার্সার = স্ট্রিং_যোগ_করো(",", রেসপন্স_বাফার, বি_কার্সার)
            }
            প্রথম = ০
            বি_কার্সার = স্ট্রিং_যোগ_করো("{\"id\":", রেসপন্স_বাফার, বি_কার্সার)
            বি_কার্সার = সংখ্যা_থেকে_আস্কি(rec_id, রেসপন্স_বাফার, বি_কার্সার)
            বি_কার্সার = স্ট্রিং_যোগ_করো(",\"timestamp\":", রেসপন্স_বাফার, বি_কার্সার)
            বি_কার্সার = সংখ্যা_থেকে_আস্কি(rec_time, রেসপন্স_বাফার, বি_কার্সার)
            বি_কার্সার = স্ট্রিং_যোগ_করো(",\"status\":1,\"value\":", রেসপন্স_বাফার, বি_কার্সার)
            বি_কার্সার = সংখ্যা_থেকে_আস্কি(rec_val, রেসপন্স_বাফার, বি_কার্সার)
            বি_কার্সার = স্ট্রিং_যোগ_করো("}", রেসপন্স_বাফার, বি_কার্সার)
        }
        i = i + ১
    }

    বি_কার্সার = স্ট্রিং_যোগ_করো("]\n", রেসপন্স_বাফার, বি_কার্সার)
    ধরি বডি_আকার = বি_কার্সার - বডি_শুরু

    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-FullStack-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার + বডি_শুরু, বডি_আকার)

    মেমরি_মুক্তি(রেসপন্স_বাফার, ১৬৩৮৪)
    ফেরত ০
}

// ৯. ডাটাবেজে রেকর্ড যোগ করার এপিআই (/api/db/add)
কাজ ডিবি_রেকর্ড_ইনসার্ট_এপিআই(ক্লায়েন্ট_এফডি, ডিবি_এফডি, মান) {
    যদি মান == ০ {
        মান = ১০০
    }
    ধরি নতুন_আইডি = ডিবি_রেকর্ড_যোগ(ডিবি_এফডি, মান)

    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(১০২৪)
    ধরি বডি_শুরু = ৫১২
    ধরি বি_কার্সার = বডি_শুরু

    বি_কার্সার = স্ট্রিং_যোগ_করো("{\"success\":true,\"message\":\"Record committed to Lipi NVMe store\",\"id\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(নতুন_আইডি, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"value\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(মান, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো("}\n", রেসপন্স_বাফার, বি_কার্সার)

    ধরি বডি_আকার = বি_কার্সার - বডি_শুরু

    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 201 Created\r\nServer: Lipi-FullStack-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার + বডি_শুরু, বডি_আকার)

    মেমরি_মুক্তি(রেসপন্স_বাফার, ১০২৪)
    ফেরত নতুন_আইডি
}

// ১০. ডাটাবেজ থেকে রেকর্ড মোছার এপিআই (/api/db/delete)
কাজ ডিবি_রেকর্ড_ডিলিট_এপিআই(ক্লায়েন্ট_এফডি, ডিবি_এফডি, টার্গেট_আইডি) {
    ধরি ফলাফল = ডিবি_রেকর্ড_মুছো(ডিবি_এফডি, টার্গেট_আইডি)

    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(১০২৪)
    ধরি বডি_শুরু = ৫১২
    ধরি বি_কার্সার = বডি_শুরু

    বি_কার্সার = স্ট্রিং_যোগ_করো("{\"success\":true,\"message\":\"Record soft deleted in Lipi store\",\"id\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(টার্গেট_আইডি, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"result\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(ফলাফল, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো("}\n", রেসপন্স_বাফার, বি_কার্সার)

    ধরি বডি_আকার = বি_কার্সার - বডি_শুরু

    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-FullStack-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার + বডি_শুরু, বডি_আকার)

    মেমরি_মুক্তি(রেসপন্স_বাফার, ১০২৪)
    ফেরত ফলাফল
}

// ১১. ডাটাবেজ পরিসংখ্যান এপিআই (/api/db/stats)
কাজ ডিবি_স্ট্যাটস_প্রেরণ(ক্লায়েন্ট_এফডি, ডিবি_এফডি) {
    ধরি মোট = ডিবি_মোট_রেকর্ড(ডিবি_এফডি)
    ধরি সাইজ = ডিবি_ফাইলের_সাইজ(ডিবি_এফডি)

    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(১০২৪)
    ধরি বডি_শুরু = ৫১২
    ধরি বি_কার্সার = বডি_শুরু

    বি_কার্সার = স্ট্রিং_যোগ_করো("{\"status\":\"success\",\"total_records\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(মোট, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"file_size_bytes\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(সাইজ, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"fsync_guarantee\":\"100% NVMe Direct\",\"engine\":\"Lipi Native Binary Storage v1.0\"}\n", রেসপন্স_বাফার, বি_কার্সার)

    ধরি বডি_আকার = বি_কার্সার - বডি_শুরু

    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-FullStack-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার + বডি_শুরু, বডি_আকার)

    মেমরি_মুক্তি(রেসপন্স_বাফার, ১০২৪)
    ফেরত ০
}

