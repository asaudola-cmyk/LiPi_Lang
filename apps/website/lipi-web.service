# ==============================================================================
# 👑 LIPI SOVEREIGN SYSTEMD SERVICE UNIT (lipi-web.service)
# File: apps/website/lipi-web.service
# ⚡ 100% Native Silicon Machine Code | Direct Kernel Sockets | Zero Libc | Zero PHP
#
# WHY: Production systemd daemon supervisor providing automated lifecycle management,
# automatic crash recovery, high-concurrency socket limits, and privilege separation
# for the sovereign Lipi HTTP web & binary database server.
# ==============================================================================

[Unit]
# WHY: Clear service description for journalctl and systemctl daemon management
Description=Lipi Sovereign High-Throughput Web & Database Server

# WHY: Ensure Linux network stack, loopback, and routing tables are active before binding
After=network.target
Wants=network.target

[Service]
# WHY: Standard daemon execution model for foreground event loop running directly on Linux syscalls
Type=simple

# WHY: Working directory context is required to resolve relative asset paths (public/, data/)
WorkingDirectory=/home/shafiullah/Documents/file/work/lipi/apps/website

# WHY: Direct invocation of the statically compiled sovereign Lipi ELF 64-bit binary
ExecStart=/home/shafiullah/Documents/file/work/lipi/apps/website/lipi_server

# WHY: Continuous reliability guarantee - restarts daemon on unhandled exits or signals
Restart=always

# WHY: 3-second throttle delay prevents aggressive CPU spin loops during rapid recovery
RestartSec=3

# WHY: Elevate maximum open file descriptors from default 1024 to 65536 for massive concurrent sockets
LimitNOFILE=65536

# WHY: Enables binding to privileged ports (< 1024, e.g. port 80 or 443) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# WHY: Security hardening - prevents escalation and isolates temporary runtime directories
NoNewPrivileges=true
PrivateTmp=true

# WHY: Direct standard output and error logging into the native systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lipi-web

[Install]
# WHY: Hooks into multi-user runlevel target so Lipi web server starts on system boot
WantedBy=multi-user.target
