[Unit]
Description=Lipi Sovereign Full-Stack Web & Database Engine (Zero-Libc Machine Code)
After=network.target
Wants=network-online.target
Documentation=https://lipi.dev

[Service]
Type=simple
User=shafiullah
WorkingDirectory=/home/shafiullah/Documents/file/work/lipi
ExecStart=/home/shafiullah/Documents/file/work/lipi/apps/website/lipi_server 8088
Restart=always
RestartSec=1s

# 🛡️ Enterprise Sandboxing & Security Boundaries
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/shafiullah/Documents/file/work/lipi/apps/website/data
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# File descriptor limits for high concurrency
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
