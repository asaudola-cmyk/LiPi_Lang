// ==============================================================================
// 👑 LIPI WEB ASSET INSPECTOR & BUILD VALIDATOR (apps/webs/site_builder.lp)
// ⚡ 100% Pure Lipi | Zero Libc | Linux Kernel AMD64 Syscalls
//
// WHY: Verifies that all official website assets (HTML, CSS, JS, SVG) are
// present on disk and properly sized before server deployment.
// ==============================================================================

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/str.lp"

কাজ ফাইল_আকার_যাচাই(পাথ) {
    ধরি fd = ফাইল_খোলো(পাথ)
    যদি fd < ০ {
        দেখাও "  ❌ মিসিং ফাইল: " + পাথ
        ফেরত -১
    }
    ধরি আকার = সিসকল(৮, fd, ০, ২) // lseek SEEK_END
    ফাইল_বন্ধ(fd)
    দেখাও "  ✔ পাওয়া গেছে: " + পাথ + " (" + আকার + " বাইট)"
    ফেরত আকার
}

দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI OFFICIAL WEB ASSET AUDITOR & BUILD VALIDATOR\033[0m                 \033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ Direct Linux Kernel Syscall Asset Inspection | Zero Dependencies\033[0m   \033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
দেখাও ""

দেখাও "\033[1;33m[১] ওয়েবসাইট অ্যাসেট ভেরিফিকেশন শুরু হচ্ছে...\033[0m"
ধরি s1 = ফাইল_আকার_যাচাই("apps/webs/public/index.html")
ধরি s2 = ফাইল_আকার_যাচাই("apps/webs/public/style.css")
ধরি s3 = ফাইল_আকার_যাচাই("apps/webs/public/app.js")
ধরি s4 = ফাইল_আকার_যাচাই("apps/webs/public/favicon.svg")

যদি s1 > ০ {
    যদি s2 > ০ {
        যদি s3 > ০ {
            যদি s4 > ০ {
                ধরি মোট_সাইজ = s1 + s2 + s3 + s4
                দেখাও ""
                দেখাও "\033[1;32m✔ সকল ওয়েব অ্যাসেট শতভাগ প্রস্তুত ও ভ্যালিডেটেড!\033[0m"
                দেখাও "  • মোট অ্যাসেট আকার: " + মোট_সাইজ + " বাইট"
                দেখাও "  • সার্ভার রেডি: apps/webs/server.lp দিয়ে তাৎক্ষণিক ডিপ্লয়যোগ্য।"
                ফেরত ০
            }
        }
    }
}

দেখাও "\033[1;31m❌ সতর্কতা: কিছু অ্যাসেট খুঁজে পাওয়া যায়নি!\033[0m"
ফেরত ১
