// ==============================================================================
// 👑 LIPI DYNAMIC SOVEREIGN HTTP WEB SERVER (apps/webs/server.lp)
// ⚡ 100% Pure Lipi | Zero Libc | Zero PHP | Linux Kernel AMD64 Syscalls
//
// WHY: Serves the official modern Lipi homepage and dynamic JSON API endpoints
// directly from silicon CPU registers and Linux kernel socket syscalls.
// ==============================================================================

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/net.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/str.lp"

// ১. পূর্ণসংখ্যাকে আস্কি অক্ষরে রূপান্তর করে মেমরিতে লেখা
// WHY: ডাইনামিক মেট্রিক্স ও কাউন্টারকে স্ট্রিংয়ে রূপান্তর করা
কাজ সংখ্যা_থেকে_আস্কি(মান, গন্তব্য, শুরু_অফসেট) {
    যদি মান == ০ {
        মেমরি_বাইট_লেখো(গন্তব্য, শুরু_অফসেট, ৪৮)
        ফেরত শুরু_অফসেট + ১
    }

    ধরি টেম্প_মান = মান
    ধরি ডিজিট_সংখ্যা = ০
    ধরি স্ট্যাক_বাফার = বাফার()

    যতক্ষণ টেম্প_মান > ০ {
        ধরি ভাগশেষ = টেম্প_মান % ১০
        মেমরি_বাইট_লেখো(স্ট্যাক_বাফার, ডিজিট_সংখ্যা, ভাগশেষ + ৪৮)
        ডিজিট_সংখ্যা = ডিজিট_সংখ্যা + ১
        টেম্প_মান = টেম্প_মান / ১০
    }

    ধরি কার্সার = শুরু_অফসেট
    ধরি k = ডিজিট_সংখ্যা - ১
    যতক্ষণ k >= ০ {
        ধরি চ = মেমরি_বাইট_পড়ো(স্ট্যাক_বাফার, k)
        মেমরি_বাইট_লেখো(গন্তব্য, কার্সার, চ)
        কার্সার = কার্সার + ১
        k = k - ১
    }

    ফেরত কার্সার
}

// ২. স্ট্রিং অনুলিপি করে মেমরিতে অ্যাপেন্ড করা
// WHY: মেমরি বাফারে এইচটিটিপি হেডার ও জেএসন ফিল্ড সাজানো
কাজ স্ট্রিং_যোগ_করো(উৎস, গন্তব্য, শুরু_অফসেট) {
    ধরি কার্সার = শুরু_অফসেট
    ধরি i = ০
    ধরি চলমান = ১
    যতক্ষণ চলমান {
        ধরি বাইট = মেমরি_বাইট_পড়ো(উৎস, i)
        যদি বাইট == ০ {
            ফেরত কার্সার
        }
        মেমরি_বাইট_লেখো(গন্তব্য, কার্সার, বাইট)
        কার্সার = কার্সার + ১
        i = i + ১
    }
    ফেরত কার্সার
}

// ৩. স্ট্যাটিক ফাইল পাঠাও (Send File over Socket)
// WHY: ডিস্ক থেকে এইচটিএমএল, সিএসএস ও জাভাস্ক্রিপ্ট ফাইল লোড করে ক্লায়েন্টে প্রেরণ
কাজ ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, ফাইলপাথ, মাইম_টাইপ) {
    ধরি ফাইল_এফডি = ফাইল_খোলো(ফাইলপাথ)
    যদি ফাইল_এফডি < ০ {
        ধরি নট_ফাউন্ড = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nConnection: close\r\n\r\n404: File Not Found in Sovereign Storage\n"
        ফাইল_লেখো(ক্লায়েন্ট_এফডি, নট_ফাউন্ড, দৈর্ঘ্য(নট_ফাউন্ড))
        ফেরত -১
    }

    // lseek দিয়ে ফাইলের আকার নির্ণয়
    ধরি আকার = সিসকল(৮, ফাইল_এফডি, ০, ২)
    সিসকল(৮, ফাইল_এফডি, ০, ০)

    ধরি ফাইল_বাফার = মেমরি_বরাদ্দ(আকার + ৮)
    ধরি পঠিত = ফাইল_পড়ো(ফাইল_এফডি, ফাইল_বাফার, আকার)
    ফাইল_বন্ধ(ফাইল_এফডি)

    // এইচটিটিপি রেসপন্স হেডার প্রস্তুতি
    ধরি হেডার_বাফার = বাফার()
    ধরি কার্সার = ০
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-Sovereign-Silicon/2.1\r\nContent-Type: ", হেডার_বাফার, কার্সার)
    কার্সার = স্ট্রিং_যোগ_করো(মাইম_টাইপ, হেডার_বাফার, কার্সার)
    কার্সার = স্ট্রিং_যোগ_করো("\r\nConnection: close\r\n\r\n", হেডার_বাফার, কার্সার)

    // হেডার ও ফাইল বডি ক্লায়েন্টে সেন্ড
    সিসকল(১, ক্লায়েন্ট_এফডি, হেডার_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, ফাইল_বাফার, আকার)

    মেমরি_মুক্তি(ফাইল_বাফার, আকার + ৮)
    ফেরত ০
}

// ৪. ডাইনামিক স্ট্যাটাস এপিআই রেসপন্স প্রেরণ (/api/status)
// WHY: লাইভ সিপিইউ সাইকেল, মোট রিকোয়েস্ট ও সার্বভৌম অবস্থা সরাসরি JSON এ প্রদান
কাজ ডাইনামিক_স্ট্যাটাস_প্রেরণ(ক্লায়েন্ট_এফডি, অনুরোধ_গণনা, শুরু_ক্লক) {
    ধরি বর্তমান_ক্লক = সিপিউ_ক্লক()
    ধরি ডেল্টা_সাইকেল = বর্তমান_ক্লক - শুরু_ক্লক

    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(২০৪৮)
    ধরি কার্সার = ০

    // JSON বডি কনস্ট্রাকশন
    ধরি বডি_শুরু = ১০২৪
    ধরি বি_কার্সার = বডি_শুরু
    বি_কার্সার = স্ট্রিং_যোগ_করো("{\"status\":\"sovereign_online\",\"engine\":\"Lipi Native Silicon ELF64\",\"version\":\"2.1-ultra\",\"cpu_cycles\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(বর্তমান_ক্লক, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"uptime_cycles\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(ডেল্টা_সাইকেল, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"requests_served\":", রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = সংখ্যা_থেকে_আস্কি(অনুরোধ_গণনা, রেসপন্স_বাফার, বি_কার্সার)
    বি_কার্সার = স্ট্রিং_যোগ_করো(",\"memory_allocated_kb\":128,\"active_horizons\":21,\"php_dependency\":0,\"libc_dependency\":0}\n", রেসপন্স_বাফার, বি_কার্সার)

    ধরি বডি_আকার = বি_কার্সার - বডি_শুরু

    // হেডার জেনারেশন
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-Sovereign-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার + বডি_শুরু, বডি_আকার)

    মেমরি_মুক্তি(রেসপন্স_বাফার, ২০৪৮)
    ফেরত ০
}

// ৫. ডাইনামিক সিস্টেম তথ্য এপিআই (/api/sysinfo)
কাজ ডাইনামিক_সিস্টেম_তথ্য_প্রেরণ(ক্লায়েন্ট_এফডি) {
    ধরি রেসপন্স_বাফার = মেমরি_বরাদ্দ(১০২৪)
    ধরি কার্সার = ০

    ধরি বডি = "{\"architecture\":\"x86_64\",\"kernel_abi\":\"Linux AMD64 Direct Syscalls\",\"compiler\":\"Lipi Sovereign Compiler v2.1\",\"self_hosting_closure\":true,\"active_horizons\":21,\"dependencies\":[\"0% PHP\",\"0% Libc\",\"0% GCC\"]}\n"
    
    কার্সার = স্ট্রিং_যোগ_করো("HTTP/1.1 200 OK\r\nServer: Lipi-Sovereign-Silicon/2.1\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\n\r\n", রেসপন্স_বাফার, কার্সার)

    সিসকল(১, ক্লায়েন্ট_এফডি, রেসপন্স_বাফার, কার্সার)
    সিসকল(১, ক্লায়েন্ট_এফডি, বডি, দৈর্ঘ্য(বডি))

    মেমরি_মুক্তি(রেসপন্স_বাফার, ১০২৪)
    ফেরত ০
}

// ==============================================================================
// প্রধান এক্সিকিউশন ও সার্ভার ইভেন্ট লুপ (Main Server Event Loop)
// ==============================================================================

দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI DYNAMIC SOVEREIGN HTTP WEB SERVER & TELEMETRY ENGINE\033[0m          \033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ 100% Native Silicon Machine Code | Direct Linux Kernel Socket Syscalls\033[0m\033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
দেখাও ""

// টিসিপি সকেট তৈরি
ধরি সার্ভার_এফডি = সকেট_তৈরি()
যদি সার্ভার_এফডি < ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: সকেট তৈরি করা সম্ভব হয়নি!\033[0m"
    ফেরত ১
}

// পোর্ট পুনঃব্যবহার ফ্ল্যাগ সক্রিয়করণ
সকেট_অপশন_সেট(সার্ভার_এফডি, বাফার())

// পোর্ট ৮০৮০ এ বাইন্ড করা
ধরি পোর্ট = ৮০৮০
ধরি বাইন্ড_কোড = পোর্ট_বাইন্ড(সার্ভার_এফডি, বাফার(), পোর্ট)
যদি বাইন্ড_কোড != ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: পোর্ট ৮০৮০ এ বাইন্ড ব্যর্থ হয়েছে (Port In Use)!\033[0m"
    সকেট_বন্ধ(সার্ভার_এফডি)
    ফেরত ১
}

// লিসেনিং কিউ সক্রিয়করণ
ধরি ব্যাকলগ = ৬৪
ধরি লিসেন_কোড = সকেট_লিসেন(সার্ভার_এফডি, ব্যাকলগ)
যদি লিসেন_কোড != ০ {
    দেখাও "\033[1;31m❌ ত্রুটি: লিসেন মোড চালু করা যায়নি!\033[0m"
    সকেট_বন্ধ(সার্ভার_এফডি)
    ফেরত ১
}

দেখাও "\033[1;32m✔ লিপি সার্বভৌম ওয়েব সার্ভার সফলভাবে প্রস্তুত!\033[0m"
দেখাও "\033[1;36m  • লোকাল এড্রেস    : http://127.0.0.1:8080/\033[0m"
দেখাও "\033[1;36m  • নেটওয়ার্ক পোর্ট : ৮০৮০ (0.0.0.0:8080)\033[0m"
দেখাও "\033[1;33m  • নির্ভরতা        : ০% PHP | ০% Libc | ১০০% স্বাধীন মেশিন কোড\033[0m"
দেখাও ""

ধরি শুরু_ক্লক = সিপিউ_ক্লক()
ধরি অনুরোধ_গণনা = ০
ধরি রিকোয়েস্ট_বাফার = মেমরি_বরাদ্দ(৪০৯৬)

// ক্লায়েন্ট রিকোয়েস্ট লুপ (Persistent Request Loop)
ধরি সার্ভার_চলমান = ১
যতক্ষণ সার্ভার_চলমান {
    ধরি ক্লায়েন্ট_এফডি = সকেট_গ্রহণ(সার্ভার_এফডি)
    যদি ক্লায়েন্ট_এফডি >= ০ {
        অনুরোধ_গণনা = অনুরোধ_গণনা + ১
        ধরি পঠিত = ফাইল_পড়ো(ক্লায়েন্ট_এফডি, রিকোয়েস্ট_বাফার, ২০৪৮)

        // রিকোয়েস্ট পাথ রাউটিং (HTTP Request Path Routing)
        ধরি b4 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, ৪)
        ধরি b5 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, ৫)
        ধরি b6 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, ৬)
        ধরি b7 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, ৭)
        ধরি b8 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, ৮)
        ধরি b9 = মেমরি_বাইট_পড়ো(রিকোয়েস্ট_বাফার, ৯)

        // ১. /api/status রাউট (97 = 'a', 112 = 'p', 105 = 'i', 47 = '/', 115 = 's')
        যদি b5 == ৯৭ {
            যদি b6 == ১১২ {
                যদি b7 == ১০৫ {
                    যদি b8 == ৪৭ {
                        যদি b9 == ১১৫ {
                            ডাইনামিক_স্ট্যাটাস_প্রেরণ(ক্লায়েন্ট_এফডি, অনুরোধ_গণনা, শুরু_ক্লক)
                            সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                            দেখাও "  [API ⚡] /api/status সার্ভ হয়েছে | অনুরোধ #" + অনুরোধ_গণনা
                        }
                    }
                }
            }
        }

        // ২. /style.css রাউট (115 = 's', 116 = 't', 121 = 'y')
        যদি b5 == ১১৫ {
            যদি b6 == ১১৬ {
                যদি b7 == ১২১ {
                    ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/webs/public/style.css", "text/css; charset=utf-8")
                    সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                    দেখাও "  [CSS 🎨] /style.css সার্ভ হয়েছে | অনুরোধ #" + অনুরোধ_গণনা
                }
            }
        }

        // ৩. /app.js রাউট (97 = 'a', 112 = 'p', 112 = 'p', 46 = '.')
        যদি b5 == ৯৭ {
            যদি b6 == ১১২ {
                যদি b7 == ১১২ {
                    যদি b8 == ৪৬ {
                        ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/webs/public/app.js", "application/javascript; charset=utf-8")
                        সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                        দেখাও "  [JS 💻] /app.js সার্ভ হয়েছে | অনুরোধ #" + অনুরোধ_গণনা
                    }
                }
            }
        }

        // ৪. /favicon.svg রাউট (102 = 'f', 97 = 'a', 118 = 'v')
        যদি b5 == ১০২ {
            যদি b6 == ৯৭ {
                যদি b7 == ১১৮ {
                    ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/webs/public/favicon.svg", "image/svg+xml")
                    সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
                    দেখাও "  [SVG 👑] /favicon.svg সার্ভ হয়েছে | অনুরোধ #" + অনুরোধ_গণনা
                }
            }
        }

        // ৫. / অথবা /index.html ডিফল্ট হোমপেজ রাউট (32 = ' ', 47 = '/', 105 = 'i')
        যদি b5 == ৩২ {
            ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/webs/public/index.html", "text/html; charset=utf-8")
            সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
            দেখাও "  [HTML 📄] হোমপেজ (/) সার্ভ হয়েছে | অনুরোধ #" + অনুরোধ_গণনা
        }
        যদি b5 == ১০৫ {
            ফাইল_পাঠাও(ক্লায়েন্ট_এফডি, "apps/webs/public/index.html", "text/html; charset=utf-8")
            সকেট_বন্ধ(ক্লায়েন্ট_এফডি)
            দেখাও "  [HTML 📄] /index.html সার্ভ হয়েছে | অনুরোধ #" + অনুরোধ_গণনা
        }
    }
}

মেমরি_মুক্তি(রিকোয়েস্ট_বাফার, ৪০৯৬)
সকেট_বন্ধ(সার্ভার_এফডি)
দেখাও "সার্ভার সমাপ্ত।"
