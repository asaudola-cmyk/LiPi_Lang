// ==============================================================================
// 👑 LIPI FIRST 1.0.0 MIDDLE-END SSA VALUE (src/compiler/middleend/ir/ssa_value.lp)
// ⚡ 100% Pure Lipi First 1.0.0 | Zero C | Zero Libc | Sovereign Compiler Architecture
//
// WHY: In Static Single Assignment (SSA) form, every value represents an immutable
//      computational result produced at a unique program point.
//      Maintaining explicit Def-Use (definition-to-uses) and Use-Def chains directly
//      on the SSA Value object allows optimization algorithms (such as Dead Code
//      Elimination, Constant Propagation, and Loop Invariant Code Motion) to query
//      and update the dependency graph in O(1) or O(uses) time, without scanning
//      the entire instruction stream.
// ==============================================================================

include "src/compiler/middleend/ir/ssa_opcodes.lp"

// ── 1. Value Kinds ────────────────────────────────────────────────────────────
// WHY: Differentiating between instruction results, immediate constants, function
//      arguments, and global symbols prevents illegal transformations (such as
//      attempting to re-assign an argument or hoist a constant).

VAL_KIND_INST    = 1  // Value generated by an instruction result (e.g. %v0)
VAL_KIND_CONST   = 2  // Immediate scalar constant integer (e.g. 42, -1)
VAL_KIND_ARG     = 3  // Formal function argument/parameter (e.g. %arg0)
VAL_KIND_GLOBAL  = 4  // Global variable or function symbol reference (e.g. @main)

// ── 2. SSA Value Structure ───────────────────────────────────────────────────
// WHY: The SSAValue record encapsulates the identity, data type, defining source,
//      and forward consumer list (def-use chain) for every value in the module.

struct SSAValue
    id          // string: unique symbol identifier (e.g. "%v0", "42", "%arg1")
    vtype       // string: type signature (e.g. "i64", "i32", "ptr", "void", "bool")
    kind        // integer: VAL_KIND_*
    const_val   // integer: literal value when kind == VAL_KIND_CONST
    def_inst    // reference: SSAInstr that computes this value (0 if arg/const/global)
    uses        // list: SSAInstr references that consume this value as an operand

// ── 3. Forward Dispatch Hooks ─────────────────────────────────────────────────
// WHY: Standalone compilation of ssa_value.lp requires a default binding for
//      replace_operand, which will be overridden with full instruction operand
//      rewriting when ssa_instr.lp is loaded.
fn ssa_instr_replace_operand inst old_val new_val
    return 0

fn replace_operand inst old_val new_val
    return ssa_instr_replace_operand(inst, old_val, new_val)

// ── 4. Constructors ───────────────────────────────────────────────────────────

// Base constructor for SSAValue
fn ssa_value_new id vtype kind
    val = SSAValue()
    val.id = id
    val.vtype = vtype
    val.kind = kind
    val.const_val = 0
    val.def_inst = 0
    val.uses = list()
    return val

// Creates a value produced as the result of an SSA instruction
// WHY: Links the value directly to its defining instruction (use-def anchor).
fn ssa_value_new_inst id vtype def_inst
    val = ssa_value_new(id, vtype, VAL_KIND_INST)
    val.def_inst = def_inst
    return val

// Creates an immediate integer constant value
// WHY: Constants are treated as first-class SSA values with no defining instruction,
//      simplifying uniform operand handling across all IR instructions.
fn ssa_value_new_const const_int vtype
    id_str = str(const_int)
    val = ssa_value_new(id_str, vtype, VAL_KIND_CONST)
    val.const_val = const_int
    return val

// Creates a formal function argument value
// WHY: Arguments dominate the entire function body starting from the entry block.
fn ssa_value_new_arg id vtype
    return ssa_value_new(id, vtype, VAL_KIND_ARG)

// Creates a global symbol reference value
// WHY: Globals reside in static data segments and have module-wide scope.
fn ssa_value_new_global name vtype
    return ssa_value_new(name, vtype, VAL_KIND_GLOBAL)

// ── 5. Def-Use Chain Management ───────────────────────────────────────────────

// Registers a consuming instruction in this value's def-use list
// WHY: Allows the value to know exactly which instructions must be notified or updated
//      if this value is replaced, folded, or deleted.
fn ssa_value_add_use val inst
    if val == 0 or inst == 0
        return 0
    i = 0
    cnt = len(val.uses)
    while i < cnt
        if get(val.uses, i) == inst
            return 0 // Avoid duplicate registrations
        i = i + 1
    push(val.uses, inst)
    return 1

fn SSAValue.add_use self inst
    return ssa_value_add_use(self, inst)

fn add_use val inst
    return ssa_value_add_use(val, inst)

// Deregisters a consuming instruction from this value's def-use list
// WHY: When an instruction is eliminated or an operand is rewritten, removing stale uses
//      prevents dangling references and ensures use_count accurately reflects liveness.
fn ssa_value_remove_use val inst
    if val == 0 or inst == 0
        return 0
    new_uses = list()
    i = 0
    cnt = len(val.uses)
    found = 0
    while i < cnt
        item = get(val.uses, i)
        if item != inst
            push(new_uses, item)
        else
            found = 1
        i = i + 1
    val.uses = new_uses
    return found

fn SSAValue.remove_use self inst
    return ssa_value_remove_use(self, inst)

fn remove_use val inst
    return ssa_value_remove_use(val, inst)

// Returns the number of instructions consuming this value
// WHY: Single-cycle deadness test: if use_count == 0 and has_side_effects == 0,
//      the defining instruction is dead and can be eliminated immediately.
fn ssa_value_use_count val
    if val == 0 return 0
    return len(val.uses)

fn SSAValue.use_count self
    return ssa_value_use_count(self)

fn use_count val
    return ssa_value_use_count(val)

// Returns 1 if this value is consumed by at least one active instruction
fn ssa_value_is_used val
    if val == 0 return 0
    return len(val.uses) > 0

fn SSAValue.is_used self
    return ssa_value_is_used(self)

// Returns 1 if this value is an immediate constant
fn ssa_value_is_const val
    if val == 0 return 0
    return val.kind == VAL_KIND_CONST

fn SSAValue.is_const self
    return ssa_value_is_const(self)

// ── 6. Core SSA Transformation: Replace All Uses With (RAUW) ─────────────────
// WHY: "Replace All Uses With" is the central transformation primitive of SSA form.
//      When an optimization determines that `old_val` is redundant (e.g. constant folded,
//      copy propagated, or common subexpression eliminated), RAUW updates all consuming
//      instructions to use `new_val` instead, updating def-use chains atomically.
fn ssa_value_replace_all_uses_with old_val new_val
    if old_val == 0 or new_val == 0 or old_val == new_val
        return 0
    
    // Copy the uses list because replace_operand will modify use chains
    consumer_list = list()
    i = 0
    cnt = len(old_val.uses)
    while i < cnt
        push(consumer_list, get(old_val.uses, i))
        i = i + 1
    
    idx = 0
    replaced_count = 0
    while idx < cnt
        user_inst = get(consumer_list, idx)
        if user_inst != 0
            // Call instruction helper to rewrite operand pointers
            replace_operand(user_inst, old_val, new_val)
            replaced_count = replaced_count + 1
        idx = idx + 1
    
    // Clear out this value's uses now that all consumers have transitioned
    old_val.uses = list()
    return replaced_count

fn SSAValue.replace_all_uses_with self new_val
    return ssa_value_replace_all_uses_with(self, new_val)

fn replace_all_uses_with old_val new_val
    return ssa_value_replace_all_uses_with(old_val, new_val)

// Formats value identifier for human-readable IR dumps
fn ssa_value_to_str val
    if val == 0 return "<nil>"
    if val.kind == VAL_KIND_CONST
        return str(val.const_val)
    return val.id

fn SSAValue.to_str self
    return ssa_value_to_str(self)

fn to_str_val val
    return ssa_value_to_str(val)
