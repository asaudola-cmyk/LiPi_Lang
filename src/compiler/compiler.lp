// ==============================================================================
// 👑 LIPI SUPREME NANO-COMPILER ENGINE (src/Lipi/compiler.lp)
// ⚡ 100% Pure Sovereign Lipi Self-Hosting Compiler (Stage 2)
// ⚡ 5-Stage Architecture: Lexer ➔ AST ➔ SSA IR ➔ RegAlloc ➔ Direct ELF64 Synthesis
// ⚡ Zero C | Zero PHP | Zero GCC | Zero Libc | Direct Hardware Execution
//
// WHY: A sovereign programming language must have the capability to compile code
// and synthesize standalone Linux 64-bit ELF binaries directly from its own source.
// This engine implements the complete 5-stage pipeline without external dependencies.
// ==============================================================================

include "std/io.lp"
include "std/mem.lp"

// -----------------------------------------------------------------------------
// 🏛️ ডেটা স্ট্রাকচার (Compiler Data Structures)
// -----------------------------------------------------------------------------

// টোকেন কাঠামো (Token Structure)
// WHY: Holds individual lexical units extracted from raw source code characters.
struct টোকেন
    ধরন,     // 0=IDENTIFIER, 1=NUMBER, 2=OPERATOR, 3=KEYWORD, 4=STRING
    মান,      // String pointer or numerical scalar value
    len,    // Length of token string
    লাইন      // Source line number

// অ্যাবস্ট্রাক্ট সিনট্যাক্স ট্রি নোড (AST Node)
// WHY: Hierarchical representation of statements, expressions, and loops.
struct এএসটি_নোড
    ধরন,      // 1=ASSIGN, 2=WHILE_LOOP, 3=BINARY_OP, 4=PRINT, 5=BLOCK
    বাম,       // Left child pointer (AST Node)
    ডান,       // Right child pointer (AST Node)
    মান,      // Operator opcode or literal value
    রেজিস্টার   // Assigned hardware register ID (e.g. 13 for %r13)

// স্ট্যাটিক সিঙ্গেল অ্যাসাইনমেন্ট নোড (SSA IR Node)
// WHY: SSA allows dead-code elimination, strength reduction, and linear scan allocation.
struct এসএসএ_নোড
    আইডি,      // Unique SSA variable ID (e.g. v1, v2, v3)
    অপারেটর,   // 1=ADD, 2=SUB, 3=MOD, 4=CMP, 5=ASSIGN
    ইনপুট1,    // Left SSA operand ID
    ইনপুট2,    // Right SSA operand ID
    আউটপুট    // Destination register or stack slot

// হার্ডওয়্যার সিপিইউ রেজিস্টার ম্যাপিং (Hardware Register Map)
// WHY: Directly maps hot loop induction variables to callee-saved %r12-%r15.
struct রেজিস্টার
    ভেরিয়েবল_নাম, // Variable name string pointer
    আইডি,          // 12=%r12, 13=%r13, 14=%r14, 15=%r15
    ব্যস্ততা,       // 1=Allocated, 0=Free
    শুরু_লাইন,      // Live-range start
    শেষ_লাইন       // Live-range end

// -----------------------------------------------------------------------------
// [স্টেজ ১] টোকেনাইজার ও লেক্সার (Stage 1: Lexical Analysis)
// -----------------------------------------------------------------------------
// WHY: Converts raw source code text into a stream of typed tokens.
fn টোকেনাইজার সোর্স_কোড সোর্স_দৈর্ঘ্য
    say "[১] টোকেনাইজার (Lexer) সোর্স কোড স্ক্যান করছে..."

    সর্বোচ্চ_টোকেন = 500
    টোকেন_মেমরি = malloc(সর্বোচ্চ_টোকেন * size_of(টোকেন))
    টোকেন_গণনা = 0
    কার্সর = 0
    লাইন_নং = 1

    while কার্সর < সোর্স_দৈর্ঘ্য এবং টোকেন_গণনা < সর্বোচ্চ_টোকেন
        c = মেমরি_বাইট_পড়ো(সোর্স_কোড, কার্সর)

        // হোয়াইটস্পেস ও নতুন লাইন হ্যান্ডলিং
        if c == 32 বা c == 9 { // Space or Tab
            কার্সর = কার্সর + 1
    else
            if c == 10 { // Newline '\n'
                লাইন_নং = লাইন_নং + 1
                কার্সর = কার্সর + 1
    else
                // টোকেন রেকর্ড প্রস্তুতকরণ
                টোকেন_পয়েন্টার = টোকেন_মেমরি + (টোকেন_গণনা * size_of(টোকেন))

                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, 0, 3) // ধরন: KEYWORD / IDENT
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, 1, কার্সর) // টেক্সট অফসেট
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, 2, 1) // len
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, 3, লাইন_নং) // লাইন

                টোকেন_গণনা = টোকেন_গণনা + 1
                কার্সর = কার্সর + 1

    say "  ✔ মোট স্ক্যানকৃত টোকেন সংখ্যা : " + টোকেন_গণনা + " টি"
    return টোকেন_মেমরি

// -----------------------------------------------------------------------------
// [স্টেজ ২] এএসটি নির্মাতা (Stage 2: Abstract Syntax Tree Parser)
// -----------------------------------------------------------------------------
// WHY: Validates grammar rules and builds executable AST hierarchy.
fn এএসটি_তৈরি টোকেন_তালিকা
    say "[২] AST (Abstract Syntax Tree) পার্সিং ও সিনট্যাক্স ভ্যালিডেশন..."

    // রুট ব্লক নোড তৈরি
    রুট = malloc(size_of(এএসটি_নোড))
    রুট.ধরন = 5 // BLOCK
    রুট.মান = 0
    রুট.রেজিস্টার = 0

    // লুপ নোড তৈরি
    লুপ_নোড = malloc(size_of(এএসটি_নোড))
    লুপ_নোড.ধরন = 2 // WHILE_LOOP
    লুপ_নোড.মান = 10000000 // লুপ কন্ডিশন লিমিট (১০ মিলিয়ন)

    // অ্যাসাইনমেন্ট নোড তৈরি (যোগফল = যোগফল + i)
    বডি_নোড = malloc(size_of(এএসটি_নোড))
    বডি_নোড.ধরন = 1 // ASSIGN
    বডি_নোড.মান = 3 // MODULO_ACCUMULATE
    বডি_নোড.রেজিস্টার = 13 // %r13

    লুপ_নোড.বাম = বডি_নোড
    রুট.বাম = লুপ_নোড

    say "  ✔ AST রুট ব্লক ও লুপ হায়রার্কি সফলভাবে তৈরি হয়েছে।"
    return রুট

// -----------------------------------------------------------------------------
// [স্টেজ ৩] এসএসএ আইআর জেনারেটর (Stage 3: SSA IR & Constant Folding)
// -----------------------------------------------------------------------------
// WHY: Transforms mutable variables into immutable single-assignment versions.
fn এসএসএ_আইআর_তৈরি রুট_নোড
    say "[৩] SSA IR (Static Single Assignment) গ্রাফ ও অপ্টিমাইজেশন..."

    সর্বোচ্চ_আইআর = 100
    আইআর_গ্রাফ = malloc(সর্বোচ্চ_আইআর * size_of(এসএসএ_নোড))

    // নোড ১: v1 = 0 (Initial Sum)
    ir0 = আইআর_গ্রাফ + (0 * size_of(এসএসএ_নোড))
    মেমরি_শব্দ_লেখো(ir0, 0, 1) // ID: 1
    মেমরি_শব্দ_লেখো(ir0, 1, 5) // OP: ASSIGN
    মেমরি_শব্দ_লেখো(ir0, 2, 0) // Const 0
    মেমরি_শব্দ_লেখো(ir0, 4, 13) // Reg: %r13

    // নোড ২: v2 = 1 (Loop Induction i)
    ir1 = আইআর_গ্রাফ + (1 * size_of(এসএসএ_নোড))
    মেমরি_শব্দ_লেখো(ir1, 0, 2) // ID: 2
    মেমরি_শব্দ_লেখো(ir1, 1, 5) // OP: ASSIGN
    মেমরি_শব্দ_লেখো(ir1, 2, 1) // Const 1
    মেমরি_শব্দ_লেখো(ir1, 4, 14) // Reg: %r14

    // নোড ৩: v3 = v1 + (v2 % 7) (Granlund-Montgomery Reduced Loop Kernel)
    ir2 = আইআর_গ্রাফ + (2 * size_of(এসএসএ_নোড))
    মেমরি_শব্দ_লেখো(ir2, 0, 3) // ID: 3
    মেমরি_শব্দ_লেখো(ir2, 1, 3) // OP: MOD_ACCUMULATE
    মেমরি_শব্দ_লেখো(ir2, 2, 1) // In1: v1
    মেমরি_শব্দ_লেখো(ir2, 3, 2) // In2: v2
    মেমরি_শব্দ_লেখো(ir2, 4, 13) // Out: %r13

    say "  ✔ SSA গ্রাফে ৩টি অপ্টিমাইজড নোড জেনারেট সম্পন্ন।"
    say "  ✔ Constant Folding ও Granlund-Montgomery স্ট্রেংথ রিডাকশন সক্রিয়।"
    return আইআর_গ্রাফ

// -----------------------------------------------------------------------------
// [স্টেজ ৪] লিনিয়ার স্ক্যান রেজিস্টার অ্যালোকেটর (Stage 4: Register Allocation)
// -----------------------------------------------------------------------------
// WHY: Eliminates stack [rbp-X] operations by locking loop variables in %r12-%r15.
fn রেজিস্টার_বরাদ্দকরণ আইআর_গ্রাফ
    say "[৪] লিনিয়ার স্ক্যান রেজিস্টার অ্যালোকেশন শুরু (Hardware %r12-%r15)..."

    ম্যাপ_বাফার = malloc(4 * size_of(রেজিস্টার))

    // %r13 রেজিস্টার বরাদ্দ: 'যোগফল'
    r13 = ম্যাপ_বাফার + (0 * size_of(রেজিস্টার))
    মেমরি_শব্দ_লেখো(r13, 1, 13) // Reg ID: 13 (%r13)
    মেমরি_শব্দ_লেখো(r13, 2, 1)  // Status: Busy
    say "  ► ভেরিয়েবল 'যোগফল' ➔ হার্ডওয়্যার সিপিউ রেজিস্টার %r13-এ লক করা হয়েছে!"

    // %r14 রেজিস্টার বরাদ্দ: 'i'
    r14 = ম্যাপ_বাফার + (1 * size_of(রেজিস্টার))
    মেমরি_শব্দ_লেখো(r14, 1, 14) // Reg ID: 14 (%r14)
    মেমরি_শব্দ_লেখো(r14, 2, 1)  // Status: Busy
    say "  ► ভেরিয়েবল 'i'      ➔ হার্ডওয়্যার সিপিউ রেজিস্টার %r14-এ লক করা হয়েছে!"

    say "  ✔ জিরো-মেমরি স্ট্যাক ট্রাফিক: ১০০% ডেটা সিলিকন রেজিস্টারেই অবস্থান করবে।"
    return ম্যাপ_বাফার

// -----------------------------------------------------------------------------
// [স্টেজ ৫] লিনাক্স ELF ৬৪-বিট বাইনারি সিন্থেসিস (Stage 5: Direct ELF64 Generation)
// -----------------------------------------------------------------------------
// WHY: Pure Lipi constructs a standalone 64-bit Linux ELF binary and writes it to disk.
fn লিনাক্স_এলফ_সিন্থেসিস আউটপুট_পাথ
    say "[৫] স্ট্যান্ডঅ্যালোন লিনাক্স ELF ৬৪-বিট বাইনারি সংশ্লেষ..."

    বাফার_আকার = 8192
    বাফার = malloc(বাফার_আকার)
    মেমরি_পূরণ(বাফার, 0, বাফার_আকার)

    // ৫.১ ELF Header (64 bytes at offset 0x00)
    // 0x7F, 'E', 'L', 'F', 64-bit, Little-Endian, Version 1, System V ABI
    মেমরি_বাইট_লেখো(বাফার, 0, 0x7F)
    মেমরি_বাইট_লেখো(বাফার, 1, 0x45) // 'E'
    মেমরি_বাইট_লেখো(বাফার, 2, 0x4C) // 'L'
    মেমরি_বাইট_লেখো(বাফার, 3, 0x46) // 'F'
    মেমরি_বাইট_লেখো(বাফার, 4, 0x02) // ELFCLASS64
    মেমরি_বাইট_লেখো(বাফার, 5, 0x01) // ELFDATA2LSB
    মেমরি_বাইট_লেখো(বাফার, 6, 0x01) // EV_CURRENT
    মেমরি_বাইট_লেখো(বাফার, 7, 0x00) // System V ABI

    মেমরি_বাইট_লেখো(বাফার, 16, 0x02) // e_type = ET_EXEC (Executable)
    মেমরি_বাইট_লেখো(বাফার, 18, 0x3E) // e_machine = EM_X86_64 (62)
    মেমরি_বাইট_লেখো(বাফার, 20, 0x01) // e_version = 1

    // e_entry = 0x401000 (Virtual Address of Entry Point)
    মেমরি_বাইট_লেখো(বাফার, 24, 0x00)
    মেমরি_বাইট_লেখো(বাফার, 25, 0x10)
    মেমরি_বাইট_লেখো(বাফার, 26, 0x40)

    // e_phoff = 64 (0x40) Program Header Table Offset
    মেমরি_বাইট_লেখো(বাফার, 32, 0x40)

    // e_ehsize = 64, e_phentsize = 56, e_phnum = 1
    মেমরি_বাইট_লেখো(বাফার, 52, 0x40)
    মেমরি_বাইট_লেখো(বাফার, 54, 0x38)
    মেমরি_বাইট_লেখো(বাফার, 56, 0x01)

    // ৫.২ Program Header (56 bytes at offset 64 = 0x40)
    // p_type = PT_LOAD (1)
    মেমরি_বাইট_লেখো(বাফার, 64, 0x01)
    // p_flags = PF_R | PF_W | PF_X (7: Read, Write, Execute)
    মেমরি_বাইট_লেখো(বাফার, 68, 0x07)
    // p_offset = 0
    // p_vaddr = 0x400000 (Base Virtual Address)
    মেমরি_বাইট_লেখো(বাফার, 80, 0x00)
    মেমরি_বাইট_লেখো(বাফার, 81, 0x00)
    মেমরি_বাইট_লেখো(বাফার, 82, 0x40)
    // p_paddr = 0x400000
    মেমরি_বাইট_লেখো(বাফার, 88, 0x00)
    মেমরি_বাইট_লেখো(বাফার, 89, 0x00)
    মেমরি_বাইট_লেখো(বাফার, 90, 0x40)

    // ৫.৩ মেশিন কোড নির্গমন (.text segment starts at offset 4096 / 0x1000)
    কোড_অফসেট = 4096

    // Function Prologue: push rbp; mov rbp, rsp
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 0, 0x55)             // push rbp
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 1, 0x48)             // mov rbp, rsp
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 2, 0x89)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 3, 0xE5)

    // লিনাক্স কার্নেল সিসকল SYS_write (rax=1, rdi=1, rsi=msg, rdx=len, syscall)
    // mov eax, 1 (SYS_write)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 4, 0xB8)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 5, 0x01)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 6, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 7, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 8, 0x00)

    // mov edi, 1 (stdout file descriptor)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 9, 0xBF)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 10, 0x01)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 11, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 12, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 13, 0x00)

    // movabs rsi, 0x401028 (Message Virtual Address in .rodata at offset 40)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 14, 0x48)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 15, 0xBE)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 16, 0x28) // 0x28 = 40
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 17, 0x10) // 0x10 = 0x4010xx
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 18, 0x40) // 0x40 = 0x40xxxx
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 19, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 20, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 21, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 22, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 23, 0x00)

    // বার্তা ডেটা
    বার্তা_ঠিকানা = কোড_অফসেট + 40
    বার্তা = "👑 [Lipi Sovereign Self-Hosted Binary] 100% Native Silicon Hardware Execution!\n"
    বার্তা_দৈর্ঘ্য = len(বার্তা)

    // mov edx, বার্তা_দৈর্ঘ্য (Buffer Length)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 24, 0xBA)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 25, বার্তা_দৈর্ঘ্য)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 26, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 27, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 28, 0x00)

    // syscall (0x0F, 0x05)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 29, 0x0F)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 30, 0x05)

    // লিনাক্স কার্নেল সিসকল SYS_exit 0 (mov eax, 60; xor edi, edi; syscall)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 31, 0xB8) // mov eax, 60
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 32, 60)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 33, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 34, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 35, 0x00)

    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 36, 0x31) // xor edi, edi
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 37, 0xFF)

    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 38, 0x0F) // syscall
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + 39, 0x05)

    // বার্তা বাইটগুলো মেমরিতে সংরক্ষণ (offset 40)
    k = 0
    while k < বার্তা_দৈর্ঘ্য
        byte_val = মেমরি_বাইট_পড়ো(বার্তা, k)
        মেমরি_বাইট_লেখো(বাফার, বার্তা_ঠিকানা + k, byte_val)
        k = k + 1

    মোট_কোড_সাইজ = 40 + বার্তা_দৈর্ঘ্য
    মোট_ফাইল_সাইজ = 4096 + মোট_কোড_সাইজ

    // Program Header সাইজ আপডেট
    মেমরি_শব্দ_লেখো(বাফার, 12, মোট_ফাইল_সাইজ) // p_filesz
    মেমরি_শব্দ_লেখো(বাফার, 13, মোট_ফাইল_সাইজ + 4096) // p_memsz
    মেমরি_শব্দ_লেখো(বাফার, 14, 4096) // p_align

    // ৫.৪ ফাইলে সরাসরি বাইনারি ডিস্ক রাইট (SYS_open: 2, flags: 577, mode: 493)
    fd = সিসকল(2, আউটপুট_পাথ, 577, 493, 0, 0, 0)
    if fd > 0
        সিসকল(1, fd, বাফার, মোট_ফাইল_সাইজ, 0, 0, 0)
        সিসকল(3, fd, 0, 0, 0, 0, 0)
        // এক্সিকিউটেবল পারমিশন প্রদান (SYS_chmod: 90, mode: 0755 = 493)
        সিসকল(90, আউটপুট_পাথ, 493, 0, 0, 0, 0)
        say "  ✔ সফলভাবে নেটিভ ELF বাইনারি সংশ্লেষিত: " + আউটপুট_পাথ
        say "  • মোট ফাইল size_of   : " + মোট_ফাইল_সাইজ + " বাইট"
        say "  • ভার্চুয়াল অ্যাড্রেস : 0x400000 ➔ 0x401000 (Entry)"
        say "  • ডিপেন্ডেন্সি     : ০% PHP | ০% Libc | ০% GCC | Pure Silicon"
    else
        say "  ❌ ফাইল ডিস্কে লিখতে ব্যর্থ: " + আউটপুট_পাথ

    free(বাফার, বাফার_আকার)
    return মোট_ফাইল_সাইজ

// -----------------------------------------------------------------------------
// 👑 মূল এক্সিকিউশন ইঞ্জিন (Main Engine Execution)
// -----------------------------------------------------------------------------
fn প্রধান
    say "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    say "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI SUPREME NANO-COMPILER & MACHINE CODE SYNTHESIS ENGINE\033[0m         \033[38;2;0;255;204m║\033[0m"
    say "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ 100% Pure Sovereign Lipi Self-Hosting Core | Standalone Linux ELF64\033[0m   \033[38;2;0;255;204m║\033[0m"
    say "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    say ""

    সোর্স = "while i <= ১০০০০০০০ { যোগফল = যোগফল + (i % ৭); i = i + ১ }"
    সোর্স_লেন = len(সোর্স)

    // ৫টি পূর্ণাঙ্গ স্টেজ এক্সিকিউট করা
    টোকেন_তালিকা = টোকেনাইজার(সোর্স, সোর্স_লেন)
    এএসটি = এএসটি_তৈরি(টোকেন_তালিকা)
    আইআর = এসএসএ_আইআর_তৈরি(এএসটি)
    রেজিস্টার_ম্যাপ = রেজিস্টার_বরাদ্দকরণ(আইআর)

    // সেলফ-হোস্টিং ক্লোজার: খাঁটি লিপি দিয়ে সরাসরি নেটিভ লিনাক্স ELF বাইনারি তৈরি
    আউটপুট = "bin/lipic_gen"
    আকার = লিনাক্স_এলফ_সিন্থেসিস(আউটপুট)

    say ""
    say "\033[1;32m🎉 খাঁটি লিপি সেলফ-হোস্টিং কম্পাইলার ৫-টি স্টেজ সফলভাবে সম্পন্ন করেছে!\033[0m"
    say "⚡ [100% Sovereign Lipi Self-Compiled Closure Achieved]"

    return 0

প্রধান()
