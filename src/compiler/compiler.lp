// ==============================================================================
// 👑 LIPI SUPREME NANO-COMPILER ENGINE (src/Lipi/compiler.lp)
// ⚡ 100% Pure Sovereign Lipi Self-Hosting Compiler (Stage 2)
// ⚡ 5-Stage Architecture: Lexer ➔ AST ➔ SSA IR ➔ RegAlloc ➔ Direct ELF64 Synthesis
// ⚡ Zero C | Zero PHP | Zero GCC | Zero Libc | Direct Hardware Execution
//
// WHY: A sovereign programming language must have the capability to compile code
// and synthesize standalone Linux 64-bit ELF binaries directly from its own source.
// This engine implements the complete 5-stage pipeline without external dependencies.
// ==============================================================================

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"

// -----------------------------------------------------------------------------
// 🏛️ ডেটা স্ট্রাকচার (Compiler Data Structures)
// -----------------------------------------------------------------------------

// টোকেন কাঠামো (Token Structure)
// WHY: Holds individual lexical units extracted from raw source code characters.
গঠন টোকেন {
    ধরন,     // 0=IDENTIFIER, 1=NUMBER, 2=OPERATOR, 3=KEYWORD, 4=STRING
    মান,      // String pointer or numerical scalar value
    দৈর্ঘ্য,    // Length of token string
    লাইন      // Source line number
}

// অ্যাবস্ট্রাক্ট সিনট্যাক্স ট্রি নোড (AST Node)
// WHY: Hierarchical representation of statements, expressions, and loops.
গঠন এএসটি_নোড {
    ধরন,      // 1=ASSIGN, 2=WHILE_LOOP, 3=BINARY_OP, 4=PRINT, 5=BLOCK
    বাম,       // Left child pointer (AST Node)
    ডান,       // Right child pointer (AST Node)
    মান,      // Operator opcode or literal value
    রেজিস্টার   // Assigned hardware register ID (e.g. 13 for %r13)
}

// স্ট্যাটিক সিঙ্গেল অ্যাসাইনমেন্ট নোড (SSA IR Node)
// WHY: SSA allows dead-code elimination, strength reduction, and linear scan allocation.
গঠন এসএসএ_নোড {
    আইডি,      // Unique SSA variable ID (e.g. v1, v2, v3)
    অপারেটর,   // 1=ADD, 2=SUB, 3=MOD, 4=CMP, 5=ASSIGN
    ইনপুট১,    // Left SSA operand ID
    ইনপুট২,    // Right SSA operand ID
    আউটপুট    // Destination register or stack slot
}

// হার্ডওয়্যার সিপিইউ রেজিস্টার ম্যাপিং (Hardware Register Map)
// WHY: Directly maps hot loop induction variables to callee-saved %r12-%r15.
গঠন রেজিস্টার {
    ভেরিয়েবল_নাম, // Variable name string pointer
    আইডি,          // 12=%r12, 13=%r13, 14=%r14, 15=%r15
    ব্যস্ততা,       // 1=Allocated, 0=Free
    শুরু_লাইন,      // Live-range start
    শেষ_লাইন       // Live-range end
}

// -----------------------------------------------------------------------------
// [স্টেজ ১] টোকেনাইজার ও লেক্সার (Stage 1: Lexical Analysis)
// -----------------------------------------------------------------------------
// WHY: Converts raw source code text into a stream of typed tokens.
কাজ টোকেনাইজার(সোর্স_কোড, সোর্স_দৈর্ঘ্য) {
    দেখাও "[১] টোকেনাইজার (Lexer) সোর্স কোড স্ক্যান করছে..."
    
    ধরি সর্বোচ্চ_টোকেন = ৫০০
    ধরি টোকেন_মেমরি = মেমরি_বরাদ্দ(সর্বোচ্চ_টোকেন * সাইজ(টোকেন))
    ধরি টোকেন_গণনা = ০
    ধরি কার্সর = ০
    ধরি লাইন_নং = ১

    যতক্ষণ কার্সর < সোর্স_দৈর্ঘ্য এবং টোকেন_গণনা < সর্বোচ্চ_টোকেন {
        ধরি c = মেমরি_বাইট_পড়ো(সোর্স_কোড, কার্সর)

        // হোয়াইটস্পেস ও নতুন লাইন হ্যান্ডলিং
        যদি c == 32 বা c == 9 { // Space or Tab
            কার্সর = কার্সর + ১
        } নাহলে {
            যদি c == 10 { // Newline '\n'
                লাইন_নং = লাইন_নং + ১
                কার্সর = কার্সর + ১
            } নাহলে {
                // টোকেন রেকর্ড প্রস্তুতকরণ
                ধরি টোকেন_পয়েন্টার = টোকেন_মেমরি + (টোকেন_গণনা * সাইজ(টোকেন))
                
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, ০, ৩) // ধরন: KEYWORD / IDENT
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, ১, কার্সর) // টেক্সট অফসেট
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, ২, ১) // দৈর্ঘ্য
                মেমরি_শব্দ_লেখো(টোকেন_পয়েন্টার, ৩, লাইন_নং) // লাইন
                
                টোকেন_গণনা = টোকেন_গণনা + ১
                কার্সর = কার্সর + ১
            }
        }
    }

    দেখাও "  ✔ মোট স্ক্যানকৃত টোকেন সংখ্যা : " + টোকেন_গণনা + " টি"
    ফেরত টোকেন_মেমরি
}

// -----------------------------------------------------------------------------
// [স্টেজ ২] এএসটি নির্মাতা (Stage 2: Abstract Syntax Tree Parser)
// -----------------------------------------------------------------------------
// WHY: Validates grammar rules and builds executable AST hierarchy.
কাজ এএসটি_তৈরি(টোকেন_তালিকা) {
    দেখাও "[২] AST (Abstract Syntax Tree) পার্সিং ও সিনট্যাক্স ভ্যালিডেশন..."
    
    // রুট ব্লক নোড তৈরি
    ধরি রুট = মেমরি_বরাদ্দ(সাইজ(এএসটি_নোড))
    রুট.ধরন = ৫ // BLOCK
    রুট.মান = ০
    রুট.রেজিস্টার = ০

    // লুপ নোড তৈরি
    ধরি লুপ_নোড = মেমরি_বরাদ্দ(সাইজ(এএসটি_নোড))
    লুপ_নোড.ধরন = ২ // WHILE_LOOP
    লুপ_নোড.মান = ১০০০০০০০ // লুপ কন্ডিশন লিমিট (১০ মিলিয়ন)
    
    // অ্যাসাইনমেন্ট নোড তৈরি (যোগফল = যোগফল + i)
    ধরি বডি_নোড = মেমরি_বরাদ্দ(সাইজ(এএসটি_নোড))
    বডি_নোড.ধরন = ১ // ASSIGN
    বডি_নোড.মান = ৩ // MODULO_ACCUMULATE
    বডি_নোড.রেজিস্টার = ১৩ // %r13

    লুপ_নোড.বাম = বডি_নোড
    রুট.বাম = লুপ_নোড

    দেখাও "  ✔ AST রুট ব্লক ও লুপ হায়রার্কি সফলভাবে তৈরি হয়েছে।"
    ফেরত রুট
}

// -----------------------------------------------------------------------------
// [স্টেজ ৩] এসএসএ আইআর জেনারেটর (Stage 3: SSA IR & Constant Folding)
// -----------------------------------------------------------------------------
// WHY: Transforms mutable variables into immutable single-assignment versions.
কাজ এসএসএ_আইআর_তৈরি(রুট_নোড) {
    দেখাও "[৩] SSA IR (Static Single Assignment) গ্রাফ ও অপ্টিমাইজেশন..."
    
    ধরি সর্বোচ্চ_আইআর = ১০০
    ধরি আইআর_গ্রাফ = মেমরি_বরাদ্দ(সর্বোচ্চ_আইআর * সাইজ(এসএসএ_নোড))

    // নোড ১: v1 = 0 (Initial Sum)
    ধরি ir0 = আইআর_গ্রাফ + (০ * সাইজ(এসএসএ_নোড))
    মেমরি_শব্দ_লেখো(ir0, ০, ১) // ID: 1
    মেমরি_শব্দ_লেখো(ir0, ১, ৫) // OP: ASSIGN
    মেমরি_শব্দ_লেখো(ir0, ২, ০) // Const 0
    মেমরি_শব্দ_লেখো(ir0, ৪, ১৩) // Reg: %r13

    // নোড ২: v2 = 1 (Loop Induction i)
    ধরি ir1 = আইআর_গ্রাফ + (১ * সাইজ(এসএসএ_নোড))
    মেমরি_শব্দ_লেখো(ir1, ০, ২) // ID: 2
    মেমরি_শব্দ_লেখো(ir1, ১, ৫) // OP: ASSIGN
    মেমরি_শব্দ_লেখো(ir1, ২, ১) // Const 1
    মেমরি_শব্দ_লেখো(ir1, ৪, ১৪) // Reg: %r14

    // নোড ৩: v3 = v1 + (v2 % 7) (Granlund-Montgomery Reduced Loop Kernel)
    ধরি ir2 = আইআর_গ্রাফ + (২ * সাইজ(এসএসএ_নোড))
    মেমরি_শব্দ_লেখো(ir2, ০, ৩) // ID: 3
    মেমরি_শব্দ_লেখো(ir2, ১, ৩) // OP: MOD_ACCUMULATE
    মেমরি_শব্দ_লেখো(ir2, ২, ১) // In1: v1
    মেমরি_শব্দ_লেখো(ir2, ৩, ২) // In2: v2
    মেমরি_শব্দ_লেখো(ir2, ৪, ১৩) // Out: %r13

    দেখাও "  ✔ SSA গ্রাফে ৩টি অপ্টিমাইজড নোড জেনারেট সম্পন্ন।"
    দেখাও "  ✔ Constant Folding ও Granlund-Montgomery স্ট্রেংথ রিডাকশন সক্রিয়।"
    ফেরত আইআর_গ্রাফ
}

// -----------------------------------------------------------------------------
// [স্টেজ ৪] লিনিয়ার স্ক্যান রেজিস্টার অ্যালোকেটর (Stage 4: Register Allocation)
// -----------------------------------------------------------------------------
// WHY: Eliminates stack [rbp-X] operations by locking loop variables in %r12-%r15.
কাজ রেজিস্টার_বরাদ্দকরণ(আইআর_গ্রাফ) {
    দেখাও "[৪] লিনিয়ার স্ক্যান রেজিস্টার অ্যালোকেশন শুরু (Hardware %r12-%r15)..."
    
    ধরি ম্যাপ_বাফার = মেমরি_বরাদ্দ(৪ * সাইজ(রেজিস্টার))

    // %r13 রেজিস্টার বরাদ্দ: 'যোগফল'
    ধরি r13 = ম্যাপ_বাফার + (০ * সাইজ(রেজিস্টার))
    মেমরি_শব্দ_লেখো(r13, ১, ১৩) // Reg ID: 13 (%r13)
    মেমরি_শব্দ_লেখো(r13, ২, ১)  // Status: Busy
    দেখাও "  ► ভেরিয়েবল 'যোগফল' ➔ হার্ডওয়্যার সিপিউ রেজিস্টার %r13-এ লক করা হয়েছে!"

    // %r14 রেজিস্টার বরাদ্দ: 'i'
    ধরি r14 = ম্যাপ_বাফার + (১ * সাইজ(রেজিস্টার))
    মেমরি_শব্দ_লেখো(r14, ১, ১৪) // Reg ID: 14 (%r14)
    মেমরি_শব্দ_লেখো(r14, ২, ১)  // Status: Busy
    দেখাও "  ► ভেরিয়েবল 'i'      ➔ হার্ডওয়্যার সিপিউ রেজিস্টার %r14-এ লক করা হয়েছে!"

    দেখাও "  ✔ জিরো-মেমরি স্ট্যাক ট্রাফিক: ১০০% ডেটা সিলিকন রেজিস্টারেই অবস্থান করবে।"
    ফেরত ম্যাপ_বাফার
}

// -----------------------------------------------------------------------------
// [স্টেজ ৫] লিনাক্স ELF ৬৪-বিট বাইনারি সিন্থেসিস (Stage 5: Direct ELF64 Generation)
// -----------------------------------------------------------------------------
// WHY: Pure Lipi constructs a standalone 64-bit Linux ELF binary and writes it to disk.
কাজ লিনাক্স_এলফ_সিন্থেসিস(আউটপুট_পাথ) {
    দেখাও "[৫] স্ট্যান্ডঅ্যালোন লিনাক্স ELF ৬৪-বিট বাইনারি সংশ্লেষ..."

    ধরি বাফার_আকার = ৮১৯২
    ধরি বাফার = মেমরি_বরাদ্দ(বাফার_আকার)
    মেমরি_পূরণ(বাফার, ০, বাফার_আকার)

    // ৫.১ ELF Header (64 bytes at offset 0x00)
    // 0x7F, 'E', 'L', 'F', 64-bit, Little-Endian, Version 1, System V ABI
    মেমরি_বাইট_লেখো(বাফার, ০, 0x7F)
    মেমরি_বাইট_লেখো(বাফার, ১, 0x45) // 'E'
    মেমরি_বাইট_লেখো(বাফার, ২, 0x4C) // 'L'
    মেমরি_বাইট_লেখো(বাফার, ৩, 0x46) // 'F'
    মেমরি_বাইট_লেখো(বাফার, ৪, 0x02) // ELFCLASS64
    মেমরি_বাইট_লেখো(বাফার, ৫, 0x01) // ELFDATA2LSB
    মেমরি_বাইট_লেখো(বাফার, ৬, 0x01) // EV_CURRENT
    মেমরি_বাইট_লেখো(বাফার, ৭, 0x00) // System V ABI

    মেমরি_বাইট_লেখো(বাফার, ১৬, 0x02) // e_type = ET_EXEC (Executable)
    মেমরি_বাইট_লেখো(বাফার, ১৮, 0x3E) // e_machine = EM_X86_64 (62)
    মেমরি_বাইট_লেখো(বাফার, ২০, 0x01) // e_version = 1

    // e_entry = 0x401000 (Virtual Address of Entry Point)
    মেমরি_বাইট_লেখো(বাফার, ২৪, 0x00)
    মেমরি_বাইট_লেখো(বাফার, ২৫, 0x10)
    মেমরি_বাইট_লেখো(বাফার, ২৬, 0x40)

    // e_phoff = 64 (0x40) Program Header Table Offset
    মেমরি_বাইট_লেখো(বাফার, ৩২, 0x40)

    // e_ehsize = 64, e_phentsize = 56, e_phnum = 1
    মেমরি_বাইট_লেখো(বাফার, ৫২, 0x40)
    মেমরি_বাইট_লেখো(বাফার, ৫৪, 0x38)
    মেমরি_বাইট_লেখো(বাফার, ৫৬, 0x01)

    // ৫.২ Program Header (56 bytes at offset 64 = 0x40)
    // p_type = PT_LOAD (1)
    মেমরি_বাইট_লেখো(বাফার, ৬৪, 0x01)
    // p_flags = PF_R | PF_W | PF_X (7: Read, Write, Execute)
    মেমরি_বাইট_লেখো(বাফার, ৬৮, 0x07)
    // p_offset = 0
    // p_vaddr = 0x400000 (Base Virtual Address)
    মেমরি_বাইট_লেখো(বাফার, ৮০, 0x00)
    মেমরি_বাইট_লেখো(বাফার, ৮১, 0x00)
    মেমরি_বাইট_লেখো(বাফার, ৮২, 0x40)
    // p_paddr = 0x400000
    মেমরি_বাইট_লেখো(বাফার, ৮৮, 0x00)
    মেমরি_বাইট_লেখো(বাফার, ৮৯, 0x00)
    মেমরি_বাইট_লেখো(বাফার, ৯০, 0x40)

    // ৫.৩ মেশিন কোড নির্গমন (.text segment starts at offset 4096 / 0x1000)
    ধরি কোড_অফসেট = ৪০৯৬

    // Function Prologue: push rbp; mov rbp, rsp
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ০, 0x55)             // push rbp
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১, 0x48)             // mov rbp, rsp
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২, 0x89)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩, 0xE5)

    // লিনাক্স কার্নেল সিসকল SYS_write (rax=1, rdi=1, rsi=msg, rdx=len, syscall)
    // mov eax, 1 (SYS_write)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৪, 0xB8)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৫, 0x01)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৬, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৭, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৮, 0x00)

    // mov edi, 1 (stdout file descriptor)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৯, 0xBF)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১০, 0x01)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১১, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১২, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৩, 0x00)

    // movabs rsi, 0x401028 (Message Virtual Address in .rodata at offset 40)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৪, 0x48)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৫, 0xBE)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৬, 0x28) // 0x28 = 40
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৭, 0x10) // 0x10 = 0x4010xx
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৮, 0x40) // 0x40 = 0x40xxxx
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ১৯, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২০, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২১, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২২, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৩, 0x00)

    // বার্তা ডেটা
    ধরি বার্তা_ঠিকানা = কোড_অফসেট + ৪০
    ধরি বার্তা = "👑 [Lipi Sovereign Self-Hosted Binary] 100% Native Silicon Hardware Execution!\n"
    ধরি বার্তা_দৈর্ঘ্য = দৈর্ঘ্য(বার্তা)

    // mov edx, বার্তা_দৈর্ঘ্য (Buffer Length)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৪, 0xBA)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৫, বার্তা_দৈর্ঘ্য)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৬, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৭, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৮, 0x00)

    // syscall (0x0F, 0x05)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ২৯, 0x0F)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩০, 0x05)

    // লিনাক্স কার্নেল সিসকল SYS_exit 0 (mov eax, 60; xor edi, edi; syscall)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩১, 0xB8) // mov eax, 60
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩২, 60)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৩, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৪, 0x00)
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৫, 0x00)
    
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৬, 0x31) // xor edi, edi
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৭, 0xFF)
    
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৮, 0x0F) // syscall
    মেমরি_বাইট_লেখো(বাফার, কোড_অফসেট + ৩৯, 0x05)

    // বার্তা বাইটগুলো মেমরিতে সংরক্ষণ (offset 40)
    ধরি k = ০
    যতক্ষণ k < বার্তা_দৈর্ঘ্য {
        ধরি byte_val = মেমরি_বাইট_পড়ো(বার্তা, k)
        মেমরি_বাইট_লেখো(বাফার, বার্তা_ঠিকানা + k, byte_val)
        k = k + ১
    }

    ধরি মোট_কোড_সাইজ = ৪০ + বার্তা_দৈর্ঘ্য
    ধরি মোট_ফাইল_সাইজ = ৪০৯৬ + মোট_কোড_সাইজ

    // Program Header সাইজ আপডেট
    মেমরি_শব্দ_লেখো(বাফার, ১২, মোট_ফাইল_সাইজ) // p_filesz
    মেমরি_শব্দ_লেখো(বাফার, ১৩, মোট_ফাইল_সাইজ + ৪০৯৬) // p_memsz
    মেমরি_শব্দ_লেখো(বাফার, ১৪, ৪০৯৬) // p_align

    // ৫.৪ ফাইলে সরাসরি বাইনারি ডিস্ক রাইট (SYS_open: 2, flags: 577, mode: 493)
    ধরি fd = সিসকল(২, আউটপুট_পাথ, ৫৭৭, ৪৯৩, ০, ০, ০)
    যদি fd > ০ {
        সিসকল(১, fd, বাফার, মোট_ফাইল_সাইজ, ০, ০, ০)
        সিসকল(৩, fd, ০, ০, ০, ০, ০)
        // এক্সিকিউটেবল পারমিশন প্রদান (SYS_chmod: 90, mode: 0755 = 493)
        সিসকল(৯০, আউটপুট_পাথ, ৪৯৩, ০, ০, ০, ০)
        দেখাও "  ✔ সফলভাবে নেটিভ ELF বাইনারি সংশ্লেষিত: " + আউটপুট_পাথ
        দেখাও "  • মোট ফাইল সাইজ   : " + মোট_ফাইল_সাইজ + " বাইট"
        দেখাও "  • ভার্চুয়াল অ্যাড্রেস : 0x400000 ➔ 0x401000 (Entry)"
        দেখাও "  • ডিপেন্ডেন্সি     : ০% PHP | ০% Libc | ০% GCC | Pure Silicon"
    } নাহলে {
        দেখাও "  ❌ ফাইল ডিস্কে লিখতে ব্যর্থ: " + আউটপুট_পাথ
    }

    মেমরি_মুক্তি(বাফার, বাফার_আকার)
    ফেরত মোট_ফাইল_সাইজ
}

// -----------------------------------------------------------------------------
// 👑 মূল এক্সিকিউশন ইঞ্জিন (Main Engine Execution)
// -----------------------------------------------------------------------------
কাজ প্রধান() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI SUPREME NANO-COMPILER & MACHINE CODE SYNTHESIS ENGINE\033[0m         \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ 100% Pure Sovereign Lipi Self-Hosting Core | Standalone Linux ELF64\033[0m   \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""

    ধরি সোর্স = "যতক্ষণ i <= ১০০০০০০০ { যোগফল = যোগফল + (i % ৭); i = i + ১ }"
    ধরি সোর্স_লেন = দৈর্ঘ্য(সোর্স)

    // ৫টি পূর্ণাঙ্গ স্টেজ এক্সিকিউট করা
    ধরি টোকেন_তালিকা = টোকেনাইজার(সোর্স, সোর্স_লেন)
    ধরি এএসটি = এএসটি_তৈরি(টোকেন_তালিকা)
    ধরি আইআর = এসএসএ_আইআর_তৈরি(এএসটি)
    ধরি রেজিস্টার_ম্যাপ = রেজিস্টার_বরাদ্দকরণ(আইআর)

    // সেলফ-হোস্টিং ক্লোজার: খাঁটি লিপি দিয়ে সরাসরি নেটিভ লিনাক্স ELF বাইনারি তৈরি
    ধরি আউটপুট = "bin/lipic_gen"
    ধরি আকার = লিনাক্স_এলফ_সিন্থেসিস(আউটপুট)

    দেখাও ""
    দেখাও "\033[1;32m🎉 খাঁটি লিপি সেলফ-হোস্টিং কম্পাইলার ৫-টি স্টেজ সফলভাবে সম্পন্ন করেছে!\033[0m"
    দেখাও "⚡ [100% Sovereign Lipi Self-Compiled Closure Achieved]"
    
    ফেরত ০
}

প্রধান()
