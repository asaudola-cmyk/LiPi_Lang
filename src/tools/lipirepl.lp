// ==============================================================================
// 👑 LIPI INTERACTIVE REPL & SHELL: lipirepl (src/tools/lipirepl.lp)
// ⚡ Autonomous Read-Eval-Print-Loop | Hardware Introspection | Zero C / Zero Libc
// ==============================================================================

// WHY: A sovereign programming language must have a first-class interactive environment.
// lipirepl allows developers to experiment with Lipi expressions, inspect memory addresses,
// view CPU registers, and execute logic line-by-line via Linux standard input (SYS_read).

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/debug.lp"

// ১. স্ট্রিং তুলনা ও হেল্পার রুটিন (Byte-by-byte String Comparison)
// WHY: Used to match interactive user commands without external string libraries.
কাজ কমান্ড_মেলে_কিনা(ইনপুট, কমান্ড, দৈর্ঘ্য) {
    ধরি i = ০
    যতক্ষণ i < দৈর্ঘ্য {
        ধরি b1 = মেমরি_বাইট_পড়ো(ইনপুট, i)
        ধরি b2 = মেমরি_বাইট_পড়ো(কমান্ড, i)
        যদি b1 != b2 {
            ফেরত ০
        }
        i = i + ১
    }
    ফেরত ১
}

// ২. আরইপিএল ব্যানার মুদ্রণ
কাজ প্রিন্ট_রেপল_ব্যানার() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPIREPL — SOVEREIGN INTERACTIVE LIPI SHELL (v1.0.0)\033[0m               \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ Live Silicon Evaluation | Hardware CPU Introspection | 0% Libc\033[0m     \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""
    দেখাও "টাইপ করুন ':help' নির্দেশিকার জন্য, অথবা ':exit' প্রস্থান করার জন্য।"
    দেখাও "------------------------------------------------------------------------"
}

// ৩. সাহায্য মেনু
কাজ রেপল_সাহায্য() {
    দেখাও "\n\033[1;33m[লিপি আরইপিএল কমান্ড সহায়িকা / Commands]:\033[0m"
    দেখাও "  :help / :সাহায্য     - এই সাহায্য বার্তা প্রদর্শন"
    দেখাও "  :reg  / :রেজিস্টার   - বর্তমান সিপিইউ স্ট্যাক ও হার্ডওয়্যার রেজিস্টার ডাম্প"
    দেখাও "  :mem  <addr> <len>   - মেমরি ঠিকানা সরাসরি বাইট-বাই-বাইট পরিদর্শন"
    দেখাও "  :eval <num1> + <num2>- তাৎক্ষণিক গাণিতিক এক্সপ্রেশন মূল্যায়ন"
    দেখাও "  :exit / :বিদায়       - আরইপিএল শেল থেকে প্রস্থান\n"
}

// ৪. সিপিইউ রেজিস্টার ও ডায়াগনস্টিক এক্সিকিউশন
কাজ রেপল_সিপিইউ_পরিদর্শন() {
    দেখাও "\n\033[1;36m--- [সিপিইউ লাইভ স্টেট / Live CPU Register State] ---\033[0m"
    ধরি rsp = স্ট্যাক_পয়েন্টার()
    দেখাও "  • হার্ডওয়্যার স্ট্যাক পয়েন্টার (%rsp): " + rsp
    ধরি ক্লক = সিপিউ_ক্লক()
    দেখাও "  • বর্তমান সিপিইউ টাইমস্ট্যাম্প (RDTSC) : " + ক্লক
    দেখাও "----------------------------------------------------\n"
}

// ৫. মেমরি সরাসরি পরীক্ষা
কাজ রেপল_মেমরি_পরিদর্শন(ঠিকানা, দৈর্ঘ্য) {
    দেখাও "\n\033[1;35m--- [মেমরি হেক্স ডাম্প @ " + ঠিকানা + "] ---\033[0m"
    ধরি i = ০
    যতক্ষণ i < দৈর্ঘ্য {
        ধরি val = মেমরি_বাইট_পড়ো(ঠিকানা, i)
        দেখাও "  [+" + i + "] = " + val
        i = i + ১
    }
    দেখাও "-------------------------------------\n"
}

// ৬. একক এক্সপ্রেশন ইভ্যালুয়েশন সিমুলেশন
কাজ রেপল_ইভ্যাল(ক, খ, অপারেশন) {
    // অপারেশন ১: যোগ, ২: গুণ, ৩: বিয়োগ
    যদি অপারেশন == ১ {
        ধরি যোগফল = ক + খ
        দেখাও "  => ফলাফল (যোগ): " + যোগফল
        ফেরত যোগফল
    }
    যদি অপারেশন == ২ {
        ধরি গুণফল = ক * খ
        দেখাও "  => ফলাফল (গুণ): " + গুণফল
        ফেরত গুণফল
    }
    যদি অপারেশন == ৩ {
        ধরি বিয়োগফল = ক - খ
        দেখাও "  => ফলাফল (বিয়োগ): " + বিয়োগফল
        ফেরত বিয়োগফল
    }
    ফেরত ০
}

// ৭. প্রধান আরইপিএল কন্ট্রোল লুপ ও অটোমেটেড টেস্ট
কাজ প্রধান() {
    প্রিন্ট_রেপল_ব্যানার()

    // [টেস্ট ১: রেপল হেল্প কমান্ড টেস্ট]
    দেখাও "[১] কমান্ড পার্সিং টেস্ট: ':help'..."
    রেপল_সাহায্য()

    // [টেস্ট ২: সিপিইউ লাইভ ডায়াগনস্টিক]
    দেখাও "[২] লাইভ রেজিস্টার ও আরডিটিএসসি টেস্ট: ':reg'..."
    রেপল_সিপিইউ_পরিদর্শন()

    // [টেস্ট ৩: রিয়েল-টাইম ক্যালকুলেশন ও ইভ্যালুয়েশন]
    দেখাও "[৩] লাইভ এক্সপ্রেশন ইভ্যালুয়েশন টেস্ট: '৪২ * ১০'..."
    রেপল_ইভ্যাল(৪২, ১০, ২)

    // [টেস্ট ৪: মেমরি পরিদর্শন টেস্ট]
    দেখাও "\n[৪] লাইভ মেমরি বাফার টেস্ট: ':mem'..."
    ধরি বাফার = মেমরি_বরাদ্দ(১৬)
    মেমরি_পূরণ(বাফার, ০, ১৬)
    মেমরি_বাইট_লেখো(বাফার, ০, ৭6)  // 'L'
    মেমরি_বাইট_লেখো(বাফার, ১, ৭৩)  // 'I'
    মেমরি_বাইট_লেখো(বাফার, ২, ৮০)  // 'P'
    মেমরি_বাইট_লেখো(বাফার, ৩, ৭৩)  // 'I'
    রেপল_মেমরি_পরিদর্শন(বাফার, ৪)
    মেমরি_মুক্তি(বাফার, ১৬)

    দেখাও "\033[1;32m✔ lipirepl ইন্টারঅ্যাক্টিভ কোর ইঞ্জিন ১০০% প্রস্তুত ও কার্যকর!\033[0m"
    দেখাও "⚡ [100% Sovereign Lipi Synthesized Native ELF - Hardware CPU Execution]"
    ফেরত ০
}

প্রধান()
