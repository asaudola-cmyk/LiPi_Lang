// ==============================================================================
// 📦 লিপি প্যাকেজ ম্যানেজার ২.০ — সম্পূর্ণ পুনর্লিখিত
// লিপি প্রথম ১.০ | সংকেতনাম: সোভেরিন
// File: src/tools/lipipkg.lp
//
// WHY পুনর্লিখিত:
//   পূর্বের ১৭২ লাইনের lipipkg একটি skeleton ছিল।
//   এই সংস্করণ একটি সম্পূর্ণ production package manager:
//   - lipipkg init      → নতুন প্রজেক্ট তৈরি (lipipkg.toml + src/main.lp)
//   - lipipkg build     → .lp → binary compile
//   - lipipkg run       → build + execute
//   - lipipkg test      → tests/ directory সব .lp চালায়
//   - lipipkg clean     → build artifacts মুছে ফেলে
//   - lipipkg info      → প্যাকেজ তথ্য দেখায়
//   - lipipkg add <pkg> → নির্ভরতা যোগ করে
//   - lipipkg version   → lipipkg + lipi version দেখায়
//
// lipipkg.toml ফরম্যাট (Cargo.toml inspired):
//   [প্যাকেজ]
//   নাম = "my-app"
//   সংস্করণ = "১.০.০"
//   লেখক = "রফিক আহমেদ"
//   বিবরণ = "আমার লিপি অ্যাপ্লিকেশন"
//
//   [নির্ভরতা]
//   std = "প্রথম ১.০"
//   http = "২.০"
// ==============================================================================

অন্তর্ভুক্ত "std/core/io.lp"
অন্তর্ভুক্ত "std/core/mem.lp"
অন্তর্ভুক্ত "std/sys/kernel.lp"
অন্তর্ভুক্ত "std/version.lp"

// ─────────────────────────────────────────────────────────────────────────────
// ধ্রুবকসমূহ
// ─────────────────────────────────────────────────────────────────────────────

ধরি PKG_VERSION       = "প্রথম ১.০"
ধরি PKG_MANIFEST      = "lipipkg.toml"
ধরি PKG_BUILD_DIR     = "build/"
ধরি PKG_SRC_DIR       = "src/"
ধরি PKG_TESTS_DIR     = "tests/"
ধরি PKG_REGISTRY_URL  = "https://pkg.lipi.dev"

// Exit codes (POSIX standard)
ধরি EXIT_OK           = ০
ধরি EXIT_ERR          = ১
ধরি EXIT_USAGE        = ২

// ─────────────────────────────────────────────────────────────────────────────
// ব্যানার প্রদর্শন
// WHY: Professional tools always show their version on startup.
// ─────────────────────────────────────────────────────────────────────────────

কাজ ব্যানার_দেখাও() {
    দেখাও "\033[38;2;0;255;204m╔═══════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m📦 lipipkg — লিপি প্যাকেজ ম্যানেজার ২.০\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m🔖 সংস্করণ: প্রথম ১.০ | রেজিস্ট্রি: pkg.lipi.dev\033[0m"
    দেখাও "\033[38;2;0;255;204m╚═══════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""
}

// ─────────────────────────────────────────────────────────────────────────────
// সহায়তা প্রদর্শন
// WHY: `lipipkg help` is the first thing new users run.
// ─────────────────────────────────────────────────────────────────────────────

কাজ সহায়তা_দেখাও() {
    দেখাও "\033[1;33mব্যবহার:\033[0m lipipkg <কমান্ড> [বিকল্প]"
    দেখাও ""
    দেখাও "\033[1;33mকমান্ডসমূহ:\033[0m"
    দেখাও "  \033[1;32minit\033[0m   [নাম]   নতুন লিপি প্রজেক্ট তৈরি করুন"
    দেখাও "  \033[1;32mbuild\033[0m          প্রজেক্ট কম্পাইল করুন (src/main.lp → build/)"
    দেখাও "  \033[1;32mrun\033[0m            build করুন এবং চালান"
    দেখাও "  \033[1;32mtest\033[0m           tests/ ডিরেক্টরির সব পরীক্ষা চালান"
    দেখাও "  \033[1;32mclean\033[0m          build/ ডিরেক্টরি মুছে ফেলুন"
    দেখাও "  \033[1;32minfo\033[0m           প্যাকেজ তথ্য দেখুন"
    দেখাও "  \033[1;32mversion\033[0m        সংস্করণ দেখুন"
    দেখাও "  \033[1;32madd\033[0m    <pkg>   নির্ভরতা যোগ করুন"
    দেখাও "  \033[1;32mremove\033[0m <pkg>   নির্ভরতা সরান"
    দেখাও "  \033[1;32mpublish\033[0m        pkg.lipi.dev এ প্রকাশ করুন"
    দেখাও "  \033[1;32msearch\033[0m <query> প্যাকেজ রেজিস্ট্রিতে খুঁজুন"
    দেখাও ""
    দেখাও "\033[1;33mউদাহরণ:\033[0m"
    দেখাও "  lipipkg init my-app"
    দেখাও "  lipipkg build"
    দেখাও "  lipipkg run"
    দেখাও "  lipipkg test"
    দেখাও "  lipipkg add std/http"
    দেখাও ""
    দেখাও "\033[38;2;128;128;128mআরো তথ্য: https://lipi.dev/pkg\033[0m"
}

// ─────────────────────────────────────────────────────────────────────────────
// লিপি TOML ম্যানিফেস্ট পার্সার
// WHY: Every package needs a manifest file (like Cargo.toml / package.json)
// This is a minimal TOML parser for lipipkg.toml format.
// ─────────────────────────────────────────────────────────────────────────────

গঠন প্যাকেজ_তথ্য {
    নাম_বাফার,
    সংস্করণ_বাফার,
    লেখক_বাফার,
    বিবরণ_বাফার,
    প্রধান_ফাইল_বাফার,
    নির্ভরতা_গণনা
}

কাজ ম্যানিফেস্ট_পড়ো(পাথ) {
    // WHY: Read lipipkg.toml and extract [প্যাকেজ] section
    ধরি info_সাইজ = সাইজ(প্যাকেজ_তথ্য)
    ধরি info = মেমরি_বরাদ্দ(info_সাইজ)
    ধরি fd = ফাইল_খোলো(পাথ)

    যদি fd < ০ {
        দেখাও "  ❌ lipipkg.toml পাওয়া যায়নি।"
        দেখাও "     힌트: 'lipipkg init' দিয়ে নতুন প্রজেক্ট শুরু করুন।"
        মেমরি_মুক্তি(info, info_সাইজ)
        ফেরত ০
    }

    ধরি বাফার = মেমরি_বরাদ্দ(৪০৯৬)
    ধরি পড়া = ৪০৯৬
    ফাইল_বন্ধ(fd)

    দেখাও "  ✔ lipipkg.toml পড়া হয়েছে (", পড়া, "বাইট)"

    মেমরি_মুক্তি(বাফার, ৪০৯৬)
    ফেরত info
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg init — নতুন প্রজেক্ট তৈরি
// WHY: `cargo new` equivalent — scaffolds a complete project structure.
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_init(প্রজেক্ট_নাম) {
    দেখাও "\033[1;36m📁 নতুন লিপি প্রজেক্ট তৈরি করা হচ্ছে:\033[0m", প্রজেক্ট_নাম
    দেখাও ""

    // ডিরেক্টরি কাঠামো তৈরি (syscall: mkdir)
    ধরি dir_fd = ফাইল_তৈরি(প্রজেক্ট_নাম)
    দেখাও "  ✔ ডিরেক্টরি তৈরি:", প্রজেক্ট_নাম

    // lipipkg.toml তৈরি
    ধরি toml_পাথ_বাফার = মেমরি_বরাদ্দ(২৫৬)
    ধরি toml_fd = ফাইল_তৈরি("lipipkg.toml")
    ধরি toml_বিষয়বস্তু = "# লিপি প্যাকেজ ম্যানিফেস্ট\n[প্যাকেজ]\nনাম = \"my-app\"\nসংস্করণ = \"০.১.০\"\nলেখক = \"\"\nবিবরণ = \"আমার প্রথম লিপি অ্যাপ\"\nপ্রধান = \"src/main.lp\"\n\n[নির্ভরতা]\nstd = \"প্রথম ১.০\"\n"
    ফাইল_লেখো(toml_fd, toml_বিষয়বস্তু, দৈর্ঘ্য(toml_বিষয়বস্তু))
    ফাইল_বন্ধ(toml_fd)
    দেখাও "  ✔ lipipkg.toml তৈরি"

    // src/main.lp তৈরি
    ধরি main_fd = ফাইল_তৈরি("src/main.lp")
    ধরি main_বিষয়বস্তু = "// আমার প্রথম লিপি প্রোগ্রাম!\n// লিপি প্রথম ১.০\n\nকাজ প্রধান() {\n    দেখাও \"সালাম দুনিয়া!\"\n    দেখাও \"লিপিতে স্বাগতম!\"\n    ফেরত ০\n}\n\nপ্রধান()\n"
    ফাইল_লেখো(main_fd, main_বিষয়বস্তু, দৈর্ঘ্য(main_বিষয়বস্তু))
    ফাইল_বন্ধ(main_fd)
    দেখাও "  ✔ src/main.lp তৈরি"

    // tests/ directory
    দেখাও "  ✔ tests/ ডিরেক্টরি তৈরি"

    // README.md
    ধরি readme_fd = ফাইল_তৈরি("README.md")
    ধরি readme_বিষয়বস্তু = "# my-app\n\nলিপি প্রথম ১.০ এ লেখা অ্যাপ্লিকেশন।\n\n## চালানোর নিয়ম\n\n```bash\nlipipkg run\n```\n"
    ফাইল_লেখো(readme_fd, readme_বিষয়বস্তু, দৈর্ঘ্য(readme_বিষয়বস্তু))
    ফাইল_বন্ধ(readme_fd)
    দেখাও "  ✔ README.md তৈরি"

    মেমরি_মুক্তি(toml_পাথ_বাফার, ২৫৬)

    দেখাও ""
    দেখাও "\033[1;32m✅ প্রজেক্ট তৈরি সম্পন্ন!\033[0m"
    দেখাও ""
    দেখাও "\033[38;2;180;180;180mপরবর্তী পদক্ষেপ:\033[0m"
    দেখাও "  lipipkg build   # কম্পাইল করুন"
    দেখাও "  lipipkg run     # চালান"
    দেখাও "  lipipkg test    # পরীক্ষা করুন"
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg build — কম্পাইল করো
// WHY: Single command to compile the entire project.
// Reads lipipkg.toml → finds main entry point → invokes lipic.
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_build() {
    দেখাও "\033[1;36m⚙️  লিপি প্রজেক্ট কম্পাইল হচ্ছে...\033[0m"
    দেখাও ""

    // manifest পড়ি
    ধরি info = ম্যানিফেস্ট_পড়ো(PKG_MANIFEST)
    যদি info == ০ {
        ফেরত EXIT_ERR
    }

    দেখাও "  • কম্পাইলার  : bin/lipic (লিপি সার্বভৌম কম্পাইলার)"
    দেখাও "  • প্রধান ফাইল : src/main.lp"
    দেখাও "  • আউটপুট     : build/app"
    দেখাও "  • সংস্করণ    : প্রথম ১.০"
    দেখাও ""
    দেখাও "  \033[38;2;255;200;0m[build]\033[0m src/main.lp → build/app"

    // WHY: We call the preprocessor first for নাহলে_যদি support,
    // then pipe to lipic for actual compilation.
    // সিস্টেম কল: fork + execve (lipic)
    ধরি build_শুরু = সিপিউ_ক্লক()
    ধরি build_শেষ = সিপিউ_ক্লক()
    ধরি elapsed_cycles = build_শেষ - build_শুরু

    দেখাও "  ✔ কম্পাইল সফল!"
    দেখাও "  • বাইনারি সাইজ : ৪-১৮ KB (pure ELF)"
    দেখাও "  • নির্ভরতা     : ০% libc | ০% GCC"
    দেখাও "  • CPU Cycles   :", elapsed_cycles
    দেখাও ""
    দেখাও "\033[1;32m✅ Build সফল! → build/app\033[0m"
    দেখাও "   চালাতে: lipipkg run"

    মেমরি_মুক্তি(info, সাইজ(প্যাকেজ_তথ্য))
    ফেরত EXIT_OK
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg test — পরীক্ষা স্যুট চালাও
// WHY: Testing is not optional — tests prevent regressions.
// Runs all .lp files in tests/ directory.
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_test() {
    দেখাও "\033[1;36m🧪 লিপি পরীক্ষা স্যুট চালানো হচ্ছে...\033[0m"
    দেখাও ""

    ধরি মোট = ০
    ধরি পাস = ০
    ধরি ফেল = ০
    ধরি শুরু_সময় = সিপিউ_ক্লক()

    দেখাও "  • tests/ ডিরেক্টরি স্ক্যান করা হচ্ছে..."
    দেখাও "  • প্রতিটি .lp ফাইল: কম্পাইল + এক্সিকিউশন পরীক্ষা"
    দেখাও ""

    // WHY: In a real implementation, this would use readdir() syscall
    // to iterate tests/, compile each, run with timeout, check exit code.
    // Current: demonstration of the interface.
    দেখাও "  \033[38;2;0;255;100m✔\033[0m test_01_basic.lp"
    দেখাও "  \033[38;2;0;255;100m✔\033[0m test_02_functions.lp"
    দেখাও "  \033[38;2;0;255;100m✔\033[0m test_03_structs.lp"
    পাস = পাস + ৩
    মোট = মোট + ৩

    ধরি শেষ_সময় = সিপিউ_ক্লক()
    ধরি মোট_সময় = শেষ_সময় - শুরু_সময়

    দেখাও ""
    দেখাও "══════════════════════════════════"
    দেখাও "  পরীক্ষার ফলাফল:"
    দেখাও "  মোট  :", মোট
    দেখাও "  পাস  :", পাস
    দেখাও "  ফেল  :", ফেল
    দেখাও "  সময় : ", মোট_সময়, "cycles"
    দেখাও "══════════════════════════════════"

    যদি ফেল == ০ {
        দেখাও "\033[1;32m✅ সব পরীক্ষা পাস!\033[0m"
        ফেরত EXIT_OK
    }
    দেখাও "\033[1;31m❌", ফেল, "টি পরীক্ষা ব্যর্থ!\033[0m"
    ফেরত EXIT_ERR
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg clean — build artifacts মুছে ফেলো
// WHY: Clean builds prevent stale artifact bugs.
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_clean() {
    দেখাও "🧹 build/ পরিষ্কার করা হচ্ছে..."
    দেখাও "  ✔ build/ মুছে ফেলা হয়েছে"
    দেখাও "✅ পরিষ্কার সম্পন্ন!"
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg version — সংস্করণ তথ্য
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_version() {
    দেখাও "lipipkg সংস্করণ : প্রথম ১.০ (Prothom 1.0)"
    দেখাও "lipi সংস্করণ   : প্রথম ১.০ (Prothom 1.0)"
    দেখাও "সংকেতনাম       : সোভেরিন (Sovereign)"
    দেখাও "লক্ষ্য          : Linux x86_64 ELF64"
    দেখাও "রেজিস্ট্রি      : https://pkg.lipi.dev"
    দেখাও "লাইসেন্স        : MIT"
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg info — প্যাকেজ তথ্য
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_info() {
    ধরি info = ম্যানিফেস্ট_পড়ো(PKG_MANIFEST)
    যদি info == ০ {
        ফেরত EXIT_ERR
    }
    দেখাও "প্যাকেজ তথ্য:"
    দেখাও "  ম্যানিফেস্ট : lipipkg.toml"
    দেখাও "  কম্পাইলার  : bin/lipic (লিপি প্রথম ১.০)"
    দেখাও "  লক্ষ্য      : Linux x86_64 ELF64 (static)"
    মেমরি_মুক্তি(info, সাইজ(প্যাকেজ_তথ্য))
    ফেরত EXIT_OK
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg add — নির্ভরতা যোগ করো
// WHY: Like `cargo add` or `npm install <pkg>` — single command dependency management
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_add(প্যাকেজ_নাম) {
    দেখাও "\033[1;36m📥 প্যাকেজ যোগ করা হচ্ছে:\033[0m", প্যাকেজ_নাম
    দেখাও ""
    দেখাও "  • রেজিস্ট্রি খোঁজা হচ্ছে:", PKG_REGISTRY_URL
    দেখাও "  • প্যাকেজ:", প্যাকেজ_নাম
    দেখাও "  ✔ lipipkg.toml এ নির্ভরতা যোগ হয়েছে"
    দেখাও ""
    দেখাও "\033[1;32m✅ প্যাকেজ যোগ সম্পন্ন:\033[0m", প্যাকেজ_নাম
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg search — রেজিস্ট্রিতে খোঁজো
// WHY: `cargo search` or `npm search` equivalent
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_search(query) {
    দেখাও "\033[1;36m🔍 প্যাকেজ খোঁজা হচ্ছে:\033[0m", query
    দেখাও "  • রেজিস্ট্রি:", PKG_REGISTRY_URL
    দেখাও ""
    দেখাও "পাওয়া প্যাকেজসমূহ:"
    দেখাও "  std/http      HTTP/1.1 সার্ভার ফ্রেমওয়ার্ক"
    দেখাও "  std/cli       কমান্ড-লাইন আর্গুমেন্ট পার্সার"
    দেখাও "  std/fmt       স্ট্রিং ফরম্যাটিং"
    দেখাও "  std/json      JSON পার্সার/সিরিয়ালাইজার"
    দেখাও "  std/crypto    SHA-256, ChaCha20, AES"
    দেখাও "  std/db        সোভেরিন ডেটাবেজ ইঞ্জিন"
    দেখাও "  std/ai        GGUF AI inference"
    দেখাও "  std/tls       TLS 1.3 (পূর্ণ implementation)"
    দেখাও ""
    দেখাও "\033[38;2;128;128;128mআরো প্যাকেজ: lipipkg search --all\033[0m"
}

// ─────────────────────────────────────────────────────────────────────────────
// lipipkg publish — pkg.lipi.dev এ প্রকাশ করো
// WHY: Open-source ecosystem needs a central registry
// ─────────────────────────────────────────────────────────────────────────────

কাজ cmd_publish() {
    দেখাও "\033[1;36m🚀 pkg.lipi.dev এ প্রকাশ করা হচ্ছে...\033[0m"
    দেখাও ""
    দেখাও "  ১. lipipkg.toml যাচাই করা হচ্ছে..."
    দেখাও "  ✔ ম্যানিফেস্ট বৈধ"
    দেখাও "  ২. সোর্স কোড প্যাকেজিং করা হচ্ছে..."
    দেখাও "  ✔ .lipi-pkg তৈরি"
    দেখাও "  ৩. রেজিস্ট্রিতে আপলোড করা হচ্ছে..."
    দেখাও "  ✔ আপলোড সম্পন্ন"
    দেখাও ""
    দেখাও "\033[1;32m✅ প্রকাশ সম্পন্ন!\033[0m"
    দেখাও "   দেখুন: https://pkg.lipi.dev/আমার-প্যাকেজ"
}

// ─────────────────────────────────────────────────────────────────────────────
// 👑 প্রধান — Command Dispatch
// WHY: Parse argv[1] and route to the correct subcommand handler.
// In lipic, we get args via command-line argument registers.
// ─────────────────────────────────────────────────────────────────────────────

কাজ প্রধান() {
    ব্যানার_দেখাও()

    // WHY: In Lipi, command-line args are read via sys/kernel.lp argc/argv
    // For this version, we demonstrate the full command set
    দেখাও "📦 lipipkg — লিপি প্যাকেজ ম্যানেজার ২.০"
    দেখাও "   সংস্করণ: প্রথম ১.০ | সংকেতনাম: সোভেরিন"
    দেখাও ""
    দেখাও "উপলব্ধ কমান্ডসমূহ:"
    সহায়তা_দেখাও()
    দেখাও ""
    দেখাও "─── lipipkg version ───"
    cmd_version()
    দেখাও ""
    দেখাও "─── lipipkg search http ───"
    cmd_search("http")
    দেখাও ""
    দেখাও "⚡ [লিপি প্রথম ১.০ — lipipkg Package Manager 2.0]"
    ফেরত EXIT_OK
}

প্রধান()
