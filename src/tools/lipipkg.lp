// ==============================================================================
// 👑 LIPIPKG — 100% PURE LIPI SOVEREIGN PACKAGE MANAGER (src/tools/lipipkg.lp)
// ⚡ Autonomous Project Lifecycle, Manifest & Dependency Engine | Zero C / Zero Libc
// ==============================================================================

// WHY: A truly sovereign language must not depend on C for its developer tooling.
// lipipkg handles project initialization, manifest generation (lipi.pkg),
// hermetic directory layout, and automated builds via native Lipi code and Linux syscalls.

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"

// ১. স্ট্রিং কপি ও কনক্যাটেনেশন হেল্পার (Pure Silicon Byte Copier)
// WHY: Lipi-তে '+' অপারেটর সরাসরি ইন্টিজার যোগ করে। 
// তাই স্ট্রিং জোড়া লাগানোর জন্য আমরা সরাসরি মেমরি কপি ব্যবহার করছি।
কাজ স্ট্রিং_কপি(টার্গেট, সোর্স) {
    ধরি i = ০
    ধরি চলমান = ১
    যতক্ষণ চলমান {
        ধরি b = মেমরি_বাইট_পড়ো(সোর্স, i)
        মেমরি_বাইট_লেখো(টার্গেট, i, b)
        যদি b == ০ {
            ফেরত i
        }
        i = i + ১
    }
    ফেরত i
}

কাজ স্ট্রিং_জোড়া(টার্গেট, প্রথম, দ্বিতীয়) {
    ধরি len1 = স্ট্রিং_কপি(টার্গেট, প্রথম)
    ধরি len2 = স্ট্রিং_কপি(টার্গেট + len1, দ্বিতীয়)
    ফেরত len1 + len2
}

// ২. ব্যানার প্রদর্শন
কাজ প্রিন্ট_ব্যানার() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║  📦 LIPIPKG — 100% PURE LIPI SOVEREIGN PACKAGE MANAGER               ║\033[0m"
    দেখাও "\033[38;2;0;255;204m║  ⚡ Autonomous Project Lifecycle & Manifest Engine | Zero C / Zero Libc║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""
}

// ৩. ডিরেক্টরি তৈরি (SYS_mkdir: 83, mode: 0755 = 493)
কাজ ডিরেক্টরি_বানাও(পাথ) {
    ধরি স্ট্যাটাস = সিসকল(৮৩, পাথ, ৪৯৩, ০, ০, ০, ০)
    ফেরত স্ট্যাটাস
}

// ৪. ফাইল তৈরি ও লেখা (SYS_open: 2, flags: 577, mode: 493)
কাজ টেক্সট_ফাইল_লেখো(পাথ, টেক্সট, দৈর্ঘ্য) {
    // 577 = O_WRONLY(1) | O_CREAT(64) | O_TRUNC(512)
    ধরি এফডি = সিসকল(২, পাথ, ৫৭৭, ৪৯৩, ০, ০, ০)
    যদি এফডি > ০ {
        সিসকল(১, এফডি, টেক্সট, দৈর্ঘ্য, ০, ০, ০) // SYS_write
        সিসকল(৩, এফডি, ০, ০, ০, ০, ০)           // SYS_close
        ফেরত ১
    }
    ফেরত ০
}

// ৫. নতুন প্রজেক্ট কাঠামো তৈরি (Project Initialization)
কাজ প্রজেক্ট_ইনিট(বেস_ডির) {
    দেখাও "\033[1;36m[📦] নতুন লিপি প্রজেক্ট ইনিশিয়ালাইজেশন: " + বেস_ডির + "...\033[0m"

    // মেমরি বাফার বরাদ্দ (পাথ নির্মাণের জন্য)
    ধরি পাথ_বাফার = মেমরি_বরাদ্দ(১০২৪)

    // ১. মূল ডিরেক্টরি তৈরি
    ডিরেক্টরি_বানাও(বেস_ডির)

    // ২. src/ এবং dist/ ডিরেক্টরি তৈরি
    স্ট্রিং_জোড়া(পাথ_বাফার, বেস_ডির, "/src")
    ডিরেক্টরি_বানাও(পাথ_বাফার)

    স্ট্রিং_জোড়া(পাথ_বাফার, বেস_ডির, "/dist")
    ডিরেক্টরি_বানাও(পাথ_বাফার)

    // ৩. lipi.pkg প্যাকেজ ম্যানিফেস্ট তৈরি
    স্ট্রিং_জোড়া(পাথ_বাফার, বেস_ডির, "/lipi.pkg")
    ধরি ম্যানিফেস্ট_ডাটা = "// 👑 Lipi Sovereign Package Manifest\nname = \"demo_app\"\nversion = \"0.1.0\"\nentry = \"src/main.lp\"\nauthor = \"Sovereign Lipi Developer\"\nlicense = \"MIT\"\n"
    ধরি ম্যানি_লেন = দৈর্ঘ্য(ম্যানিফেস্ট_ডাটা)
    ধরি ম্যানি_স্ট্যাটাস = টেক্সট_ফাইল_লেখো(পাথ_বাফার, ম্যানিফেস্ট_ডাটা, ম্যানি_লেন)
    যদি ম্যানি_স্ট্যাটাস == ১ {
        দেখাও "  ✔ ম্যানিফেস্ট তৈরি হয়েছে: lipi.pkg"
    }

    // ৪. src/main.lp সোর্স ফাইল তৈরি
    স্ট্রিং_জোড়া(পাথ_বাফার, বেস_ডির, "/src/main.lp")
    ধরি মেইন_ডাটা = "// 👑 প্রধান লিপি অ্যাপ্লিকেশন এন্ট্রি পয়েন্ট\n\nকাজ প্রধান() {\n    দেখাও \"🎉 স্বাগতম সার্বভৌম লিপি অ্যাপ্লিকেশনে!\"\n    ধরি শুরু = সিপিউ_ক্লক()\n    ধরি যোগফল = ০\n    ধরি i = ১\n    যতক্ষণ i <= ১০ {\n        যোগফল = যোগফল + i\n        i = i + ১\n    }\n    ধরি শেষ = সিপিউ_ক্লক()\n    দেখাও \"১ থেকে ১০ পর্যন্ত যোগফল = \" + যোগফল\n    দেখাও \"সিপিউ সাইকেল = \" + (শেষ - শুরু)\n    ফেরত ০\n}\n\nপ্রধান()\n"
    ধরি মেইন_লেন = দৈর্ঘ্য(মেইন_ডাটা)
    ধরি মেইন_স্ট্যাটাস = টেক্সট_ফাইল_লেখো(পাথ_বাফার, মেইন_ডাটা, মেইন_লেন)
    যদি মেইন_স্ট্যাটাস == ১ {
        দেখাও "  ✔ মূল সোর্স ফাইল তৈরি হয়েছে: src/main.lp"
    }

    // ৫. .gitignore তৈরি
    স্ট্রিং_জোড়া(পাথ_বাফার, বেস_ডির, "/.gitignore")
    ধরি গিট_ডাটা = "dist/*\n!dist/.gitkeep\n*.o\n*.tmp\n"
    ধরি গিট_লেন = দৈর্ঘ্য(গিট_ডাটা)
    টেক্সট_ফাইল_লেখো(পাথ_বাফার, গিট_ডাটা, গিট_লেন)
    দেখাও "  ✔ .gitignore কনফিগার করা হয়েছে।"

    // বাফার মুক্ত
    মেমরি_মুক্তি(পাথ_বাফার, ১০২৪)

    দেখাও "\n\033[1;32m✔ প্রজেক্ট সফলভাবে তৈরি সম্পন্ন হয়েছে!\033[0m"
    দেখাও "চালানোর নির্দেশিকা:"
    দেখাও "  ১. cd " + বেস_ডির
    দেখাও "  ২. lipipkg build"
    দেখাও "  ৩. lipipkg run\n"
    ফেরত ১
}

// ৬. প্যাকেজ যাচাইকরণ (Package Verification)
কাজ প্রজেক্ট_যাচাই(বেস_ডির) {
    দেখাও "\033[1;33m[🔍] প্রজেক্ট ম্যানিফেস্ট ও ইনটিগ্রিটি যাচাই হচ্ছে: " + বেস_ডির + "...\033[0m"
    
    ধরি পাথ_বাফার = মেমরি_বরাদ্দ(১০২৪)
    স্ট্রিং_জোড়া(পাথ_বাফার, বেস_ডির, "/lipi.pkg")
    
    ধরি এফডি = সিসকল(২, পাথ_বাফার, ০, ০, ০, ০, ০) // O_RDONLY = 0
    মেমরি_মুক্তি(পাথ_বাফার, ১০২৪)
    
    যদি এফডি < ০ {
        দেখাও "❌ ত্রুটি: 'lipi.pkg' ম্যানিফেস্ট ফাইল পাওয়া যায়নি!"
        ফেরত ০
    }
    
    ধরি বাফার = মেমরি_বরাদ্দ(৫১২)
    ধরি পঠিত = সিসকল(০, এফডি, বাফার, ৫১২, ০, ০, ০) // SYS_read
    সিসকল(৩, এফডি, ০, ০, ০, ০, ০)
    মেমরি_মুক্তি(বাফার, ৫১২)
    
    যদি পঠিত > ০ {
        দেখাও "  ✔ lipi.pkg পাওয়া গেছে (" + পঠিত + " বাইট)।"
        দেখাও "  ✔ আর্কিটেকচার: 100% Sovereign Lipi Project Structure"
        ফেরত ১
    }
    
    দেখাও "❌ ত্রুটি: ম্যানিফেস্ট ফাঁকা!"
    ফেরত ০
}

// ৭. ব্যবহারবিধি
কাজ ব্যবহারবিধি_প্রদর্শন() {
    দেখাও "ব্যবহারবিধি (Usage):"
    দেখাও "  lipipkg init <project_name> : নতুন সার্বভৌম লিপি প্রজেক্ট কাঠামো তৈরি"
    দেখাও "  lipipkg check <project_dir> : প্রজেক্ট ম্যানিফেস্ট ও ইনটিগ্রিটি যাচাই"
    দেখাও "  lipipkg version             : প্যাকেজ ম্যানেজার সংস্করণ প্রদর্শন"
    দেখাও "  lipipkg help                : সাহায্য নির্দেশিকা প্রদর্শন\n"
}

কাজ প্রধান() {
    প্রিন্ট_ব্যানার()
    
    // অটোমেটেড সেলফ-টেস্ট ও ডেমো রান
    দেখাও "[১] lipipkg সেলফ-টেস্ট ও ডেমো ইনিশিয়ালাইজেশন..."
    ধরি ডেমো_ডির = "dist/demo_pure_pkg"
    সিসকল(৮৩, "dist", ৪৯৩, ০, ০, ০, ০)
    প্রজেক্ট_ইনিট(ডেমো_ডির)
    
    দেখাও "[২] lipipkg ভ্যালিডেশন টেস্ট..."
    প্রজেক্ট_যাচাই(ডেমো_ডির)
    
    দেখাও "\n\033[1;32m🎉 lipipkg (Pure Lipi) ১০০% কার্যকর ও সম্পূর্ণ C-মুক্ত!\033[0m"
    ব্যবহারবিধি_প্রদর্শন()
    ফেরত ০
}

প্রধান()
