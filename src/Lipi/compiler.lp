// 📜 লিপি প্রোগ্রামিং ভাষা — খাঁটি লিপিতে নির্মিত কম্পাইলার কোর (Lipi Self-Hosting Compiler Core)
// 👑 এই ফাইলটি প্রমাণ করে যে লিপি ভাষা নিজেই একটি সম্পূর্ণ কম্পাইলার ধারণ করতে সক্ষম।
// লিপি কোড পার্স করে সরাসরি স্ট্যান্ডঅ্যালোন লিনাক্স ELF ৬৪-বিট বাইনারি তৈরি করে!

দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m📜 PURE LIPI SELF-HOSTING COMPILER ENGINE (compiler.lp)\033[0m               \033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ 100% Written in Pure Lipi | Native Linux ELF 64-bit Generation\033[0m     \033[38;2;0;255;204m║\033[0m"
দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
দেখাও ""

// ১. টোকেন গঠন (Token Struct)
গঠন টোকেন {
    টাইপ,
    মান,
    লাইন
}

// ২. সাধারণ লেক্সার (Lexer in pure Lipi)
কাজ লিপি_টোকেনাইজ(উৎস) {
    ধরি টোকেনগুলো = []
    ধরি মোট_দৈর্ঘ্য = দৈর্ঘ্য(উৎস)
    ধরি কার্সর = ০
    ধরি লাইন_নং = ১

    যতক্ষণ কার্সর < মোট_দৈর্ঘ্য {
        ধরি অক্ষর = উৎস[কার্সর]

        // নতুন লাইন হ্যান্ডলিং
        যদি অক্ষর == "\n" {
            লাইন_নং = লাইন_নং + ১
            কার্সর = কার্সর + ১
            চালিয়ে_যাও
        }

        // স্পেস ও ট্যাব এড়িয়ে যাওয়া
        যদি অক্ষর == " " অথবা অক্ষর == "\t" {
            কার্সর = কার্সর + ১
            চালিয়ে_যাও
        }

        // কমেন্ট এড়িয়ে যাওয়া (// ...)
        যদি অক্ষর == "/" এবং (কার্সর + ১ < মোট_দৈর্ঘ্য) এবং উৎস[কার্সর + ১] == "/" {
            যতক্ষণ কার্সর < মোট_দৈর্ঘ্য এবং উৎস[কার্সর] != "\n" {
                কার্সর = কার্সর + ১
            }
            চালিয়ে_যাও
        }

        // স্ট্রিং লিটারেল ("...")
        যদি অক্ষর == "\"" {
            কার্সর = কার্সর + ১
            ধরি স্ট্রিং_মান = ""
            যতক্ষণ কার্সর < মোট_দৈর্ঘ্য এবং উৎস[কার্সর] != "\"" {
                স্ট্রিং_মান = স্ট্রিং_মান + উৎস[কার্সর]
                কার্সর = কার্সর + ১
            }
            কার্সর = কার্সর + ১ // উদ্ধৃতি চিহ্ন পার করা
            টোকেনগুলো = টোকেনগুলো + [নতুন টোকেন("STRING", স্ট্রিং_মান, লাইন_নং)]
            চালিয়ে_যাও
        }

        // সাধারণ শনাক্তকারী বা কিওয়ার্ড (বাংলা ও ইংরেজি শব্দ)
        ধরি শব্দ = ""
        যতক্ষণ কার্সর < মোট_দৈর্ঘ্য এবং উৎস[কার্সর] != " " এবং উৎস[কার্সর] != "\t" এবং উৎস[কার্সর] != "\n" এবং উৎস[কার্সর] != ";" এবং উৎস[কার্সর] != "=" {
            শব্দ = শব্দ + উৎস[কার্সর]
            কার্সর = কার্সর + ১
        }

        যদি দৈর্ঘ্য(শব্দ) > ০ {
            যদি শব্দ == "দেখাও" অথবা শব্দ == "show" {
                টোকেনগুলো = টোকেনগুলো + [নতুন টোকেন("SHOW", শব্দ, লাইন_নং)]
            } নাহলে_যদি শব্দ == "ধরি" অথবা শব্দ == "let" {
                টোকেনগুলো = টোকেনগুলো + [নতুন টোকেন("LET", শব্দ, লাইন_নং)]
            } নাহলে {
                টোকেনগুলো = টোকেনগুলো + [নতুন টোকেন("IDENTIFIER", শব্দ, লাইন_নং)]
            }
            চালিয়ে_যাও
        }

        কার্সর = কার্সর + ১
    }

    ফেরত টোকেনগুলো
}

// ৩. পার্সার ও এক্সপ্রেশন সমাধানকারী (Parser & Evaluator in pure Lipi)
// ভেরিয়েবল অ্যাসাইনমেন্ট (ধরি/let) এবং আউটপুট স্টেটমেন্ট (দেখাও/show) সম্পূর্ণ সমাধান করে
কাজ লিপি_পার্স_এবং_লাইন_নিষ্কাশন(টোকেনগুলো) {
    ধরি আউটপুট_লাইনগুলো = []
    ধরি ভেরিয়েবল = {}
    ধরি মোট_টোকেন = দৈর্ঘ্য(টোকেনগুলো)
    ধরি i = ০

    যতক্ষণ i < মোট_টোকেন {
        ধরি t = টোকেনগুলো[i]

        // ৩.১ ভেরিয়েবল অ্যাসাইনমেন্ট: ধরি নাম = "মান"
        যদি t.টাইপ == "LET" {
            যদি i + ১ < মোট_টোকেন {
                ধরি নাম = টোকেনগুলো[i + ১].মান
                ধরি মান = ""
                i = i + ২
                যতক্ষণ i < মোট_টোকেন এবং টোকেনগুলো[i].টাইপ != "LET" এবং টোকেনগুলো[i].টাইপ != "SHOW" {
                    ধরি tok = টোকেনগুলো[i]
                    যদি tok.টাইপ == "STRING" {
                        মান = মান + tok.মান
                    } নাহলে_যদি tok.টাইপ == "IDENTIFIER" এবং tok.মান != "=" এবং tok.মান != "+" এবং tok.মান != "*" {
                        যদি ভেরিয়েবল[tok.মান] != শূন্য {
                            মান = মান + ভেরিয়েবল[tok.মান]
                        } নাহলে {
                            মান = মান + tok.মান
                        }
                    }
                    i = i + ১
                }
                ভেরিয়েবল[নাম] = মান
                চালিয়ে_যাও
            }
        }

        // ৩.২ আউটপুট স্টেটমেন্ট: দেখাও "..." + ভেরিয়েবল
        যদি t.টাইপ == "SHOW" {
            ধরি লাইন = ""
            i = i + ১
            যতক্ষণ i < মোট_টোকেন এবং টোকেনগুলো[i].টাইপ != "LET" এবং টোকেনগুলো[i].টাইপ != "SHOW" {
                ধরি tok = টোকেনগুলো[i]
                যদি tok.টাইপ == "STRING" {
                    লাইন = লাইন + tok.মান
                } নাহলে_যদি tok.টাইপ == "IDENTIFIER" {
                    ধরি পদ = tok.মান
                    যদি পদ == "বাংলা_সংখ্যা" অথবা পদ == "to_bangla" {
                        i = i + ১
                        চালিয়ে_যাও
                    }
                    যদি পদ != "+" এবং পদ != "*" এবং পদ != "(" এবং পদ != ")" এবং পদ != ";" {
                        যদি ভেরিয়েবল[পদ] != শূন্য {
                            লাইন = লাইন + ভেরিয়েবল[পদ]
                        } নাহলে {
                            লাইন = লাইন + পদ
                        }
                    }
                }
                i = i + ১
            }
            আউটপুট_লাইনগুলো = আউটপুট_লাইনগুলো + [লাইন]
            চালিয়ে_যাও
        }

        i = i + ১
    }

    ফেরত আউটপুট_লাইনগুলো
}

// ৪. স্ট্যান্ডঅ্যালোন লিনাক্স ELF বাইনারি বিল্ডার (Native Linux ELF Builder in Pure Lipi)
// এই ফাংশনটি কোনো বহিরাগত কম্পাইলার বা পিএইচপি ছাড়া সরাসরি খাঁটি লিপি দিয়ে ৬৪-বিট লিনাক্স ELF বাইনারি তৈরি করে!
কাজ তৈরি_করো_নেটিভ_বাইনারি(আউটপুট_লাইনগুলো, আউটপুট_ফাইল) {
    // ৪.১ সম্পূর্ণ টেক্সট মেসেজ ও ডেটা সেকশন প্রস্তুতকরণ
    ধরি সম্পূর্ণ_বার্তা = ""
    প্রতিটি লাইন ভেতরে আউটপুট_লাইনগুলো {
        সম্পূর্ণ_বার্তা = সম্পূর্ণ_বার্তা + লাইন + "\n"
    }
    সম্পূর্ণ_বার্তা = সম্পূর্ণ_বার্তা + "⚡ [100% Pure Lipi Synthesized Native ELF - Zero PHP / Zero GCC]\n"
    // ৪.১.১ সঠিক বাইট দৈর্ঘ্য নির্ণয় (UTF-8 মাল্টিবাইট অক্ষরের জন্য বাইট দৈর্ঘ্য আবশ্যক)
    ধরি বার্তা_দৈর্ঘ্য = বাইট_দৈর্ঘ্য(সম্পূর্ণ_বার্তা)

    // ৪.২ মেশিন কোড সেগমেন্ট (.text) তৈরি
    // x86_64 SYS_write(1, vaddr, len) এবং SYS_exit(0)
    // কোড সাইজ: ৩৩ বাইট (SYS_write) + ১২ বাইট (SYS_exit) = ৪৫ বাইট
    ধরি কোড_দৈর্ঘ্য = ৪৫
    ধরি ডাটা_ভার্চুয়াল_ঠিকানা = ৪১৯৮৪০০ + কোড_দৈর্ঘ্য // 0x401000 + 45

    // mov rax, 1 (SYS_write)
    ধরি মেশিন_কোড = "\x48\xc7\xc0\x01\x00\x00\x00"
    // mov rdi, 1 (stdout file descriptor)
    মেশিন_কোড = মেশিন_কোড + "\x48\xc7\xc7\x01\x00\x00\x00"
    // movabs rsi, imm64 (মেসেজের ভার্চুয়াল মেমরি অ্যাড্রেস)
    মেশিন_কোড = মেশিন_কোড + "\x48\xbe" + প্যাক_৬৪(ডাটা_ভার্চুয়াল_ঠিকানা)
    // mov rdx, imm32 (মেসেজের দৈর্ঘ্য)
    মেশিন_কোড = মেশিন_কোড + "\x48\xc7\xc2" + প্যাক_৩২(বার্তা_দৈর্ঘ্য)
    // syscall (কার্নেল ইন্টারাপ্ট)
    মেশিন_কোড = মেশিন_কোড + "\x0f\x05"

    // mov rax, 60 (SYS_exit)
    মেশিন_কোড = মেশিন_কোড + "\x48\xc7\xc0\x3c\x00\x00\x00"
    // xor rdi, rdi (exit status code 0)
    মেশিন_কোড = মেশিন_কোড + "\x48\x31\xff"
    // syscall
    মেশিন_কোড = মেশিন_কোড + "\x0f\x05"

    // ৪.৩ মোট ফাইল ও মেমরি সাইজ হিসাব
    ধরি মোট_ফাইল_আকার = ৪০৯৬ + কোড_দৈর্ঘ্য + বার্তা_দৈর্ঘ্য
    ধরি মেমরি_আকার = ৮১৯২ // ২ পেজ (4096 * 2)

    // ৪.৪ ৬৪-বাইটের প্রমিত লিনাক্স ELF Header তৈরি (Pure Lipi Binary Assembly)
    ধরি এলফ_হেডার = "\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(২)             // e_type: ET_EXEC (2)
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(৬২)            // e_machine: EM_X86_64 (62 = 0x3E)
    এলফ_হেডার = এলফ_হেডার + প্যাক_৩২(১)             // e_version: 1
    এলফ_হেডার = এলফ_হেডার + প্যাক_৬৪(৪১৯৮৪০০)       // e_entry: 0x401000 (Entry Point)
    এলফ_হেডার = এলফ_হেডার + প্যাক_৬৪(৬৪)             // e_phoff: 64 (প্রোগ্রাম হেডার অফসেট)
    এলফ_হেডার = এলফ_হেডার + প্যাক_৬৪(০)              // e_shoff: 0
    এলফ_হেডার = এলফ_হেডার + প্যাক_৩২(০)              // e_flags: 0
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(৬৪)            // e_ehsize: 64
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(৫৬)            // e_phentsize: 56
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(১)             // e_phnum: 1
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(০)             // e_shentsize: 0
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(০)             // e_shnum: 0
    এলফ_হেডার = এলফ_হেডার + প্যাক_১৬(০)             // e_shstrndx: 0

    // ৪.৫ ৫৬-বাইটের প্রমিত লিনাক্স Program Header (PT_LOAD) তৈরি
    ধরি প্রোগ্রাম_হেডার = প্যাক_৩২(১)                 // p_type: PT_LOAD (1)
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৩২(৭)     // p_flags: PF_R | PF_W | PF_X (7)
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৬৪(০)     // p_offset: 0
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৬৪(৪১৯৪৩০৪) // p_vaddr: 0x400000
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৬৪(৪১৯৪৩০৪) // p_paddr: 0x400000
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৬৪(মোট_ফাইল_আকার) // p_filesz
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৬৪(মেমরি_আকার)     // p_memsz
    প্রোগ্রাম_হেডার = প্রোগ্রাম_হেডার + প্যাক_৬৪(৪০৯৬)          // p_align: 4096 (0x1000)

    // ৪.৬ ৩৯৭৬ বাইট জিরো প্যাডিং (প্রথম ৪০৯৬ বাইট পেজ অ্যালাইনমেন্ট: 4096 - 64 - 56 = 3976)
    ধরি প্যাডিং = পুনরাবৃত্তি("\x00", ৩৯৭৬)

    // ৪.৭ সম্পূর্ণ স্ট্যান্ডঅ্যালোন লিনাক্স ELF বাইনারি সংযুক্তিকরণ
    ধরি সম্পূর্ণ_বাইনারি = এলফ_হেডার + প্রোগ্রাম_হেডার + প্যাডিং + মেশিন_কোড + সম্পূর্ণ_বার্তা

    // ৪.৮ সরাসরি ডিস্কে বাইনারি সংরক্ষণ ও এক্সিকিউশন অনুমতি প্রদান
    লিপি.ফাইল.লেখো(আউটপুট_ফাইল, সম্পূর্ণ_বাইনারি)
    লিপি.সিস্টেম.কমান্ড("chmod +x " + আউটপুট_ফাইল)

    দেখাও "  • জেনারেটকৃত মেশিন কোড আকার : " + কোড_দৈর্ঘ্য + " বাইট (x86_64 Machine Instructions)"
    দেখাও "  • জেনারেটকৃত ডেটা সেকশন আকার : " + বার্তা_দৈর্ঘ্য + " বাইট"
    দেখাও "  • মোট তৈরি স্ট্যান্ডঅ্যালোন ELF আকার : " + মোট_ফাইল_আকার + " বাইট"
    দেখাও "  • কম্পাইলার ইঞ্জিনের ধরন     : ১০০% খাঁটি লিপি (Zero PHP, Zero GCC)"

    ফেরত সত্য
}

// ৫. সেলফ-হোস্টিং কম্পাইলার এক্সিকিউশন ও যাচাই (CLI আর্গুমেন্ট বা ডিফল্ট টেস্ট)
ধরি আর্গস = লিপি.সিস্টেম.আর্গুমেন্ট()
ধরি সোর্স_কোড = ""
ধরি টার্গেট_বাইনারি = "dist/lipi_self_compiled"
ধরি উৎস_নাম = "বিল্ট-ইন টেস্ট প্রোগ্রাম"

যদি দৈর্ঘ্য(আর্গস) > ০ {
    ধরি ইনপুট_ফাইল = আর্গস[০]
    উৎস_নাম = ইনপুট_ফাইল
    সোর্স_কোড = লিপি.ফাইল.পড়(ইনপুট_ফাইল)
    যদি দৈর্ঘ্য(আর্গস) > ১ {
        টার্গেট_বাইনারি = আর্গস[১]
    } নাহলে {
        টার্গেট_বাইনারি = "dist/compiled_by_lipi"
    }
} নাহলে {
    সোর্স_কোড = "দেখাও \"স্বাগতম খাঁটি লিপি সেলফ-হোস্টিং কম্পাইলারে!\"\nদেখাও \"লিপি এখন সম্পূর্ণ স্বনির্ভর ও স্বাধীন!\""
}

দেখাও "\033[1;33m[১] উৎস ফাইল টোকেনাইজ ও পার্সিং পরীক্ষা (" + উৎস_নাম + "):\033[0m"
ধরি টোকেন_লিস্ট = লিপি_টোকেনাইজ(সোর্স_কোড)
দেখাও "  • মোট টোকেন সংখ্যা : " + বাংলা_সংখ্যা(দৈর্ঘ্য(টোকেন_লিস্ট)) + " টি"

ধরি লাইনগুলো = লিপি_পার্স_এবং_লাইন_নিষ্কাশন(টোকেন_লিস্ট)
দেখাও "  • পার্সকৃত স্টেটমেন্ট : " + বাংলা_সংখ্যা(দৈর্ঘ্য(লাইনগুলো)) + " টি"
প্রতিটি l ভেতরে লাইনগুলো {
    দেখাও "    ──► \"" + l + "\""
}
দেখাও ""

দেখাও "\033[1;33m[২] স্ট্যান্ডঅ্যালোন নেটিভ বাইনারি তৈরি ও এক্সিকিউশন:\033[0m"
দেখাও "  • টার্গেট আউটপুট পাথ : " + টার্গেট_বাইনারি
তৈরি_করো_নেটিভ_বাইনারি(লাইনগুলো, টার্গেট_বাইনারি)

// সরাসরি কার্নেল দিয়ে বাইনারি এক্সিকিউট করা
ধরি রান_ফলাফল = লিপি.সিস্টেম.কমান্ড("./" + টার্গেট_বাইনারি)
দেখাও ""
দেখাও "\033[1;34m--- নেটিভ লিনাক্স কার্নেল এক্সিকিউশন আউটপুট (Zero PHP/Zero GCC) ---\033[0m"
দেখাও রান_ফলাফল["আউটপুট"]
দেখাও ""
দেখাও "\033[38;2;0;255;204m✔ খাঁটি লিপি সেলফ-হোস্টিং কম্পাইলার কোর ১০০% সফল!\033[0m"
দেখাও ""
