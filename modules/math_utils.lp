// ==============================================================================
// 📦 LIPI MODULE: math_utils.lp (গণিত সহায়িকা মডিউল)
// WHY: test/07_multi_file_import.lp এর জন্য প্রয়োজনীয় মডিউল।
// এটি লিপির মাল্টি-ফাইল মডিউল সিস্টেমের উদাহরণ।
// ==============================================================================

ধরি সংস্করণ = "1.0.0"

// দ্বিগুণ: প্রদত্ত সংখ্যাকে ২ দিয়ে গুণ করে ফেরত দেয়
// WHY: মাল্টি-ফাইল ফাংশন ইমপোর্ট পরীক্ষার প্রাথমিক উদাহরণ
কাজ দ্বিগুণ(সংখ্যা) {
    ফেরত সংখ্যা * ২
}

// ত্রিগুণ: প্রদত্ত সংখ্যাকে ৩ দিয়ে গুণ করে ফেরত দেয়
কাজ ত্রিগুণ(সংখ্যা) {
    ফেরত সংখ্যা * ৩
}

// বর্গ: প্রদত্ত সংখ্যার বর্গফল গণনা করে ফেরত দেয়
// WHY: n² = n * n, ভবিষ্যৎ পাইথাগোরাস ও জ্যামিতিক গণনার ভিত্তি
কাজ বর্গ(সংখ্যা) {
    ফেরত সংখ্যা * সংখ্যা
}
