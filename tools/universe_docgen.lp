// standard library API reference across all 14 canonical Universe domains,
// generating a pristine, production-grade GitHub-Flavored Markdown reference manual.
// ==============================================================================

import "universe/core/string"
import "universe/core/io"

@fn build_header()
    h = ""
    h = h + "# 👑 Lipi Universe Standard Library — Complete API Reference\n\n"
    h = h + "> **Version:** First 1.0 (প্রথম ১.০) — Sovereign  \n"
    h = h + "> **Architecture:** Direct Machine Code (x86_64, ARM64, WASM)  \n"
    h = h + "> **Zero-Libc / Zero-C / Zero-Python:** 100% Guaranteed Native Silicon  \n\n"
    h = h + "Welcome to the official, authoritative API reference for **Lipi Universe** (`universe/`).\n"
    h = h + "Lipi is an autonomous, bilingual, high-performance systems and application language\n"
    h = h + "designed from scratch without reliance on GCC, LLVM, Clang, POSIX libc, or external runtimes.\n\n"
    h = h + "The **Universe** standard library consolidates over 280 modules and 73,000 lines of pure machine-code\n"
    h = h + "algorithms across 14 canonical domains, unified by Directed Acyclic Graph (DAG) layering.\n\n"
    h = h + "---\n\n"
    return h
@end

@fn build_toc()
    t = ""
    t = t + "## 📑 Table of Contents\n\n"
    t = t + "1. [Domain 1: Grand Prelude & Unified Umbrella Gateways](#1-grand-prelude--unified-umbrella-gateways)\n"
    t = t + "2. [Domain 2: Core Memory, Arena & Low-Level Foundations](#2-core-memory-arena--low-level-foundations)\n"
    t = t + "3. [Domain 3: High-Throughput Web Engine & HTTP Framework](#3-high-throughput-web-engine--http-framework)\n"
    t = t + "4. [Domain 4: Embedded Database, B+Tree & ACID Storage (LipiKV)](#4-embedded-database-btree--acid-storage-lipikv)\n"
    t = t + "5. [Domain 5: Silicon AI, Vector Mathematics & Tensor Engine](#5-silicon-ai-vector-mathematics--tensor-engine)\n"
    t = t + "6. [Domain 6: Sovereign Networking & Asynchronous Wire Protocols](#6-sovereign-networking--asynchronous-wire-protocols)\n"
    t = t + "7. [Domain 7: FIPS Cryptography, True Kernel Entropy & TLS 1.3](#7-fips-cryptography-true-kernel-entropy--tls-13)\n"
    t = t + "8. [Domain 8: Direct Hardware Framebuffer GUI & 2D Rasterizer](#8-direct-hardware-framebuffer-gui--2d-rasterizer)\n"
    t = t + "9. [Domain 9: Operating System, Syscalls & Bare-Metal Unikernel](#9-operating-system-syscalls--bare-metal-unikernel)\n"
    t = t + "10. [Domain 10: Sovereign Package Management (MPM 2.0)](#10-sovereign-package-management-mpm-20)\n"
    t = t + "11. [Domain 11: Direct GPU SPIR-V Compute & Shader Compiler](#11-direct-gpu-spir-v-compute--shader-compiler)\n"
    t = t + "12. [Domain 12: Silicon CPU Hardware Acceleration & SIMD (AVX2 / AVX-512)](#12-silicon-cpu-hardware-acceleration--simd-avx2--avx-512)\n"
    t = t + "13. [Domain 13: Autonomous Mobile Android DEX Synthesis](#13-autonomous-mobile-android-dex-synthesis)\n"
    t = t + "14. [Domain 14: Universal Code Assimilation & Multi-Language Transpiler](#14-universal-code-assimilation--multi-language-transpiler)\n"
    t = t + "15. [Bilingual English ⇄ Bengali Keyword & Function Dictionary](#15-bilingual-english--bengali-dictionary)\n\n"
    t = t + "---\n\n"
    return t
@end

@fn build_domain1()
    d = ""
    d = d + "## 1. Grand Prelude & Unified Umbrella Gateways\n\n"
    d = d + "The Lipi standard library provides 7 domain umbrella gateways at `universe/*.lp`.\n"
    d = d + "Instead of manually remembering hundreds of deep internal submodule paths, developers can\n"
    d = d + "import domain gateways directly:\n\n"
    d = d + "```lipi\n"
    d = d + "import \"universe/lipi_universe\" // Master prelude (Collections, Arena, SIMD, Crypto, JSON)\n"
    d = d + "import \"universe/web\"           // High-concurrency web server and routing\n"
    d = d + "import \"universe/db\"            // Embedded LipiKV, B+Tree, and WAL storage\n"
    d = d + "import \"universe/ai\"            // AI Tensors, Matrix Multiplication, GGUF\n"
    d = d + "import \"universe/net\"           // Sockets, HTTP/2, WebSocket, gRPC\n"
    d = d + "import \"universe/crypto\"        // SHA-256, AES-GCM, TLS 1.3, Entropy\n"
    d = d + "import \"universe/gui\"           // Direct /dev/fb0 framebuffer and UI chrome\n"
    d = d + "import \"universe/os\"            // Bare-metal kernel, direct syscalls, threads\n"
    d = d + "```\n\n"
    d = d + "### Gateway Functions\n\n"
    d = d + "| Function Signature | Bengali Alias | Description |\n"
    d = d + "| :--- | :--- | :--- |\n"
    d = d + "| `lipi_universe_stats()` | `লিপি_ইউনিভার্স_পরিসংখ্যান()` | Displays active standard library domains, module counts, and hardware verification status. |\n"
    d = d + "| `lipi_hardware_info()` | `লিপি_হার্ডওয়্যার_তথ্য()` | Probes CPUID hardware capabilities (AVX2, AVX-512, cacheline sizes) directly. |\n"
    d = d + "| `lipi_arena_new(capacity)` | `লিপি_নতুন_অ্যারিনা(ক্ষমতা)` | Instantiates a 64-byte aligned sovereign memory arena. |\n"
    d = d + "| `lipi_sha256(s)` | `লিপি_শা২৫৬(লেখা)` | Computes NIST FIPS 180-4 256-bit hexadecimal cryptographic hash. |\n"
    d = d + "| `lipi_db_open(path, capacity)` | `লিপি_ডিবি_ওপেন(পাথ, ক্ষমতা)` | Opens or creates an ACID LipiKV database with Write-Ahead Logging. |\n"
    d = d + "| `lipi_gui_open(w, h)` | `লিপি_গুই_ওপেন(প্রস্থ, উচ্চতা)` | Initializes direct hardware Linux framebuffer or virtual display buffer. |\n\n"
    return d
@end

@fn build_domain2()
    d = ""
    d = d + "## 2. Core Memory, Arena & Low-Level Foundations\n\n"
    d = d + "Direct 64-bit address manipulation and deterministic memory allocation.\n"
    d = d + "Lipi never relies on C malloc/free or POSIX sbrk.\n\n"
    d = d + "### Module: `universe/core/memory.lp`\n"
    d = d + "- `mem_alloc(bytes) -> ptr`: Allocates contiguous memory via raw Linux kernel SYS_mmap.\n"
    d = d + "- `mem_free(ptr, bytes) -> i64`: Releases memory pages directly to the kernel via SYS_munmap.\n"
    d = d + "- `mem_read_u8(ptr, offset) -> i64`: Reads single unsigned 8-bit byte.\n"
    d = d + "- `mem_write_u8(ptr, offset, val) -> i64`: Writes single unsigned 8-bit byte.\n"
    d = d + "- `mem_read_u32(ptr, offset) -> i64`: Reads 32-bit unsigned integer.\n"
    d = d + "- `mem_write_u32(ptr, offset, val) -> i64`: Writes 32-bit unsigned integer.\n"
    d = d + "- `mem_read_u64(ptr, offset) -> i64`: Reads 64-bit unsigned integer.\n"
    d = d + "- `mem_write_u64(ptr, offset, val) -> i64`: Writes 64-bit unsigned integer.\n\n"
    d = d + "### Module: `universe/core/arena.lp`\n"
    d = d + "- `arena_create(capacity) -> Arena`: Initializes a high-speed bump-pointer memory arena.\n"
    d = d + "- `arena_alloc(arena, size) -> ptr`: Rapid O(1) contiguous allocation without page fragmentation.\n"
    d = d + "- `arena_alloc_aligned(arena, size, alignment) -> ptr`: Allocates memory strictly aligned to hardware boundaries (e.g. 64-byte AVX-512 cachelines).\n"
    d = d + "- `arena_reset(arena) -> i64`: Rewinds bump offset to 0 for instant bulk reclamation.\n\n"
    d = d + "### Module: `universe/core/string.lp`\n"
    d = d + "- `str_len(s) -> i64`: Instant O(1) STR0 length lookup.\n"
    d = d + "- `str_concat(s1, s2) -> string`: Zero-copy concatenator with STR0 capacity expansion.\n"
    d = d + "- `str_sub(s, start, end) -> string`: In-place string slice.\n"
    d = d + "- `to_str(val) -> string`: Universal integer/value string formatter.\n"
    d = d + "- `to_int(val) -> i64`: Robust zero-libc integer parser.\n"
    d = d + "- `float_from_str(s) -> f64`: Pure software IEEE-754 decimal parser.\n"
    d = d + "- `str_split(s, sep) -> array`: High-speed string splitter.\n\n"
    d = d + "### Module: `universe/core/json_fast.lp`\n"
    d = d + "- `fast_json_parse(json_str) -> doc`: Zero-copy linear-time JSON deserializer.\n"
    d = d + "- `fast_json_get(doc, obj_idx, key) -> node_idx`: Fast key lookup.\n"
    d = d + "- `fast_json_get_str(doc, node_idx) -> string`: Extracts unescaped string payload.\n"
    d = d + "- `fast_json_get_int(doc, node_idx) -> i64`: Extracts numeric integer value.\n"
    d = d + "- `fast_json_path(doc, root, path_str) -> node_idx`: Traverses dotted path (e.g. `\"user.stats.score\"`).\n\n"
    return d
@end

@fn build_domain3()
    d = ""
    d = d + "## 3. High-Throughput Web Engine & HTTP Framework\n\n"
    d = d + "100% native asynchronous HTTP/1.1 and HTTP/2 engine with zero external dependencies.\n\n"
    d = d + "### Module: `universe/web.lp` & `universe/web/engine.lp`\n"
    d = d + "- `web_app_create() -> WebApp`: Constructs an asynchronous HTTP web application.\n"
    d = d + "- `web_route(app, method, path, handler_fn) -> i64`: Registers high-speed router endpoints with exact and wildcard prefix support.\n"
    d = d + "- `web_listen_and_serve(app, port) -> i64`: Binds non-blocking TCP socket and processes connections via Linux epoll reactor.\n"
    d = d + "- `http_response_ok(body, content_type) -> string`: Packages standard `200 OK` HTTP envelope.\n"
    d = d + "- `http_response_json(json_body) -> string`: Formats `application/json` response with correct `Content-Length` headers.\n"
    d = d + "- `http_response_not_found() -> string`: Packages `404 Not Found` response.\n\n"
    d = d + "```lipi\n"
    d = d + "import \"universe/web\"\n\n"
    d = d + "app = web_app_create()\n"
    d = d + "web_route(app, \"GET\", \"/api/health\", @fn(req) return http_response_json(\"{\\\"status\\\":\\\"ok\\\"}\") @end)\n"
    d = d + "web_listen_and_serve(app, 8080)\n"
    d = d + "```\n\n"
    return d
@end

@fn build_domain4()
    d = ""
    d = d + "## 4. Embedded Database, B+Tree & ACID Storage (LipiKV)\n\n"
    d = d + "Autonomous embedded transactional database engine combining disk B+Tree indexing,\n"
    d = d + "LRU Buffer Pool page cache, and Write-Ahead Logging (WAL).\n\n"
    d = d + "### Module: `universe/db.lp` & `universe/db/engine.lp`\n"
    d = d + "- `lipi_db_open(path, frame_capacity) -> Database`: Opens or initializes ACID database.\n"
    d = d + "- `db_put(db, key, value) -> i64`: Atomically writes entry to WAL, syncs to disk, and updates memory B+Tree.\n"
    d = d + "- `db_get(db, key) -> string`: Queries value by key through B+Tree and Page Cache.\n"
    d = d + "- `db_delete(db, key) -> i64`: Removes entry under strict WAL logging.\n"
    d = d + "- `db_checkpoint(db) -> i64`: Flushes dirty buffer frames to disk and safely truncates WAL.\n"
    d = d + "- `db_close(db) -> i64`: Syncs pages, closes file descriptors, and releases resources.\n\n"
    d = d + "### Module: `universe/db/kv.lp` (In-Memory Key-Value Store)\n"
    d = d + "- `KV_create(bucket_count) -> KV`: Instantiates lock-free in-memory key-value dictionary.\n"
    d = d + "- `KV_set(kv, key, val) -> i64`: Stores key-value mapping.\n"
    d = d + "- `KV_get(kv, key) -> string`: Retrieves value.\n"
    d = d + "- `KV_delete(kv, key) -> i64`: Deletes key.\n\n"
    return d
@end

@fn build_domain5()
    d = ""
    d = d + "## 5. Silicon AI, Vector Mathematics & Tensor Engine\n\n"
    d = d + "Direct machine code vector arithmetic, SIMD GEMM matrix multiplication,\n"
    d = d + "activation functions, and native GGUF LLM weight ingestion.\n\n"
    d = d + "### Module: `universe/ai.lp` & `universe/ai/tensor_engine.lp`\n"
    d = d + "- `tensor_new(rows, cols) -> Tensor`: Allocates 2D tensor in aligned memory.\n"
    d = d + "- `tensor_matmul(A, B) -> Tensor`: Computes General Matrix Multiplication (GEMM) via AVX2 / AVX-512 register tiling.\n"
    d = d + "- `tensor_dot(v1, v2, len) -> i64`: Computes vector dot product in single-instruction SIMD.\n"
    d = d + "- `tensor_relu(t) -> Tensor`: In-place Rectified Linear Unit activation.\n"
    d = d + "- `tensor_sigmoid(t) -> Tensor`: Pure software polynomial Sigmoid transformation.\n\n"
    d = d + "### Module: `universe/ai/gguf.lp`\n"
    d = d + "- `gguf_open(path) -> GgufModel`: Ingests binary GGUF LLM model headers and tensor metadata.\n"
    d = d + "- `gguf_get_tensor(model, name) -> TensorRef`: Direct zero-copy memory mapped tensor slice.\n\n"
    return d
@end

@fn build_domain6()
    d = ""
    d = d + "## 6. Sovereign Networking & Asynchronous Wire Protocols\n\n"
    d = d + "Raw Linux Berkeley Socket abstraction with direct Linux AMD64 syscall dispatching.\n\n"
    d = d + "### Module: `universe/net.lp` & `universe/net/socket.lp`\n"
    d = d + "- `socket_tcp() -> fd`: Creates raw `AF_INET (2)`, `SOCK_STREAM (1)` socket.\n"
    d = d + "- `socket_bind(fd, port) -> i64`: Binds network interface without libc `sockaddr_in` overhead.\n"
    d = d + "- `socket_listen(fd, backlog) -> i64`: Places socket into passive listening state.\n"
    d = d + "- `socket_accept(fd) -> client_fd`: Accepts incoming client connection.\n"
    d = d + "- `socket_connect(ip, port) -> fd`: Initiates outbound TCP connection.\n"
    d = d + "- `socket_send(fd, data, len) -> i64`: Direct `SYS_sendto` socket transmission.\n"
    d = d + "- `socket_recv(fd, buf, max_len) -> i64`: Direct `SYS_recvfrom` socket reception.\n"
    d = d + "- `ws_frame_encode(opcode, payload) -> string`: Encodes RFC 6455 WebSocket frame.\n"
    d = d + "- `ws_frame_decode(raw_frame) -> FrameData`: Validates masking key and decodes payload.\n\n"
    return d
@end

@fn build_domain7()
    d = ""
    d = d + "## 7. FIPS Cryptography, True Kernel Entropy & TLS 1.3\n\n"
    d = d + "FIPS 180-4 compliant cryptographic suite with zero OpenSSL or external C dependencies.\n\n"
    d = d + "### Module: `universe/crypto.lp` & `universe/crypto/sha256.lp`\n"
    d = d + "- `lipi_sha256(s) -> string`: Computes deterministic 64-character hex SHA-256 digest.\n"
    d = d + "- `sha256_init() -> Sha256Context`: Initializes streaming hashing state.\n"
    d = d + "- `sha256_update(ctx, data) -> Sha256Context`: Feeds arbitrary byte streams or strings.\n"
    d = d + "- `sha256_final(ctx) -> array`: Finalizes block padding and returns 32 raw digest bytes.\n"
    d = d + "- `crypto_random_bytes(count) -> array`: Gathers true cryptographic entropy directly from Linux `SYS_getrandom (318)`.\n\n"
    d = d + "### Module: `universe/crypto/advanced.lp` (NIST SP 800-38D)\n"
    d = d + "- `aes_gcm_encrypt(key, iv, plaintext, aad) -> CipherResult`: Authenticated AES-GCM encryption with 128-bit GHASH authentication tag.\n"
    d = d + "- `aes_gcm_decrypt(key, iv, ciphertext, tag, aad) -> PlainResult`: Constant-time authentication tag verification and decryption.\n\n"
    return d
@end

@fn build_domain8()
    d = ""
    d = d + "## 8. Direct Hardware Framebuffer GUI & 2D Rasterizer\n\n"
    d = d + "Renders graphics directly onto Linux hardware `/dev/fb0` or virtual double-buffered memory.\n"
    d = d + "Zero X11, Zero Wayland, Zero GPU driver dependencies.\n\n"
    d = d + "### Module: `universe/gui.lp` & `universe/gui/framebuffer.lp`\n"
    d = d + "- `lipi_gui_open(width, height) -> LipiFramebuffer`: Queries hardware screen info via `SYS_ioctl (16)` and establishes double-buffered backbuffer.\n"
    d = d + "- `fb_draw_pixel(fb, x, y, color) -> i64`: Draws 32-bit ARGB pixel at dynamic stride offset.\n"
    d = d + "- `fb_read_pixel(fb, x, y) -> i64`: Inspects color value of backbuffer pixel.\n"
    d = d + "- `fb_fill_rect(fb, x, y, w, h, color) -> i64`: High-speed clipped rectangle fill.\n"
    d = d + "- `fb_window_create(fb, x, y, w, h, title) -> i64`: Renders complete desktop window chrome (Mantle header, border, close button, title text).\n"
    d = d + "- `fb_draw_lipi_icon(fb, x, y) -> i64`: Rasterizes the official Lipi Brand Icon (Cyan vertical stem `#00C2FF`, Magenta base `#FF007A`, Gold loop `#FFD700`).\n"
    d = d + "- `fb_button_create(fb, x, y, w, h, label, is_pressed) -> i64`: Interactive GUI button widget.\n"
    d = d + "- `fb_flip(fb) -> i64`: Blits backbuffer to front video memory for tear-free display.\n"
    d = d + "- `lipi_fb_close(fb) -> i64`: Releases framebuffer video mappings.\n\n"
    return d
@end

@fn build_domain9()
    d = ""
    d = d + "## 9. Operating System, Syscalls & Bare-Metal Unikernel\n\n"
    d = d + "Bare-metal Ring-0 execution and raw Linux kernel ABI bindings.\n\n"
    d = d + "### Module: `universe/os/syscalls.lp`\n"
    d = d + "- `sys_open(path, flags, mode) -> fd`: Linux SYS_open (syscall 2).\n"
    d = d + "- `sys_close(fd) -> i64`: Linux SYS_close (syscall 3).\n"
    d = d + "- `sys_read(fd, buf, count) -> i64`: Linux SYS_read (syscall 0).\n"
    d = d + "- `sys_write(fd, buf, count) -> i64`: Linux SYS_write (syscall 1).\n"
    d = d + "- `sys_mmap(addr, len, prot, flags, fd, off) -> ptr`: Linux SYS_mmap (syscall 9).\n"
    d = d + "- `sys_munmap(addr, len) -> i64`: Linux SYS_munmap (syscall 11).\n"
    d = d + "- `sys_exit(code)`: Terminates process via Linux SYS_exit (syscall 60).\n\n"
    d = d + "### Module: `universe/os/kernel_multiboot.lp`\n"
    d = d + "- `kernel_synthesize_multiboot2_image(output_bin)`: Generates raw x86_64 Multiboot2 bootable ELF image with VGA 0xB8000 and COM1 UART 0x3F8 drivers for QEMU bare-metal boot.\n\n"
    return d
@end

@fn build_domain10_14()
    d = ""
    d = d + "## 10. Sovereign Package Management (MPM 2.0)\n\n"
    d = d + "Deterministic package management with SHA-256 cryptographically locked dependency trees.\n"
    d = d + "- `mpm init`: Initializes a pristine `lipi.pkg` project manifest.\n"
    d = d + "- `mpm add <pkg>`: Registers package dependency and updates manifest.\n"
    d = d + "- `mpm install`: Resolves Directed Acyclic Graph (DAG) and generates bit-for-bit reproducible `lipi.lock`.\n"
    d = d + "- `mpm verify`: Validates hash integrity of all installed artifacts against lockfile.\n\n"
    d = d + "---\n\n"
    d = d + "## 11. Direct GPU SPIR-V Compute & Shader Compiler\n\n"
    d = d + "Pure Lipi binary compiler synthesizing Khronos standard SPIR-V 1.0 binary modules.\n"
    d = d + "- `spirv_build_vector_add_kernel() -> SpirvModule`: Generates Vulkan/OpenCL compute shader.\n"
    d = d + "- `spirv_write_binary(mod, path) -> i64`: Emits byte-aligned SPIR-V binary directly to disk.\n\n"
    d = d + "---\n\n"
    d = d + "## 12. Silicon CPU Hardware Acceleration & SIMD (AVX2 / AVX-512)\n\n"
    d = d + "Direct machine code instruction synthesis exploiting 256-bit YMM and 512-bit ZMM silicon registers.\n"
    d = d + "- `vector_sum_hardware(ptr, count) -> i64`: 8-wide / 16-wide parallel arithmetic reduction.\n"
    d = d + "- `avx512_gemm_4x4_tile(a, b, c, lda, ldb, ldc)`: 4x4 register-tiled matrix multiplication microkernel without stack spills.\n"
    d = d + "- `cpu_has_avx2() -> i64`: Runtime CPUID hardware feature detection.\n"
    d = d + "- `cpu_has_avx512() -> i64`: Probes AVX-512 Foundation (F) and Vector Length Extensions (VL).\n\n"
    d = d + "---\n\n"
    d = d + "## 13. Autonomous Mobile Android DEX Synthesis\n\n"
    d = d + "Pure sovereign DEX bytecode synthesizer producing installable Android binaries without JVM, Gradle, or Android SDK.\n"
    d = d + "- `dex_create_apk(package_name, activity_name) -> ApkBytes`: Emits Android Dalvik Executable with valid Adler32 and SHA-1 checksum headers.\n"
    d = d + "- `LipiNativeActivity.lipi`: Sovereign mobile application entry point.\n\n"
    d = d + "---\n\n"
    d = d + "## 14. Universal Code Assimilation & Multi-Language Transpiler\n\n"
    d = d + "In-memory AST lowering engine converting legacy languages into canonical Lipi 2.0 source.\n"
    d = d + "- `assimilate_python_source(py_code) -> string`: Lowers Python function definitions, indentation blocks, and control flow into pure Lipi AST.\n"
    d = d + "- `assimilate_c_source(c_code) -> string`: Strips C-style braces, semicolon delimiters, and types into idiomatic Lipi syntax.\n"
    d = d + "- `assimilate_file_to_lipi(in_path, out_path) -> i64`: Complete end-to-end file migration pipeline.\n\n"
    d = d + "---\n\n"
    return d
@end

@fn build_bilingual_dictionary()
    d = ""
    d = d + "## 15. Bilingual English ⇄ Bengali Dictionary\n\n"
    d = d + "Lipi is the world's first fully bilingual sovereign programming language.\n"
    d = d + "Any English keyword or function in Universe can be interchanged with its canonical Bengali equivalent.\n\n"
    d = d + "| English Keyword / Function | Bengali Keyword / Function | Domain |\n"
    d = d + "| :--- | :--- | :--- |\n"
    d = d + "| `say` / `print` / `println` | `বলো` / `দেখাও` | Standard Output |\n"
    d = d + "| `if` / `elif` / `else` | `যদি` / `নাহলে_যদি` / `নাহলে` | Control Flow |\n"
    d = d + "| `while` / `for` | `যতক্ষণ` / `জন্য` | Iteration Loops |\n"
    d = d + "| `return` | `ফেরত` | Function Termination |\n"
    d = d + "| `lipi_universe_stats()` | `লিপি_ইউনিভার্স_পরিসংখ্যান()` | Grand Prelude |\n"
    d = d + "| `lipi_hardware_info()` | `লিপি_হার্ডওয়্যার_তথ্য()` | Silicon Introspection |\n"
    d = d + "| `lipi_arena_new()` | `লিপি_নতুন_অ্যারিনা()` | Core Arena Memory |\n"
    d = d + "| `lipi_sha256()` | `লিপি_শা২৫৬()` | Cryptography |\n"
    d = d + "| `lipi_db_open()` | `লিপি_ডিবি_ওপেন()` | Database Engine |\n"
    d = d + "| `lipi_gui_open()` | `লিপি_গুই_ওপেন()` | Framebuffer GUI |\n"
    d = d + "| `to_int()` | `লিপি_ইন্টে_রূপান্তর()` | String Conversion |\n"
    d = d + "| `str_upper()` | `বড়_অক্ষর()` | String Case |\n"
    d = d + "| `str_lower()` | `ছোট_অক্ষর()` | String Case |\n"
    d = d + "| `str_trim()` | `ছাঁটাই()` | String Cleaning |\n\n"
    d = d + "---\n\n"
    d = d + "> *Generated autonomously by Lipi Sovereign DocGen Engine (`tools/universe_docgen.lp`).*\n"
    d = d + "> *100% Pure Lipi Machine Code Engine | 0% Libc | 0% Python | 0% C.*\n"
    return d
@end

@fn main()
    say "=================================================================="
    say "  📖 LIPI UNIVERSE SOVEREIGN DOCGEN ENGINE (tools/universe_docgen.lp)"
    say "  ⚡ 100% Pure Sovereign Lipi Machine Code | Zero Libc | Zero Python"
    say "=================================================================="

    say "▶ Synthesizing Complete Universe API Reference..."
    doc = ""
    doc = doc + build_header()
    doc = doc + build_toc()
    doc = doc + build_domain1()
    doc = doc + build_domain2()
    doc = doc + build_domain3()
    doc = doc + build_domain4()
    doc = doc + build_domain5()
    doc = doc + build_domain6()
    doc = doc + build_domain7()
    doc = doc + build_domain8()
    doc = doc + build_domain9()
    doc = doc + build_domain10_14()
    doc = doc + build_bilingual_dictionary()

    out_file = "docs/UNIVERSE_API_REFERENCE.md"
    say "▶ Writing documentation artifact to: " + out_file + "..."
    file_write(out_file, doc)

    say "  ✔ Successfully written " + to_str(len(doc)) + " bytes of documentation."
    say "=================================================================="
    say "🎉 UNIVERSE API REFERENCE GENERATION COMPLETE!"
    say "=================================================================="
    return 0
@end

main()
