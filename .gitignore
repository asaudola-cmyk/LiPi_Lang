# ==============================================================================
# Lipi Programming Language — Git Ignore Configuration
# WHY: Clean, standardized configuration without legacy 3rd-party/PHP debris.
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Artifacts & Compiled Binaries
# WHY: Binaries generated during native bootstrap, self-hosting, and compilation
# should not be committed to source control (boot/lipi-seed is the canonical seed).
# ------------------------------------------------------------------------------
/dist/*
!/dist/.gitkeep
/build/*
!/build/.gitkeep

bin/lipc_bin
bin/lipc_native_elf
bin/lipc_pure_elf
bin/lipic-stage1
bin/lipic_gen
bin/lipi-gen2
bin/lipirepl_bin
bin/lipils
bin/lipic2

# Standalone package manager dependencies
lipi_modules/

# Compiled Application Binaries
apps/**/lipi_server
apps/**/site_builder

# Generic object files and binaries
*.o
*.a
*.so
*.dylib
*.bin
*.out

# ------------------------------------------------------------------------------
# Editor & OS Artifacts
# WHY: Prevent developer-specific environment clutter in repositories.
# ------------------------------------------------------------------------------
*~
*.swp
*.tmp
*.log
.DS_Store
Thumbs.db

# VS Code / IDE development caches (editors/vscode extension builds)
.vscode/*
!.vscode/settings.json
.idea/
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix

junit.out.xml
.cache/
iso_staging/



# Test binaries and temporary silicon artifacts
bin/test_*
*.spv
*.db
/tmp/libtest_*
