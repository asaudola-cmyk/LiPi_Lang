{
  "name": "lipi-lang",
  "displayName": "Lipi Language",
  "description": "Lipi Programming Language — Syntax highlighting, snippets, and language support for .lp files",
  "version": "1.0.0",
  "publisher": "lipi-lang",
  "icon": "icons/lipi-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asaudola-cmyk/LiPi_Lang"
  },
  "homepage": "https://github.com/asaudola-cmyk/LiPi_Lang",
  "bugs": {
    "url": "https://github.com/asaudola-cmyk/LiPi_Lang/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "lipi", "lp", "lipi-lang", "bengali", "unicode", "minimal"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lipi",
        "aliases": ["Lipi", "lipi"],
        "extensions": [".lp"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lipi-icon.png",
          "dark": "./icons/lipi-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "lipi",
        "scopeName": "source.lipi",
        "path": "./syntaxes/lipi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lipi",
        "path": "./snippets/lipi.json"
      }
    ],
    "configurationDefaults": {
      "[lipi]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordBasedSuggestions": "off"
      }
    }
  }
}
