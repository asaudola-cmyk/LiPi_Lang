{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lipi",
  "scopeName": "source.lipi",
  "fileTypes": ["lp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-def" },
    { "include": "#struct-def" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.lipi",
        "match": "//.*$"
      }]
    },
    "strings": {
      "patterns": [{
        "name": "string.quoted.double.lipi",
        "begin": "\"",
        "end": "\"",
        "patterns": [
          { "name": "constant.character.escape.lipi", "match": "\\\\." },
          { "name": "variable.other.interpolated.lipi", "match": "\\{[^}]+\\}" }
        ]
      }]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lipi",
          "match": "\\b(if|elif|else|while|for|in|repeat|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.lipi",
          "match": "\\b(fn|struct|include|import)\\b"
        },
        {
          "name": "keyword.other.lipi",
          "match": "\\b(and|or|not|null|nil|true|false|step|to|times|each)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [{
        "name": "support.function.builtin.lipi",
        "match": "\\b(say|print|println|show|len|str|int|float|abs|min|max|type|input|syscall)\\b"
      }]
    },
    "constants": {
      "patterns": [{
        "name": "constant.language.lipi",
        "match": "\\b(true|false|null|nil)\\b"
      }]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lipi",
          "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.lipi",
          "match": "[\\u09E6-\\u09EF]+\\.?[\\u09E6-\\u09EF]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arithmetic.lipi", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.comparison.lipi", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.assignment.lipi", "match": "(?<![=!<>])=(?!=)" },
        { "name": "keyword.operator.range.lipi", "match": "\\.\\." }
      ]
    },
    "function-def": {
      "patterns": [{
        "match": "^(\\s*)(fn)\\s+([\\w\\u0980-\\u09FF]+)",
        "captures": {
          "2": { "name": "keyword.declaration.lipi" },
          "3": { "name": "entity.name.function.lipi" }
        }
      }]
    },
    "struct-def": {
      "patterns": [{
        "match": "^(\\s*)(struct)\\s+([\\w\\u0980-\\u09FF]+)",
        "captures": {
          "2": { "name": "keyword.declaration.lipi" },
          "3": { "name": "entity.name.type.lipi" }
        }
      }]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.lipi",
          "match": "\\b([\\w\\u0980-\\u09FF]+)(?=\\s*\\()"
        },
        {
          "name": "variable.other.lipi",
          "match": "[\\u0980-\\u09FF\\u0600-\\u06FF][\\w\\u0980-\\u09FF\\u0600-\\u06FF]*"
        }
      ]
    }
  }
}
