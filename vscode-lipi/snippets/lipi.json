{
  "Function Definition": {
    "prefix": ["fn", "func"],
    "body": ["fn ${1:name} ${2:params}", "\t${3:body}"],
    "description": "Define a function"
  },
  "Function One-liner": {
    "prefix": "fnl",
    "body": ["fn ${1:name} ${2:params} = ${3:expr}"],
    "description": "One-line function"
  },
  "If Statement": {
    "prefix": "ife",
    "body": ["if ${1:condition}", "\t${2:then}", "else", "\t${3:else}"],
    "description": "If-else statement"
  },
  "While Loop": {
    "prefix": "wh",
    "body": ["while ${1:condition}", "\t${2:body}"],
    "description": "While loop"
  },
  "For Range": {
    "prefix": "fr",
    "body": ["for ${1:i} in ${2:1}..${3:10}", "\t${4:body}"],
    "description": "For range loop"
  },
  "Repeat": {
    "prefix": "rep",
    "body": ["repeat ${1:5}", "\t${2:body}"],
    "description": "Repeat N times"
  },
  "Struct Definition": {
    "prefix": "st",
    "body": ["struct ${1:Name}", "\t${2:field1}", "\t${3:field2}"],
    "description": "Define a struct"
  },
  "Say": {
    "prefix": "say",
    "body": ["say \"${1:message}\""],
    "description": "Print to stdout"
  },
  "Hello World": {
    "prefix": "hello",
    "body": ["say \"Hello, World!\""],
    "description": "Hello World"
  },
  "Factorial": {
    "prefix": "factorial",
    "body": [
      "fn factorial n",
      "\tif n <= 1",
      "\t\treturn 1",
      "\treturn n * factorial(n - 1)",
      "",
      "say factorial ${1:10}"
    ],
    "description": "Recursive factorial"
  },
  "Fibonacci": {
    "prefix": "fibonacci",
    "body": [
      "fn fibonacci n",
      "\tif n <= 1",
      "\t\treturn n",
      "\ta = 0",
      "\tb = 1",
      "\ti = 2",
      "\twhile i <= n",
      "\t\tc = a + b",
      "\t\ta = b",
      "\t\tb = c",
      "\t\ti = i + 1",
      "\treturn b",
      "",
      "for i in 0..${1:10}",
      "\tsay fibonacci i"
    ],
    "description": "Iterative fibonacci"
  }
}
