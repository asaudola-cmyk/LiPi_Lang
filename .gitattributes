# ==============================================================================
# 👑 LiPi Sovereign Programming Language — Git Attributes
# ⚡ Standards configuration for GitHub Linguist, line endings, and binaries
# ==============================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# LiPi Source Code files (*.lp, *.lipi, *.লিপি)
*.lp text eol=lf linguist-language=Lipi
*.lipi text eol=lf linguist-language=Lipi
*.লিপি text eol=lf linguist-language=Lipi

# Documentation and Project Specifications
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Canonical Bootstrap Binary Seed & Graphic Assets
src/boot/lipi-seed binary
boot/lipi-seed binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.iso binary
*.vsix binary
