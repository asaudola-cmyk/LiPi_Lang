{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) -> ${3:ReturnType} {",
      "\t$0",
      "}"
    ],
    "description": "Maya Function"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Maya Struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Maya Enum"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:pattern} => ${3:result},",
      "\t_ => ${4:default},",
      "}"
    ],
    "description": "Maya Match Expression"
  },
  "Test Function": {
    "prefix": "test",
    "body": [
      "@test",
      "fn test_${1:name}() {",
      "\t$0",
      "}"
    ],
    "description": "Maya Test Function"
  }
}
