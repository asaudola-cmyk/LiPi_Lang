{
  "Function Definition (English)": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params})",
      "    ${0:// function body}",
      "    return ${3:result}"
    ],
    "description": "Define a function in Lipi"
  },
  "OOP Struct Method (English)": {
    "prefix": "fn method",
    "body": [
      "fn ${1:Class}.${2:method}(${3:params})",
      "    ${0:// method implementation}",
      "    return ${4:result}"
    ],
    "description": "Define an OOP struct method in Lipi"
  },
  "Function Definition (Bengali)": {
    "prefix": "কাজ",
    "body": [
