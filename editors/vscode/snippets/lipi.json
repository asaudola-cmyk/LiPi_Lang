  "Pattern Match (English)": {
    "prefix": "match",
    "body": [
      "match ${1:val}",
      "    case ${2:1} =>",
      "        ${3:// case 1}",
      "    case ${4:2} =>",
      "        ${5:// case 2}",
      "    else =>",
      "        ${0:// default}"
    ],
    "description": "Pattern matching block"
  },
  "Hash Map Template": {
    "prefix": "hashmap",
    "body": [
      "include \"std/hashmap.lp\"",
      "",
      "hm = hashmap_new()",
      "hashmap_set(hm, \"${1:key}\", \"${2:value}\")",
      "val = hashmap_get(hm, \"${1:key}\")",
      "say \"Lookup result: \" + val"
    ],
    "description": "Fast Robin-Hood hash map data structure initialization and lookup"
  },
  "Memory Arena Allocator": {
    "prefix": "arena",
    "body": [
      "include \"std/arena.lp\"",
      "",
      "ar = arena_create(${1:65536}) // 64KB arena",
      "ptr1 = arena_alloc(ar, ${2:256})",
      "arena_reset(ar)"
    ],
    "description": "High-performance contiguous memory arena allocator"
  },
  "Linux Kernel Syscall": {
    "prefix": "syscall",
    "body": [
      "// Linux AMD64 Syscall: num=${1:1}, arg1=${2:1}, arg2=${3:buf}, arg3=${4:len}",
      "res = syscall(${1:1}, ${2:1}, ${3:buf}, ${4:len}, 0, 0, 0)"
    ],
    "description": "Direct Linux x86_64 kernel syscall (0% Libc)"
  }
