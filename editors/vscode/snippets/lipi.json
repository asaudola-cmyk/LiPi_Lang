  "Struct Definition (English)": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "    ${2:field1},",
      "    ${3:field2}"
    ],
    "description": "Define a structure data type"
  },
  "Struct Definition (Bengali)": {
    "prefix": "কাঠামো",
    "body": [
      "কাঠামো ${1:নাম}",
      "    ${2:ক্ষেত্র১},",
      "    ${3:ক্ষেত্র২}"
    ],
    "description": "লিপিতে নতুন ডেটা কাঠামো তৈরি করুন"
  },
  "Web Router HTTP Server": {
    "prefix": "web_router",
    "body": [
      "include \"std/web.lp\"",
      "",
      "fn handle_home(req)",
      "    return web_response_json(200, \"{\\\"status\\\":\\\"ok\\\",\\\"message\\\":\\\"Lipi Server Online\\\"}\")",
      "",
      "fn handle_api(req)",
      "    return web_response_json(200, \"{\\\"version\\\":\\\"2.0.0\\\",\\\"engine\\\":\\\"lipc\\\"}\")",
      "",
      "fn start_server()",
      "    router = web_router_create()",
      "    web_router_get(router, \"/\", handle_home)",
      "    web_router_get(router, \"/api\", handle_api)",
      "    say \"🚀 Web Server listening on http://0.0.0.0:${1:8080}...\"",
      "    web_server_start(router, ${1:8080})",
      "",
      "start_server()"
    ],
    "description": "High-performance HTTP Web Router and Server template using std/web.lp"
  },
  "Native Thread Spawn": {
    "prefix": "thread_create",
    "body": [
      "include \"std/thread.lp\"",
      "",
      "fn worker_task(arg)",
      "    say \"[Thread Worker] Running task with arg: \" + arg",
      "    ${0:// concurrent workload here}",
      "    return 0",
      "",
      "th = thread_create(worker_task, ${1:100})",
      "thread_join(th)",
      "say \"✔ Thread execution completed.\""
    ],
    "description": "Spawn and join a native Linux OS thread via direct clone syscall"
  },
  "Say Statement (English)": {
    "prefix": "say",
    "body": [
      "say \"${1:Hello, Lipi!}\""
    ],
    "description": "Print line to standard output"
  },
  "Bolo Statement (Bengali)": {
    "prefix": "বলো",
    "body": [
