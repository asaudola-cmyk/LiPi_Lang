{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lipi",
  "scopeName": "source.lipi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numerals"
    },
    {
      "include": "#keywords_control"
    },
    {
      "include": "#keywords_declaration"
    },
    {
      "include": "#type_keywords"
    },
    {
      "include": "#constants_boolean"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#structs"
    },
    {
      "include": "#keywords_subsystems"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.docstring.lipi",
          "match": "///.*$"
        },
        {
          "name": "comment.block.documentation.lipi",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.lipi",
          "match": "//.*$"
        },
        {
          "name": "comment.line.directive.lipi",
          "match": "@!.*$"
        },
        {
          "name": "comment.line.number-sign.lipi",
          "match": "#.*$"
        },
        {
          "name": "comment.block.lipi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lipi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\([0-9]{3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|[nrt\\\"'\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.single.lipi",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numerals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lipi",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.lipi",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.bengali.lipi",
          "match": "\\b[০-৯]+(\\.[০-৯]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.lipi",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.lipi",
          "match": "(@if|@elif|@else|@while|@for|@end|@return|@break|@continue|@yield)\\b|\\b(if|elif|elseif|else|then|while|for|in|return|match|case|break|continue|try|catch|throw|spawn|async|await|main|যদি|নাহলে_যদি|নাহলে|তবে|যতক্ষণ|প্রতিটি|মধ্যে|ভেতরে|ফেরত|মিল|ঘটনা|থামো|চলো|চালিয়ে_যাও|চেষ্টা|ধরো|নিক্ষেপ|সহযোগ|সমান্তরাল|অপেক্ষা|প্রধান)\\b"
        }
      ]
    },
    "keywords_declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.lipi",
          "match": "(@fn|@struct|@let|@var|@const|@type|@pub|@use|@include)\\b|\\b(fn|struct|let|var|const|type|asm|include|import|as|pub|priv|abstract|interface|impl|extends|কাজ|কাঠামো|গঠন|চলক|ধরি|ধ্রুবক|ধরন|অন্তর্ভুক্ত|আমদানি|হিসেবে|সার্বজনীন|সংরক্ষিত|বিমূর্ত|ইন্টারফেস|বাস্তবায়ন|বিস্তার)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "(@fn|\\b(fn|কাজ|def|func|function))\\s+([\\p{L}_][\\p{L}0-9_]*)\\.([\\p{L}_][\\p{L}0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.lipi"
            },
            "2": {
              "name": "entity.name.type.class.lipi"
            },
            "3": {
              "name": "entity.name.function.lipi"
            }
          }
        },
        {
          "match": "(@fn|\\b(fn|কাজ|def|func|function))\\s+([\\p{L}_][\\p{L}0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.lipi"
            },
            "2": {
              "name": "entity.name.function.lipi"
            }
          }
        },
        {
          "match": "\\.([\\p{L}_][\\p{L}0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.member.lipi"
        },
        {
          "match": "([\\p{L}_][\\p{L}0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.lipi"
        }
      ]
    },
    "structs": {
      "patterns": [
        {
          "match": "(@struct|\\b(struct|class|interface|কাঠামো|গঠন|ইন্টারফেস))\\s+([\\p{L}_][\\p{L}0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.lipi"
            },
            "2": {
              "name": "entity.name.type.class.lipi"
            }
          }
        }
      ]
    },
    "type_keywords": {
      "patterns": [
        {
          "name": "storage.type.lipi",
          "match": "\\b(int|float|string|bool|list|map|void|ptr|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|সংখ্যা|দশমিক|লেখা|বুলিয়ান|তালিকা|মানচিত্র|শূন্যতা|পয়েন্টার)\\b"
        }
      ]
    },
    "constants_boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.lipi",
          "match": "\\b(true|false|null|nil|সত্য|মিথ্যা|শূন্য|LIPI_VERSION|LIPI_সংস্করণ|LIPI_CODENAME|LIPI_সংকেতনাম|EXIT_OK|EXIT_ERR|HTTP_200_OK|HTTP_404_NOT_FOUND|HTTP_500_SERVER_ERROR)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.lipi",
          "match": "=>|->|\\.\\."
        },
        {
          "name": "keyword.operator.comparison.lipi",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.lipi",
          "match": "=|\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.logical.lipi",
          "match": "\\b(and|or|not|এবং|অথবা|না)\\b|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.lipi",
          "match": "[\\+\\-\\*/%\\^]"
        }
      ]
    },
    "keywords_subsystems": {
      "patterns": [
        {
          "name": "support.function.builtin.lipi",
          "match": "(@!|println|\\b(say|print|echo|input|len|size|clock|rdtsc|syscall|malloc|free|mem_byte_read|mem_byte_write|mem_word_read|mem_write_word|mem_copy|mem_fill|file_open|file_read|file_write|file_close|file_exists|argv|ord|chr|char_at|floor|exit|বলো|দেখাও|ইনপুট|দৈর্ঘ্য|সাইজ|ক্লক|সিসকল|মেমরি_বরাদ্দ|মেমরি_মুক্তি|মেমরি_বাইট_পড়ো|মেমরি_বাইট_লেখো|মেমরি_শব্দ_পড়ো|মেমরি_শব্দ_লেখো|মেমরি_কপি|মেমরি_ভরাট|ফাইল_খোলো|ফাইল_পড়ো|ফাইল_লেখো|ফাইল_বন্ধ|প্রস্থান)\\b)"
        },
        {
          "name": "support.class.stdlib.lipi",
          "match": "\\b(web_router_create|web_server_start|thread_create|thread_join|hashmap_new|hashmap_set|hashmap_get|arena_create|arena_alloc|arena_reset|simd_add_f32|db_open|db_put|db_get)\\b"
        }
      ]
    }
  }
}
