{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lipi",
  "scopeName": "source.lipi",
  "fileTypes": ["lp", "lipi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#keywords_bengali" },
    { "include": "#keywords_english" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lipi",
          "match": "//.*$"
        },
        {
          "name": "comment.line.directive.lipi",
          "match": "@!.*$"
        },
        {
          "name": "comment.block.lipi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.lipi",
          "match": "@(fn|let|if|elif|else|while|for|struct|impl|end|inline|gpu|universe|infinity_rule)\\b"
        }
      ]
    },
    "keywords_bengali": {
      "patterns": [
        {
          "name": "keyword.declaration.bengali.lipi",
          "match": "(কাজ|চলক|গঠন|ধ্রুবক)\\b"
        },
        {
          "name": "keyword.control.bengali.lipi",
          "match": "(যদি|নাহলে|অথবা|যতক্ষণ|ফেরত|থামো|চালিয়ে_যাও)\\b"
        },
        {
          "name": "support.function.bengali.lipi",
          "match": "(বলো|প্রিন্ট)\\b"
        }
      ]
    },
    "keywords_english": {
      "patterns": [
        {
          "name": "keyword.declaration.english.lipi",
          "match": "\\b(fn|let|struct|enum|impl|const)\\b"
        },
        {
          "name": "keyword.control.english.lipi",
          "match": "\\b(if|else|elif|while|for|return|break|continue|match|import|pub|in)\\b"
        },
        {
          "name": "support.function.builtin.lipi",
          "match": "\\b(say|print|println|len|assert|assert_eq)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lipi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.lipi",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lipi",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.lipi",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.lipi",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lipi",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.lipi",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|str|string|bool|void|ptr|array|LipiType)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lipi",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=|&&|\\|\\||!|\\?)"
        }
      ]
    }
  }
}
