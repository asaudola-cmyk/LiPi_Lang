{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Maya",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#macros"
    },
    {
      "include": "#annotations"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.maya",
          "match": "\\b(if|else|while|for|return|match|import|pub)\\b"
        },
        {
          "name": "keyword.declaration.maya",
          "match": "\\b(fn|let|struct|enum|impl)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.maya",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.maya",
          "match": "//.*$"
        },
        {
          "name": "comment.block.maya",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.maya",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.maya",
          "match": "\\\\([nrt\\\\\"']|x[0-9a-fA-F]{2})"
        },
        {
          "name": "meta.interpolation.maya",
          "match": "#\\{[^}]+\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.maya",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.maya",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.maya",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.maya",
      "match": "\\b(Int|Float|Bool|String|Bytes|List|Map|Option|Result|Any|u8|u16|u32|u64|i8|i16|i32|i64)\\b"
    },
    "macros": {
      "name": "entity.name.function.macro.maya",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!\\b"
    },
    "annotations": {
      "name": "entity.name.function.decorator.maya",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    }
  },
  "scopeName": "source.maya"
}
