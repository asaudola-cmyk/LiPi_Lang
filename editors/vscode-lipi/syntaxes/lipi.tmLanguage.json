{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lipi",
  "scopeName": "source.lipi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numerals" },
    { "include": "#keywords_control" },
    { "include": "#keywords_declaration" },
    { "include": "#keywords_subsystems" },
    { "include": "#constants_boolean" },
    { "include": "#functions" },
    { "include": "#structs" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lipi",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lipi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lipi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.lipi",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numerals": {
      "patterns": [
        {
          "name": "constant.numeric.bengali.lipi",
          "match": "\\b[০-৯]+(\\.[০-৯]+)?\\b"
        },
        {
          "name": "constant.numeric.ascii.lipi",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.lipi",
          "match": "\\b(যদি|নাহলে_যদি|নাহলে|তবে|যতক্ষণ|প্রতিটি|ভেতরে|থামো|চালিয়ে_যাও|ফেরত|চেষ্টা|ধরো|নিক্ষেপ|সহযোগ|সমান্তরাল|অপেক্ষা|if|else|elif|elseif|then|while|for|in|break|continue|return|try|catch|throw|spawn|async|await)\\b"
        }
      ]
    },
    "keywords_declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.lipi",
          "match": "\\b(ধরি|ধ্রুবক|কাজ|গঠন|নতুন|আমদানি|অন্তর্ভুক্ত|হিসেবে|let|var|const|fn|def|func|function|struct|class|new|import|include|as)\\b"
        }
      ]
    },
    "keywords_subsystems": {
      "patterns": [
        {
          "name": "support.class.subsystem.lipi",
          "match": "\\b(লিপি|সার্ভার|পর্দা|স্মৃতি|গণনা|চ্যানেল|সিসকল|বাফার|মেমরি_লেখো|মেমরি_পড়ো|মেমরি_শব্দ_লেখো|মেমরি_শব্দ_পড়ো|মেমরি_বাইট_লেখো|মেমরি_বাইট_পড়ো|মেমরি_বরাদ্দ|মেমরি_মুক্তি|মেমরি_অনুলিপি|মেমরি_পূরণ|কলাম_তৈরি|কলাম_লেখো|কলাম_পড়ো|কলাম_শর্তযুক্ত_যোগফল|কলাম_মুছে_ফেলো|হ্যাশম্যাপ_তৈরি|হ্যাশম্যাপ_ইনসার্ট|হ্যাশম্যাপ_লুকআপ|হ্যাশম্যাপ_মুছে_ফেলো|শেয়ার্ড_মেমরি_খোলো|শেয়ার্ড_মেমরি_মুছে_ফেলো|এআই_কোসাইন_সিমিলারিটি|এআই_সফটম্যাক্স|ওয়েবসকেট_ফ্রেম_তৈরি|ওয়েবসকেট_আনমাস্ক|টার্মিনাল_বাফার_তৈরি|কার্সর_লুকাও|কার্সর_দেখাও|জিজিইউএফ_হেডার_যাচাই|জিজিইউএফ_কিউ৪_আনপ্যাক|জিজিইউএফ_ম্যাট্রিক্স_ভেক্টর_গুণন|জিজিইউএফ_টোকেন_আর্গম্যাক্স|মাল্টিবুট_হেডার_তৈরি|ভিজিএ_সেল_তৈরি|দাবি|বর্তমান_স্ট্যাক|মেমরি_পরিদর্শন|lipi|server|ui|memory|compute|channel|syscall|buffer|mem_write|mem_read)\\b"
        },
        {
          "name": "keyword.other.show.lipi",
          "match": "\\b(দেখাও|ইনপুট|বাংলা_সংখ্যা|লেখা|স্ট্রিং|দৈর্ঘ্য|সিপিউ_ক্লক|show|print|echo|input|len|clock|rdtsc)\\b"
        }
      ]
    },
    "constants_boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.lipi",
          "match": "\\b(সত্য|মিথ্যা|শূন্য|true|false|null|nil)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(কাজ|fn|def|func|function)\\s+([\\p{L}_][\\p{L}0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.lipi" },
            "2": { "name": "entity.name.function.lipi" }
          }
        },
        {
          "match": "([\\p{L}_][\\p{L}0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.lipi"
        }
      ]
    },
    "structs": {
      "patterns": [
        {
          "match": "\\b(গঠন|struct|class)\\s+([\\p{L}_][\\p{L}0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.lipi" },
            "2": { "name": "entity.name.type.class.lipi" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lipi",
          "match": "\\b(এবং|অথবা|না|and|or|not)\\b|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.lipi",
          "match": "[\\+\\-\\*/%\\^]"
        },
        {
          "name": "keyword.operator.comparison.lipi",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.lipi",
          "match": "=|\\+=|-=|\\*=|/="
        }
      ]
    }
  }
}
