// 📜 লিপি রবিন-হুড হ্যাশম্যাপ টেস্ট
// 👑 UNUM এর O(1) ক্যাশিং ইঞ্জিন এখন সম্পূর্ণ লিপির নেটিভ মেশিন কোডে!

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/hashmap.lp"

কাজ প্রধান() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI NATIVE ROBIN-HOOD HASHMAP ENGINE (O(1) Memory Cache)\033[0m       \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""

    ধরি ক্যাপাসিটি = ১০০
    দেখাও "১. হ্যাশম্যাপ তৈরি করা হচ্ছে (ক্যাপাসিটি: " + ক্যাপাসিটি + ")..."
    ধরি ম্যাপ = হ্যাশম্যাপ_তৈরি(ক্যাপাসিটি)
    
    // ইনসার্ট ডেটা
    দেখাও "২. ডেটা ইনসার্ট করা হচ্ছে..."
    হ্যাশম্যাপ_ইনসার্ট(ম্যাপ, ক্যাপাসিটি, ১০১, ৫০০১) // Key: 101, Val: 5001
    হ্যাশম্যাপ_ইনসার্ট(ম্যাপ, ক্যাপাসিটি, ২০৫, ৮০০২) // Key: 205, Val: 8002
    হ্যাশম্যাপ_ইনসার্ট(ম্যাপ, ক্যাপাসিটি, ৩০৩, ৯০০৩) // Key: 303, Val: 9003
    দেখাও "✅ ৩টি ডেটা সফলভাবে ইনসার্ট হয়েছে।"
    
    // লুকআপ ডেটা
    দেখাও "৩. ডেটা লুকআপ করা হচ্ছে (O(1) স্পিড)..."
    ধরি মান১ = হ্যাশম্যাপ_লুকআপ(ম্যাপ, ক্যাপাসিটি, ১০১)
    ধরি মান২ = হ্যাশম্যাপ_লুকআপ(ম্যাপ, ক্যাপাসিটি, ২০৫)
    ধরি মান৩ = হ্যাশম্যাপ_লুকআপ(ম্যাপ, ক্যাপাসিটি, ৪০৪) // Exist করে না
    
    দেখাও "  • Key 101 -> Value: " + মান১ + " (Expected: 5001)"
    দেখাও "  • Key 205 -> Value: " + মান২ + " (Expected: 8002)"
    দেখাও "  • Key 404 -> Value: " + মান৩ + " (Expected: -1)"
    
    // রিলিজ
    হ্যাশম্যাপ_মুছে_ফেলো(ম্যাপ, ক্যাপাসিটি)
    
    দেখাও "\n🎉 টেস্ট সফল! লিপি এখন রবিন-হুড হ্যাশম্যাপ সাপোর্ট করে!"
    ফেরত ০
}

প্রধান()
