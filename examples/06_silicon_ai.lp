    [0.83, 0.85, 0.87, 0.91]  // উন্নত
]

// ৩. লিনিয়ার প্রোজেকশন ম্যাট্রিক্স (Weights: 4 x 4)
// W_Q (Query), W_K (Key), W_V (Value)
ধরি ডব্লিউ_কিউ = [
    [0.45, -0.12, 0.33, 0.21],
    [-0.18, 0.52, 0.15, -0.09],
    [0.28, 0.11, 0.49, 0.35],
    [0.14, -0.22, 0.31, 0.60]
]

ধরি ডব্লিউ_কে = [
    [0.42, -0.08, 0.30, 0.25],
    [-0.15, 0.48, 0.12, -0.05],
    [0.25, 0.09, 0.45, 0.32],
    [0.19, -0.18, 0.28, 0.58]
]

ধরি ডব্লিউ_ভি = [
    [0.55, 0.20, 0.10, 0.30],
    [0.12, 0.62, 0.22, 0.18],
    [0.31, 0.15, 0.58, 0.24],
    [0.22, 0.28, 0.19, 0.65]
]

// ৪. গাণিতিক সহায়ক কার্যাবলী (Mathematical Tensor Library in Pure Lipi)

// ৪.১ দুটি ভেক্টরের ডট গুণফল (Dot Product)
কাজ ডট_গুণ(ভি১, ভি২) {
    ধরি মোট = ০.০
    ধরি সাইজ = দৈর্ঘ্য(ভি১)
    প্রতিটি i ভেতরে পরিসীমা(সাইজ) {
        মোট = মোট + (ভি১[i] * ভি২[i])
    }
    ফেরত মোট
}

// ৪.২ ভেক্টর ও ম্যাট্রিক্সের গুণফল (Vector x Matrix Projection)
কাজ ভেক্টর_ম্যাট্রিক্স_গুণ(ভেক্টর, ম্যাট্রিক্স) {
    ধরি সারি = দৈর্ঘ্য(ম্যাট্রিক্স)
    ধরি কলাম = দৈর্ঘ্য(ম্যাট্রিক্স[০])
    ধরি আউটপুট = []
    প্রতিটি c ভেতরে পরিসীমা(কলাম) {
        ধরি সমষ্টি = ০.০
        প্রতিটি r ভেতরে পরিসীমা(সারি) {
            সমষ্টি = সমষ্টি + (ভেক্টর[r] * ম্যাট্রিক্স[r][c])
        }
        আউটপুট = আউটপুট + [সমষ্টি]
    }
    ফেরত আউটপুট
}

// ৪.৩ নিউমেরিক্যালি স্ট্যাবল সফটম্যাক্স (Softmax Activation)
কাজ সফটম্যাক্স(লগিটস) {
    ধরি সাইজ = দৈর্ঘ্য(লগিটস)
    ধরি সর্বোচ্চ = লগিটস[০]
    প্রতিটি i ভেতরে পরিসীমা(সাইজ) {
        যদি লগিটস[i] > সর্বোচ্চ {
            সর্বোচ্চ = লগিটস[i]
        }
    }
    
    ধরি এক্সপো = []
    ধরি মোট_সমষ্টি = ০.০
    ধরি e = লিপি.গণিত.ই
    প্রতিটি i ভেতরে পরিসীমা(সাইজ) {
        ধরি মান = e ^ (লগিটস[i] - সর্বোচ্চ)
        এক্সপো = এক্সপো + [মান]
        মোট_সমষ্টি = মোট_সমষ্টি + মান
    }
    
    ধরি সম্ভাবনা = []
    প্রতিটি i ভেতরে পরিসীমা(সাইজ) {
        সম্ভাবনা = সম্ভাবনা + [এক্সপো[i] / মোট_সমষ্টি]
    }
    ফেরত সম্ভাবনা
}

// ৪.৪ আর্গম্যাক্স (Argmax: সর্বোচ্চ সম্ভাব্য টোকেন আইডি নির্বাচন)
কাজ আর্গম্যাক্স(সম্ভাবনা_তালিকা) {
    ধরি সর্বোচ্চ_ইনডেক্স = ০
    ধরি সর্বোচ্চ_মান = সম্ভাবনা_তালিকা[০]
    ধরি সাইজ = দৈর্ঘ্য(সম্ভাবনা_তালিকা)
    প্রতিটি i ভেতরে পরিসীমা(সাইজ) {
        যদি সম্ভাবনা_তালিকা[i] > সর্বোচ্চ_মান {
            সর্বোচ্চ_মান = সম্ভাবনা_তালিকা[i]
            সর্বোচ্চ_ইনডেক্স = i
        }
    }
    ফেরত সর্বোচ্চ_ইনডেক্স
}

// ৫. সেলফ-অ্যাটেনশন ট্রান্সফরমার লেয়ার (Scaled Dot-Product Self Attention)
কাজ সেলফ_অ্যাটেনশন_গণনা(সিকোয়েন্স) {
    ধরি দৈর্ঘ্য_টি = দৈর্ঘ্য(সিকোয়েন্স)
    ধরি কিউ_তালিকা = []
    ধরি কে_তালিকা = []
    ধরি ভি_তালিকা = []

    // ১. কিউ, কে, ভি প্রোজেকশন তৈরি
    প্রতিটি i ভেতরে পরিসীমা(দৈর্ঘ্য_টি) {
        ধরি টোকেন_আইডি = সিকোয়েন্স[i]
        ধরি এমবেডিং = এমবেডিং_ওজন[টোকেন_আইডি]
        কিউ_তালিকা = কিউ_তালিকা + [ভেক্টর_ম্যাট্রিক্স_গুণ(এমবেডিং, ডব্লিউ_কিউ)]
        কে_তালিকা = কে_তালিকা + [ভেক্টর_ম্যাট্রিক্স_গুণ(এমবেডিং, ডব্লিউ_কে)]
        ভি_তালিকা = ভি_তালিকা + [ভেক্টর_ম্যাট্রিক্স_গুণ(এমবেডিং, ডব্লিউ_ভি)]
    }

    // ২. অ্যাটেনশন স্কোর ম্যাট্রিক্স (Attention Matrix: T x T)
    ধরি স্কেল = লিপি.গণিত.বর্গমূল(৪.০) // sqrt(d_k) = sqrt(4) = 2.0
    ধরি অ্যাটেনশন_ওজন = []

    প্রতিটি i ভেতরে পরিসীমা(দৈর্ঘ্য_টি) {
        ধরি কাঁচা_স্কোর = []
        প্রতিটি j ভেতরে পরিসীমা(দৈর্ঘ্য_টি) {
            ধরি ডট = ডট_গুণ(কিউ_তালিকা[i], কে_তালিকা[j])
            কাঁচা_স্কোর = কাঁচা_স্কোর + [ডট / স্কেল]
        }
        ধরি নরম_ওজন = সফটম্যাক্স(কাঁচা_স্কোর)
        অ্যাটেনশন_ওজন = অ্যাটেনশন_ওজন + [নরম_ওজন]
    }

    // ৩. কনটেক্সট ভেক্টর গণনা (Context Vector Z = AttentionWeight x V)
    ধরি কনটেক্সট_লিস্ট = []
    প্রতিটি i ভেতরে পরিসীমা(দৈর্ঘ্য_টি) {
        ধরি হেড_ভেক্টর = [০.০, ০.০, ০.০, ০.০]
        ধরি ওয়েট = অ্যাটেনশন_ওজন[i]
        প্রতিটি j ভেতরে পরিসীমা(দৈর্ঘ্য_টি) {
            ধরি w = ওয়েট[j]
            ধরি v = ভি_তালিকা[j]
            প্রতিটি d ভেতরে পরিসীমা(৪) {
                হেড_ভেক্টর[d] = হেড_ভেক্টর[d] + (w * v[d])
            }
        }
        কনটেক্সট_লিস্ট = কনটেক্সট_লিস্ট + [হেড_ভেক্টর]
    }

    ফেরত {
        "কনটেক্সট": কনটেক্সট_লিস্ট,
        "ওজন": অ্যাটেনশন_ওজন
    }
}

// ৬. নেক্সট টোকেন প্রেডিকশন হেড (Next Token Predictor via Vocab Projection)
কাজ পরবর্তী_টোকেন_অনুমান(কনটেক্সট_ভেক্টর) {
    ধরি লগিটস = []
    প্রতিটি v ভেতরে পরিসীমা(ভোকাব_আকার) {
        // ডট গুণফল কনটেক্সট ও প্রতিটি ভোকাব শব্দের এমবেডিং এর সাথে
        ধরি স্কোর = ডট_গুণ(কনটেক্সট_ভেক্টর, এমবেডিং_ওজন[v])
        লগিটস = লগিটস + [স্কোর]
    }
    ধরি সম্ভাবনা = সফটম্যাক্স(লগিটস)
    ধরি নির্বাচিত_আইডি = আর্গম্যাক্স(সম্ভাবনা)
    ফেরত {
        "টোকেন_আইডি": নির্বাচিত_আইডি,
        "সম্ভাবনা": সম্ভাবনা[নির্বাচিত_আইডি]
    }
}

// ৭. মডেলের এক্সিকিউশন ও রেজাল্ট প্রদর্শন
দেখাও "\033[1;33m[২] নিউরাল ইনফারেন্স ও অ্যাটেনশন হিটম্যাপ শুরু:\033[0m"

ধরি প্রম্পট_সিকোয়েন্স = [১, ২] // ["লিপি", "সোভারেন"]
দেখাও "  • প্রাথমিক প্রম্পট (Prompt) : \033[1;32m\"" + শব্দভাণ্ডার[১] + " " + শব্দভাণ্ডার[২] + "\"\033[0m"

ধরি শুরু_সময় = লিপি.সময়.এখন()
ধরি রেজাল্ট = সেলফ_অ্যাটেনশন_গণনা(প্রম্পট_সিকোয়েন্স)
ধরি শেষ_সময় = লিপি.সময়.এখন()
ধরি ইনফারেন্স_সময় = (শেষ_সময় - শুরু_সময়) * ১০০০ // মিলিসেকেন্ড

দেখাও "  • সেলফ-অ্যাটেনশন ল্যাটেন্সি : \033[1;36m" + লিপি.গণিত.নিকটবর্তী(ইনফারেন্স_সময়, ২) + " ms\033[0m"
দেখাও ""
দেখাও "\033[1;34m--- মনোযোগ স্কোর হিটম্যাপ (Self-Attention Heatmap) ---\033[0m"
ধরি ওজন_ম্যাট্রিক্স = রেজাল্ট["ওজন"]
প্রতিটি r ভেতরে পরিসীমা(দৈর্ঘ্য(প্রম্পট_সিকোয়েন্স)) {
    ধরি টোকেন_নাম = শব্দভাণ্ডার[প্রম্পট_সিকোয়েন্স[r]]
    ধরি লাইন = "  [" + টোকেন_নাম + "] -> "
    প্রতিটি c ভেতরে পরিসীমা(দৈর্ঘ্য(প্রম্পট_সিকোয়েন্স)) {
        ধরি স্কোর = ওজন_ম্যাট্রিক্স[r][c]
        ধরি শতাংশ = লিপি.গণিত.নিকটবর্তী(স্কোর * ১০০, ১)
        লাইন = লাইন + "  \033[38;2;0;255;150m" + শতাংশ + "%\033[0m"
    }
    দেখাও লাইন
}
দেখাও ""

// ৮. অটোরেগ্রেসিভ টেক্সট জেনারেশন লুপ (Autoregressive Generation)
দেখাও "\033[1;33m[৩] অটোরেগ্রেসিভ ভাষা উৎপাদন (Autoregressive Generation Stream):\033[0m"
দেখাও "  \033[38;2;255;255;100mজেনারেটেড ফলাফল:\033[0m"

ধরি সিকোয়েন্স = [১, ২] // ["লিপি", "সোভারেন"]
ধরি জেনারেট_দৈর্ঘ্য = ৫

প্রতিটি ধাপ ভেতরে পরিসীমা(জেনারেট_দৈর্ঘ্য) {
    ধরি অ্যাটেনশন = সেলফ_অ্যাটেনশন_গণনা(সিকোয়েন্স)
    ধরি কনটেক্সট_লিস্ট = অ্যাটেনশন["কনটেক্সট"]
    // শেষ টোকেনের কনটেক্সট ভেক্টর নেই
    ধরি শেষ_ইনডেক্স = দৈর্ঘ্য(কনটেক্সট_লিস্ট) - ১
    ধরি শেষ_কনটেক্সট = কনটেক্সট_লিস্ট[শেষ_ইনডেক্স]
    
    ধরি প্রেডিকশন = পরবর্তী_টোকেন_অনুমান(শেষ_কনটেক্সট)
    ধরি নতুন_টোকেন_আইডি = প্রেডিকশন["টোকেন_আইডি"]
    
    // পুনরাবৃত্তি রোধে শিফট যদি একই হয়
    যদি নতুন_টোকেন_আইডি == সিকোয়েন্স[শেষ_ইনডেক্স] {
        নতুন_টোকেন_আইডি = (নতুন_টোকেন_আইডি + ৩) % ভোকাব_আকার
    }

    সিকোয়েন্স = সিকোয়েন্স + [নতুন_টোকেন_আইডি]
    ধরি শব্দ = শব্দভাণ্ডার[নতুন_টোকেন_আইডি]
    ধরি কনফিডেন্স = লিপি.গণিত.নিকটবর্তী(প্রেডিকশন["সম্ভাবনা"] * ১০০, ১)
    
    দেখাও "    ধাপ " + বাংলা_সংখ্যা(ধাপ + ১) + ": \033[1;32m" + শব্দ + "\033[0m (আস্থা: " + বাংলা_সংখ্যা(কনফিডেন্স) + "%)"
}

// সম্পূর্ণ বাক্য তৈরি
ধরি সম্পূর্ণ_বাক্য = ""
প্রতিটি i ভেতরে পরিসীমা(দৈর্ঘ্য(সিকোয়েন্স)) {
    সম্পূর্ণ_বাক্য = সম্পূর্ণ_বাক্য + শব্দভাণ্ডার[সিকোয়েন্স[i]] + " "
}

দেখাও ""
দেখাও "\033[38;2;0;255;204m✔ নিউরাল জেনারেশন সমাপ্ত!\033[0m"
দেখাও "  \033[1;37mপূর্ণ বাক্য : \033[1;38;2;0;255;204m\"" + সম্পূর্ণ_বাক্য + "\"\033[0m"
দেখাও "  মোট উৎপাদিত টোকেন সংখ্যা : " + বাংলা_সংখ্যা(দৈর্ঘ্য(সিকোয়েন্স)) + " টি"
দেখাও ""
