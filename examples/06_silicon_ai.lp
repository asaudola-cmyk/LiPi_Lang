    "কৃত্রিম",      // ৩
    "বুদ্ধিমত্তা",    // ৪
    "সিলিকন",     // ৫
    "গতি",        // ৬
    "ভবিষ্যৎ",     // ৭
    "ভাষা",       // ৮
