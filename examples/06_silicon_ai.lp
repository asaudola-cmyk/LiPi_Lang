    [0.75, 0.65, 0.90, 0.84], // কৃত্রিম
    [0.79, 0.88, 0.93, 0.91], // বুদ্ধিমত্তা
    [0.95, 0.70, 0.85, 0.96], // সিলিকন
    [0.84, 0.72, 0.68, 0.80], // গতি
    [0.81, 0.86, 0.89, 0.93], // ভবিষ্যৎ
    [0.90, 0.82, 0.75, 0.88], // ভাষা
    [0.87, 0.94, 0.83, 0.92], // স্বনির্ভর
    [0.78, 0.89, 0.84, 0.90], // বিপ্লব
    [0.85, 0.68, 0.72, 0.86], // কোড
