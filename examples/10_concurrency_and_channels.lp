// =============================================================================
// ১. চ্যানেল তৈরি ও ফাইবারদের মধ্যে যোগাযোগ (Message Passing across Fibers)
// =============================================================================
দেখাও "--- [১] ফাইবার ও চ্যানেল মেসেজ পাসিং (Channel Communication) ---"

ধরি বার্তা_চ্যানেল = নতুন চ্যানেল(ধারণক্ষমতা: ৫)

// ব্যাকগ্রাউন্ড প্রডিউসার ফাইবার
সহযোগ {
    দেখাও "  [প্রডিউসার ফাইবার] ডেটা প্রস্তুত করা হচ্ছে..."
    প্রতিটি সংখ্যা ভেতরে [১০, ২০, ৩০] {
        দেখাও "  [প্রডিউসার ফাইবার] চ্যানেলে পাঠানো হচ্ছে :", সংখ্যা
        বার্তা_চ্যানেল.পাঠাও(সংখ্যা)
    }
    বার্তা_চ্যানেল.পাঠাও("সম্পন্ন")
}

// কনজিউমার ফাইবার
সহযোগ {
    দেখাও "  [কনজিউমার ফাইবার] বার্তা গ্রহণের অপেক্ষায়..."
    ধরি চলমান = সত্য
    যতক্ষণ চলমান {
        ধরি প্রাপ্ত_ডাটা = বার্তা_চ্যানেল.গ্রহণ()
        যদি প্রাপ্ত_ডাটা == "সম্পন্ন" {
            চলমান = মিথ্যা
            দেখাও "  [কনজিউমার ফাইবার] সমাপ্তি সংকেত গৃহীত!"
        } নাহলে {
            দেখাও "  [কনজিউমার ফাইবার] প্রাপ্ত ডাটা :", প্রাপ্ত_ডাটা
        }
    }
}

// =============================================================================
// ২. অ্যাসিনক্রোনাস টাস্ক ও অপেক্ষা (Async Spawn & Await Result)
// =============================================================================
দেখাও ""
দেখাও "--- [২] অ্যাসিনক্রোনাস কাজ ও অপেক্ষা (Async Spawn & Await) ---"

কাজ দীর্ঘমেয়াদী_হিসাব(সংখ্যা) {
    দেখাও "  [টাস্ক ফাইবার] ভারী গাণিতিক হিসাব শুরু হচ্ছে (ইনপুট: " + সংখ্যা + ")..."
    ধরি ফলাফল = সংখ্যা * সংখ্যা + ১০০
    ফেরত ফলাফল
}

// ফাইবার স্পন এবং রেজাল্ট অপেক্ষা
ধরি ব্যাকগ্রাউন্ড_টাস্ক = সহযোগ দীর্ঘমেয়াদী_হিসাব(৫০)
ধরি চূড়ান্ত_হিসাব = অপেক্ষা ব্যাকগ্রাউন্ড_টাস্ক

দেখাও "  [মূল থ্রেড] প্রাপ্ত ফলাফল :", চূড়ান্ত_হিসাব
দেখাও ""
দেখাও "✔ লিপি সার্বভৌমিক কনকারেন্সি ও চ্যানেল সিস্টেম শতভাগ সফল!"
