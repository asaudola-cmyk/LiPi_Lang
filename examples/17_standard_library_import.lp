// 📜 লিপি প্রোগ্রামিং ভাষা — স্ট্যান্ডার্ড লাইব্রেরি ও মাল্টি-ফাইল মডিউল সিস্টেম টেস্ট
// 🏛️ std/math.lp, std/io.lp এবং std/str.lp মডিউল ইমপোর্ট ও এক্সিকিউশন

// ১. মাল্টি-ফাইল স্ট্যান্ডার্ড লাইব্রেরি অন্তর্ভুক্তিকরণ
অন্তর্ভুক্ত "std/str.lp"
অন্তর্ভুক্ত "std/math.lp"
অন্তর্ভুক্ত "std/io.lp"

// ২. ডেকোরেশন ও তথ্য প্রিন্ট
রঙিন_শিরোনাম("লিপি স্ট্যান্ডার্ড লাইব্রেরি (Standard Library) ভেরিফিকেশন")
তথ্য_বার্তা("স্ট্যান্ডার্ড লাইব্রেরির গণিত ও ফাইল আই/ও ইঞ্জিন চালু হচ্ছে...")

// ৩. std/math.lp গণিত ফাংশন পরীক্ষা
ধরি abs_val = পরম_মান(-৮৫)
দেখাও "|-৮৫| এর পরম মান: " + abs_val

ধরি pow_val = পাওয়ার(২, ৮)
দেখাও "২ এর ঘাত ৮ (২^৮): " + pow_val

ধরি g = গসাগু(৪৮, ১৮)
দেখাও "৪৮ এবং ১৮ এর গসাগু: " + g

ধরি l = লসাগু(১২, ১৫)
দেখাও "১২ এবং ১৫ এর লসাগু: " + l

ধরি p17 = মৌলিক_কিনা(১৭)
দেখাও "১৭ মৌলিক সংখ্যা কিনা (১=হ্যাঁ, ০=না): " + p17

ধরি p24 = মৌলিক_কিনা(২৪)
দেখাও "২৪ মৌলিক সংখ্যা কিনা (১=হ্যাঁ, ০=না): " + p24

ধরি boro = সর্বোচ্চ(৯৯, ৪৫)
দেখাও "৯৯ এবং ৪৫ এর মধ্যে সর্বোচ্চ: " + boro

ধরি choto = সর্বনিম্ন(৯৯, ৪৫)
দেখাও "৯৯ এবং ৪৫ এর মধ্যে সর্বনিম্ন: " + choto

// ৪. std/io.lp কার্নেল ফাইল অপারেশন পরীক্ষা
তথ্য_বার্তা("স্ট্যান্ডার্ড আই/ও মডিউল দিয়ে ফাইল তৈরি ও টেস্ট বার্তা লেখা হচ্ছে...")
ধরি fd_write = ফাইল_তৈরি("dist/stdlib_demo.txt")
ধরি txt = "লিপি স্ট্যান্ডার্ড লাইব্রেরি সম্পূর্ণ কার্যকর ও স্বাধীন!\n"
ধরি len_txt = দৈর্ঘ্য(txt)
ধরি written = ফাইল_লেখো(fd_write, txt, len_txt)
ধরি c1 = ফাইল_বন্ধ(fd_write)

তথ্য_বার্তা("ফাইল থেকে বাফারে রি-রিড করা হচ্ছে...")
ধরি fd_read = ফাইল_খোলো("dist/stdlib_demo.txt")
ধরি read_bytes = ফাইল_পড়ো(fd_read, বাফার(), ১০২৪)
ধরি c2 = ফাইল_বন্ধ(fd_read)

// বাফারের ডেটা কনসোলে সরাসরি কার্নেল আউটপুট
ধরি out = কনসোল_লেখো(বাফার(), read_bytes)

সফলতা_বার্তা("লিপি স্ট্যান্ডার্ড লাইব্রেরি (std/math, std/io, std/str) সফলভাবে ভেরিফাইড!")
