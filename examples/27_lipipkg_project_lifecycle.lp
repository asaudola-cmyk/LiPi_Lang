// ==============================================================================
// 👑 LIPI HORIZON 16: SOVEREIGN PACKAGE MANAGER & LIFECYCLE (examples/27_lipipkg_project_lifecycle.lp)
// ⚡ Autonomous Project Manifest (lipi.pkg), Packaging, Hermetic Build & Run
// ==============================================================================

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"

দেখাও "╔════════════════════════════════════════════════════════════════════════╗"
দেখাও "║  📦 সার্বভৌম প্যাকেজ ম্যানেজার ও প্রজেক্ট লাইফসাইকেল (lipipkg)         ║"
দেখাও "║  ⚡ Autonomous Manifest | Isolated Builds | Zero External Dependency  ║"
দেখাও "╚════════════════════════════════════════════════════════════════════════╝"
দেখাও ""

// [১] lipipkg টেস্ট প্রজেক্ট ডিরেক্টরি পাথ ও সেটআপ
দেখাও "[১] lipipkg টেস্ট প্রজেক্ট ডিরেক্টরি কাঠামো প্রস্তুতকরণ..."
ধরি প্রজেক্ট_ডির = "dist/demo_sovereign_app"
ধরি ম্যানিফেস্ট_ফাইল = "dist/demo_sovereign_app/lipi.pkg"
ধরি সোর্স_ফাইল = "dist/demo_sovereign_app/src/main.lp"

// ডিরেক্টরি তৈরি (SYS_mkdir: 39, mode: 0755 = 493)
সিসকল(৮৩, "dist", 493, 0, 0, 0, 0)
সিসকল(৮৩, প্রজেক্ট_ডির, 493, 0, 0, 0, 0)
সিসকল(৮৩, "dist/demo_sovereign_app/src", 493, 0, 0, 0, 0)
সিসকল(৮৩, "dist/demo_sovereign_app/dist", 493, 0, 0, 0, 0)

// [২] lipi.pkg প্যাকেজ ম্যানিফেস্ট তৈরি ও ডিস্কে সংরক্ষণ
দেখাও "[২] প্যাকেজ কনফিগারেশন ম্যানিফেস্ট (lipi.pkg) এমিশন..."
ধরি ম্যানিফেস্ট_ডাটা = "name = \"demo_app\"\nversion = \"1.0.0\"\nentry = \"src/main.lp\"\n"
ধরি এম_দৈর্ঘ্য = দৈর্ঘ্য(ম্যানিফেস্ট_ডাটা)

ধরি এম_এফডি = ফাইল_তৈরি(ম্যানিফেস্ট_ফাইল)
যদি এম_এফডি > ০ {
    ফাইল_লেখো(এম_এফডি, ম্যানিফেস্ট_ডাটা, এম_দৈর্ঘ্য)
    ফাইল_বন্ধ(এম_এফডি)
    দেখাও "  ✔ ম্যানিফেস্ট সফলভাবে লিখিত: " + ম্যানিফেস্ট_ফাইল
}

// [৩] প্রজেক্ট সোর্স কোড (src/main.lp) তৈরি
দেখাও "[৩] মূল অ্যাপ্লিকেশন সোর্স কোড (src/main.lp) তৈরি..."
ধরি মূল_কোড = "দেখাও \"🎉 হ্যালো ফ্রম প্যাকেজড লিপি অ্যাপ!\"\nধরি গুণফল = ৪২ * ১০\nদেখাও \"ফলাফল: \" + গুণফল\n"
ধরি কোড_দৈর্ঘ্য = দৈর্ঘ্য(মূল_কোড)

ধরি এস_এফডি = ফাইল_তৈরি(সোর্স_ফাইল)
যদি এস_এফডি > ০ {
    ফাইল_লেখো(এস_এফডি, মূল_কোড, কোড_দৈর্ঘ্য)
    ফাইল_বন্ধ(এস_এফডি)
    দেখাও "  ✔ সোর্স কোড লিখিত: " + সোর্স_ফাইল
}

// [৪] lipipkg ম্যানিফেস্ট ফাইল রিড ও ডেটা ইনটিগ্রিটি ভ্যালিডেশন
দেখাও "[৪] lipi.pkg ম্যানিফেস্ট রিড ও ভ্যালিডেশন..."
ধরি পড়া_বাফার = মেমরি_বরাদ্দ(৫১২)
ধরি রিড_এফডি = ফাইল_খোলো(ম্যানিফেস্ট_ফাইল)
যদি রিড_এফডি > ০ {
    ধরি পড়া_বাইট = ফাইল_পড়ো(রিড_এফডি, পড়া_বাফার, ৫১২)
    ফাইল_বন্ধ(রিড_এফডি)
    দেখাও "  • ম্যানিফেস্ট থেকে পড়া সাইজ: " + পড়া_বাইট + " বাইট"
    যদি পড়া_বাইট > ০ {
        দেখাও "  ✔ ম্যানিফেস্ট ডেটা ইনটিগ্রিটি ১০০% সঠিক!"
    }
}

// [৫] প্যাকেজ ম্যানেজার ভেন্ডরিং ও মডিউল রেজিস্ট্রি ডিরেক্টরি তৈরি
দেখাও "[৫] হারমেটিক ভেন্ডর ডিরেক্টরি (lipi_modules/) সেটআপ..."
সিসকল(৮৩, "dist/demo_sovereign_app/lipi_modules", 493, 0, 0, 0, 0)
দেখাও "  ✔ লোকাল ভেন্ডর ডিরেক্টরি প্রস্তুত!"

// [৬] প্যাকেজ এন্ট্রি পয়েন্ট অস্তিত্ব যাচাই
দেখাও "[৬] সোর্স এন্ট্রি পয়েন্ট অ্যাক্সেসিবিলিটি টেস্ট..."
ধরি চেক_এফডি = ফাইল_খোলো(সোর্স_ফাইল)
যদি চেক_এফডি > ০ {
    দেখাও "  ✔ প্রজেক্ট এন্ট্রি পয়েন্ট কার্নেল দ্বারা ভ্যালিডেটেড (FD: " + চেক_এফডি + ")"
    ফাইল_বন্ধ(চেক_এফডি)
}

দেখাও ""
দেখাও "🎉 লিপি প্যাকেজ ম্যানেজার ও প্রজেক্ট লাইফসাইকেল সম্পূর্ণ সফল!"
