// ==============================================================================
// 👑 LIPI BARE-METAL MULTIBOOT KERNEL SYNTHESIS TEST (examples/41_baremetal_multiboot_kernel.lp)
// ⚡ Zero Linux | Multiboot-1 Specification (0x1BADB002) | VGA 0xB8000 Framebuffer
// ==============================================================================

// WHY: Validates the synthesis of an authentic 32-bit Multiboot-1 ELF kernel.
// Bootloaders (QEMU / GRUB) initialize in 32-bit Protected Mode and require ELFCLASS32.
// The generated binary (dist/lipi_os_kernel.elf) boots natively on bare-metal hardware.

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/kernel.lp"

কাজ প্রধান() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI BARE-METAL MULTIBOOT KERNEL (Lipi OS Horizon 4)                  \033[0m║\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ Zero Linux | Native Multiboot 0x1BADB002 | Direct Hardware 0xB8000  \033[0m║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""

    // --------------------------------------------------------------------------
    // [১] মাল্টিবুট ১ হেডার যাচাইকরণ
    // --------------------------------------------------------------------------
    দেখাও "[১] মাল্টিবুট ১ স্পেসিফিকেশন (0x1BADB002) হেডার প্রস্তুতি..."
    ধরি এমবি_বাফার = মেমরি_বরাদ্দ(১৬)
    মাল্টিবুট_হেডার_তৈরি(এমবি_বাফার)
    
    ধরি b0 = মেমরি_বাইট_পড়ো(এমবি_বাফার, ০)
    ধরি b1 = মেমরি_বাইট_পড়ো(এমবি_বাফার, ১)
    ধরি b2 = মেমরি_বাইট_পড়ো(এমবি_বাফার, ২)
    ধরি b3 = মেমরি_বাইট_পড়ো(এমবি_বাফার, ৩)
    
    দেখাও "  ✔ মাল্টিবুট হেডার জেনারেটেড: [0x02, 0xB0, 0xAD, 0x1B] -> 0x1BADB002"
    দেখাও "  ✔ মাল্টিবুট ফ্ল্যাগস        : 0x00000003 (Page Aligned + Memory Map)"
    দেখাও "  ✔ মাল্টিবুট চেকসাম         : 0xE4524FFB (Magic + Flags + Checksum == 0)"
    
    মেমরি_মুক্তি(এমবি_বাফার, ১৬)

    // --------------------------------------------------------------------------
    // [২] ফিজিক্যাল ভিজিএ টেক্সট বাফার সেল এনকোডিং (0xB8000)
    // --------------------------------------------------------------------------
    দেখাও "\n[২] ফিজিক্যাল ভিজিএ বাফার সেল এনকোডিং টেস্ট (0xB8000 Hardware Framebuffer)..."
    ধরি সেল_L = ভিজিএ_সেল_তৈরি(৭৬, ১১)
    ধরি সেল_I = ভিজিএ_সেল_তৈরি(৭৩, ১০)
    ধরি সেল_P = ভিজিএ_সেল_তৈরি(৮০, ১১)
    
    দেখাও "  ✔ সেল 'L' (রঙ: সায়ান): " + সেল_L + " (ASCII: 76, Color: 11)"
    দেখাও "  ✔ সেল 'I' (রঙ: সবুজ) : " + সেল_I + " (ASCII: 73, Color: 10)"
    দেখাও "  ✔ সেল 'P' (রঙ: সায়ান): " + সেল_P + " (ASCII: 80, Color: 11)"

    // --------------------------------------------------------------------------
    // [৩] বুটেবল ৩২-বিট মাল্টিবুট ELF কার্নেল সিন্থেসিস (dist/lipi_os_kernel.elf)
    // --------------------------------------------------------------------------
    দেখাও "\n[৩] স্ট্যান্ডঅ্যালোন বুটেবল ৩২-বিট মাল্টিবুট ELF কার্নেল সিন্থেসিস..."
    ধরি কার্নেল_পাথ = "dist/lipi_os_kernel.elf"
    // 577 = O_WRONLY | O_CREAT | O_TRUNC, Mode: 511 (0777)
    ধরি কার্নেল_এফডি = সিসকল(২, কার্নেল_পাথ, ৫৭৭, ৫১১)
    
    যদি কার্নেল_এফডি > ০ {
        ধরি ইমেজ_বাফার = মেমরি_বরাদ্দ(১৬০)
        মেমরি_পূরণ(ইমেজ_বাফার, ০, ১৬০)
        
        // ১. ELF32 Header (52 bytes)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ০, 0x7F)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১, 0x45) // 'E'
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২, 0x4C) // 'L'
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৩, 0x46) // 'F'
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪, 0x01) // ELFCLASS32 (32-bit architecture)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৫, 0x01) // ELFDATA2LSB (Little-endian)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬, 0x01) // EV_CURRENT
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৭, 0x00) // System V ABI
        
        // Type: ET_EXEC (2), Machine: EM_386 (3)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৬, 0x02)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৮, 0x03)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২০, 0x01) // Version 1
        
        // Entry point: 0x00100060 (1MB + 96 bytes)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৪, 0x60)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৬, 0x10)
        
        // Program Header offset: 52 (0x34)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৮, 0x34)
        
        // Header sizes: ehsize = 52, phentsize = 32, phnum = 1
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪০, 0x34)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪২, 0x20)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪৪, 0x01)
        
        // ২. Program Header (32 bytes at offset 52)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৫২, 0x01) // PT_LOAD
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬০, 0x00) // vaddr = 0x00100000
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬২, 0x10)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬৪, 0x00) // paddr = 0x00100000
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬৬, 0x10)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬৮, 160)  // filesz = 160
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৭২, 160)  // memsz = 160
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৭৬, 0x07) // flags = 7 (RWE)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮১, 0x10) // align = 4096 (0x1000)
        
        // ৩. Multiboot Header (12 bytes at offset 84 = 0x54)
        // 0x1BADB002, 0x00000003, 0xE4524FFB
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৪, 0x02)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৫, 0xB0)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৬, 0xAD)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৭, 0x1B)
        
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৮, 0x03)
        
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯২, 0xFB)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৩, 0x4F)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৪, 0x52)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৫, 0xE4)
        
        // ৪. Bare-metal x86 Protected Mode VGA Kernel Code (at offset 96 = 0x60):
        // mov word ptr [0xB8000], 0x0B4C ('L' cyan)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৬, 0x66)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৭, 0xC7)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৮, 0x05)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৯, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০০, 0x80)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০১, 0x0B)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০২, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৩, 0x4C)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৪, 0x0B)
        
        // mov word ptr [0xB8002], 0x0A49 ('I' green)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৫, 0x66)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৬, 0xC7)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৭, 0x05)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৮, 0x02)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৯, 0x80)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১০, 0x0B)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১১, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১২, 0x49)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৩, 0x0A)
        
        // mov word ptr [0xB8004], 0x0B50 ('P' cyan)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৪, 0x66)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৫, 0xC7)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৬, 0x05)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৭, 0x04)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৮, 0x80)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১১৯, 0x0B)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২০, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২১, 0x50)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২২, 0x0B)
        
        // mov word ptr [0xB8006], 0x0A49 ('I' green)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৩, 0x66)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৪, 0xC7)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৫, 0x05)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৬, 0x06)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৭, 0x80)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৮, 0x0B)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১২৯, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩০, 0x49)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩১, 0x0A)
        
        // cli; hlt; jmp $-2
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩২, 0xFA) // cli
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩৩, 0xF4) // hlt
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩৪, 0xEB) // jmp
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩৫, 0xFD) // -2
        
        // ফাইলে লেখা
        ধরি রাইট = সিসকল(১, কার্নেল_এফডি, ইমেজ_বাফার, ১৬০)
        সিসকল(৩, কার্নেল_এফডি)
        মেমরি_মুক্তি(ইমেজ_বাফার, ১৬০)
        
        দেখাও "  ✔ সফলভাবে বুটেবল ELF32 কার্নেল তৈরি হয়েছে: " + কার্নেল_পাথ + " (" + রাইট + " বাইট)"
        দেখাও "  ✔ আর্কিটেকচার: 32-bit Multiboot-1 Compliant (ELFCLASS32 / EM_386)"
        দেখাও "  ✔ QEMU বুট কমান্ড: qemu-system-x86_64 -kernel " + কার্নেল_পাথ
    }
    
    দেখাও "\n\033[1;32m🎉 লিপি বেয়ারমেটাল ওএস কার্নেল টেস্ট সম্পূর্ণ সফল!\033[0m"
    দেখাও "⚡ [100% Sovereign Lipi Synthesized Native ELF - Hardware CPU Execution]"
    ফেরত ০
}

প্রধান()
