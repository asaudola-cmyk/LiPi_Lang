// 📜 লিপি ANSI TUI (Terminal User Interface) টেস্ট
// 👑 UNUM এর Zero-HTML আর্কিটেকচার এখন সম্পূর্ণ লিপির নেটিভ মেশিন কোডে!

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/tui.lp"

কাজ প্রধান() {
    ধরি প্রস্থ = ৪০
    ধরি উচ্চতা = ১০
    
    দেখাও "১. ডাবল-বাফার ক্যানভাস বরাদ্দ করা হচ্ছে (" + প্রস্থ + "x" + উচ্চতা + ")...\n"
    ধরি ক্যানভাস = ক্যানভাস_তৈরি(প্রস্থ, উচ্চতা)
    
    // ক্যানভাসের মাঝখানে "LIPI TUI" লেখা
    // ASCII Codes: L=76, I=73, P=80, T=84, U=85
    
    // "LIPI" at line 4, col 15
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৫, ৪, ৭৬) // L
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৬, ৪, ৭৩) // I
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৭, ৪, ৮০) // P
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৮, ৪, ৭৩) // I

    // "TUI" at line 5, col 16
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৬, ৫, ৮৪) // T
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৭, ৫, ৮৫) // U
    ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, ১৮, ৫, ৭৩) // I

    // বর্ডার আঁকা (সরলীকৃত)
    ধরি এক্স = ০
    যতক্ষণ এক্স < প্রস্থ {
        ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, এক্স, ০, ৪৫) // '-'
        ক্যানভাস_পিক্সেল(ক্যানভাস, প্রস্থ, এক্স, উচ্চতা - ১, ৪৫) // '-'
        এক্স = এক্স + ১
    }

    দেখাও "২. কার্সর লুকানো হচ্ছে..."
    কার্সর_লুকাও()
    
    // ফ্রেম রেন্ডার করা (SYS_write দিয়ে সরাসরি টার্মিনালে)
    // লিপি অটোমেটিক্যালি ক্যারেক্টারগুলো দেখাবে
    দেখাও "\033[38;2;0;255;204m" // সাইয়ান কালার সেট
    ক্যানভাস_রেন্ডার(ক্যানভাস, প্রস্থ * উচ্চতা)
    দেখাও "\033[0m" // কালার রিসেট

    দেখাও "\n৩. কার্সর ফিরিয়ে আনা হচ্ছে..."
    কার্সর_দেখাও()

    // মেমরি মুক্ত করা
    সিসকল(১১, ক্যানভাস, প্রস্থ * উচ্চতা)
    
    দেখাও "\n🎉 টেস্ট সফল! লিপি এখন HTML ছাড়াই টার্মিনাল UI রেন্ডার করতে সক্ষম!"
    ফেরত ০
}
প্রধান()
