// 📜 লিপি প্রোগ্রামিং ভাষা — প্রথম শ্রেণীর ফাংশন ও কলিং কনভেনশন টেস্ট (Functions & AMD64 ABI)
দেখাও "\033[1;36m=== লিপি প্রথম শ্রেণীর ফাংশন ও কল স্ট্যাক পরীক্ষা ===\033[0m"

// ১. প্যারামিটারসহ ফাংশন সংজ্ঞা (System V AMD64 ABI: rdi, rsi -> rax)
কাজ যোগ(ক, খ) {
    ধরি ফলাফল = ক + খ
    ফেরত ফলাফল
}

কাজ গুণ(ক, খ) {
    ধরি ফলাফল = ক * খ
    ফেরত ফলাফল
}

// ২. শর্ত ও লুপ সম্বলিত ফাংশন
কাজ ফ্যাক্টোরিয়াল(n) {
    ধরি ফল = ১
    ধরি i = ১
    যতক্ষণ i <= n {
        ফল = ফল * i
        i = i + ১
    }
    ফেরত ফল
}

// ৩. প্রধান কার্যনির্বাহী অংশ (Main Execution Entry)
ধরি x = যোগ(২০, ৩০)
দেখাও "২০ + ৩০ = " + x

ধরি y = গুণ(x, ৪)
দেখাও "৫০ * ৪ = " + y

ধরি f5 = ফ্যাক্টোরিয়াল(৫)
দেখাও "৫ এর ফ্যাক্টোরিয়াল = " + f5

ধরি f6 = ফ্যাক্টোরিয়াল(৬)
দেখাও "৬ এর ফ্যাক্টোরিয়াল = " + f6
