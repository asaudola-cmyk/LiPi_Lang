// 📜 লিপি প্রোগ্রামিং ভাষা — নবম পাঠ (Lipi 09: Full-Stack Sovereign REST Web Framework)
// কোনো বাহ্যিক ফ্রেমওয়ার্ক ছাড়া সরাসরি খাঁটি লিপিতে লিখিত রাউটার, রিকোয়েস্ট ও রেসপন্স আর্কিটেকচার

আমদানি "modules/web.lp" হিসেবে ওয়েব

দেখাও "╔════════════════════════════════════════════════════════════════════════╗"
দেখাও "║  🌐 LIPI SOVEREIGN FULL-STACK REST API FRAMEWORK                       ║"
দেখাও "╚════════════════════════════════════════════════════════════════════════╝"
দেখাও ""

// ১. রাউটার ইনস্ট্যান্স তৈরি
ধরি অ্যাপ = ওয়েব.তৈরি_রাউটার()

// ২. মিডলওয়্যার নিবন্ধন (Request Logger Middleware)
ধরি লগার = কাজ(অনুরোধ) {
    দেখাও "  [লগার মিডলওয়্যার] আগমনী অনুরোধ : " + অনুরোধ.পদ্ধতি + " " + অনুরোধ.পথ
}
অ্যাপ["মিডলওয়্যার"](লগার)

// ৩. রুট হ্যান্ডলার নিবন্ধন
// ৩.১ হোম রুট (GET /)
অ্যাপ["গেট"]("/", কাজ(অনুরোধ) {
    ফেরত ওয়েব.তৈরি_জেসন_রেসপন্স(২০০, {
        "অ্যাপ্লিকেশন": "লিপি সার্বভৌমিক ওয়েব ফ্রেমওয়ার্ক",
        "সংস্করণ": "২.০.০",
        "ভাষা": "লিপি (Lipi Sovereign Silicon)",
        "বার্তা": "স্বাগতম পিএইচপি ও নোড-মুক্ত বিশুদ্ধ লিপি ব্যাকএন্ডে!",
        "স্ট্যাটাস": "সক্রিয়"
    })
})

// ৩.২ স্বাস্থ্য পরীক্ষা রুট (GET /api/v1/health)
অ্যাপ["গেট"]("/api/v1/health", কাজ(অনুরোধ) {
    ফেরত ওয়েব.তৈরি_জেসন_রেসপন্স(২০০, {
        "স্ট্যাটাস": "সুস্থ ও সক্রিয়",
        "ওএস": লিপি.সিস্টেম.প্ল্যাটফর্ম(),
        "আর্কিটেকচার": লিপি.সিস্টেম.প্রসেসর(),
        "মেমরি_ক্যাশিং": "POSIX Silicon Shared Memory (/dev/shm) সক্রিয়"
    })
})

// ৩.৩ ব্যবহারকারী তৈরি রুট (POST /api/v1/users)
অ্যাপ["পোস্ট"]("/api/v1/users", কাজ(অনুরোধ) {
    ধরি রিকোয়েস্ট_বডি = অনুরোধ.বডি
    // মেমোরি সিলিকনে সেভ করা
    ধরি ইউজার_আইডি = ১০১
    ধরি সংরক্ষিত_ডেটা = {
        "আইডি": ইউজার_আইডি,
        "নাম": রিকোয়েস্ট_বডি["নাম"],
        "পদবী": রিকোয়েস্ট_বডি["পদবী"],
        "তৈরির_সময়": লিপি.সময়.তারিখ("Y-m-d H:i:s")
    }

    ফেরত ওয়েব.তৈরি_জেসন_রেসপন্স(২০১, {
        "সাফল্য": সত্য,
        "বার্তা": "ব্যবহারকারী সফলভাবে তৈরি হয়েছে!",
        "ডেটা": সংরক্ষিত_ডেটা
    })
})

// =============================================================================
// ৪. সিমুলেটেড এইচটিটিপি ট্রাফিক ডিসপ্যাচ ও পরীক্ষণ (Simulated HTTP Traffic)
// =============================================================================
দেখাও "--- [১] টেস্ট রিকোয়েস্ট ১: GET / ---"
ধরি রিকোয়েস্ট_১ = নতুন ওয়েব.রিকোয়েস্ট(পদ্ধতি: "GET", পথ: "/", হেডার: {}, বডি: {})
ধরি উত্তর_১ = অ্যাপ["বিতরণ"](রিকোয়েস্ট_১)
দেখাও "  • রেসপন্স স্ট্যাটাস :", উত্তর_১.স্ট্যাটাস
দেখাও "  • রেসপন্স হেডার    :", উত্তর_১.হেডার
দেখাও "  • রেসপন্স বডি      :", উত্তর_১.বডি
দেখাও ""

দেখাও "--- [২] টেস্ট রিকোয়েস্ট ২: GET /api/v1/health ---"
ধরি রিকোয়েস্ট_২ = নতুন ওয়েব.রিকোয়েস্ট(পদ্ধতি: "GET", পথ: "/api/v1/health", হেডার: {}, বডি: {})
ধরি উত্তর_২ = অ্যাপ["বিতরণ"](রিকোয়েস্ট_২)
দেখাও "  • রেসপন্স স্ট্যাটাস :", উত্তর_২.স্ট্যাটাস
দেখাও "  • রেসপন্স বডি      :", উত্তর_২.বডি
দেখাও ""

দেখাও "--- [৩] টেস্ট রিকোয়েস্ট ৩: POST /api/v1/users ---"
ধরি নতুন_ইউজার_পেলোড = {"নাম": "শফিউল্লাহ", "পদবী": "সিস্টেম স্থপতি"}
ধরি রিকোয়েস্ট_৩ = নতুন ওয়েব.রিকোয়েস্ট(পদ্ধতি: "POST", পথ: "/api/v1/users", হেডার: {"Content-Type": "application/json"}, বডি: নতুন_ইউজার_পেলোড)
ধরি উত্তর_৩ = অ্যাপ["বিতরণ"](রিকোয়েস্ট_৩)
দেখাও "  • রেসপন্স স্ট্যাটাস :", উত্তর_৩.স্ট্যাটাস
দেখাও "  • রেসপন্স বডি      :", উত্তর_৩.বডি
দেখাও ""

দেখাও "--- [৪] টেস্ট রিকোয়েস্ট ৪: 404 Not Found Handling (GET /unknown) ---"
ধরি রিকোয়েস্ট_৪ = নতুন ওয়েব.রিকোয়েস্ট(পদ্ধতি: "GET", পথ: "/অজানা_পথ", হেডার: {}, বডি: {})
ধরি উত্তর_৪ = অ্যাপ["বিতরণ"](রিকোয়েস্ট_৪)
দেখাও "  • রেসপন্স স্ট্যাটাস :", উত্তর_৪.স্ট্যাটাস
দেখাও "  • রেসপন্স বডি      :", উত্তর_৪.বডি
দেখাও ""

দেখাও "✔ খাঁটি লিপি সার্বভৌম ফুল-স্ট্যাক ওয়েব ফ্রেমওয়ার্ক শতভাগ সফলভাবে যাচাইকৃত!"
