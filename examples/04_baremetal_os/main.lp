// ==============================================================================
// 👑 LIPI BARE-METAL MULTIBOOT KERNEL (examples/04_baremetal_os/main.lp)
// ⚡ Zero Linux | Native Multiboot 0x1BADB002 | Direct Hardware VGA 0xB8000
// ==============================================================================

// WHY: Lipi can compile directly to bare-metal operating system kernels that boot
// directly on x86 hardware via GRUB or QEMU without an underlying Linux kernel.

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/kernel.lp"

কাজ প্রধান() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI BARE-METAL MULTIBOOT KERNEL BUILDER (Lipi OS)\033[0m                   \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[38;2;180;180;180m⚡ Zero Linux | Native Multiboot 0x1BADB002 | Direct Hardware 0xB8000  \033[0m\033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""

    // ১. মাল্টিবুট ১ হেডার স্পেসিফিকেশন ভ্যালিডেশন
    দেখাও "[১] মাল্টিবুট ১ স্পেসিফিকেশন (0x1BADB002) হেডার প্রস্তুতি..."
    ধরি ম্যাজিক = 0x1BADB002
    ধরি ফ্ল্যাগস = 0x00000003
    ধরি চেকসাম = 0xE4524FFB

    ধরি চেক_ফলাফল = মাল্টিবুট_চেকসাম_যাচাই(ম্যাজিক, ফ্ল্যাগস, চেকসাম)
    যদি চেক_ফলাফল == ১ {
        দেখাও "  ✔ মাল্টিবুট হেডার জেনারেটেড: 0x1BADB002"
        দেখাও "  ✔ মাল্টিবুট ফ্ল্যাগস        : 0x00000003 (Page Aligned + Memory Map)"
        দেখাও "  ✔ মাল্টিবুট চেকসাম         : 0xE4524FFB (Magic + Flags + Checksum == 0)"
    }

    // ২. ফিজিক্যাল ভিজিএ বাফার সেল এনকোডিং (0xB8000 Hardware Framebuffer)
    দেখাও "\n[২] ফিজিক্যাল ভিজিএ বাফার সেল এনকোডিং (0xB8000 Hardware Framebuffer)..."
    ধরি সেল_L = ভিজিএ_সেল_তৈরি(76, ভিজিএ_সায়ান_রং) // 'L'
    ধরি সেল_I = ভিজিএ_সেল_তৈরি(73, ভিজিএ_সবুজ_রং) // 'I'
    ধরি সেল_P = ভিজিএ_সেল_তৈরি(80, ভিজিএ_সায়ান_রং) // 'P'
    
    দেখাও "  ✔ সেল 'L' (রঙ: সায়ান): " + সেল_L + " (ASCII: 76, Color: 11)"
    দেখাও "  ✔ সেল 'I' (রঙ: সবুজ) : " + সেল_I + " (ASCII: 73, Color: 10)"
    দেখাও "  ✔ সেল 'P' (রঙ: সায়ান): " + সেল_P + " (ASCII: 80, Color: 11)"

    // ৩. বুটেবল ৩২-বিট ELF32 কার্নেল ইমেজ সিন্থেসিস
    দেখাও "\n[৩] স্ট্যান্ডঅ্যালোন বুটেবল ৩২-বিট মাল্টিবুট ELF কার্নেল সিন্থেসিস..."
    ধরি কার্নেল_পাথ = "dist/lipi_os_kernel.elf"
    
    // কার্নেল ফাইল তৈরি (SYS_open: 2, O_WRONLY|O_CREAT|O_TRUNC = 577, mode = 420)
    ধরি কার্নেল_এফডি = সিসকল(২, কার্নেল_পাথ, ৫৭৭, ৪২০)
    
    যদি কার্নেল_এফডি > ০ {
        ধরি ইমেজ_বাফার = মেমরি_বরাদ্দ(১৬০)
        মেমরি_পূরণ(ইমেজ_বাফার, ০, ১৬০)
        
        // ELF32 Header (52 bytes)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ০, 0x7F)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১, 0x45) // 'E'
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২, 0x4C) // 'L'
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৩, 0x46) // 'F'
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪, 0x01) // 32-bit (ELFCLASS32)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৫, 0x01) // Little-endian
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬, 0x01) // EV_CURRENT
        
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৬, 0x02) // ET_EXEC
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৮, 0x03) // EM_386 (x86)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২০, 0x01)
        
        // Entry point: 0x00100060 (offset 96)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৪, 0x60)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৫, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৬, 0x10)
        
        // Program Header offset: 52 (0x34)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ২৮, 0x34)
        
        // Header sizes: ehsize = 52, phentsize = 32, phnum = 1
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪০, 0x34)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪২, 0x20)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৪৪, 0x01)
        
        // Program Header (32 bytes at offset 52)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৫২, 0x01) // PT_LOAD
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬০, 0x00) // vaddr = 0x00100000
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬২, 0x10)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬৪, 0x00) // paddr = 0x00100000
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬৬, 0x10)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৬৮, 160)  // filesz = 160
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৭২, 160)  // memsz = 160
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৭৬, 0x07) // flags = 7 (RWE)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮১, 0x10) // align = 4096 (0x1000)
        
        // Multiboot Header (12 bytes at offset 84)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৪, 0x02)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৫, 0xB0)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৬, 0xAD)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৭, 0x1B)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৮৮, 0x03)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯২, 0xFB)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৩, 0x4F)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৪, 0x52)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৫, 0xE4)
        
        // VGA Kernel Code (at offset 96 = 0x60):
        // mov word ptr [0xB8000], 0x0B4C ('L' cyan)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৬, 0x66)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৭, 0xC7)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৮, 0x05)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ৯৯, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০০, 0x80)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০১, 0x0B)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০২, 0x00)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৩, 0x4C)
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১০৪, 0x0B)
        
        // cli; hlt; jmp $-2
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩২, 0xFA) // cli
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩৩, 0xF4) // hlt
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩৪, 0xEB) // jmp
        মেমরি_বাইট_লেখো(ইমেজ_বাফার, ১৩৫, 0xFD) // -2
        
        // ফাইলে লেখা
        ধরি রাইট = সিসকল(১, কার্নেল_এফডি, ইমেজ_বাফার, ১৬০)
        সিসকল(৩, কার্নেল_এফডি)
        মেমরি_মুক্তি(ইমেজ_বাফার, ১৬০)
        
        দেখাও "  ✔ সফলভাবে বুটেবল ELF32 কার্নেল তৈরি হয়েছে: " + কার্নেল_পাথ + " (" + রাইট + " বাইট)"
        দেখাও "  ✔ আর্কিটেকচার: 32-bit Multiboot-1 Compliant (ELFCLASS32 / EM_386)"
        দেখাও "  ✔ QEMU বুট কমান্ড: qemu-system-x86_64 -kernel " + কার্নেল_পাথ
    }
    
    দেখাও "\n\033[1;32m🎉 লিপি বেয়ারমেটাল ওএস কার্নেল টেস্ট সম্পূর্ণ সফল!\033[0m"
    দেখাও "⚡ [100% Sovereign Lipi Synthesized Native ELF - Hardware CPU Execution]"
    ফেরত ০
}

প্রধান()
