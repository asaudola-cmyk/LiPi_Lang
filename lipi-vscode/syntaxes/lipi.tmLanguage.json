{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lipi",
  "scopeName": "source.lipi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lipi",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.lipi",
          "match": "#.*$"
        },
        {
          "name": "comment.block.lipi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lipi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\([nrt\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            },
            {
              "name": "meta.embedded.line.lipi",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.lipi"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.lipi"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.lipi",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lipi",
              "match": "\\\\([nrt\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lipi",
          "match": "\\b(if|else|elif|while|for|repeat|return|break|continue|in|to|step|times)\\b"
        },
        {
          "name": "keyword.control.bengali.lipi",
          "match": "(যদি|নাহলে_যদি|নাহলে|যতক্ষণ|প্রতিটি|বার|ফেরত|থামো|চালিয়ে_যাও|ভেতরে)"
        },
        {
          "name": "keyword.declaration.lipi",
          "match": "\\b(fn|function|def|struct|class|include|import)\\b"
        },
        {
          "name": "keyword.declaration.bengali.lipi",
          "match": "(কাজ|গঠন|ধরি|ধরো|অন্তর্ভুক্ত)"
        },
        {
          "name": "keyword.operator.logical.lipi",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.logical.bengali.lipi",
          "match": "(এবং|অথবা|না)"
        },
        {
          "name": "constant.language.boolean.true.lipi",
          "match": "\\b(true)\\b|(সত্য)"
        },
        {
          "name": "constant.language.boolean.false.lipi",
          "match": "\\b(false)\\b|(মিথ্যা)"
        },
        {
          "name": "constant.language.null.lipi",
          "match": "\\b(null|nil)\\b|(শূন্য)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lipi",
          "match": "\\b(say|show|print|println|puts|echo|len|length|type|abs|max|min|sqrt|pow|sin|cos|tan|floor|ceil|round|input|read_file|write_file|file_exists|system|exit)\\b"
        },
        {
          "name": "support.function.builtin.bengali.lipi",
          "match": "(বলো|দেখাও|দৈর্ঘ্য|ধরন|পড়ো|লেখো)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn|কাজ|def)\\s+([a-zA-Z_\\x{0980}-\\x{09FF}][a-zA-Z0-9_\\x{0980}-\\x{09FF}]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.lipi"
            },
            "2": {
              "name": "entity.name.function.lipi"
            }
          }
        },
        {
          "match": "([a-zA-Z_\\x{0980}-\\x{09FF}][a-zA-Z0-9_\\x{0980}-\\x{09FF}]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.lipi"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lipi",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.lipi",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.lipi",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lipi",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.bengali.float.lipi",
          "match": "[০-৯]+\\.[০-৯]+"
        },
        {
          "name": "constant.numeric.bengali.integer.lipi",
          "match": "[০-৯]+"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.lipi",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.lipi",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.lipi",
          "match": "(\\+|-|\\*\\*|\\*|//|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.lipi",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.range.lipi",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.arrow.lipi",
          "match": "(->)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.lipi",
          "match": "\\b(int|float|str|bool|list|map|void|any)\\b"
        },
        {
          "name": "entity.name.type.bengali.lipi",
          "match": "(সংখ্যা|লেখা|বুলিয়ান|তালিকা)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.name.lipi",
          "match": "[a-zA-Z_\\x{0980}-\\x{09FF}][a-zA-Z0-9_\\x{0980}-\\x{09FF}]*"
        }
      ]
    }
  }
}
