{
  "Function Definition (English)": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params})",
      "    ${0:// function body}",
      "    return ${3:result}"
    ],
    "description": "Define a new function in Lipi"
  },
  "Function Definition (Bengali)": {
    "prefix": "কাজ",
    "body": [
      "কাজ ${1:নাম}(${2:প্যারামিটার})",
      "    ${0:// কাজের বিবরণ}",
      "    ফেরত ${3:ফলাফল}"
    ],
    "description": "লিপিতে নতুন কাজ (ফাংশন) তৈরি করুন"
  },
  "If Statement (English)": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "    ${0:// body}"
    ],
    "description": "If conditional statement"
  },
  "If Statement (Bengali)": {
    "prefix": "যদি",
    "body": [
      "যদি ${1:শর্ত}",
      "    ${0:// কোড}"
    ],
    "description": "যদি শর্ত সাপেক্ষ বিবৃতি"
  },
  "If-Else Statement (English)": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}",
      "    ${2:// then body}",
      "else",
      "    ${0:// else body}"
    ],
    "description": "If-Else conditional block"
  },
  "If-Else Statement (Bengali)": {
    "prefix": "যদি_নাহলে",
    "body": [
      "যদি ${1:শর্ত}",
      "    ${2:// যদি সত্য হয়}",
      "নাহলে",
      "    ${0:// যদি মিথ্যা হয়}"
    ],
    "description": "যদি-নাহলে শর্ত সাপেক্ষ ব্লক"
  },
  "While Loop (English)": {
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "    ${0:// loop body}"
    ],
    "description": "While loop"
  },
  "While Loop (Bengali)": {
    "prefix": "যতক্ষণ",
    "body": [
      "যতক্ষণ ${1:শর্ত}",
      "    ${0:// লুপ বডি}"
    ],
    "description": "যতক্ষণ লুপ"
  },
  "For Range Loop (English)": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:1}..${3:10}",
      "    ${0:// loop body}"
    ],
    "description": "For range loop"
  },
  "For Range Loop (Bengali)": {
    "prefix": "প্রতিটি",
    "body": [
      "প্রতিটি ${1:i} ভেতরে ${2:১}..${3:১০}",
      "    ${0:// লুপ বডি}"
    ],
    "description": "প্রতিটি রেঞ্জ লুপ"
  },
  "Repeat Loop (English)": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:5}",
      "    ${0:// body}"
    ],
    "description": "Repeat block N times"
  },
  "Repeat Loop (Bengali)": {
    "prefix": "বার",
    "body": [
      "${1:৫} বার বলো \"${0:হ্যালো লিপি!}\""
    ],
    "description": "N বার পুনরাবৃত্তি বিবৃতি"
  },
  "Struct Definition (English)": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "    ${2:field1}",
      "    ${3:field2}"
    ],
    "description": "Define a structure data type"
  },
  "Struct Definition (Bengali)": {
    "prefix": "গঠন",
    "body": [
      "গঠন ${1:নাম}",
      "    ${2:ক্ষেত্র১}",
      "    ${3:ক্ষেত্র২}"
    ],
    "description": "লিপিতে নতুন গঠন (স্ট্রাকচার) তৈরি করুন"
  },
  "Say Statement": {
    "prefix": "say",
    "body": [
      "say \"${1:Hello, Lipi!}\""
    ],
    "description": "Print line to standard output"
  },
  "Bolo Statement": {
    "prefix": "বলো",
    "body": [
      "বলো \"${1:হ্যালো লিপি!}\""
    ],
    "description": "কনসোলে বার্তা প্রিন্ট করুন"
  },
  "Main Application Template": {
    "prefix": "main",
    "body": [
      "// Lipi Application: ${1:AppName}",
      "",
      "fn main()",
      "    say \"Starting ${1:AppName}...\"",
      "    ${0:// code here}",
      "    say \"Done.\"",
      "",
      "main()"
    ],
    "description": "Standard Lipi main application entry point"
  },
  "Linux Kernel Syscall": {
    "prefix": "syscall",
    "body": [
      "// Syscall ${1:write}: num=${2:1}, fd=${3:1}, buf=${4:ptr}, len=${5:count}",
      "val res = syscall(${2:1}, ${3:1}, ${4:ptr}, ${5:count})"
    ],
    "description": "Direct Linux x86_64 kernel syscall"
  }
}
