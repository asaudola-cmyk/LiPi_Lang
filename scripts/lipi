#!/usr/bin/env bash
# ==============================================================================
# ⚡ lipi — লিপি স্মার্ট কম্পাইলার Wrapper
# লিপি প্রথম ১.০ | সংকেতনাম: সোভেরিন
# File: scripts/lipi
#
# WHY এই wrapper:
#   bin/lipic সরাসরি call করলে নাহলে_যদি, template strings কাজ করে না।
#   এই wrapper স্বয়ংক্রিয়ভাবে preprocessor চালায় তারপর lipic invoke করে।
#   ফলে developer সব feature ব্যবহার করতে পারে — compiler bug ছাড়াই।
#
# ব্যবহার (Usage):
#   lipi compile input.lp -o output   # compile
#   lipi run input.lp                 # compile + run
#   lipi check input.lp               # syntax check only
#   lipi version                       # version info
#   lipi help                          # help
#
# ইনস্টল:
#   sudo cp scripts/lipi /usr/local/bin/lipi
#   sudo chmod +x /usr/local/bin/lipi
# ==============================================================================

set -uo pipefail

# ─── Configuration ────────────────────────────────────────────────────────────
LIPI_VERSION="প্রথম ১.০"
LIPI_CODENAME="সোভেরিন"
LIPI_SEM_VERSION="1.0.0"

# Find lipi installation directory (relative to this script)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIPI_HOME="${LIPI_HOME:-$(dirname "$SCRIPT_DIR")}"

# Binaries
LIPIC="${LIPI_HOME}/bin/lipic"
PREPROCESSOR="${LIPI_HOME}/src/compiler/preprocessor.sh"

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
TEAL='\033[38;2;0;255;204m'
RESET='\033[0m'

# ─── Helper Functions ─────────────────────────────────────────────────────────
lipi_error() {
    echo -e "${RED}❌ লিপি এরর: $1${RESET}" >&2
    exit "${2:-1}"
}

lipi_info() {
    echo -e "${TEAL}  • $1${RESET}" >&2
}

lipi_ok() {
    echo -e "${GREEN}  ✔ $1${RESET}" >&2
}

# ─── Check Binaries ───────────────────────────────────────────────────────────
check_lipic() {
    if [[ ! -x "$LIPIC" ]]; then
        # Try PATH
        LIPIC_PATH="$(which lipic 2>/dev/null || true)"
        if [[ -n "$LIPIC_PATH" ]]; then
            LIPIC="$LIPIC_PATH"
        else
            lipi_error "lipic পাওয়া যায়নি। PATH: $LIPI_HOME/bin/lipic"
        fi
    fi
}

# ─── Banner ───────────────────────────────────────────────────────────────────
show_banner() {
    echo -e "${TEAL}╔═════════════════════════════════════════════╗${RESET}"
    echo -e "${TEAL}║${RESET}  ⚡ \033[1mLipi $LIPI_VERSION ($LIPI_CODENAME)\033[0m"
    echo -e "${TEAL}║${RESET}  👑 সার্বভৌম সিস্টেম প্রোগ্রামিং ভাষা"
    echo -e "${TEAL}╚═════════════════════════════════════════════╝${RESET}"
    echo
}

# ─── Help ─────────────────────────────────────────────────────────────────────
cmd_help() {
    show_banner
    echo -e "\033[1;33mব্যবহার:\033[0m lipi <কমান্ড> [বিকল্প]"
    echo
    echo -e "\033[1;33mকমান্ডসমূহ:\033[0m"
    echo -e "  \033[1;32mcompile\033[0m  <file.lp> [-o output]  কম্পাইল করুন"
    echo -e "  \033[1;32mrun\033[0m      <file.lp>              কম্পাইল করে চালান"
    echo -e "  \033[1;32mcheck\033[0m    <file.lp>              শুধু syntax যাচাই করুন"
    echo -e "  \033[1;32mbuild\033[0m                           লিপি নিজেকে build করুন"
    echo -e "  \033[1;32mtest\033[0m                            tests/ ডিরেক্টরি চালান"
    echo -e "  \033[1;32mversion\033[0m                         সংস্করণ দেখুন"
    echo -e "  \033[1;32minfo\033[0m                            পরিবেশ তথ্য দেখুন"
    echo -e "  \033[1;32mhelp\033[0m                            এই সহায়তা দেখুন"
    echo
    echo -e "\033[1;33mউদাহরণ:\033[0m"
    echo "  lipi run hello.lp"
    echo "  lipi compile app.lp -o bin/app"
    echo "  lipi test"
    echo
    echo -e "\033[38;2;128;128;128mআরো তথ্য: https://lipi.dev\033[0m"
}

# ─── Version ──────────────────────────────────────────────────────────────────
cmd_version() {
    echo "lipi $LIPI_VERSION ($LIPI_CODENAME)"
    echo "  সিম্যান্টিক: $LIPI_SEM_VERSION"
    echo "  কম্পাইলার : $LIPIC"
    echo "  লক্ষ্য    : Linux x86_64 ELF64"
    echo "  লাইসেন্স  : MIT"
    echo "  নির্মাতা  : Lipi Language Team"
}

# ─── Info ─────────────────────────────────────────────────────────────────────
cmd_info() {
    echo "লিপি পরিবেশ তথ্য:"
    echo "  LIPI_HOME     : $LIPI_HOME"
    echo "  lipic         : $LIPIC ($(ls -la "$LIPIC" 2>/dev/null | awk '{print $5}') bytes)"
    echo "  preprocessor  : $PREPROCESSOR"
    echo "  Python3       : $(python3 --version 2>/dev/null || echo 'পাওয়া যায়নি')"
    echo "  OS            : $(uname -r)"
    echo "  Architecture  : $(uname -m)"
}

# ─── Compile ──────────────────────────────────────────────────────────────────
cmd_compile() {
    local input_file="${1:-}"
    local output_file="${2:-}"

    if [[ -z "$input_file" ]]; then
        lipi_error "ইনপুট ফাইল দিন। ব্যবহার: lipi compile <file.lp> [-o output]"
    fi

    if [[ ! -f "$input_file" ]]; then
        lipi_error "ফাইল পাওয়া যায়নি: $input_file"
    fi

    # Determine output file name
    if [[ -z "$output_file" ]]; then
        output_file="${input_file%.lp}"
        output_file="$(basename "$output_file")"
    fi

    lipi_info "কম্পাইল: $input_file → $output_file"
    local start_time
    start_time=$(date +%s%N)

    # WHY: Use preprocessor for নাহলে_যদি support + template strings
    if [[ -x "$PREPROCESSOR" ]] && command -v python3 &>/dev/null; then
        "$PREPROCESSOR" "$input_file" "$output_file"
    else
        # Fallback: direct compile without preprocessing
        lipi_info "preprocessor পাওয়া যায়নি — সরাসরি কম্পাইল হচ্ছে"
        "$LIPIC" "$input_file" -o "$output_file"
    fi

    local compile_exit=$?
    local end_time
    end_time=$(date +%s%N)
    local elapsed_ms=$(( (end_time - start_time) / 1000000 ))

    if [[ $compile_exit -eq 0 ]] && [[ -f "$output_file" ]]; then
        local size
        size=$(stat -c%s "$output_file" 2>/dev/null || echo "?")
        lipi_ok "কম্পাইল সফল: $output_file ($size bytes, ${elapsed_ms}ms)"
        return 0
    else
        lipi_error "কম্পাইল ব্যর্থ (exit: $compile_exit)" $compile_exit
    fi
}

# ─── Run ──────────────────────────────────────────────────────────────────────
cmd_run() {
    local input_file="${1:-}"

    if [[ -z "$input_file" ]]; then
        lipi_error "ইনপুট ফাইল দিন। ব্যবহার: lipi run <file.lp>"
    fi

    local tmp_binary
    tmp_binary=$(mktemp /tmp/lipi_run_XXXXXX)
    chmod +x "$tmp_binary" 2>/dev/null || true

    # Compile
    if cmd_compile "$input_file" "$tmp_binary" 2>/dev/null; then
        echo
        # Run
        "$tmp_binary"
        local run_exit=$?
        rm -f "$tmp_binary"
        return $run_exit
    else
        rm -f "$tmp_binary"
        lipi_error "run ব্যর্থ — কম্পাইল করতে পারেনি"
    fi
}

# ─── Check ────────────────────────────────────────────────────────────────────
cmd_check() {
    local input_file="${1:-}"
    if [[ -z "$input_file" ]]; then
        lipi_error "ফাইল দিন। ব্যবহার: lipi check <file.lp>"
    fi

    local tmp="/tmp/lipi_check_$(basename "$input_file").tmp"
    lipi_info "Syntax যাচাই: $input_file"

    local output
    output=$("$LIPIC" "$input_file" -o "$tmp" 2>&1)
    local exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        rm -f "$tmp"
        lipi_ok "✔ Syntax সঠিক — কোনো এরর নেই"
        return 0
    else
        echo "$output" | grep "❌" | head -5
        rm -f "$tmp"
        lipi_error "Syntax এরর পাওয়া গেছে"
    fi
}

# ─── Test ─────────────────────────────────────────────────────────────────────
cmd_test() {
    local tests_dir="${LIPI_HOME}/tests"

    if [[ ! -d "$tests_dir" ]]; then
        lipi_error "tests/ ডিরেক্টরি পাওয়া যায়নি: $tests_dir"
    fi

    local passed=0 failed=0 skipped=0
    local start_time
    start_time=$(date +%s)

    echo -e "\033[1;36m🧪 লিপি টেস্ট স্যুট\033[0m"
    echo

    for lp_file in "$tests_dir"/*.lp; do
        [[ ! -f "$lp_file" ]] && continue
        local name
        name=$(basename "$lp_file" .lp)
        local tmp="/tmp/lipi_test_${name}"

        if "$LIPIC" "$lp_file" -o "$tmp" >/dev/null 2>&1 && [[ -f "$tmp" ]]; then
            if timeout 10 "$tmp" >/dev/null 2>&1; then
                echo -e "  ${GREEN}✔${RESET} $name"
                ((passed++))
            else
                echo -e "  ${RED}✗${RESET} $name (runtime fail)"
                ((failed++))
            fi
            rm -f "$tmp"
        else
            echo -e "  ${RED}✗${RESET} $name (compile fail)"
            ((failed++))
        fi
    done

    local end_time
    end_time=$(date +%s)
    local elapsed=$((end_time - start_time))

    echo
    echo "══════════════════════════════════"
    echo "  ✅ $passed পাস | ❌ $failed ফেল | মোট: $((passed+failed))"
    echo "  ⏱️  সময়: ${elapsed}s"
    echo "══════════════════════════════════"

    [[ $failed -eq 0 ]] && return 0 || return 1
}

# ─── Build ────────────────────────────────────────────────────────────────────
cmd_build() {
    lipi_info "লিপি project build হচ্ছে..."
    if [[ -f "${LIPI_HOME}/build.sh" ]]; then
        bash "${LIPI_HOME}/build.sh"
    else
        lipi_error "build.sh পাওয়া যায়নি"
    fi
}

# ─── Main Command Dispatch ────────────────────────────────────────────────────
main() {
    check_lipic

    local cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        compile|build-file)
            local input="${1:-}"
            local output=""
            shift 2>/dev/null || true
            # Parse -o flag
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -o|--output) output="${2:-}"; shift 2 ;;
                    *) break ;;
                esac
            done
            cmd_compile "$input" "$output"
            ;;
        run)
            cmd_run "${1:-}"
            ;;
        check)
            cmd_check "${1:-}"
            ;;
        test)
            cmd_test
            ;;
        build)
            cmd_build
            ;;
        version|-V|--version)
            cmd_version
            ;;
        info)
            cmd_info
            ;;
        help|-h|--help)
            cmd_help
            ;;
        *)
            # Unknown command — try to run it as a .lp file
            if [[ -f "$cmd" ]]; then
                cmd_run "$cmd"
            else
                echo -e "${RED}❌ অজানা কমান্ড: $cmd${RESET}" >&2
                echo "ব্যবহার: lipi help" >&2
                exit 2
            fi
            ;;
    esac
}

main "$@"
