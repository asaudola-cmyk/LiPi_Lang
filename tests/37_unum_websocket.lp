// 📜 লিপি ওয়েবসকেট RFC 6455 ফ্রেম ইঞ্জিন টেস্ট
// 👑 UNUM এর রিয়েল-টাইম ডেটা ইঞ্জিন এখন সম্পূর্ণ লিপির নেটিভ মেশিন কোডে!

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"
অন্তর্ভুক্ত "std/websocket.lp"

কাজ প্রধান() {
    দেখাও "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    দেখাও "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI NATIVE WEBSOCKET ENGINE (RFC 6455 Framing & Masking)\033[0m       \033[38;2;0;255;204m║\033[0m"
    দেখাও "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    দেখাও ""

    // ১. সার্ভার টু ক্লায়েন্ট ফ্রেম তৈরি (Unmasked)
    দেখাও "১. সার্ভার ফ্রেম জেনারেট করা হচ্ছে..."
    ধরি পেয়লোড_আকার = ৫ // "Hello"
    ধরি টেক্সট_মেমরি = সিসকল(৯, ০, ১০, ৩, ৩৪, -১, ০)
    মেমরি_বাইট_লেখো(টেক্সট_মেমরি, ০, ৭২) // H
    মেমরি_বাইট_লেখো(টেক্সট_মেমরি, ১, ১০১) 
    মেমরি_বাইট_লেখো(টেক্সট_মেমরি, ২, ১০৮) // l
    মেমরি_বাইট_লেখো(টেক্সট_মেমরি, ৩, ১০৮) // l
    মেমরি_বাইট_লেখো(টেক্সট_মেমরি, ৪, ১১১) // o
    
    ধরি ফ্রেম_বাফার = সিসকল(৯, ০, ২০, ৩, ৩৪, -১, ০)
    ধরি ফ্রেম_সাইজ = ওয়েবসকেট_ফ্রেম_তৈরি(ফ্রেম_বাফার, টেক্সট_মেমরি, পেয়লোড_আকার)
    
    ধরি বাইট০ = মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, ০)
    ধরি বাইট১ = মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, ১)
    
    দেখাও "  • ফ্রেম সাইজ: " + ফ্রেম_সাইজ + " বাইট (Expected: 7)"
    দেখাও "  • Byte 0 (FIN+Opcode): " + বাইট০ + " (Expected: 129 / 0x81)"
    দেখাও "  • Byte 1 (Length)    : " + বাইট১ + " (Expected: 5)"
    
    সিসকল(১১, টেক্সট_মেমরি, ১০)
    সিসকল(১১, ফ্রেম_বাফার, ২০)
    
    দেখাও "\n🎉 টেস্ট সফল! লিপি এখন ওয়েবসকেট বাইনারি ফ্রেম পার্স করতে সক্ষম!"
    ফেরত ০
}

প্রধান()
