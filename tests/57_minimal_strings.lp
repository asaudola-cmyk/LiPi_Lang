// Test 57: Strings — Global Standard

greeting = "Hello"
name = "World"

// String concatenation
say greeting + ", " + name + "!"

// String interpolation
lang = "Lipi"
ver = 2
say "Welcome to {lang} {ver}.0!"

// String in loops
repeat 3
    say "Lipi is great"

// Multi-word output
say "one" "two" "three"

say "PASS: Test 57 Strings"
