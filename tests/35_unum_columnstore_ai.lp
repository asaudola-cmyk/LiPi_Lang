// 📜 লিপি কলাম-স্টোর এবং এআই ভেক্টর ইঞ্জিন টেস্ট
// 👑 UNUM এর SQL-মুক্ত এবং Python-মুক্ত ডেটা ইঞ্জিন এখন সম্পূর্ণ লিপির নেটিভ মেশিন কোডে!

include "std/io.lp"
include "std/mem.lp"
include "std/columnstore.lp"
include "std/ai.lp"

fn প্রধান
    say "\033[38;2;0;255;204m╔════════════════════════════════════════════════════════════════════════╗\033[0m"
    say "\033[38;2;0;255;204m║\033[0m  \033[1;38;2;255;255;255m👑 LIPI NATIVE COLUMNSTORE & AI VECTOR ENGINE (SQL/Python Free)\033[0m        \033[38;2;0;255;204m║\033[0m"
    say "\033[38;2;0;255;204m╚════════════════════════════════════════════════════════════════════════╝\033[0m"
    say ""

    // ---------------------------------------------------------
    // পার্ট ১: কলাম-স্টোর টেস্ট (ColumnStore)
    // ---------------------------------------------------------
    say "\033[1;33m[১] কলাম-স্টোর অ্যানালিটিক্যাল কুয়েরি টেস্ট:\033[0m"
    রো_সংখ্যা = 5

    // বয়স এবং বেতন কলাম তৈরি
    বয়স_কলাম = কলাম_তৈরি(রো_সংখ্যা)
    বেতন_কলাম = কলাম_তৈরি(রো_সংখ্যা)

    // ডেটা ইনসার্ট
    কলাম_লেখো(বয়স_কলাম, 0, 25)
    কলাম_লেখো(বেতন_কলাম, 0, 40000)
    কলাম_লেখো(বয়স_কলাম, 1, 45)
    কলাম_লেখো(বেতন_কলাম, 1, 90000)
    কলাম_লেখো(বয়স_কলাম, 2, 30)
    কলাম_লেখো(বেতন_কলাম, 2, 50000)
    কলাম_লেখো(বয়স_কলাম, 3, 55)
    কলাম_লেখো(বেতন_কলাম, 3, 120000)
    কলাম_লেখো(বয়স_কলাম, 4, 20)
    কলাম_লেখো(বেতন_কলাম, 4, 320000)

    say "  • ডেটাবেজে ৫টি রেকর্ড ইনসার্ট করা হয়েছে।"

    // কুয়েরি: SELECT SUM(বেতন) WHERE বয়স > ৪০
    শর্ত_বয়স = 40
    মোট_বেতন = কলাম_শর্তযুক্ত_যোগফল(বয়স_কলাম, বেতন_কলাম, রো_সংখ্যা, শর্ত_বয়স)

    say "  • কুয়েরি: SELECT SUM(Salary) WHERE Age > 40"
    say "  • ফলাফল: মোট বেতন = " + মোট_বেতন + " (Expected: 90000 + 120000 = 210000)"

    // কলাম মুছে ফেলা
    কলাম_মুছে_ফেলো(বয়স_কলাম, রো_সংখ্যা)
    কলাম_মুছে_ফেলো(বেতন_কলাম, রো_সংখ্যা)
    say "  • কলাম মেমরি সফলভাবে আন-ম্যাপ করা হয়েছে।\n"

    // ---------------------------------------------------------
    // পার্ট ২: এআই ভেক্টর এবং সফটম্যাক্স টেস্ট (AI & LLM Primitives)
    // ---------------------------------------------------------
    say "\033[1;33m[২] এআই ভেক্টর কোসাইন সিমিলারিটি ও সফটম্যাক্স টেস্ট:\033[0m"
    ডাইমেনশন = 4
    ভেক্টর_ক = কলাম_তৈরি(ডাইমেনশন) // ভেক্টর রাখার জন্য কলাম স্টোর ব্যবহার করছি
    ভেক্টর_খ = কলাম_তৈরি(ডাইমেনশন)

    // ভেক্টর A = [1, 2, 3, 4]
    কলাম_লেখো(ভেক্টর_ক, 0, 1)
    কলাম_লেখো(ভেক্টর_ক, 1, 2)
    কলাম_লেখো(ভেক্টর_ক, 2, 3)
    কলাম_লেখো(ভেক্টর_ক, 3, 4)

    // ভেক্টর B = [2, 3, 4, 5]
    কলাম_লেখো(ভেক্টর_খ, 0, 2)
    কলাম_লেখো(ভেক্টর_খ, 1, 3)
    কলাম_লেখো(ভেক্টর_খ, 2, 4)
    কলাম_লেখো(ভেক্টর_খ, 3, 5)

    // কোসাইন সিমিলারিটি (ডট প্রোডাক্ট)
    সিমিলারিটি = এআই_কোসাইন_সিমিলারিটি(ভেক্টর_ক, ভেক্টর_খ, ডাইমেনশন)
    say "  • ভেক্টর ক ও খ এর সিমিলারিটি স্কোর: " + সিমিলারিটি + " (Expected: 1*2 + 2*3 + 3*4 + 4*5 = 40)"

    // সফটম্যাক্স টেস্ট
    অ্যাটেনশন_স্কোর = কলাম_তৈরি(3)
    কলাম_লেখো(অ্যাটেনশন_স্কোর, 0, 10) // Token 1 score
    কলাম_লেখো(অ্যাটেনশন_স্কোর, 1, 20) // Token 2 score
    কলাম_লেখো(অ্যাটেনশন_স্কোর, 2, 5)  // Token 3 score

    say "  • অরিজিনাল অ্যাটেনশন স্কোর: [১০, ২০, ৫]"
    এআই_সফটম্যাক্স(অ্যাটেনশন_স্কোর, 3)

    প্রব1 = কলাম_পড়ো(অ্যাটেনশন_স্কোর, 0)
    প্রব2 = কলাম_পড়ো(অ্যাটেনশন_স্কোর, 1)
    প্রব3 = কলাম_পড়ো(অ্যাটেনশন_স্কোর, 2)

    say "  • সফটম্যাক্স প্রবাবিলিটি (স্কেলড): [" + প্রব1 + ", " + প্রব2 + ", " + প্রব3 + "]"

    কলাম_মুছে_ফেলো(ভেক্টর_ক, ডাইমেনশন)
    কলাম_মুছে_ফেলো(ভেক্টর_খ, ডাইমেনশন)
    কলাম_মুছে_ফেলো(অ্যাটেনশন_স্কোর, 3)

    say "\n🎉 টেস্ট সফল! লিপি এখন SQL এবং Python ছাড়াই Big Data ও AI রান করতে সক্ষম!"
    return 0
প্রধান()
