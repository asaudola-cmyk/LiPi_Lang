// ==============================================================================
// 👑 LIPI HORIZON 15: ASYNC EPOLL EVENT LOOP ENGINE (examples/26_async_epoll_event_loop.lp)
// ⚡ Linux epoll Subsystem (SYS_epoll_create1, SYS_epoll_ctl, SYS_epoll_wait)
// ==============================================================================

include "std/event.lp"

say "╔════════════════════════════════════════════════════════════════════════╗"
say "║  ⚡ খাঁটি লিপি এসিঙ্ক ইভেন্ট লুপ ও epoll নেটওয়ার্ক ইঞ্জিন (std/event.lp)   ║"
say "║  ⚡ SYS_epoll_create1 | SYS_epoll_ctl | SYS_epoll_wait | O(1) C10K   ║"
say "╚════════════════════════════════════════════════════════════════════════╝"
say ""

// [১] কার্নেল epoll ইনস্ট্যান্স তৈরি
say "[১] কার্নেল epoll ইভেন্ট মনিটর অবজেক্ট তৈরি..."
লুপ_এফডি = ইভেন্ট_লুপ_তৈরি()
if লুপ_এফডি <= 0
    say "  ❌ epoll ইনস্ট্যান্স তৈরি ব্যর্থ!"
    return 1
say "  ✔ epoll মনিটর সফলভাবে তৈরি! কার্নেল FD: " + লুপ_এফডি

// [২] লিনাক্স নন-ব্লকিং I/O চ্যানেল (Pipe) তৈরি
say "[২] লিনাক্স কার্নেল I/O চ্যানেল (SYS_pipe: 22) তৈরি..."
পাইপ_বাফার = malloc(16)
পাইপ_স্ট্যাটাস = সিসকল(22, পাইপ_বাফার, 0, 0, 0, 0, 0)
if পাইপ_স্ট্যাটাস != 0
    say "  ❌ পাইপ চ্যানেল তৈরি ব্যর্থ!"
    return 1
রিড_এফডি = মেমরি_শব্দ32_পড়ো(পাইপ_বাফার, 0)
রাইট_এফডি = মেমরি_শব্দ32_পড়ো(পাইপ_বাফার, 4)
say "  • রিড চ্যানেল FD  : " + রিড_এফডি
say "  • রাইট চ্যানেল FD : " + রাইট_এফডি

// [৩] epoll মনিটরিং তালিকায় রিড চ্যানেল যুক্তকরণ (EPOLLIN = 1)
say "[৩] রিড চ্যানেল epoll মনিটরে যুক্তকরণ (EPOLL_CTL_ADD, EPOLLIN)..."
যোগ_স্ট্যাটাস = ইভেন্ট_সকেট_যোগ(লুপ_এফডি, রিড_এফডি, 1)
if যোগ_স্ট্যাটাস != 0
    say "  ❌ epoll_ctl ADD ব্যর্থ!"
    return 1
say "  ✔ রিড চ্যানেল সফলভাবে epoll এ রেজিস্টার্ড।"

// [৪] ডেটাহীন অবস্থায় নন-ব্লকিং ওয়েট পরীক্ষা (Timeout Verification)
say "[৪] নন-ব্লকিং পলিং যাচাই (১০ms টাইমআউট, শুন্য ইভেন্ট প্রত্যাশিত)..."
ইভেন্ট_বাফার = malloc(120) // ১০টি ইভেন্টের জন্য ১২০ বাইট
প্রাথমিক_রেডি = ইভেন্ট_লুপ_অপেক্ষা(লুপ_এফডি, ইভেন্ট_বাফার, 10, 10)
say "  • প্রাথমিক রেডি ইভেন্ট সংখ্যা : " + প্রাথমিক_রেডি
if প্রাথমিক_রেডি == 0
    say "  ✔ টাইমআউট সফল! অপ্রয়োজনীয় সিপিইউ ব্লকিং হয়নি।"

// [৫] চ্যানেলে ডেটা প্রেরণ ও epoll ইভেন্ট ট্রিগারিং
say "[৫] রাইট চ্যানেলে ক্রিপ্টোগ্রাফিক সিগন্যাল প্রেরণ..."
বার্তা = "👑 লিপি এসিঙ্ক epoll ইভেন্ট কার্নেল দ্বারা সফলভাবে ট্রিগার হয়েছে!"
বার্তা_দৈর্ঘ্য = len(বার্তা)
সিসকল(1, রাইট_এফডি, বার্তা, বার্তা_দৈর্ঘ্য, 0, 0, 0) // SYS_write
say "  ✔ পাইপ বাফারে বার্তা প্রেরিত (len: " + বার্তা_দৈর্ঘ্য + " বাইট)।"

// [৬] ইভেন্ট মাল্টিপ্লেক্সিং অপেক্ষা (Event Arrival Verification)
say "[৬] epoll অপেক্ষা: কার্নেল ইভেন্ট নোটিফিকেশন চেক..."
সক্রিয়_সংখ্যা = ইভেন্ট_লুপ_অপেক্ষা(লুপ_এফডি, ইভেন্ট_বাফার, 10, 100)
say "  • কার্নেল কর্তৃক জাগ্রত রেডি ইভেন্ট সংখ্যা : " + সক্রিয়_সংখ্যা

if সক্রিয়_সংখ্যা > 0
    সক্রিয়_এফডি = ইভেন্ট_এফডি_পড়ো(ইভেন্ট_বাফার, 0)
    ইভেন্ট_মাস্ক = ইভেন্ট_মাস্ক_পড়ো(ইভেন্ট_বাফার, 0)
    say "  • নোটিফাইড রেডি FD   : " + সক্রিয়_এফডি
    say "  • নোটিফাইড ইভেন্ট মাস্ক : " + ইভেন্ট_মাস্ক

    if সক্রিয়_এফডি == রিড_এফডি
        say "  ✔ epoll কর্তৃক প্রত্যাশিত রিড চ্যানেল সফলভাবে শনাক্ত হয়েছে!"

    // ডেটা পাঠ
    ইনকামিং_বাফার = malloc(1024)
    সিসকল(0, সক্রিয়_এফডি, ইনকামিং_বাফার, 1024, 0, 0, 0) // SYS_read
    say "  • চ্যানেল থেকে প্রাপ্ত বার্তা : " + লেখা(ইনকামিং_বাফার)

// [৭] epoll মনিটর থেকে অপসারণ ও রিসোর্স বন্ধকরণ
ইভেন্ট_সকেট_মুছো(লুপ_এফডি, রিড_এফডি)
ইভেন্ট_লুপ_বন্ধ(লুপ_এফডি)
সিসকল(3, রিড_এফডি, 0, 0, 0, 0, 0)
সিসকল(3, রাইট_এফডি, 0, 0, 0, 0, 0)

say ""
say "🎉 লিপি এসিঙ্ক epoll ইভেন্ট লুপ ইঞ্জিন সম্পূর্ণ সফল!"
