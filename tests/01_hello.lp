// Test 01: Hello World — Lipi 2.0 Global Standard
// Demonstrates: variables, say, string concat, arithmetic

// Simple output
say "Hello, World!"
say "Welcome to Lipi 2.0"

// Variables and types
name = "Lipi"
version = 2
say name
say version

// Arithmetic
price = 250
qty = 4
total = price * qty
say total

// String concat
developer = "global"
say "Built for: " + developer + " developers"

say "PASS: Test 01 Hello World"
