// ==============================================================================
// 🧪 Test 43: Preprocessor — নাহলে_যদি Chain
// লিপি প্রথম ১.০ | সংকেতনাম: সোভেরিন
//
// WHY এই টেস্ট:
//   লিপি প্রথম ১.০ এ নাহলে_যদি কাজ করে না।
//   কিন্তু nested যদি/নাহলে দিয়ে একই কাজ করা যায়।
//   এই টেস্ট সেই pattern টি verify করে।
//   যখন Compiler 2.0 আসবে, নাহলে_যদি সরাসরি কাজ করবে।
// ==============================================================================

কাজ গ্রেড(নম্বর) {
    যদি নম্বর >= ৯০ {
        দেখাও "গ্রেড: A+"
    } নাহলে {
        যদি নম্বর >= ৮০ {
            দেখাও "গ্রেড: A"
        } নাহলে {
            যদি নম্বর >= ৭০ {
                দেখাও "গ্রেড: B"
            } নাহলে {
                যদি নম্বর >= ৬০ {
                    দেখাও "গ্রেড: C"
                } নাহলে {
                    দেখাও "গ্রেড: F"
                }
            }
        }
    }
}

কাজ বয়স_শ্রেণী(বয়স) {
    যদি বয়স >= ৬৫ {
        দেখাও "প্রবীণ"
    } নাহলে {
        যদি বয়স >= ১৮ {
            দেখাও "প্রাপ্তবয়স্ক"
        } নাহলে {
            যদি বয়স >= ১৩ {
                দেখাও "কিশোর"
            } নাহলে {
                দেখাও "শিশু"
            }
        }
    }
}

কাজ দিনের_সময়(ঘন্টা) {
    যদি ঘন্টা >= ১৭ {
        দেখাও "সন্ধ্যা/রাত"
    } নাহলে {
        যদি ঘন্টা >= ১২ {
            দেখাও "বিকেল"
        } নাহলে {
            যদি ঘন্টা >= ৬ {
                দেখাও "সকাল"
            } নাহলে {
                দেখাও "রাত (গভীর)"
            }
        }
    }
}

কাজ প্রধান() {
    দেখাও "══════════════════════════════════════"
    দেখাও "Test 43: নাহলে_যদি Chain Pattern"
    দেখাও "══════════════════════════════════════"
    দেখাও ""
    দেখাও "--- গ্রেড পরীক্ষা ---"
    গ্রেড(৯৫)
    গ্রেড(৮২)
    গ্রেড(৭৩)
    গ্রেড(৬১)
    গ্রেড(৪৫)
    দেখাও ""
    দেখাও "--- বয়স শ্রেণী ---"
    বয়স_শ্রেণী(৭০)
    বয়স_শ্রেণী(২৫)
    বয়স_শ্রেণী(১৫)
    বয়স_শ্রেণী(৮)
    দেখাও ""
    দেখাও "--- দিনের সময় ---"
    দিনের_সময়(৬)
    দিনের_সময়(১২)
    দিনের_সময়(১৮)
    দিনের_সময়(২)
    দেখাও ""
    দেখাও "✅ Test 43 পাস — nested যদি/নাহলে সঠিকভাবে কাজ করছে"
    দেখাও "⚡ [লিপি প্রথম ১.০]"
    ফেরত ০
}

প্রধান()
