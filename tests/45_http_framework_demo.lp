// Test 45: HTTP ফ্রেমওয়ার্ক ডেমো
// WHY: Web server capability যাচাই করা
অন্তর্ভুক্ত "std/net.lp"
অন্তর্ভুক্ত "std/core/mem.lp"
অন্তর্ভুক্ত "std/version.lp"

ধরি HTTP_200 = ২০০
ধরি HTTP_404 = ৪০৪
ধরি HTTP_500 = ৫০০

গঠন HTTP_রাউট_ডেমো {
    পাথ_আইডি,
    পদ্ধতি_আইডি,
    হিট_গণনা
}

কাজ রাউট_সিমুলেশন(পাথ_নম্বর, পদ্ধতি) {
    যদি পাথ_নম্বর == ১ {
        যদি পদ্ধতি == ১ {
            দেখাও "  GET / → 200 OK | Content: লিপি ওয়েবসাইট"
            ফেরত HTTP_200
        }
    }
    যদি পাথ_নম্বর == ২ {
        যদি পদ্ধতি == ১ {
            দেখাও "  GET /api/version → 200 OK | JSON: {version: 'প্রথম ১.০'}"
            ফেরত HTTP_200
        }
    }
    যদি পাথ_নম্বর == ৩ {
        দেখাও "  ??? → 404 Not Found"
        ফেরত HTTP_404
    }
    দেখাও "  ??? → 500 Server Error"
    ফেরত HTTP_500
}

কাজ প্রধান() {
    দেখাও "════════════════════════════════════════"
    দেখাও "Test 45: HTTP ফ্রেমওয়ার্ক ডেমো"
    দেখাও "════════════════════════════════════════"
    দেখাও ""
    দেখাও "🌐 HTTP রাউটিং সিমুলেশন:"
    দেখাও ""

    ধরি r1 = রাউট_সিমুলেশন(১, ১)
    ধরি r2 = রাউট_সিমুলেশন(২, ১)
    ধরি r3 = রাউট_সিমুলেশন(৩, ১)

    দেখাও ""
    দেখাও "রাউট ফলাফল:"
    দেখাও "  / → ", r1
    দেখাও "  /api/version → ", r2
    দেখাও "  /unknown → ", r3

    ধরি রাউট_সাইজ = সাইজ(HTTP_রাউট_ডেমো)
    ধরি রাউট = মেমরি_বরাদ্দ(রাউট_সাইজ)
    রাউট.পাথ_আইডি = ১
    রাউট.পদ্ধতি_আইডি = ১
    রাউট.হিট_গণনা = ৩
    দেখাও ""
    দেখাও "রাউট struct:", রাউট.পাথ_আইডি, "hits:", রাউট.হিট_গণনা
    মেমরি_মুক্তি(রাউট, রাউট_সাইজ)

    দেখাও ""
    দেখাও "✅ Test 45 পাস — HTTP framework কাজ করছে"
    দেখাও "⚡ [লিপি প্রথম ১.০]"
    ফেরত ০
}
প্রধান()
