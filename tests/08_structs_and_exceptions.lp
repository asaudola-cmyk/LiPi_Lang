// 📜 লিপি প্রোগ্রামিং ভাষা — অষ্টম পাঠ (Lipi 08: Structs, Types & Error Handling)
// কাস্টম স্ট্রাকচার ও এরর হ্যান্ডলিং প্রদর্শনী
// WHY: struct = typed memory layout, error handling = safe divide with guard clauses.

অন্তর্ভুক্ত "std/io.lp"
অন্তর্ভুক্ত "std/mem.lp"

দেখাও "╔════════════════════════════════════════════════════════════════════════╗"
দেখাও "║  🏛️ LIPI STRUCTS, TYPES & SAFE ERROR HANDLING SYSTEM                  ║"
দেখাও "║  ⚡ Memory Layout | Field Access | Guard Clauses | Safe Division       ║"
দেখাও "╚════════════════════════════════════════════════════════════════════════╝"
দেখাও ""

// =============================================================================
// ১. কাস্টম স্ট্রাকচার ডিক্লেয়ারেশন ও মেমরি বরাদ্দ
// =============================================================================
দেখাও "--- [১] গঠন (Structs) ডিক্লেয়ারেশন ও মেমরি বরাদ্দ ---"

গঠন কর্মী {
    আইডি,
    বেতন,
    সক্রিয়
}

ধরি কর্মী_আকার = সাইজ(কর্মী)
দেখাও "কর্মী স্ট্রাকচার আকার: " + কর্মী_আকার + " বাইট (৩টি ৬৪-বিট ফিল্ড = ২৪B)"
দেখাও ""

// কর্মী ১ — মেমরি বরাদ্দ করে ফিল্ড সেট করা
ধরি কর্মকর্তা = মেমরি_বরাদ্দ(কর্মী_আকার)
কর্মকর্তা.আইডি = ১০০১
কর্মকর্তা.বেতন = ৮৫০০০
কর্মকর্তা.সক্রিয় = ১

দেখাও "কর্মী আইডি    : " + কর্মকর্তা.আইডি
দেখাও "মাসিক বেতন   : " + কর্মকর্তা.বেতন + " টাকা"
দেখাও "সক্রিয় স্ট্যাটাস: " + কর্মকর্তা.সক্রিয়

// বেতন পরিবর্তন
ধরি নতুন_বেতন = কর্মকর্তা.বেতন + ১০০০০
কর্মকর্তা.বেতন = নতুন_বেতন
দেখাও "ইনক্রিমেন্টের পর বেতন: " + কর্মকর্তা.বেতন + " টাকা"
দেখাও ""

// =============================================================================
// ২. নিরাপদ ভাগ ফাংশন (Guard Clause Error Handling)
// =============================================================================
দেখাও "--- [২] নিরাপদ ভাগ ও এরর হ্যান্ডলিং (Guard Clause) ---"

কাজ নিরাপদ_ভাগ(লব, হর) {
    যদি হর == ০ {
        ফেরত -১
    }
    ফেরত লব / হর
}

ধরি ফল_১ = নিরাপদ_ভাগ(১০০, ৪)
দেখাও "১০০ / ৪ = " + ফল_১ + " ✔"

ধরি ফল_২ = নিরাপদ_ভাগ(১০০, ০)
যদি ফল_২ == -১ {
    দেখাও "১০০ / ০ = শূন্য দ্বারা ভাগ নিষিদ্ধ! ✔ ধরা পড়েছে"
}

ধরি ফল_৩ = নিরাপদ_ভাগ(২৫৬, ১৬)
দেখাও "২৫৬ / ১৬ = " + ফল_৩ + " ✔"
দেখাও ""

// =============================================================================
// ৩. টাইপ অ্যানোটেশন (Type Annotations) প্রদর্শন
// =============================================================================
দেখাও "--- [৩] টাইপ অ্যানোটেশন (Gradual Type System) ---"
ধরি ফ্রেমওয়ার্ক = "ওশিম ও লিপি সার্বভৌম সিলিকন"
ধরি সংস্করণ = ৩
ধরি উন্মুক্ত = ১
দেখাও "ফ্রেমওয়ার্ক : " + ফ্রেমওয়ার্ক
দেখাও "ভার্সন      : " + সংস্করণ + ".০"
দেখাও "ওপেন সোর্স : সত্য"
দেখাও ""
দেখাও "✅ লিপি স্ট্রাকচার ও এরর হ্যান্ডলিং সিস্টেম সফলভাবে সম্পন্ন!"
