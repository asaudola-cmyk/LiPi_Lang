// 📜 লিপি প্রোগ্রামিং ভাষা — তৃতীয় পাঠ (Lipi 03: Arrays, Maps & For Loops)
// তালিকা, ম্যাপ ও লজিক্যাল ফিল্টারিং

ধরি ছাত্র_ছাত্রী = [
    {"নাম": "তানভীর", "নম্বর": ৮৫},
    {"নাম": "সাদিয়া", "নম্বর": ৯২},
    {"নাম": "রাকিব", "নম্বর": ৫৮},
    {"নাম": "মীম", "নম্বর": ৭৬}
]

দেখাও "মোট শিক্ষার্থীর সংখ্যা: " + দৈর্ঘ্য(ছাত্র_ছাত্রী)
দেখাও "------------------------------------------"

প্রতিটি ছাত্র ভেতরে ছাত্র_ছাত্রী {
    ধরি নাম = ছাত্র["নাম"]
    ধরি নম্বর = ছাত্র["নম্বর"]
    
    ধরি গ্রেড = "F"
    যদি নম্বর >= ৮০ {
        গ্রেড = "A+"
    } নাহলে_যদি নম্বর >= ৭০ {
        গ্রেড = "A"
    } নাহলে_যদি নম্বর >= ৬০ {
        গ্রেড = "B"
    } নাহলে {
        গ্রেড = "F"
    }
    
    দেখাও "শিক্ষার্থী: " + নাম + " | প্রাপ্ত নম্বর: " + বাংলা_সংখ্যা(নম্বর) + " | গ্রেড: " + গ্রেড
}

দেখাও "------------------------------------------"
দেখাও "ফলাফল প্রক্রিয়াকরণ সফলভাবে সম্পন্ন!"
