// Test 49: String Formatting Library Demo
// WHY: Printf-style formatting is essential for all real programs
অন্তর্ভুক্ত "std/core/mem.lp"
অন্তর্ভুক্ত "std/core/str.lp"

কাজ hex_দেখাও(n) {
    দেখাও "hex(", n, ") = 0x..."
    ধরি h15 = n / ১৬ / ১৬ / ১৬ % ১৬
    ধরি h8 = n / ১৬ / ১৬ % ১৬
    ধরি h4 = n / ১৬ % ১৬
    ধরি h1 = n % ১৬
    দেখাও "  nibbles:", h15, h8, h4, h1
}

কাজ বাইনারি_দেখাও(n) {
    দেখাও "binary(", n, "):"
    ধরি bit7 = (n / ১২৮) % ২
    ধরি bit6 = (n / ৬৪) % ২
    ধরি bit5 = (n / ৩২) % ২
    ধরি bit4 = (n / ১৬) % ২
    ধরি bit3 = (n / ৮) % ২
    ধরি bit2 = (n / ৪) % ২
    ধরি bit1 = (n / ২) % ২
    ধরি bit0 = n % ২
    দেখাও "  0b", bit7, bit6, bit5, bit4, bit3, bit2, bit1, bit0
}

কাজ টেবিল_দেখাও() {
    দেখাও "══════════════════════════════════════════"
    দেখাও "  নাম           সংখ্যা    বাংলা"
    দেখাও "══════════════════════════════════════════"
    দেখাও "  ফিবোনাচি(১)    ১         ", বাংলা_সংখ্যা(১)
    দেখাও "  ফিবোনাচি(৫)    ৫         ", বাংলা_সংখ্যা(৫)
    দেখাও "  ফিবোনাচি(১০)   ৫৫        ", বাংলা_সংখ্যা(৫৫)
    দেখাও "  ফিবোনাচি(১৫)   ৬১০       ", বাংলা_সংখ্যা(৬১০)
    দেখাও "  ফিবোনাচি(২০)   ৬৭৬৫      ", বাংলা_সংখ্যা(৬৭৬৫)
    দেখাও "══════════════════════════════════════════"
}

কাজ progress_দেখাও(done, total) {
    ধরি pct = done * ১০০ / total
    ধরি bars = done * ২০ / total
    দেখাও "  Progress:", done, "/", total, "(", pct, "%)"
    দেখাও "  [", bars, "/20 filled]"
}

কাজ প্রধান() {
    দেখাও "══════════════════════════════════════"
    দেখাও "Test 49: String Formatting"
    দেখাও "══════════════════════════════════════"
    দেখাও ""
    দেখাও "--- Hex Formatting ---"
    hex_দেখাও(২৫৫)
    hex_দেখাও(৬৫৫৩৬)
    hex_দেখাও(৪১৯৪৩০৪)
    দেখাও ""
    দেখাও "--- Binary Formatting ---"
    বাইনারি_দেখাও(১০)
    বাইনারি_দেখাও(৪২)
    বাইনারি_দেখাও(২৫৫)
    দেখাও ""
    দেখাও "--- Table Formatting ---"
    টেবিল_দেখাও()
    দেখাও ""
    দেখাও "--- Progress Bar ---"
    progress_দেখাও(৭, ১০)
    progress_দেখাও(১৫, ২০)
    progress_দেখাও(২০, ২০)
    দেখাও ""
    দেখাও "--- Bengali Number Formatting ---"
    ধরি i = ১
    যতক্ষণ i <= ১০ {
        দেখাও "  n=", i, "→", বাংলা_সংখ্যা(i * i)
        i = i + ১
    }
    দেখাও ""
    দেখাও "✅ Test 49 পাস — String formatting কাজ করছে"
    দেখাও "⚡ [লিপি প্রথম ১.০]"
    ফেরত ০
}
প্রধান()
