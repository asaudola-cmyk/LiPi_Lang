// Test 51: Hello World — Global Standard Minimal Syntax
// Unicode identifiers + English keywords ✅

// English style
greeting = "Hello, World!"
say greeting

// Unicode Bengali identifiers (variable names in Bengali, keywords English)
greeting = "স্বাগতম Lipi 2.0 এ!"
say greeting

// Arithmetic
x = 42
y = 8
say x + y
say x * y
say x / y

// String operations
name = "Lipi"
version = 2
say "Language: " + name + " " + version + ".0"

say "PASS: Test 51 Hello World"
