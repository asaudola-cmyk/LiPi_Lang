// Test 44: lipipkg.toml ম্যানিফেস্ট সিস্টেম
// WHY: Package manager এর core feature যাচাই করা
অন্তর্ভুক্ত "std/core/mem.lp"
অন্তর্ভুক্ত "std/version.lp"

গঠন ম্যানিফেস্ট {
    নাম_সূচক,
    সংস্করণ_সূচক,
    লেখক_সূচক,
    নির্ভরতা_গণনা
}

কাজ ম্যানিফেস্ট_তৈরি(নাম, সংস্করণ, লেখক) {
    ধরি সাইজ_মান = সাইজ(ম্যানিফেস্ট)
    ধরি pkg = মেমরি_বরাদ্দ(সাইজ_মান)
    pkg.নাম_সূচক = ১
    pkg.সংস্করণ_সূচক = ২
    pkg.লেখক_সূচক = ৩
    pkg.নির্ভরতা_গণনা = ০
    ফেরত pkg
}

কাজ প্রধান() {
    দেখাও "══════════════════════════════════"
    দেখাও "Test 44: lipipkg ম্যানিফেস্ট সিস্টেম"
    দেখাও "══════════════════════════════════"
    দেখাও ""
    দেখাও "[প্যাকেজ]"
    দেখাও "নাম        = \"my-sovereign-app\""
    দেখাও "সংস্করণ    = \"১.০.০\""
    দেখাও "লেখক       = \"রফিক আহমেদ\""
    দেখাও "বিবরণ      = \"লিপিতে তৈরি অ্যাপ\""
    দেখাও "লাইসেন্স   = \"MIT\""
    দেখাও ""
    দেখাও "[নির্ভরতা]"
    দেখাও "std         = \"", LIPI_সংস্করণ, "\""
    দেখাও "http        = \"২.০\""
    দেখাও "crypto      = \"১.৫\""
    দেখাও ""
    ধরি pkg = ম্যানিফেস্ট_তৈরি("my-app", "১.০.০", "রফিক")
    দেখাও "struct size:", সাইজ(ম্যানিফেস্ট)
    দেখাও "নির্ভরতা গণনা:", pkg.নির্ভরতা_গণনা
    মেমরি_মুক্তি(pkg, সাইজ(ম্যানিফেস্ট))
    দেখাও ""
    দেখাও "✅ Test 44 পাস — lipipkg ম্যানিফেস্ট কাজ করছে"
    দেখাও "⚡ [লিপি প্রথম ১.০]"
    ফেরত ০
}
প্রধান()
