// ==============================================================================
// 👑 LIPI HORIZON 20: PURE LIPI TLS CRYPTO STREAM & CHACHA20 CIPHER ENGINE
// ⚡ RFC 8439 ChaCha20 Stream Cipher | RFC 8446 TLS Record Layer | Zero OpenSSL
// ==============================================================================

// WHY: Verifies pure native symmetric cryptography and TLS framing running
// directly on CPU silicon without libc or external cryptographic libraries.
// Demonstrates keystream synthesis, encryption, decryption, and TLS framing.

অন্তর্ভুক্ত "std/tls.lp"
অন্তর্ভুক্ত "std/debug.lp"
অন্তর্ভুক্ত "std/time.lp"

দেখাও "╔════════════════════════════════════════════════════════════════════════╗"
দেখাও "║  🔒 লিপি পিওর সিলিকন টিএলএস ক্রিপ্টো স্ট্রিম ও ChaCha20 সাইফার ইঞ্জিন   ║"
দেখাও "║  ⚡ RFC 8439 Symmetric Stream | RFC 8446 TLS Record Frame | Zero Libc  ║"
দেখাও "╚════════════════════════════════════════════════════════════════════════╝"
দেখাও ""

// [১] ২৫৬-বিট ক্রিপ্টোগ্রাফিক কি ও ৯৬-বিট ননস প্রস্তুতি
দেখাও "[১] ক্রিপ্টোগ্রাফিক কি ও ননস ভেক্টর ইনিশিয়ালাইজেশন..."
ধরি কি_মেমরি = মেমরি_বরাদ্দ(64)
ধরি ননস_মেমরি = মেমরি_বরাদ্দ(32)

// ২৫৬-বিট কি (৮টি ৩২-বিট শব্দ)
মেমরি_লেখো(কি_মেমরি, 0, 0x03020100)
মেমরি_লেখো(কি_মেমরি, 8, 0x07060504)
মেমরি_লেখো(কি_মেমরি, 16, 0x0b0a0908)
মেমরি_লেখো(কি_মেমরি, 24, 0x0f0e0d0c)
মেমরি_লেখো(কি_মেমরি, 32, 0x13121110)
মেমরি_লেখো(কি_মেমরি, 40, 0x17161514)
মেমরি_লেখো(কি_মেমরি, 48, 0x1b1a1918)
মেমরি_লেখো(কি_মেমরি, 56, 0x1f1e1d1c)

// ৯৬-বিট ননস (৩টি ৩২-বিট শব্দ)
মেমরি_লেখো(ননস_মেমরি, 0, 0x00000000)
মেমরি_লেখো(ননস_মেমরি, 8, 0x4a000000)
মেমরি_লেখো(ননস_মেমরি, 16, 0x00000000)
ধরি কাউন্টার = 1

দেখাও "  ✔ ২৫৬-বিট সিমেট্রিক কি (AES-256 সমমানের শক্তি) সফলভাবে লোড হয়েছে!"
দেখাও "  ✔ ৯৬-বিট র্যান্ডম ক্রিপ্টোগ্রাফিক ননস ও কাউন্টার প্রস্তুত!"

// [২] প্লেইনটেক্সট বার্তা বাফার প্রস্তুতি
দেখাও ""
দেখাও "[২] প্লেইনটেক্সট বাফার প্রস্তুতি..."
ধরি প্লেইনটেক্সট_আকার = 16
ধরি প্লেইন_বাফার = মেমরি_বরাদ্দ(64)
ধরি সাইফার_বাফার = মেমরি_বরাদ্দ(64)
ধরি ডিক্রিপ্ট_বাফার = মেমরি_বরাদ্দ(64)

// প্লেইনটেক্সট: "SOVEREIGN_LIPI!" (16 bytes)
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 0, 83)  // 'S'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 1, 79)  // 'O'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 2, 86)  // 'V'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 3, 69)  // 'E'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 4, 82)  // 'R'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 5, 69)  // 'E'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 6, 73)  // 'I'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 7, 71)  // 'G'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 8, 78)  // 'N'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 9, 95)  // '_'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 10, 76) // 'L'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 11, 73) // 'I'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 12, 80) // 'P'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 13, 73) // 'I'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 14, 33) // '!'
মেমরি_বাইট_লেখো(প্লেইন_বাফার, 15, 0)  // '\0'

দেখাও "  • মূল প্লেইনটেক্সট দৈর্ঘ্য: " + প্লেইনটেক্সট_আকার + " বাইট"

// [৩] ChaCha20 সিমেট্রিক এনক্রিপশন (Hardware Rol32 Accelerated)
দেখাও ""
দেখাও "[৩] RFC 8439 ChaCha20 স্ট্রিম এনক্রিপশন শুরু..."
ধরি শুরু_সাইকেল = সিপিউ_ক্লক()
chacha20_প্রসেস(কি_মেমরি, ননস_মেমরি, কাউন্টার, প্লেইন_বাফার, প্লেইনটেক্সট_আকার, সাইফার_বাফার)
ধরি শেষ_সাইকেল = সিপিউ_ক্লক()
ধরি এনক্রিপ্ট_সাইকেল = শেষ_সাইকেল - শুরু_সাইকেল

দেখাও "  ✔ এনক্রিপশন সফল! অতিক্রান্ত সিলিকন সাইকেল: " + এনক্রিপ্ট_সাইকেল

// সাইফারটেক্সট অবশ্যই প্লেইনটেক্সটের সমান হবে না
ধরি c0 = মেমরি_বাইট_পড়ো(সাইফার_বাফার, 0)
ধরি p0 = মেমরি_বাইট_পড়ো(প্লেইন_বাফার, 0)
দেখাও "  • প্লেইনটেক্সট বাইট ০: " + p0 + " ('S')"
দেখাও "  • সাইফারটেক্সট বাইট ০: " + c0 + " (এনক্রিপ্টেড)"
দাবি(c0 != p0, "সাইফারটেক্সট অবশ্যই প্লেইনটেক্সট থেকে ভিন্ন হতে হবে")

// [৪] ChaCha20 সিমেট্রিক ডিক্রিপশন ও অখণ্ডতা যাচাই
দেখাও ""
দেখাও "[৪] ChaCha20 স্ট্রিম ডিক্রিপশন ও ডেটা অখণ্ডতা যাচাই..."
chacha20_প্রসেস(কি_মেমরি, ননস_মেমরি, কাউন্টার, সাইফার_বাফার, প্লেইনটেক্সট_আকার, ডিক্রিপ্ট_বাফার)

ধরি মিল_হয়েছে = 1
ধরি k = 0
যতক্ষণ k < প্লেইনটেক্সট_আকার {
    ধরি orig_b = মেমরি_বাইট_পড়ো(প্লেইন_বাফার, k)
    ধরি dec_b  = মেমরি_বাইট_পড়ো(ডিক্রিপ্ট_বাফার, k)
    যদি orig_b != dec_b {
        মিল_হয়েছে = 0
    }
    k = k + 1
}

দাবি(মিল_হয়েছে == 1, "ডিক্রিপ্টকৃত ডেটা মূল প্লেইনটেক্সটের শতভাগ সমকক্ষ হতে হবে")
দেখাও "  ✔ ডিক্রিপশন শতভাগ সফল! ডিক্রিপ্টকৃত প্রতিটি বাইট মূল বার্তার সাথে অবিকল মিলেছে!"

// [৫] টিএলএস রেকর্ড লেয়ার ফ্রেম প্যাকেজিং (RFC 8446 Application Data 0x17)
দেখাও ""
দেখাও "[৫] RFC 8446 টিএলএস রেকর্ড লেয়ার ফ্রেম সিরিয়ালাইজেশন..."
ধরি ফ্রেম_বাফার = মেমরি_বরাদ্দ(128)
ধরি আনপ্যাক_বাফার = মেমরি_বরাদ্দ(64)

// টাইপ ২৩ = Application Data (RFC 8446 / 5246)
ধরি মোট_ফ্রেম_সাইজ = tls_রেকর্ড_প্যাক(23, সাইফার_বাফার, প্লেইনটেক্সট_আকার, ফ্রেম_বাফার)
দেখাও "  • টিএলএস ফ্রেম তৈরি সম্পন্ন! মোট সাইজ: " + মোট_ফ্রেম_সাইজ + " বাইট (৫ বাইট হেডার + " + প্লেইনটেক্সট_আকার + " বাইট পেয়লোড)"

ধরি hdr_type = মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, 0)
ধরি hdr_maj  = মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, 1)
ধরি hdr_min  = মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, 2)
ধরি hdr_len  = (মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, 3) << 8) | মেমরি_বাইট_পড়ো(ফ্রেম_বাফার, 4)

দেখাও "  • টিএলএস রেকর্ড টাইপ : " + hdr_type + " (প্রত্যাশিত: ২৩ = Application Data)"
দেখাও "  • টিএলএস ভার্সন হেডার: " + hdr_maj + "." + hdr_min + " (TLS 1.2/1.3 Compat 0x0303)"
দেখাও "  • এনকোডেড পেয়লোড সাইজ: " + hdr_len + " বাইট"

দাবি(hdr_type == 23, "টিএলএস রেকর্ড টাইপ অবশ্যই ২৩ হতে হবে")
দাবি(hdr_maj == 3, "টিএলএস মেজর ভার্সন অবশ্যই ৩ হতে হবে")
দাবি(hdr_min == 3, "টিএলএস মাইনর ভার্সন অবশ্যই ৩ হতে হবে")
দাবি(hdr_len == প্লেইনটেক্সট_আকার, "টিএলএস রেকর্ড পেয়লোড দৈর্ঘ্য সঠিক হওয়া আবশ্যক")

// [৬] টিএলএস ফ্রেম আনপ্যাকিং ভ্যালিডেশন
ধরি আনপ্যাক_দৈর্ঘ্য = tls_রেকর্ড_আনপ্যাক(ফ্রেম_বাফার, আনপ্যাক_বাফার)
দাবি(আনপ্যাক_দৈর্ঘ্য == প্লেইনটেক্সট_আকার, "আনপ্যাককৃত পেয়লোড দৈর্ঘ্য মিলতে হবে")
ধরি আনপ্যাক_b0 = মেমরি_বাইট_পড়ো(আনপ্যাক_বাফার, 0)
দাবি(আনপ্যাক_b0 == c0, "আনপ্যাককৃত সাইফারটেক্সট সঠিক হওয়া আবশ্যক")
দেখাও "  ✔ টিএলএস রেকর্ড লেয়ার পার্সিং ও আনপ্যাকিং শতভাগ সফল!"

// মেমরি অবমুক্তি
মেমরি_মুক্তি(আনপ্যাক_বাফার, 64)
মেমরি_মুক্তি(ফ্রেম_বাফার, 128)
মেমরি_মুক্তি(ডিক্রিপ্ট_বাফার, 64)
মেমরি_মুক্তি(সাইফার_বাফার, 64)
মেমরি_মুক্তি(প্লেইন_বাফার, 64)
মেমরি_মুক্তি(ননস_মেমরি, 32)
মেমরি_মুক্তি(কি_মেমরি, 64)

দেখাও ""
দেখাও "🎉 লিপি পিওর সিলিকন টিএলএস ক্রিপ্টো স্ট্রিম ও ChaCha20 ইঞ্জিন সম্পূর্ণ সফল!"
